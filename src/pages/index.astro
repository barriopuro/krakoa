---
import catalogo from "../data/catalogo.json";

const categories = catalogo.categories;

const base = import.meta.env.BASE_URL;

const marqueeText = [
  "Envíos a todo el país",
  "100% Algodón Peinado 24/1",
  "Cortes Oversize y Regular Fit",
  "Estampas DTF Premium",
  "Pre-encogido Térmico",
  "Atención personalizada por WhatsApp",
];
---

<!doctype html>
<html lang="es">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>KRAKOA | REMERAS</title>
<link rel="icon" type="image/png" href={`${base}/logos/krakoalogo-isotipo.webp`} />
  <meta
    name="description"
    content="KRAKOA — Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />

  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#111111" />

  <meta property="og:title" content="KRAKOA | Remeras" />
  <meta
    property="og:description"
    content="Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KRAKOA" />
  <meta property="og:image" content={`${base}/og-image.jpg`} />
  <meta property="og:image:url" content={`${base}/og-image.jpg`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="KRAKOA | Remeras" />
  <meta
    name="twitter:description"
    content="Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />
</head>

  <body>

 <div id="krakoa-loader" class="krakoa-loader" style="position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:#0a0a0a;transition:opacity 0.45s ease;">
  <img src={`${base}/logos/krakoalogo-isotipo.webp`} alt="KRAKOA" style="width:90px;height:auto;opacity:0;transition:opacity 0.6s ease;" />
</div>

<header class="site-header">
  <a href={`${base}/`} class="brand" aria-label="KRAKOA">
    <img
      class="logo-horizontal"
      src={`${base}/logos/krakoalogo-horizontal.webp`}
      alt="KRAKOA"
    />

    <img
      class="logo-isotipo"
      src={`${base}/logos/krakoalogo-isotipo.webp`}
      alt=""
      aria-hidden="true"
    />
  </a>

  <nav class="desktop-nav" aria-label="Navegación principal">
    <a href="#catalogo">Catálogo</a>
    <a href="#como-comprar">Cómo Comprar</a>
    <a href="#calidad">Materiales</a>
  </nav>

  <div class="header-actions">
    <a
      href="https://instagram.com/krakoa.sw"
      target="_blank"
      rel="noopener noreferrer"
      class="instagram-btn"
      aria-label="Instagram de KRAKOA"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
      <span class="instagram-label">@krakoa.sw</span>
    </a>

    <button
      id="cart-toggle"
      class="cart-button"
      type="button"
      aria-label="Ver mi pedido"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
        <path d="M3 6h18" />
        <path d="M16 10a4 4 0 0 1-8 0" />
      </svg>
      <span id="cart-count" class="cart-count" hidden>0</span>
    </button>

    <button
      id="menu-toggle"
      class="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</header>

  <!-- MENÚ MOBILE -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-backdrop"></div>

    <aside
      class="mobile-menu-panel"
      role="dialog"
      aria-modal="true"
      aria-label="Menú de navegación"
    >
      <header class="mobile-menu-header">
        <span class="mobile-menu-title">Menú</span>
        <button
          id="mobile-menu-close"
          class="mobile-menu-close"
          type="button"
          aria-label="Cerrar menú"
        >
          ×
        </button>
      </header>

      <nav class="mobile-menu-nav" aria-label="Secciones">
        <a href="#catalogo" data-menu-link>Catálogo</a>
        <a href="#como-comprar" data-menu-link>Cómo Comprar</a>
        <a href="#calidad" data-menu-link>Materiales</a>
        <a
          href="https://instagram.com/krakoa.sw"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </nav>
    </aside>
  </div>

    <main>
      <section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-content">
    <h1>CATALOGO.</h1>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {[1, 2].map(() =>
      marqueeText.map((item) => (
        <span class="marquee-item">
          {item}
          <i class="marquee-sep">·</i>
        </span>
      ))
    )}
  </div>
</div>

      <section id="catalogo" class="catalog">
        <div class="catalog-header">
        

          <div class="search-wrapper">
            <input
              id="search"
              type="search"
              placeholder="Buscar diseño..."
              autocomplete="off"
            />
          </div>
        </div>

        <nav class="categories" aria-label="Categorías">
          {
  categories.map((category) => (
    <span
      class="category-wrap"
      style={`--category-color: ${category.color ?? "#888888"}`}
    >
      <button
        class="category-button"
        data-category={category.id}
      >
        {category.name}
      </button>
    </span>
  ))
}
        </nav>

        <div id="products" class="products">
          {
            catalogo.products.map((product) => (
              <article
                class="product-card"
                data-name={product.name.toLowerCase()}
                data-category={product.category}
              >
                <button class="product-button" type="button">
                  <div class="product-image">
                    <img
                      src={`${base}/${product.modelo}`}
                      alt={`Remera ${product.name}`}
                      loading="lazy"
                    />
                  </div>

                  <div class="product-info">
  <h3>{product.name}</h3>

  <span
    class="product-category"
    style={`--category-color: ${
      catalogo.categories.find(
        (category) => category.id === product.category
      )?.color ?? "#888888"
    }`}
  >
    <i class="category-dot"></i>
    {product.categoryName}
  </span>
</div>
                </button>
              </article>
            ))
          }
        </div>
           </section>

      <!-- CÓMO COMPRAR -->
      <section id="como-comprar" class="faq-section">
        <div class="faq-inner">
          <div class="faq-head">
            <span class="section-kicker">Preguntas Frecuentes</span>
            <h2>Cómo Comprar en KRAKOA</h2>
            <p class="faq-sub">
              Todo lo que necesitás saber sobre pedidos, pagos, talles y envíos.
            </p>
          </div>

          <div class="faq-list">
            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Cómo realizo mi pedido desde la web?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
                  Navegá por el catálogo, elegí tus diseños favoritos, seleccioná el corte
                  (Oversize o Regular Fit), talle y cantidad, y sumalos a <strong>Mi Pedido </strong>
                   con el botón "Agregar al Pedido". Cuando termines, tocá el ícono del carrito
                  (arriba a la derecha) y hacé click en <strong>"Enviar Pedido por WhatsApp"</strong>.
                  Se genera automáticamente tu lista completa para coordinar pago y entrega.
                </p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Qué medios de pago aceptan?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
                  Aceptamos <strong>transferencias bancarias</strong> directas,
                  <strong> Mercado Pago</strong> (dinero en cuenta, tarjetas de débito y crédito), y
                  <strong> efectivo</strong> para entregas previamente coordinadas.
                </p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Hacen envíos a toda la Argentina?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
                  Sí, realizamos envíos a todo el país mediante <strong>Correo Argentino</strong> y
                  <strong> Andreani</strong> (a sucursal o directo a domicilio). También contamos con
                  servicio de mensajería para CABA y zonas de Gran Buenos Aires.
                </p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Cómo sé qué talle elegir?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
                  En cada remera, dentro del modal de detalle, tenés la opción
                  <strong> "Ver gráfico"</strong> que te muestra la tabla de medidas exactas en
                  centímetros (alto × ancho). Te recomendamos medir una remera tuya estirada
                  sobre una mesa plana para comparar. Si te queda la duda, escribinos por
                  WhatsApp y te asesoramos.
                </p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Qué diferencia hay entre corte Oversize y Regular Fit?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
                  El corte <strong>Oversize</strong> tiene una moldería amplia, con hombros caídos
                  y mayor amplitud en el torso para una estética streetwear holgada. El corte
                  <strong> Regular Fit</strong> es el estándar tradicional, más al cuerpo.
                </p>
              </div>
            </div>

            
          </div>

          <div class="faq-cta">
            <div class="faq-cta-text">
              <h3>¿Tenés una consulta especial?</h3>
              <p>
                Atención personalizada vía WhatsApp para dudas sobre talles, stock o pedidos por mayor.
              </p>
            </div>
            <a
              href="https://wa.me/5491132372306?text=Hola%20KRAKOA!%20Tengo%20una%20consulta%20sobre%20el%20cat%C3%A1logo."
              target="_blank"
              rel="noopener noreferrer"
              class="faq-cta-button"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              Hablar por WhatsApp
            </a>
          </div>
        </div>
      </section>

      <!-- CALIDAD Y MATERIALES -->
      <section id="calidad" class="quality-section">
        <div class="quality-inner">
          <div class="quality-head">
            <span class="section-kicker">Materia Prima & Confección</span>
            <h2>Algodón Pesado & Estampas Inalterables</h2>
            <p class="quality-sub">
              Cada prenda de KRAKOA está pensada bajo estándares de alta calidad.
              No usamos telas livianas ni estampas que se cuartean tras el primer lavado.
            </p>
          </div>

          <div class="quality-pillars">
            <div class="quality-pillar">
              <div class="quality-pillar-head">
              <div class="quality-icon quality-icon--green">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              </div>
              <h3>100% Algodón Peinado 24/1</h3>
              </div>
              <p>
                Hilado premium de fibra larga, de tacto suave pero con gramaje pesado
                (220-240 g) para lograr una caída con cuerpo sin traslucir.
              </p>
            </div>

            <div class="quality-pillar">
              <div class="quality-pillar-head">
              <div class="quality-icon quality-icon--amber">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
                </svg>
              </div>
              <h3>Estampa DTF Premium</h3>
              </div>
              <p>
                Pigmentos de alta fidelidad cromática con curado térmico.
                No se desprenden ni pierden viveza con el uso cotidiano.
              </p>
            </div>

            <div class="quality-pillar">
              <div class="quality-pillar-head">
              <div class="quality-icon quality-icon--sky">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="6" cy="6" r="3"/>
                  <path d="M8.12 8.12 12 12"/>
                  <path d="M20 4 8.12 15.88"/>
                  <circle cx="6" cy="18" r="3"/>
                  <path d="M14.8 14.8 20 20"/>
                </svg>
              </div>
              <h3>Moldería Propia Oversize y Regular Fit</h3>
              </div>
              <p>
                Patron exclusivo con cuello de rib elastizado reforzado de 3 cm
                y sisas con doble despunte para mantener la forma original.
              </p>
            </div>

            <div class="quality-pillar">
              <div class="quality-pillar-head">
              <div class="quality-icon quality-icon--indigo">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/>
                  <path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>
                </svg>
              </div>
              <h3>Pre-encogido Térmico</h3>
              </div>
              <p>
                La tela pasa por un proceso de pre-lavado y vaporizado para
                asegurar que las medidas en centímetros se conserven con los lavados.
              </p>
            </div>
          </div>

          <div class="care-strip">
            <span class="section-kicker">Guía de Cuidado</span>
            <h3 class="care-title">Para prolongar la vida útil de tu remera</h3>

            <div class="care-grid">
              <div class="care-item">
                <strong>Lavar con agua fría</strong>
                <p>Ciclo suave, del revés (estampa hacia adentro), a un máximo de 30°C.</p>
              </div>

              <div class="care-item">
                <strong>No planchar la estampa</strong>
                <p>Planchar la prenda del revés o con un paño intermedio a temperatura media.</p>
              </div>

              <div class="care-item">
                <strong>Secado a la sombra</strong>
                <p>No usar secarropas por calor ni centrifugar a altas revoluciones.</p>
              </div>

              <div class="care-item">
                <strong>No usar lavandina</strong>
                <p>Evitar blanqueadores o productos abrasivos para proteger el color profundo.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

<div id="product-modal" class="modal" aria-hidden="true">
  <div class="modal-backdrop"></div>

  <div class="modal-content" role="dialog" aria-modal="true">
    <button
      id="modal-close"
      class="modal-close"
      type="button"
      aria-label="Cerrar"
    >
      ×
    </button>

    <div class="modal-grid">
      <!-- COLUMNA IZQUIERDA: GALERÍA -->
      <div class="modal-gallery">
        <div class="modal-image-area">
          <button
            id="modal-prev"
            class="modal-arrow modal-prev"
            type="button"
            aria-label="Imagen anterior"
          >
            ‹
          </button>

          <div class="modal-image-wrapper">
            <img id="modal-image" src="" alt="" />
          </div>

          <button
            id="modal-next"
            class="modal-arrow modal-next"
            type="button"
            aria-label="Imagen siguiente"
          >
            ›
          </button>

          <div class="modal-image-overlay">
            <span id="modal-image-label" class="modal-image-label">Modelo</span>
            <span id="modal-image-counter" class="modal-image-counter">1 / 4</span>
          </div>
        </div>

        <div id="modal-thumbs" class="modal-thumbs"></div>
      </div>

      <!-- COLUMNA DERECHA: INFO + SELECTORES -->
      <div class="modal-info">
        <div class="modal-info-header">
          <span id="modal-category" class="modal-category"></span>
          <h2 id="modal-title"></h2>
        </div>

        <div class="modal-info-body">
          <!-- CORTE -->
          <div class="modal-field">
            <div class="modal-label-row">
              <label class="modal-label">
                <span class="modal-step">1.</span> Elegí el corte:
              </label>
              <button
                id="modal-see-chart"
                class="modal-link"
                type="button"
              >
                Ver gráfico
              </button>
            </div>
            <div id="modal-fits" class="modal-fits"></div>
          </div>

          <!-- TALLE -->
          <div class="modal-field">
            <div class="modal-label-row">
              <label class="modal-label">
                <span class="modal-step">2.</span> Elegí el talle:
              </label>
              <span id="modal-size-cm" class="modal-size-cm"></span>
            </div>
            <div id="modal-sizes" class="modal-sizes"></div>
          </div>

          <!-- CANTIDAD -->
          <div class="modal-field modal-quantity-row">
            <label class="modal-label">Cantidad:</label>
            <div class="modal-quantity">
              <button
                id="modal-qty-minus"
                type="button"
                aria-label="Restar uno"
              >
                −
              </button>
              <span id="modal-qty-value">1</span>
              <button
                id="modal-qty-plus"
                type="button"
                aria-label="Sumar uno"
              >
                +
              </button>
            </div>
          </div>

          <!-- AVISO TELA -->
          <div class="modal-note">
            <strong>100% Algodón Peinado 24/1 Premium</strong>
            <p>No encoge, cuello con rib reforzado y costuras de alta resistencia.</p>
          </div>
        </div>

        <div class="modal-info-footer">
          <button id="modal-add" class="modal-add" type="button">
            Agregar al Pedido
          </button>

          <div class="modal-actions">
