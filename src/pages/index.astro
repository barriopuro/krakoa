    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .modal-arrow:hover {
    background: #fff;
    color: #111;
  }

  .modal-prev {
    left: 12px;
  }

  .modal-next {
    right: 12px;
  }

  .modal-image-overlay {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .modal-image-label,
  .modal-image-counter {
    padding: 4px 9px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.75);
    color: #ddd;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .modal-image-counter {
    color: #999;
    font-variant-numeric: tabular-nums;
  }

  .modal-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    flex-shrink: 0;
    width: 100%;
    height: 72px;
  }

  :global(.modal-thumb) {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 2px solid #242424;
    border-radius: 8px;
    background: #141414;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  :global(.modal-thumb:hover) {
    opacity: 0.9;
    border-color: var(--category-color, #666);
  }

  :global(.modal-thumb.active) {
    opacity: 1;
    border-color: var(--category-color, #fff);
    box-shadow: 0 0 10px -2px var(--category-color, #fff);
  }

  :global(.modal-thumb img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* INFO */

  .modal-info {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    background: #111;
  }

  .modal-info-header {
    padding: 22px 24px 14px;
    border-bottom: 1px solid #242424;
    flex-shrink: 0;
  }

  .modal-category {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #999;
  }

  .modal-category::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--category-color, #888);
    box-shadow: 0 0 8px var(--category-color, #888);
  }

  .modal-info-header h2 {
    margin: 0;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 900;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    line-height: 1.05;
    padding-right: 30px;
  }

  .modal-info-body {
    flex: 1;
    overflow-y: auto;
    padding: 18px 24px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-height: 0;
  }

  .modal-field {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .modal-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .modal-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ddd;
  }

  .modal-step {
    color: var(--category-color, #fff);
    font-weight: 900;
  }

  .modal-link {
    background: none;
    border: 0;
    padding: 0;
    color: #888;
    font-size: 11px;
    text-decoration: underline;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .modal-link:hover {
    color: var(--category-color, #fff);
  }

  .modal-size-cm {
    font-size: 11px;
    color: #999;
    font-variant-numeric: tabular-nums;
  }

  /* FITS */

  .modal-fits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  :global(.modal-fit) {
    padding: 12px 14px;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    background: #0a0a0a;
    color: #bbb;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
    font-family: inherit;
    font-size: inherit;
  }

  :global(.modal-fit strong) {
    display: block;
    font-size: 13px;
    color: #fff;
    margin-bottom: 2px;
  }

  :global(.modal-fit span) {
    font-size: 11px;
    color: #888;
    line-height: 1.35;
  }

  :global(.modal-fit:hover) {
    border-color: #444;
    background: #141414;
  }

  :global(.modal-fit.active) {
    border-color: var(--category-color, #fff);
    background: #181818;
  }

  :global(.modal-fit.active strong) {
    color: var(--category-color, #fff);
  }

  /* SIZES */

  .modal-sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  :global(.modal-size) {
    min-width: 48px;
    padding: 9px 12px;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    background: #0a0a0a;
    color: #ccc;
    font-family: monospace;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global(.modal-size:hover) {
    border-color: #444;
    background: #141414;
  }

  :global(.modal-size.active) {
    border-color: var(--category-color, #fff);
    background: var(--category-color, #fff);
    color: #0a0a0a;
  }

  /* QUANTITY */

  .modal-quantity-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .modal-quantity {
    display: inline-flex;
    align-items: center;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    overflow: hidden;
    background: #0a0a0a;
  }

  .modal-quantity button {
    width: 34px;
    height: 34px;
    border: 0;
    background: transparent;
    color: #bbb;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .modal-quantity button:hover {
    background: #1f1f1f;
    color: #fff;
  }

  .modal-quantity span {
    min-width: 34px;
    padding: 0 6px;
    text-align: center;
    font-family: monospace;
    font-size: 14px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* NOTE */

  .modal-note {
    padding: 12px 14px;
    border: 1px solid #242424;
    border-radius: 10px;
    background: #0a0a0a;
  }

  .modal-note strong {
    display: block;
    font-size: 12px;
    color: #ddd;
    margin-bottom: 3px;
  }

  .modal-note p {
    margin: 0;
    font-size: 11px;
    color: #777;
    line-height: 1.4;
  }

  /* FOOTER */

  .modal-info-footer {
    border-top: 1px solid #242424;
    padding: 16px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
  }

  .modal-add {
    width: 100%;
    padding: 14px 18px;
    border: 0;
    border-radius: 10px;
    background: var(--category-color, #fff);
    color: #0a0a0a;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.15s ease, filter 0.2s ease;
  }

  .modal-add:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }

  .modal-add.is-added {
    background: #25d366 !important;
    color: #fff;
  }

  .modal-actions {
    display: flex;
    gap: 8px;
  }

  .modal-whatsapp,
  .modal-share {
    flex: 1;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, border-color 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .modal-whatsapp {
    background: #25d366;
    color: #fff;
    border: 1px solid #25d366;
  }

  .modal-whatsapp:hover {
    background: #35e276;
    border-color: #35e276;
  }

  .modal-share {
    background: transparent;
    color: #ddd;
    border: 1px solid #2a2a2a;
  }

  .modal-share:hover {
    border-color: var(--category-color, #fff);
    color: var(--category-color, #fff);
  }

  :global(body.modal-open) {
    overflow: hidden;
  }

  /* MODAL RESPONSIVE */

   @media (max-width: 800px) {
    .modal {
      padding: 0;
      align-items: stretch;
    }

    .modal-content {
      width: 100%;
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
      border: 0;
      overflow: hidden;
    }

    /* En mobile el modal-grid pasa a ser el ÚNICO scroller:
       todo el contenido (foto, thumbs, título, selectores, botones)
       se desplaza junto. */
    .modal-grid {
      display: flex;
      flex-direction: column;
      grid-template-columns: none;
      height: 100%;
      max-height: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
    }

    .modal-gallery {
      flex-shrink: 0;
      border-right: 0;
      border-bottom: 1px solid #242424;
      padding: 14px;
    }

    .modal-image-area {
      aspect-ratio: 1 / 1;
      flex: none;
      min-height: auto;
    }

    /* La info deja de ser flex/scroll internamente en mobile. */
    .modal-info {
      display: block;
      flex-shrink: 0;
      min-height: auto;
    }

    .modal-info-header {
      padding: 18px 16px 12px;
    }

    .modal-info-body {
      padding: 16px;
      overflow: visible;
      flex: none;
      min-height: auto;
    }

    .modal-info-footer {
      padding: 14px 16px;
      flex-shrink: 0;
    }

    .modal-close {
      top: 10px;
      right: 10px;
    }
  }

    :global(.back-to-top) {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 900;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(40, 40, 40, 0.9);
    color: white;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
  }

  :global(.back-to-top.visible) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

    :global(.back-to-top:hover) {
    background: #555;
  }


  /* Cart drawer */
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 1100;
    display: none;
  }

  .cart-drawer.open {
    display: block;
  }

  .cart-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }

  .cart-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(420px, 100vw);
    height: 100%;
    background: #111;
    border-left: 1px solid #242424;
    display: flex;
    flex-direction: column;
    animation: slideInRight 0.28s ease;
  }

  @keyframes slideInRight {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .cart-drawer-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    border-bottom: 1px solid #242424;
  }

  .cart-drawer-header h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    flex: 1;
  }

  .cart-drawer-count {
    min-width: 24px;
    height: 24px;
    padding: 0 8px;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-size: 12px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
  }

  .cart-drawer-close {
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #999;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cart-drawer-close:hover {
    background: #242424;
    color: #fff;
  }

  .cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 18px 20px;
  }

  .cart-empty {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #777;
    padding: 20px;
  }

  .cart-empty p {
    margin: 0;
    font-size: 14px;
    color: #ccc;
    font-weight: 600;
  }

  .cart-empty-hint {
    font-size: 12px !important;
    color: #666 !important;
    font-weight: 400 !important;
    margin-top: 6px !important;
    max-width: 260px;
    line-height: 1.5;
  }

  .cart-empty-cta {
    margin-top: 22px;
    padding: 10px 16px;
    border: 0;
    border-radius: 8px;
    background: #242424;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .cart-empty-cta:hover {
    background: #333;
  }

  .cart-drawer-footer {
    border-top: 1px solid #242424;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cart-drawer-total {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: #aaa;
  }

  .cart-drawer-total strong {
    color: #fff;
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }

  .cart-drawer-whatsapp {
    width: 100%;
    padding: 14px 16px;
    border: 0;
    border-radius: 10px;
    background: #25d366;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .cart-drawer-whatsapp:hover {
    background: #35e276;
    transform: translateY(-1px);
  }

  :global(body.cart-open) {
    overflow: hidden;
  }

    @media (max-width: 700px) {
    .cart-drawer-panel {
      width: 100vw;
    }
  }

  /* Items del carrito */
  :global(.cart-items-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #888;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid #1f1f1f;
  }

  :global(.cart-clear) {
    background: none;
    border: 0;
    padding: 0;
    color: #666;
    font-size: 11px;
    text-decoration: underline;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  :global(.cart-clear:hover) {
    color: #f87171;
  }

  :global(.cart-items) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.cart-item) {
    display: flex;
    gap: 12px;
    padding: 12px;
    background: #0a0a0a;
    border: 1px solid #242424;
    border-radius: 10px;
  }

  :global(.cart-item-img) {
    width: 60px;
    height: 76px;
    object-fit: cover;
    background: #141414;
    border-radius: 6px;
    flex-shrink: 0;
    border: 1px solid #242424;
    display: block;
  }

  :global(.cart-item-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  :global(.cart-item-top) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 6px;
  }

  :global(.cart-item-top h4) {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.cart-item-remove) {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 0;
    background: transparent;
    color: #666;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s ease;
  }

  :global(.cart-item-remove:hover) {
    color: #f87171;
  }

  :global(.cart-item-meta) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 3px;
    font-size: 11px;
    color: #999;
  }

  :global(.cart-item-meta strong) {
    color: #fff;
    font-family: monospace;
  }

  :global(.cart-item-qty) {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    margin-top: 8px;
    border: 1px solid #242424;
    border-radius: 6px;
    overflow: hidden;
    background: #111;
  }

  :global(.cart-item-qty button) {
    width: 26px;
    height: 26px;
    border: 0;
    background: transparent;
    color: #999;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  :global(.cart-item-qty button:hover) {
    background: #1f1f1f;
    color: #fff;
  }

  :global(.cart-item-qty span) {
    min-width: 26px;
    padding: 0 4px;
    text-align: center;
    font-family: monospace;
    font-size: 12px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* Empty state (ahora también lo genera el JS, así que va en :global) */
  :global(.cart-empty) {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #777;
    padding: 20px;
  }

  :global(.cart-empty p) {
    margin: 0;
    font-size: 14px;
    color: #ccc;
    font-weight: 600;
  }

  :global(.cart-empty-hint) {
    font-size: 12px !important;
    color: #666 !important;
    font-weight: 400 !important;
    margin-top: 6px !important;
    max-width: 260px;
    line-height: 1.5;
  }

  :global(.cart-empty-cta) {
    margin-top: 22px;
    padding: 10px 16px;
    border: 0;
    border-radius: 8px;
    background: #242424;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  :global(.cart-empty-cta:hover) {
    background: #333;
  }

  /* ------------------------------------ */
  /* SECCIÓN CÓMO COMPRAR (FAQ ACORDEÓN)  */
  /* ------------------------------------ */

  .faq-section {
    width: 100%;
    padding: 80px 5vw 90px;
    border-top: 1px solid #1f1f1f;
    background: #0b0b0b;
  }

  .faq-inner {
    width: min(820px, 100%);
    margin: 0 auto;
  }

  .faq-head {
    text-align: center;
    margin-bottom: 44px;
  }

  .section-kicker {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #777;
    margin-bottom: 10px;
  }

  .faq-head h2 {
    margin: 0 0 12px;
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 900;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.05;
  }

  .faq-sub {
    margin: 0;
    color: #888;
    font-size: 14px;
    line-height: 1.5;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq-item {
    border: 1px solid #232323;
    border-radius: 12px;
    background: #111;
    overflow: hidden;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .faq-item:hover {
    border-color: #333;
  }

  .faq-item.open {
    border-color: #444;
    background: #151515;
  }

  .faq-question {
    width: 100%;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    border: 0;
    background: transparent;
    color: #eee;
    font-size: 14px;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .faq-question:hover {
    color: #fff;
  }

  .faq-chevron {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: #777;
    transition: transform 0.25s ease, color 0.2s ease;
  }

  .faq-item.open .faq-chevron {
    transform: rotate(180deg);
    color: #fff;
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .faq-answer p {
    margin: 0;
    padding: 0 20px 20px;
    color: #a5a5a5;
    font-size: 13.5px;
    line-height: 1.65;
  }

  .faq-answer strong {
    color: #ddd;
