  // S35: actualiza la tarjeta (imágenes + dot activo) cuando cambia
  // el color, sea desde el dot de la tarjeta o desde el modal.
  // Mantiene la coherencia visual entre ambos.
  function updateCardColorVisual(productId, colorSlug, colorData) {
    if (!productId || !colorData) return;
    const card = document.querySelector(
      `.product-card[data-id="${productId}"]`
