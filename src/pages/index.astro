---
import catalogo from "../data/catalogo.json";
import promo from "../data/promo.json";
import "../styles/global.css";

const categories = catalogo.categories;

// Conteo de productos por categoría, para el badge del menú.
const productCountByCategory = {};
catalogo.products.forEach((p) => {
  productCountByCategory[p.category] = (productCountByCategory[p.category] || 0) + 1;
});

const base = import.meta.env.BASE_URL;

// URL base absoluta para los JSON-LD (Schema.org necesita URLs absolutas).
// Si Astro.site no está configurado, cae a la URL de producción.
// Nota: evitamos optional chaining (?.), nullish coalescing (??) y
// template literals en este bloque porque el scanner de dependencias
// de Vite 7 (rolldown) no los procesa bien en el frontmatter.
const siteOriginRaw = Astro.site ? Astro.site.origin : "https://barriopuro.github.io";
const SITE_ORIGIN = siteOriginRaw.replace(/\/$/, "");
const BASE_PATH = base.endsWith("/") ? base.slice(0, -1) : base;

function productUrl(path) {
  return SITE_ORIGIN + BASE_PATH + path;
}

// (SCHEMA_PRICES y SCHEMA_ORG se eliminaron del frontmatter porque
// el scanner de dependencias de Vite 7 (rolldown) falla al parsear
// declaraciones const con objetos literales en este contexto.
// Los valores van inline en el JSON-LD del head.)

const totalModelos = catalogo.products.length;

const marqueeText = [
  "Envíos a todo el país",
  "" + totalModelos + " modelos diferentes",
  "100% Algodón Peinado 24/1",
  "Cortes Oversize y Regular Fit",
  "Estampas DTF Premium",
  "Pre-encogido Térmico",
  "Atención personalizada por WhatsApp",
];
---

<!doctype html>
<html lang="es">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>KRAKOA | REMERAS</title>
<link rel="icon" type="image/png" href={`${base}/logos/krakoalogo-isotipo.webp`} />
  <meta
    name="description"
    content="KRAKOA — Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />

  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#111111" />

  <meta property="og:title" content="KRAKOA | Remeras" />
  <meta
    property="og:description"
    content="Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KRAKOA" />
  <!-- S31: URLs absolutas para que WhatsApp/Facebook/Twitter/LinkedIn
       muestren la miniatura al compartir. Los scrapers de redes NO
       resuelven `og:image` si es relativa ("/krakoa/og-image.jpg");
       necesitan la URL completa (https://...). Por eso usamos
       SITE_ORIGIN + BASE_PATH (constantes del frontmatter). -->
  <meta property="og:url" content={SITE_ORIGIN + BASE_PATH + "/"} />
  <meta property="og:image" content={SITE_ORIGIN + BASE_PATH + "/og-image.jpg"} />
  <meta property="og:image:url" content={SITE_ORIGIN + BASE_PATH + "/og-image.jpg"} />
  <meta property="og:image:secure_url" content={SITE_ORIGIN + BASE_PATH + "/og-image.jpg"} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="KRAKOA — Remeras" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="KRAKOA | Remeras" />
  <meta
    name="twitter:description"
    content="Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />
  <meta name="twitter:image" content={SITE_ORIGIN + BASE_PATH + "/og-image.jpg"} />
  <meta name="twitter:image:alt" content="KRAKOA — Remeras" />

  <!-- Schema.org: Organization + todos los productos en un único
       script con @graph. Antes había 117 <script> inline (uno por
       producto) que el navegador tenía que parsear. Ahora es uno
       solo. Google lo acepta igual. -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          name: "KRAKOA",
          url: SITE_ORIGIN + BASE_PATH,
          logo: SITE_ORIGIN + BASE_PATH + "/logos/krakoalogo-horizontal.webp",
          sameAs: ["https://instagram.com/krakoa.sw"],
        },
        ...catalogo.products.map((product) => ({
          "@type": "Product",
          name: product.name,
          image: SITE_ORIGIN + BASE_PATH + product.modelo,
          description: "Remera " + product.name + " de KRAKOA. Categoría: " + product.categoryName + ". Algodón peinado 24/1, estampa DTF premium.",
          sku: product.id,
          brand: { "@type": "Brand", name: "KRAKOA" },
          offers: {
            "@type": "AggregateOffer",
            priceCurrency: "ARS",
            lowPrice: "20000",
            highPrice: "25000",
            offerCount: "3",
            availability: "https://schema.org/InStock",
          },
        })),
      ],
    })}
  ></script>

  <!-- S31: Clarity se carga diferido. El snippet original corría en
       el arranque (async, pero competía con el render inicial por
       CPU/red en mobile). Ahora espera a la primera interacción del
       usuario (scroll, click, touch, tecla) o a los 5s como
       fallback. El usuario que rebota en <1s no se trackea (pérdida
       aceptable). El usuario real se trackea igual, un instante más
       tarde. -->
  <script is:inline>
    (function(){
      var loaded = false;
      function loadClarity() {
        if (loaded) return;
        loaded = true;
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "yuh7dq7teh");
      }
      ["scroll", "click", "touchstart", "keydown", "pointerdown"].forEach(function(ev){
        window.addEventListener(ev, loadClarity, { once: true, passive: true });
      });
      setTimeout(loadClarity, 5000);
    })();
  </script>

  <!-- Fuente custom (Payback, renombrada a KrakoaFont).
       set:html + template literal permite interpolar ${base} dentro
       del CSS. Necesario porque el sitio corre con base: /krakoa. -->
  <style is:inline set:html={`
    @font-face {
      font-family: "KrakoaFont";
      src: url("${base}/fonts/krakoafont.ttf") format("truetype");
      font-weight: normal;
      font-style: normal;
      font-display: swap;
    }
  `}></style>
    <link rel="preload" as="font" type="font/ttf" href={`${base}/fonts/krakoafont.ttf`} crossorigin />
  
  <!-- Precargamos la primera imagen del hero (que ahora es estática
       en el HTML). El navegador la prioriza desde el HTML y la baja
       antes que las 234 imágenes del catálogo. El LCP debería bajar
       a ~2-3s. -->
  <link rel="preload" as="image" href={`${base}/${catalogo.products[0].modelo}`} fetchpriority="high" />

  <!-- S33: precargamos las imágenes de las primeras tarjetas del
       catálogo (productos 1, 2 y 3 del JSON — el 0 ya está precargado
       arriba como hero). Se precargan CON srcset para que el navegador
       elija la variante correcta según el viewport (igual que el <img>
       de la tarjeta). Acelera el LCP del catálogo, que es lo segundo
       que ve el usuario después del hero. -->
  {catalogo.products.slice(1, 4).map((product) => (
    <link
      rel="preload"
      as="image"
      href={`${base}/${product.modelo}`}
      imagesrcset={`${base}/${product.modelo400} 400w, ${base}/${product.modelo600} 600w, ${base}/${product.modelo} 1000w`}
      imagesizes="(max-width: 900px) 50vw, (max-width: 1400px) 33vw, 25vw"
    />
  ))}
</head>

  <body>

 <div id="krakoa-loader" class="krakoa-loader" style="position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:#0a0a0a;transition:opacity 0.45s ease;">
  <img src={`${base}/logos/krakoalogo-isotipo.webp`} alt="KRAKOA" style="width:90px;height:auto;opacity:0;transition:opacity 0.6s ease;" />
</div>

<!-- Barra de progreso de scroll: línea fina arriba de todo que
     se llena a medida que el usuario baja la página. -->
<div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

<header class="site-header">
  <a href={`${base}/`} class="brand" aria-label="KRAKOA">
    <img
      class="logo-horizontal"
      src={`${base}/logos/krakoalogo-horizontal.webp`}
      alt="KRAKOA"
    />

    <img
      class="logo-isotipo"
      src={`${base}/logos/krakoalogo-isotipo.webp`}
      alt=""
      aria-hidden="true"
    />
  </a>

  <nav class="desktop-nav" aria-label="Navegación principal">
    <a href="#catalogo">Catálogo</a>
    <a href="#como-comprar">Cómo Comprar</a>
    <a href="#calidad">Materiales</a>
  </nav>

  <div class="header-actions">
    <!-- Buscador: en desktop es un input visible; en mobile es una lupa
         que despliega el input transformando el header. -->
    <button
      id="search-toggle"
      class="search-toggle"
      type="button"
      aria-label="Buscar"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>

    <div class="header-search-panel" id="header-search-panel">
      <input
        id="search"
        type="search"
        placeholder="Buscar diseño..."
        autocomplete="off"
        aria-label="Buscar diseño"
      />
      <button
        id="search-close"
        class="search-close"
        type="button"
        aria-label="Cerrar búsqueda"
      >
        ×
      </button>
    </div>

    <a
      href="https://instagram.com/krakoa.sw"
      target="_blank"
