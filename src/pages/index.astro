    lastCartUnitPrice = unitPrice;
  }


  function buildWhatsAppOrderMessage() {
    const total = getTotalCount();
    const unitPrice = getUnitPrice(total);
    const subtotal = total * unitPrice;

    let text = `¡Hola KRAKOA! Quería encargar las siguientes remeras:\n\n`;

    cartItems.forEach((item, index) => {
      const lineTotal = item.quantity * unitPrice;
      text += `${index + 1}. *Remera ${item.name}*\n`;
      text += `   - Corte: *${item.fit}*\n`;
      text += `   - Talle: *${item.size}*\n`;
      text += `   - Cantidad: *${item.quantity}*\n`;
      text += `   - Precio unitario: *${formatPrice(unitPrice)}*\n`;
      text += `   - Subtotal: *${formatPrice(lineTotal)}*\n\n`;
    });

    text += `Subtotal prendas (${total} ${total === 1 ? "unidad" : "unidades"}): *${formatPrice(subtotal)}*\n`;
    text += `Precio por unidad aplicado: *${formatPrice(unitPrice)}*\n`;
    text += `Envío: *A coordinar según zona*\n\n`;
    text += `¿Tienen disponibilidad y cómo coordinamos pago y envío? ¡Gracias!`;

    return text;
