  const imageZoom = document.querySelector("#image-zoom");
  const imageZoomImg = document.querySelector("#image-zoom-img");
  const imageZoomClose = document.querySelector("#image-zoom-close");
  const imageZoomPrev = document.querySelector("#image-zoom-prev");
  const imageZoomNext = document.querySelector("#image-zoom-next");
  const modalImageWrapper = document.querySelector(".modal-image-wrapper");

  // ¿Qué slides del carrusel son zoomeables?
  // Regla: todos los slides de fotos SÍ, las dos últimas (tablas de
  // talles) NO. Se calcula dinámicamente según la cantidad de slides
  // del producto actual (porque puede haber fotos extra).
  function isZoomableSlide(index, total) {
    // Los últimos 2 slides siempre son las tablas de talles.
    return index < total - 2;
  }

  // Índice del slide que está mostrándose en el zoom (dentro de
  // currentImages). Guardamos esto para poder navegar entre fotos
  // zoomeables sin cerrar el zoom.
  let zoomImageIndex = 0;

  // Estado del zoom de imagen (1 = tamaño original).
  let zoomScale = 1;
  let zoomPanX = 0;
  let zoomPanY = 0;
  let zoomIsDragging = false;
  let zoomDragStartX = 0;
  let zoomDragStartY = 0;
  let zoomDragStartPanX = 0;
  let zoomDragStartPanY = 0;
  let zoomDidDrag = false;

  const ZOOM_MIN = 1;
  const ZOOM_MAX = 4;
  const ZOOM_STEP = 0.15;
  const ZOOM_DRAG_THRESHOLD = 4; // px de movimiento para considerar drag

  // Aplica el transform actual (translate + scale) y actualiza el cursor.
  function applyImageZoomTransform() {
    if (!imageZoomImg) return;
    imageZoomImg.style.transform =
      `translate(${zoomPanX}px, ${zoomPanY}px) scale(${zoomScale})`;
    imageZoomImg.classList.toggle("is-zoomed", zoomScale > 1);
  }

  // Limita el pan para que la imagen no se pueda arrastrar más allá de
  // sus bordes naturales. Si la imagen es más grande que el viewport,
  // permite pan hasta que un borde coincida con el borde opuesto.
  function clampImageZoomPan() {
    if (!imageZoomImg || !imageZoom) return;
    if (zoomScale <= 1) {
      zoomPanX = 0;
      zoomPanY = 0;
      return;
    }

    const rect = imageZoomImg.getBoundingClientRect();
    const W = rect.width / zoomScale;
    const H = rect.height / zoomScale;
    const container = imageZoom.getBoundingClientRect();

    const maxPanX = Math.max(0, (W * zoomScale - container.width) / 2);
    const maxPanY = Math.max(0, (H * zoomScale - container.height) / 2);

    zoomPanX = Math.max(-maxPanX, Math.min(maxPanX, zoomPanX));
    zoomPanY = Math.max(-maxPanY, Math.min(maxPanY, zoomPanY));
  }

  // Resetea el zoom (escala y pan) a su estado inicial.
  function resetImageZoomScale() {
    zoomScale = 1;
    zoomPanX = 0;
    zoomPanY = 0;
    zoomIsDragging = false;
    zoomDidDrag = false;
    if (imageZoomImg) {
      imageZoomImg.style.transform = "";
      imageZoomImg.style.transformOrigin = "";
      imageZoomImg.classList.remove("is-zoomed", "is-grabbing");
    }
  }

  // Lista de índices zoomeables del producto actual. Se recalcula
  // cada vez que se abre un modal (porque currentImages cambia).
  let zoomableIndices = [];

  function getSizesForFit(fit) {
    return SIZE_CHART[fit] || [];
  }

  function getMeasure(fit, size) {
    return getSizesForFit(fit).find((item) => item.size === size) || null;
  }


  function renderThumbs() {
    modalThumbs.innerHTML = "";

    currentImages.forEach((image, index) => {
      const thumb = document.createElement("button");
      thumb.type = "button";
      thumb.className = "modal-thumb";
      if (index === currentImageIndex) thumb.classList.add("active");
      thumb.setAttribute("aria-label", `Ver ${image.label}`);

      const img = document.createElement("img");
      img.src = image.thumbSrc || image.src;
      img.alt = image.label;
      img.loading = "lazy";

      thumb.appendChild(img);

      thumb.addEventListener("click", () => {
        if (index === currentImageIndex) return;
        const direction = index > currentImageIndex ? "next" : "prev";
        currentImageIndex = index;
        renderModalImage(direction);
      });

      modalThumbs.appendChild(thumb);
    });
  }


  // Renderiza la imagen del modal con una transición direccional.
  // direction: "next" (entra desde la derecha), "prev" (entra desde la izquierda),
  // "fade" (sin desplazamiento, para saltos como "Ver gráfico").
  // Renderiza la imagen del modal con una transición direccional.
  // direction: "next" (entra desde la derecha) o "prev" (entra desde la izquierda).
  // cleanupDelay: cuánto esperar antes de swapear los roles de las capas.
  //   340ms en modo normal (0.32s de transición + 20ms de margen).
  //   140ms en fast-forward (0.12s de transición + 20ms de margen).
  function renderModalImage(direction = "next", cleanupDelay = 340) {
    const current = currentImages[currentImageIndex];
    if (!current) return;

    // Marcamos el wrapper como zoomeable solo si el slide actual es una foto.
    modalImageWrapper.classList.toggle(
      "is-zoomable",
      isZoomableSlide(currentImageIndex, currentImages.length)
    );

    const thumbs = modalThumbs.querySelectorAll(".modal-thumb");
    thumbs.forEach((thumb, index) => {
      thumb.classList.toggle("active", index === currentImageIndex);
    });

    // La capa visible y la capa oculta.
    const visible = modalImageActive;
    const hidden = visible === modalImageA ? modalImageB : modalImageA;

    // ¿Es el primer render (no hay nada visible todavía)?
    const isFirstRender = !visible.src;

    if (isFirstRender) {
      visible.src = current.src;
      visible.alt = `${currentProductName} — ${current.label}`;
      visible.decoding = "async";
      visible.classList.add("active");
      return;
    }

    // Las clases de animación según la dirección.
    let enterClass, leaveClass;
    if (direction === "next") {
      enterClass = "enter-from-right";
      leaveClass = "leave-to-left";
    } else {
      enterClass = "enter-from-left";
      leaveClass = "leave-to-right";
    }

    // 1) Preparamos la capa oculta: src nuevo, posición inicial, sin transición.
    hidden.src = current.src;
    hidden.alt = `${currentProductName} — ${current.label}`;
    hidden.decoding = "async";
    hidden.classList.remove(
      "active",
      "enter-from-right",
      "enter-from-left"
    );
    hidden.classList.add(enterClass);
    // Forzamos reflow para que el navegador registre la posición inicial
    // antes de animar hacia la posición final. Sin esto, a veces el navegador
    // agrupa los cambios de clase y saltea la animación.
    hidden.getBoundingClientRect();

    // Capturamos el token de este render. Si otro render arranca antes
    // de que corra el cleanup, este cleanup se descarta.
    const myToken = ++renderToken;

    // 2) Disparamos la animación.
    requestAnimationFrame(() => {
      if (myToken !== renderToken) return;

      hidden.classList.remove(enterClass);
      hidden.classList.add("active");

      visible.classList.remove("active");
      visible.classList.add(leaveClass);

      // Cuando termina la transición, limpiamos y swapeamos el rol.
      const cleanup = () => {
        if (myToken !== renderToken) return;
        visible.classList.remove(leaveClass);
        visible.classList.remove("active");
        // La que era "visible" pasa a ser la oculta (se queda con el src viejo
        // hasta el próximo render).
        modalImageActive = hidden;
      };
      setTimeout(cleanup, cleanupDelay);
    });
  }


  function renderFits() {
    modalFits.innerHTML = "";

    ["Oversize", "Regular"].forEach((fit) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "modal-fit";
      if (fit === selectedFit) btn.classList.add("active");

      btn.innerHTML = fit === "Oversize"
        ? `<strong>Oversize</strong><span>Hombros caídos, corte amplio</span>`
        : `<strong>Regular Fit</strong><span>Corte tradicional al cuerpo</span>`;

      btn.addEventListener("click", () => {
        if (selectedFit === fit) return;
        selectedFit = fit;

        // Si el talle actual no existe en el nuevo corte, bajamos al más alto disponible.
        const sizes = getSizesForFit(selectedFit);
        const exists = sizes.some((item) => item.size === selectedSize);
        if (!exists) {
          selectedSize = sizes[sizes.length - 1].size;
        }

        renderFits();
        renderSizes();
        updateSizeCm();
      });

      modalFits.appendChild(btn);
    });
  }


  function renderSizes() {
    modalSizes.innerHTML = "";

    const sizes = getSizesForFit(selectedFit);

    sizes.forEach(({ size }) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "modal-size";
      btn.textContent = size;
      if (size === selectedSize) btn.classList.add("active");

      btn.addEventListener("click", () => {
        selectedSize = size;
        renderSizes();
        updateSizeCm();
      });

      modalSizes.appendChild(btn);
    });
  }


  function updateSizeCm() {
    const measure = getMeasure(selectedFit, selectedSize);
    if (!measure) {
      modalSizeCm.textContent = "";
      return;
    }
    modalSizeCm.textContent = `${measure.alto} cm alto × ${measure.ancho} cm ancho`;
  }


  function renderQuantity(animate = false) {
    modalQtyValue.textContent = currentQuantity;
    updatePriceBlock(animate);
  }


  // -------------------------
  // BLOQUE DE PRECIO DEL MODAL
  // -------------------------

  // Guardamos el último precio unitario renderizado para detectar
  // cuándo cambia de tier y disparar el flash verde/rojo.
  // Se resetea al abrir el modal (sin flash al abrir).
  let lastUnitPrice = null;

  // Dibuja la tablita de tiers. Marca con .active la fila que corresponde
  // al total proyectado actual.
  function renderPriceTiers(activeTierIndex) {
    modalPriceTiers.innerHTML = "";

    PRICE_TIERS.forEach((tier, index) => {
      const row = document.createElement("div");
      row.className = "modal-price-tier";
      if (index === activeTierIndex) row.classList.add("active");

      const labelEl = document.createElement("span");
      labelEl.className = "modal-price-tier-label";
      labelEl.textContent = tier.label;

      const valueEl = document.createElement("span");
      valueEl.className = "modal-price-tier-value";
      valueEl.textContent = `${formatPrice(tier.price)} c/u`;

      row.appendChild(labelEl);
      row.appendChild(valueEl);
      modalPriceTiers.appendChild(row);
    });
  }

  // Dispara el flash verde o rojo sobre el precio grande.
  function flashPriceElement(el, isCheaper) {
    el.classList.remove("flash-green", "flash-red");
    // Forzamos reflow para que la animación se reinicie aunque ya
    // tenga una clase aplicada de un flash anterior.
    void el.offsetWidth;
    el.classList.add(isCheaper ? "flash-green" : "flash-red");
    setTimeout(() => {
      el.classList.remove("flash-green", "flash-red");
    }, 620);
  }

  // Guarda el último precio renderizado para comparar dígito a dígito.
  // Se resetea a null cuando se abre el modal (sin animación al abrir).
  let lastRenderedPrice = null;

  // Renderiza el precio en #modal-price-unit como una serie de spans
  // (uno por carácter). Si hay un precio anterior y los caracteres en
  // la misma posición son distintos, esos dígitos "ruedan" (sale el
  // viejo, entra el nuevo). Los que no cambian se quedan quietos.
  //
  // Ejemplo: "$25.000" → "$23.000"
  //   Los caracteres cambian en la posición del 5→3 (el 2, 5, ".", 0, 0, 0).
  //   Solo el "5" y el "3" son distintos en esa posición. Los demás
  //   (2, ".", 0, 0, 0) se mantienen. Se anima solo el que cambió.
  function renderPriceDigits(newText, animate = true) {
    if (!modalPriceUnit) return;

    // Si NO hay que animar (primera vez, o se resetea al abrir el modal),
    // reemplazamos el contenido directamente sin spans de animación.
    if (!animate || lastRenderedPrice === null || lastRenderedPrice === newText) {
      modalPriceUnit.textContent = newText;
      lastRenderedPrice = newText;
      return;
    }

    const oldText = lastRenderedPrice;
    // Recorremos carácter por carácter. Manejamos el caso en que las
    // longitudes sean distintas (ej: "$9.000" → "$10.000", que pasa
    // de 6 a 7 caracteres). En ese caso, todos los caracteres a
    // partir de la primera diferencia se animan (no solo uno).
    const maxLen = Math.max(oldText.length, newText.length);
    const fragments = [];

    for (let i = 0; i < maxLen; i++) {
      const oldCh = oldText[i] ?? "";
      const newCh = newText[i] ?? "";

      if (oldCh === newCh) {
        // Carácter sin cambios: se renderiza estático.
        const span = document.createElement("span");
        span.className = "price-digit";
        span.textContent = newCh;
        fragments.push(span);
      } else {
        // Carácter que cambia: se anima con el "out" y el "in".
        const wrapper = document.createElement("span");
        wrapper.className = "price-digit";
        // Clonamos los caracteres a partir del índice i para que
        // todos los que cambian se animen juntos (si las longitudes
        // difieren, es la única forma de que se vea coherente).
        if (oldCh) {
          const out = document.createElement("span");
          out.className = "digit-out";
          out.textContent = oldText.slice(i);
          wrapper.appendChild(out);
        }
        const inEl = document.createElement("span");
        inEl.className = "digit-in";
        inEl.textContent = newText.slice(i);
        wrapper.appendChild(inEl);
        fragments.push(wrapper);
        // Cortamos: el "out" y el "in" ya tienen el resto del texto.
        break;
      }
    }

    // Construimos los fragmentos en un DocumentFragment y los
    // reemplazamos de una sola vez con replaceChildren. Así el
    // contenedor NUNCA queda vacío (que causaba un salto de layout
    // porque el padre colapsaba a 0px por un frame).
    const fragment = document.createDocumentFragment();
    fragments.forEach((frag) => fragment.appendChild(frag));
    modalPriceUnit.replaceChildren(fragment);

    lastRenderedPrice = newText;
  }

  // Recalcula y pinta todo el bloque de precio.
  // animate: si es true, dispara el flash cuando cambia el unitario.
  function updatePriceBlock(animate = false) {
    const cartTotal = getTotalCount();
    const projectedTotal = cartTotal + currentQuantity;
    const unitPrice = getUnitPrice(projectedTotal);
    const totalWithProduct = projectedTotal * unitPrice;

    // Precio grande (con animación de dígitos que ruedan al cambiar).
    // Solo animamos si animate = true (no en la apertura del modal
    // ni cuando se resetea el estado).
    renderPriceDigits(`${formatPrice(unitPrice)} c/u`, animate);

    // Texto chico de contexto
    if (cartTotal === 0) {
      modalPriceSub.textContent =
        currentQuantity === 1
          ? "Llevás 1 remera"
          : `Llevás ${currentQuantity} remeras`;
    } else {
      const word = projectedTotal === 1 ? "remera" : "remeras";
      modalPriceSub.textContent = `Tu pedido queda en ${projectedTotal} ${word}`;
    }

    // Tabla de tiers
    const activeTierIndex = PRICE_TIERS.findIndex(
      (t) => projectedTotal >= t.min && projectedTotal <= t.max
    );
    renderPriceTiers(activeTierIndex);

    // Badge de contexto. NO se oculta nunca (así el bloque de precio
    // mantiene la misma altura en todos los tiers y no salta cuando
    // se cruza al máximo). Tres estados posibles:
    //   - Tier máximo (next === null): mensaje positivo "Ya tenés
    //     el mejor precio".
    //   - Faltan ≤3 unidades para el próximo tier: "Agregá X más".
    //   - Faltan >3 unidades (no debería pasar con los tiers
    //     actuales, pero por las dudas): frase de contexto.
    const next = getNextTier(projectedTotal);
    if (!next) {
      modalPriceBadge.textContent = "✓ Ya tenés el mejor precio por unidad";
    } else if (next.unitsNeeded <= 3) {
      const word = next.unitsNeeded === 1 ? "remera" : "remeras";
      modalPriceBadge.textContent = `Agregá ${next.unitsNeeded} ${word} más y todas salen a ${formatPrice(next.price)} c/u`;
    } else {
      modalPriceBadge.textContent = `Sumá ${next.unitsNeeded} remeras más para llegar a ${formatPrice(next.price)} c/u`;
    }
    modalPriceBadge.hidden = false;

    // Total
    modalPriceTotal.textContent = formatPrice(totalWithProduct);

    // Flash (solo si el unitario cambió)
    if (animate && lastUnitPrice !== null && unitPrice !== lastUnitPrice) {
      flashPriceElement(modalPriceUnit, unitPrice < lastUnitPrice);
    }
    lastUnitPrice = unitPrice;
  }

  // Calcula el ancho de la barra de scroll y lo guarda en una variable CSS.
  // Sirve para compensar el "salto" que hace el layout cuando se oculta la barra.
  function getScrollbarWidth() {
    return window.innerWidth - document.documentElement.clientWidth;
  }

  // S29: contador de locks de scroll. Varias capas (modal, carrito,
  // menú mobile) pueden pedir bloquear el scroll simultáneamente.
  // IMPORTANTE: lockBodyScroll debe llamarse ANTES de aplicar la
  // clase que dispara `overflow: hidden` (cart-open, modal-open,
  // menu-open), porque getScrollbarWidth() necesita que la scrollbar
  // todavía esté visible para devolver un valor > 0.
  let scrollLockCount = 0;

  function lockBodyScroll() {
    scrollLockCount++;
    if (scrollLockCount === 1) {
      const scrollbarWidth = getScrollbarWidth();
      if (scrollbarWidth > 0) {
        document.body.style.paddingRight = `${scrollbarWidth}px`;
      }
    }
  }

  function unlockBodyScroll() {
    if (scrollLockCount === 0) return;
    scrollLockCount--;
    if (scrollLockCount === 0) {
      document.body.style.paddingRight = "";
    }
  }

  function lockScroll() {
    lockBodyScroll();
    document.body.classList.add("modal-open");
  }

  function unlockScroll() {
    unlockBodyScroll();
    document.body.classList.remove("modal-open");
  }

  // Dispara el glitch del título del modal (E19 y E20 comparten esta
  // función). Recibe la duración en ms. Cancela cualquier timer
  // anterior para que dos glitches seguidos no se pisen.
  let modalTitleGlitchTimer = null;
  function triggerModalTitleGlitch(duration = 400) {
    if (!modalTitle) return;
    if (modalTitleGlitchTimer) clearTimeout(modalTitleGlitchTimer);
    // Forzamos reinicio de la animación aunque ya estuviera activa.
    modalTitle.classList.remove("glitching");
    void modalTitle.offsetWidth;
    modalTitle.classList.add("glitching");
    modalTitleGlitchTimer = setTimeout(() => {
      modalTitle.classList.remove("glitching");
      modalTitleGlitchTimer = null;
    }, duration);
  }


  function openModal(product) {
    // Si había un cierre en curso (CRT close), lo cancelamos.
    if (modalCloseTimer) {
      clearTimeout(modalCloseTimer);
      modalCloseTimer = null;
    }
    modal.classList.remove("is-closing");

    const name = product.querySelector("h3")?.textContent ?? "";
    const category = product.querySelector(".product-category");
    const overlay = product.querySelector(".product-overlay");
    const categoryColor =
      overlay?.style.getPropertyValue("--category-color") ?? "#ffffff";
    const categoryName =
      category?.textContent?.trim() ?? "";

    // Enviamos evento a Clarity: qué producto se vio.
    // Usamos el data-id (slug del producto) como identificador.
    const productIdForClarity = product.dataset.id || "";
    if (window.clarity && productIdForClarity) {
      window.clarity("event", "view_" + productIdForClarity);
    }


    const image = product.querySelector(".product-image-base");
    if (!image) return;

    // S34: leer colores desde data-colors (JSON serializado por Astro).
    // Si el producto no tiene colores, colorsData queda null y se usa
    // el flujo legacy (modelo/remera directos).
    const colorsRaw = product.dataset.colors || "";
    colorsData = colorsRaw ? JSON.parse(colorsRaw) : null;
    hasColors = !!colorsData && Object.keys(colorsData).length > 1;
    currentColor = hasColors ? resolveColorForProduct(product, colorsData) : null;

    if (hasColors) {
      currentImages = buildImagesForColor(colorsData[currentColor]);
    } else {
      const modelo = image.getAttribute("src");
      const remera = modelo.replace("/modelo.", "/remera.");

      // S33: thumbs a 400w para las miniaturas del modal.
      const modelo400 = product.dataset.modelo400 || "";
      const remera400 = product.dataset.remera400 || "";

      const extras = product.dataset.extras
        ? JSON.parse(product.dataset.extras)
        : [];

      currentImages = [
        { src: modelo, thumbSrc: modelo400, label: "Modelo" },
        { src: remera, thumbSrc: remera400, label: "Remera" },
        ...extras.map((extra) => ({
          src: `${base}${extra.src}`,
          label: extra.label,
        })),
        { src: `${base}/talles/oversize.webp`, label: "Talles Oversize" },
        { src: `${base}/talles/regular.webp`, label: "Talles Regular" },
      ];
    }

    // Precargamos todas las imágenes del producto en paralelo.
    currentImages.forEach((image) => {
      const preload = new Image();
      preload.src = image.src;
    });

    currentImageIndex = 0;
    currentProductName = name;
    currentProductId = product.dataset.id || "";
    currentQuantity = 1;
    lastUnitPrice = null;
    lastRenderedPrice = null;

    zoomableIndices = currentImages
      .map((_, index) => (isZoomableSlide(index, currentImages.length) ? index : -1))
      .filter((index) => index !== -1);

    // Reseteamos las dos capas de imagen para que el próximo modal
    // arranque limpio (sin restos del producto anterior).
    modalImageActive = modalImageA;
    modalImageA.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade", "leave-to-left", "leave-to-right", "leave-fade");
    modalImageB.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade", "leave-to-left", "leave-to-right", "leave-fade");
    modalImageA.src = "";
    modalImageB.src = "";
    selectedFit = "Oversize";
    selectedSize = "L";

    modalTitle.textContent = name;
    modalCategory.textContent = categoryName;

    renderThumbs();
    renderModalImage();
    renderColors();
    renderFits();
    renderSizes();
    updateSizeCm();
    renderQuantity();

    modalAdd.classList.remove("is-added");
    if (modalAddText) modalAddText.textContent = "Agregar al Pedido";

    modal.style.setProperty("--category-color", categoryColor);

    modal.setAttribute("aria-hidden", "false");
    lockScroll();

    // Empujamos el modal a la pila del historial para que el botón "atrás"
    // del celular lo cierre en vez de salir de la página. Si el modal se
    // abrió porque la URL traía un hash (link compartido), NO lo hacemos:
    // el usuario entró directo, no navegó desde la página.
    if (!openingFromHash) {
      pushHistory("modal");
      // Actualizamos la URL con el hash del producto, sin agregar
      // otra entrada al historial (pushHistory ya lo hizo).
      // Así, si el usuario copia la URL del navegador, lleva directo
      // al producto.
      try {
        const urlObj = new URL(window.location.href);
        urlObj.hash = currentProductId ? `#${currentProductId}` : "";
        history.replaceState(history.state, "", urlObj);
      } catch (error) {
        console.warn("[KRAKOA] No se pudo actualizar la URL:", error);
      }
    }

    // Actualizamos el título de la pestaña con el nombre del producto.
    updatePageTitle();

    // Separamos el "pintar el modal" (que existe, pero invisible) del
    // "animar el modal" (agregar .open). Así el navegador tiene un frame
    // completo para calcular layout antes de arrancar la animación.
    // Esto reduce mucho el "tirón" en mobile, especialmente la primera vez.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        modal.classList.add("open");
      });
    });

    // Glitch breve del título después de que el modal ya está
    // entrando (200ms de delay para que no compita con la
    // animación de apertura del modal).
    setTimeout(() => triggerModalTitleGlitch(400), 200);
  }
  


  function closeModal() {
    // Si el modal está en la pila, lo sacamos por ahí: history.back()
    // dispara el popstate, que hace el cierre real. Así el "atrás" del
    // celular y el click en la X quedan perfectamente sincronizados.
    if (isTopOfHistory("modal")) {
      popHistory();
      return;
    }
    closeModalDirect();
  }

  function closeModalDirect() {
    // Si ya está cerrado (aria-hidden="true"), no hacemos nada.
    if (modal.getAttribute("aria-hidden") === "true") return;

    // Disparamos el CRT close.
    modal.classList.remove("open");
    modal.classList.add("is-closing");
    unlockScroll();

    // Quitamos el hash del producto de la URL (sin agregar entrada nueva).
    // Cuando el cierre viene desde popstate (botón atrás), la URL ya
    // cambió a la base: este replaceState queda como no-op.
    try {
      const urlObj = new URL(window.location.href);
      urlObj.hash = "";
      history.replaceState(history.state, "", urlObj);
    } catch (error) {
      console.warn("[KRAKOA] No se pudo limpiar el hash de la URL:", error);
    }

    // Al cerrar el modal, el título vuelve al de la categoría activa
    // (o al default si no hay filtro).
    updatePageTitle();

    // Esperamos a que termine la animación CRT close para limpiar
    // el estado (aria-hidden, is-closing).
    if (modalCloseTimer) clearTimeout(modalCloseTimer);
    modalCloseTimer = setTimeout(() => {
      modal.classList.remove("is-closing");
      modal.setAttribute("aria-hidden", "true");
      modalCloseTimer = null;
    }, 380);
  }

  // -------------------------
  // ZOOM DE IMAGEN
  // -------------------------

  // Renderiza la imagen del zoom según zoomImageIndex.
  // Se usa tanto al abrir como al navegar entre fotos zoomeables.
  function renderImageZoom() {
    const current = currentImages[zoomImageIndex];
    if (!current) return;
    imageZoomImg.src = current.src;
    imageZoomImg.alt = `${currentProductName} — ${current.label}`;
  }

  // Abre el zoom apuntando al slide "startIndex".
  function openImageZoom(startIndex) {
    zoomImageIndex = startIndex;
    resetImageZoomScale();
    renderImageZoom();
    imageZoom.setAttribute("aria-hidden", "false");
    imageZoom.classList.add("open");
    document.body.classList.add("zoom-open");
    pushHistory("image-zoom");
  }

  // Salta a la foto zoomeable anterior / siguiente (con wrap).
  function showZoomPrev() {
    const pos = zoomableIndices.indexOf(zoomImageIndex);
    if (pos === -1) return;
    const prevPos = (pos - 1 + zoomableIndices.length) % zoomableIndices.length;
    zoomImageIndex = zoomableIndices[prevPos];
    resetImageZoomScale();
    renderImageZoom();
  }

  function showZoomNext() {
    const pos = zoomableIndices.indexOf(zoomImageIndex);
    if (pos === -1) return;
    const nextPos = (pos + 1) % zoomableIndices.length;
    zoomImageIndex = zoomableIndices[nextPos];
    resetImageZoomScale();
    renderImageZoom();
  }

  function closeImageZoom() {
    if (isTopOfHistory("image-zoom")) {
      popHistory();
      return;
    }
    closeImageZoomDirect();
  }

  function closeImageZoomDirect() {
    if (imageZoom.getAttribute("aria-hidden") === "true") return;
    imageZoom.classList.remove("open");
    imageZoom.setAttribute("aria-hidden", "true");
    document.body.classList.remove("zoom-open");
    resetImageZoomScale();

    // Limpiamos la src para que no quede la imagen colgada en memoria.
    // La hacemos después de la transición.
    setTimeout(() => {
      if (!imageZoom.classList.contains("open")) {
        imageZoomImg.src = "";
      }
    }, 260);
  }


  function showPreviousImage() {
    currentImageIndex =
      (currentImageIndex - 1 + currentImages.length) % currentImages.length;
    renderModalImage("prev");
  }


  function showNextImage() {
    currentImageIndex = (currentImageIndex + 1) % currentImages.length;
    renderModalImage("next");
  }


  // -------------------------
  // NAVEGACIÓN ENTRE PRODUCTOS
  // -------------------------

  // Devuelve la lista de productos VISIBLES en el ORDEN ACTUAL del DOM
  // (respetando filtros de categoría, búsqueda y reordenamiento).
  //
  // OJO: no usamos el NodeList `products` (que se creó al inicio del
  // script y no se actualiza cuando reordenamos el DOM con appendChild).
  // Consultamos el DOM en vivo para obtener el orden real.
  function getVisibleProducts() {
    return Array.from(
      document.querySelectorAll("#products .product-card")
    ).filter((product) => {
      // Una tarjeta cuenta como "visible" si no está oculta
      // (.is-hidden). Como ahora el hide es instantáneo (display:
      // none), no hace falta chequear estados intermedios.
      return !product.classList.contains("is-hidden");
    });
  }

  // Encuentra el producto actual en el DOM (para saber dónde estamos parados).
  function findCurrentProductIndex(visibleList) {
    return visibleList.findIndex(
      (product) => product.dataset.id === currentProductId
    );
  }

  // Cambia al producto anterior o siguiente con animación.
  // direction: "next" | "prev"
  function switchProduct(direction) {
    if (isSwitchingProduct) return;
    if (!modal.classList.contains("open")) return;

    const visibleList = getVisibleProducts();
    if (visibleList.length === 0) return;

    const currentIndex = findCurrentProductIndex(visibleList);
    if (currentIndex === -1) return;

    let targetIndex;
    if (direction === "next") {
      targetIndex = (currentIndex + 1) % visibleList.length;
    } else {
      targetIndex = (currentIndex - 1 + visibleList.length) % visibleList.length;
    }

    const targetProduct = visibleList[targetIndex];
    if (!targetProduct) return;

    // Si el zoom estaba abierto, lo cerramos antes de cambiar.
    if (imageZoom.getAttribute("aria-hidden") === "false") {
      closeImageZoomDirect();
    }

    isSwitchingProduct = true;

    const modalGrid = modal.querySelector(".modal-grid");
    if (!modalGrid) {
      isSwitchingProduct = false;
      return;
    }

    // Cambio de canal: RGB split suave + ruido en la galería.
    // Una sola animación (el nombre de la clase indica la dirección,
    // pero visualmente el efecto es simétrico).
    const switchClass = direction === "next" ? "switching-next" : "switching-prev";

    modalGrid.classList.add(switchClass);

    // A los 110ms (pico del ruido) cambiamos el contenido.
    setTimeout(() => {
      loadProductIntoModal(targetProduct);
    }, 110);

    // A los 260ms (fin de la animación + margen) limpiamos.
    setTimeout(() => {
      modalGrid.classList.remove(switchClass);
      isSwitchingProduct = false;
    }, 260);
  }

  // Carga el contenido de un producto en el modal ya abierto.
  // Es como openModal pero SIN tocar el estado de apertura del modal,
  // el historyStack ni el scroll.
  function loadProductIntoModal(product) {
    const name = product.querySelector("h3")?.textContent ?? "";
    const category = product.querySelector(".product-category");
    const overlay = product.querySelector(".product-overlay");
    const categoryColor =
      overlay?.style.getPropertyValue("--category-color") ?? "#ffffff";
    const categoryName =
      category?.textContent?.trim() ?? "";

    const image = product.querySelector(".product-image-base");
    if (!image) return;

    // S34: leer colores (igual que en openModal).
    const colorsRaw = product.dataset.colors || "";
    colorsData = colorsRaw ? JSON.parse(colorsRaw) : null;
    hasColors = !!colorsData && Object.keys(colorsData).length > 1;
    currentColor = hasColors ? resolveColorForProduct(product, colorsData) : null;

    if (hasColors) {
      currentImages = buildImagesForColor(colorsData[currentColor]);
    } else {
      const modelo = image.getAttribute("src");
      const remera = modelo.replace("/modelo.", "/remera.");

      const modelo400 = product.dataset.modelo400 || "";
      const remera400 = product.dataset.remera400 || "";

      const extras = product.dataset.extras
        ? JSON.parse(product.dataset.extras)
        : [];

      currentImages = [
        { src: modelo, thumbSrc: modelo400, label: "Modelo" },
        { src: remera, thumbSrc: remera400, label: "Remera" },
        ...extras.map((extra) => ({
          src: `${base}${extra.src}`,
          label: extra.label,
        })),
        { src: `${base}/talles/oversize.webp`, label: "Talles Oversize" },
        { src: `${base}/talles/regular.webp`, label: "Talles Regular" },
      ];
    }

    // Precargamos todas las imágenes del producto en paralelo.
    currentImages.forEach((image) => {
      const preload = new Image();
      preload.src = image.src;
    });

    currentImageIndex = 0;
    currentProductName = name;
    currentProductId = product.dataset.id || "";
    currentQuantity = 1;
    lastUnitPrice = null;
    lastRenderedPrice = null;

    zoomableIndices = currentImages
      .map((_, index) => (isZoomableSlide(index, currentImages.length) ? index : -1))
      .filter((index) => index !== -1);

    // Reset de capas del carrusel.
    modalImageActive = modalImageA;
    modalImageA.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade", "leave-to-left", "leave-to-right", "leave-fade");
    modalImageB.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade", "leave-to-left", "leave-to-right", "leave-fade");
    modalImageA.src = "";
    modalImageB.src = "";
    selectedFit = "Oversize";
    selectedSize = "L";

    modalTitle.textContent = name;
    modalCategory.textContent = categoryName;

    renderThumbs();
    renderModalImage();
    renderColors();
    renderFits();
    renderSizes();
    updateSizeCm();
    renderQuantity();

    modalAdd.classList.remove("is-added");
    if (modalAddText) modalAddText.textContent = "Agregar al Pedido";

    modal.style.setProperty("--category-color", categoryColor);

    // Enviamos evento a Clarity: qué producto se vio.
    const productIdForClarity = product.dataset.id || "";
    if (window.clarity && productIdForClarity) {
      window.clarity("event", "view_" + productIdForClarity);
    }

    // Scroll interno del modal: volver arriba (mobile).
    const modalGrid = modal.querySelector(".modal-grid");
    if (modalGrid) {
      modalGrid.scrollTop = 0;
    }

    // Actualizamos el título de la pestaña con el nuevo producto.
    updatePageTitle();

    // Actualizamos el hash de la URL con el nuevo producto (sin agregar
    // entrada al historial: el modal ya está en el stack).
    try {
      const urlObj = new URL(window.location.href);
      urlObj.hash = currentProductId ? `#${currentProductId}` : "";
      history.replaceState(history.state, "", urlObj);
    } catch (error) {
      console.warn("[KRAKOA] No se pudo actualizar el hash:", error);
    }

    // Glitch breve del título al cambiar de producto.
    triggerModalTitleGlitch(400);
  }

  // Listeners de las flechas de producto.
  modalProductPrev?.addEventListener("click", () => switchProduct("prev"));
  modalProductNext?.addEventListener("click", () => switchProduct("next"));
  modalProductPrevMobile?.addEventListener("click", () => switchProduct("prev"));
  modalProductNextMobile?.addEventListener("click", () => switchProduct("next"));


  products.forEach((product) => {
    const button = product.querySelector(".product-button");
    button?.addEventListener("click", () => {
      openModal(product);
    });
  });

  // Si la URL trae un hash tipo #remera-naruto, abrimos ese producto solo.
  let hashHandled = false;

  function openProductFromHash() {
    if (hashHandled) return;

    const hash = window.location.hash.replace(/^#/, "");
    if (!hash) return;

    const target = Array.from(products).find(
      (product) => product.dataset.id === hash
    );

    if (target) {
      hashHandled = true;

      // OJO: abrimos el modal PRIMERO, y después tocamos el historial.
      // Así, si el pushState falla por algún motivo, el modal ya está abierto
      // y todos los botones siguen funcionando.
      openingFromHash = true;
      openModal(target);
      openingFromHash = false;

      // Ahora hacemos el truco del historial. Si algo falla acá,
      // el modal ya está abierto y no se rompe nada más.
      try {
        // Preservamos la query string (?cat=anime) al limpiar el hash,
        // así el filtro activo sigue en la URL si el usuario comparte
        // o recarga.
        const url = new URL(window.location.href);
        url.hash = "";
        history.replaceState(null, "", url.pathname + url.search);
        history.pushState(
          { krakoaOverlay: "modal" },
          "",
          `${url.pathname}${url.search}#${hash}`
        );
        historyStack.push({ kind: "modal", state: {} });
      } catch (error) {
        console.error("[KRAKOA] Error manipulando el historial:", error);
      }
    }
  }

  // Al cargar la página. Lo diferimos con setTimeout para asegurarnos de que
  // TODO el resto del script ya se registró (por si algo tira un error que
  // antes rompía la ejecución del script entero).
  // Primero aplicamos el filtro de categoría (?cat=anime), y después
  // abrimos el producto por hash si corresponde (?cat=anime#naruto).
  setTimeout(() => {
    try {
      applyCategoryFromUrl();
    } catch (error) {
      console.error("[KRAKOA] Error aplicando categoría desde la URL:", error);
    }
    try {
      openProductFromHash();
    } catch (error) {
      console.error("[KRAKOA] Error abriendo producto desde el hash:", error);
    }
  }, 0);

  // Nota: no escuchamos "hashchange". Antes lo hacíamos, pero generaba
  // bucles raros cuando el propio openProductFromHash hacía pushState.
  // Si el usuario cambia el hash a mano, recarga y listo.


  modalClose.addEventListener("click", closeModal);
  modalBackdrop.addEventListener("click", closeModal);
  modalPrev.addEventListener("click", showPreviousImage);
  modalNext.addEventListener("click", showNextImage);

  // Atajo: al tocar "Ver tabla de talles", salta a la tabla del corte actual.
  // Las tablas SIEMPRE son los últimos 2 slides:
  //   - Oversize: length - 2
  //   - Regular:  length - 1
  modalSeeChart.addEventListener("click", () => {
    const total = currentImages.length;
    const targetIndex = selectedFit === "Oversize" ? total - 2 : total - 1;
    if (targetIndex === currentImageIndex) return;
    const direction = targetIndex > currentImageIndex ? "next" : "prev";
    currentImageIndex = targetIndex;
    renderModalImage(direction);
  });


  modalQtyMinus.addEventListener("click", () => {
    if (currentQuantity > 1) {
      currentQuantity -= 1;
      renderQuantity(true);
    }
  });

  modalQtyPlus.addEventListener("click", () => {
    if (currentQuantity < 20) {
      currentQuantity += 1;
      renderQuantity(true);
    }
  });





  modalSeeCart.addEventListener("click", () => {
    openCartDrawer();
  });


  modalShare.addEventListener("click", async () => {
    // S32: compartimos la URL de la página puente (/producto/slug/),
    // que tiene los meta tags OG correctos (og:image = foto de la
    // remera) para que WhatsApp/Facebook/Twitter muestren la
    // miniatura en la preview. Esa página redirige a /#slug, así
    // el receptor cae en el modal abierto como siempre.
    // Si por algún motivo no hay id (no debería pasar), caemos a
    // la home genérica.
    const url = currentProductId
      ? `${SITE_ORIGIN}${BASE_PATH}/producto/${currentProductId}/`
      : `${SITE_ORIGIN}${BASE_PATH}/`;
    const title = currentProductName;

    if (navigator.share) {
      try {
        await navigator.share({
          title: `KRAKOA | ${title}`,
          text: `Mirá esta remera de KRAKOA: ${title}`,
          url,
        });
      } catch (error) {
        // cancelado
      }
    } else {
      try {
        await navigator.clipboard.writeText(url);
        modalShare.textContent = "¡Enlace copiado!";
        setTimeout(() => {
          modalShare.textContent = "Compartir";
        }, 2000);
      } catch (error) {
        alert("No se pudo copiar el enlace.");
      }
    }
  });


  // El swipe ahora va sobre el contenedor de las dos imágenes, porque la imagen
  // "activa" va cambiando entre la capa A y la B. Escuchar en el wrapper evita
  // tener que reconectar el listener cada vez.

  modalImageWrapper.addEventListener("touchstart", (event) => {
    touchStartX = event.changedTouches[0].screenX;
  });

  modalImageWrapper.addEventListener("touchend", (event) => {
    touchEndX = event.changedTouches[0].screenX;
    const difference = touchStartX - touchEndX;
    if (Math.abs(difference) < 50) return;
    if (difference > 0) {
      showNextImage();
    } else {
      showPreviousImage();
    }
  });

  // -------------------------
  // ZOOM DE IMAGEN — listeners
  // -------------------------

  // Abrir el zoom al hacer click/tap sobre la imagen del carrusel,
  // solo si el slide activo es una foto (no tabla de talles).
  let zoomTouchStartX = 0;
  let zoomTouchStartY = 0;
  let zoomMoved = false;

  modalImageWrapper.addEventListener("touchstart", (event) => {
    zoomTouchStartX = event.changedTouches[0].screenX;
    zoomTouchStartY = event.changedTouches[0].screenY;
    zoomMoved = false;
  });

  modalImageWrapper.addEventListener("touchmove", (event) => {
    const dx = Math.abs(event.changedTouches[0].screenX - zoomTouchStartX);
    const dy = Math.abs(event.changedTouches[0].screenY - zoomTouchStartY);
    if (dx > 8 || dy > 8) zoomMoved = true;
  });

  modalImageWrapper.addEventListener("click", (event) => {
    // Si en mobile el usuario hizo swipe, no disparamos el zoom.
    if (zoomMoved) {
      zoomMoved = false;
      return;
    }
    if (!isZoomableSlide(currentImageIndex, currentImages.length)) return;
    openImageZoom(currentImageIndex);
  });

  // Cerrar el zoom: click en cualquier parte del overlay (incluye la ×).
  // Usamos pointerdown + pointerup para evitar cierres accidentales
  // cuando el toque empieza sobre la imagen y termina afuera (o al revés).
  // La × se maneja aparte (ver más abajo) y NO debe gatillar este handler.
  let zoomPointerDownOnImage = false;

  // Pointerdown sobre el overlay del zoom.
  // Tres casos:
  //   1) Fue sobre la imagen con zoom > 1 (mouse): empezamos drag (pan).
  //   2) Fue sobre la imagen con zoom === 1: marcamos para cerrar.
  //   3) Fue fuera de la imagen: cerramos (comportamiento viejo).
  imageZoom.addEventListener("pointerdown", (event) => {
    // Ignoramos si el pointerdown fue sobre la × o sobre las flechas.
    if (imageZoomClose.contains(event.target)) return;
    if (imageZoomPrev.contains(event.target)) return;
    if (imageZoomNext.contains(event.target)) return;

    const downOnImage = event.target === imageZoomImg;

    if (downOnImage && zoomScale > 1 && event.pointerType === "mouse") {
      // Empezamos drag (pan).
      zoomIsDragging = true;
      zoomDidDrag = false;
      zoomDragStartX = event.clientX;
      zoomDragStartY = event.clientY;
      zoomDragStartPanX = zoomPanX;
      zoomDragStartPanY = zoomPanY;
      imageZoomImg.classList.add("is-grabbing");
      try {
        imageZoomImg.setPointerCapture(event.pointerId);
      } catch (error) {
        // Algunos navegadores viejos no soportan setPointerCapture.
      }
      event.preventDefault();
      return;
    }

    zoomPointerDownOnImage = downOnImage;
  });

  // Movimiento del mouse: si estamos arrastrando, actualizamos el pan.
  imageZoom.addEventListener("pointermove", (event) => {
    if (!zoomIsDragging) return;
    if (event.pointerType !== "mouse") return;

    const dx = event.clientX - zoomDragStartX;
    const dy = event.clientY - zoomDragStartY;

    if (
      !zoomDidDrag &&
      (Math.abs(dx) > ZOOM_DRAG_THRESHOLD || Math.abs(dy) > ZOOM_DRAG_THRESHOLD)
    ) {
      zoomDidDrag = true;
    }

    zoomPanX = zoomDragStartPanX + dx;
    zoomPanY = zoomDragStartPanY + dy;
    clampImageZoomPan();
    applyImageZoomTransform();
  });

  imageZoom.addEventListener("pointerup", (event) => {
    // Ignoramos si el pointerup fue sobre la × o sobre las flechas.
    if (imageZoomClose.contains(event.target)) return;
    if (imageZoomPrev.contains(event.target)) return;
    if (imageZoomNext.contains(event.target)) return;

    // Si estábamos arrastrando, terminamos el drag.
    if (zoomIsDragging) {
      zoomIsDragging = false;
      imageZoomImg.classList.remove("is-grabbing");
      try {
        imageZoomImg.releasePointerCapture(event.pointerId);
      } catch (error) {
        // Ignoramos.
      }

      // Si NO hubo movimiento (fue un click rápido sin arrastrar),
      // reseteamos el zoom a 1x (sin cerrar).
      if (!zoomDidDrag && event.pointerType === "mouse") {
        resetImageZoomScale();
      }
      zoomDidDrag = false;
      return;
    }

    const upOnImage = event.target === imageZoomImg;
    // Si empezó y terminó sobre la imagen, NO cerramos
    // (es un tap sobre la foto, probablemente queriendo hacer pinch-zoom).
    if (zoomPointerDownOnImage && upOnImage) {
      zoomPointerDownOnImage = false;

      // En DESKTOP, el click sobre la imagen cierra el zoom SOLO si
      // no está ampliada. Si el usuario ya hizo zoom con la rueda,
      // el click resetea la escala a 1 (sin cerrar), para no
      // frustrarlo.
      // En MOBILE no cerramos, porque el usuario podría estar haciendo
      // pinch-to-zoom nativo sobre la foto.
      if (event.pointerType === "mouse") {
        if (zoomScale > 1) {
          resetImageZoomScale();
        } else {
          closeImageZoom();
        }
      }
      return;
    }
    zoomPointerDownOnImage = false;
    closeImageZoom();
  });

  // La × cierra sola, sin que el overlay se entere.
  imageZoomClose.addEventListener("click", (event) => {
    event.stopPropagation();
    event.preventDefault();
    closeImageZoom();
  });

  // Flechas del zoom. Usamos pointerdown con stopPropagation porque el
  // overlay tiene su propio listener de pointerdown/pointerup para cerrar.
  // Sin esto, el pointerup del overlay agarraba el click en la flecha y
  // cerraba el zoom.
  imageZoomPrev.addEventListener("pointerdown", (event) => {
    event.stopPropagation();
    event.preventDefault();
    showZoomPrev();
  });

  imageZoomNext.addEventListener("pointerdown", (event) => {
    event.stopPropagation();
    event.preventDefault();
    showZoomNext();
  });

  // Zoom con la rueda del mouse (solo desktop), anclado al cursor.
  // El punto de la imagen bajo el mouse se queda quieto mientras la
  // imagen escala. preventDefault evita que la página scrollee.
  imageZoomImg.addEventListener(
    "wheel",
    (event) => {
      event.preventDefault();

      const delta = event.deltaY < 0 ? ZOOM_STEP : -ZOOM_STEP;
      const oldScale = zoomScale;
      const newScale = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, oldScale + delta));
      if (newScale === oldScale) return;

      // Posición del mouse relativa al centro del viewport (que es el
      // centro de la imagen cuando está en 1x, o el centro del pan
      // actual cuando está ampliada).
      const container = imageZoom.getBoundingClientRect();
      const centerX = container.left + container.width / 2;
      const centerY = container.top + container.height / 2;
      const mouseX = event.clientX - centerX;
      const mouseY = event.clientY - centerY;

      // Fórmula de zoom anclado: el punto bajo el mouse se mantiene
      // fijo antes y después del zoom.
      const ratio = newScale / oldScale;
      zoomPanX = mouseX - (mouseX - zoomPanX) * ratio;
      zoomPanY = mouseY - (mouseY - zoomPanY) * ratio;
      zoomScale = newScale;

      clampImageZoomPan();
      applyImageZoomTransform();
    },
    { passive: false }
  );

  // Swipe en mobile sobre el overlay del zoom.
  let zoomSwipeStartX = 0;
  let zoomSwipeStartY = 0;

  imageZoom.addEventListener("touchstart", (event) => {
    zoomSwipeStartX = event.changedTouches[0].screenX;
    zoomSwipeStartY = event.changedTouches[0].screenY;
  }, { passive: true });

  imageZoom.addEventListener("touchend", (event) => {
    const dx = event.changedTouches[0].screenX - zoomSwipeStartX;
    const dy = event.changedTouches[0].screenY - zoomSwipeStartY;
    // Si el movimiento fue más vertical que horizontal, no es swipe.
    if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy)) return;
    if (dx < 0) {
      showZoomNext();
    } else {
      showZoomPrev();
    }
  }, { passive: true });


  document.addEventListener("keydown", (event) => {
    // Si el buscador está abierto en mobile y tocan Escape, lo cerramos.
    if (
      event.key === "Escape" &&
      siteHeader?.classList.contains("search-open")
    ) {
      closeSearch();
      return;
    }

    // Primero, si el zoom está abierto, Escape lo cierra solo a él.
    if (imageZoom.getAttribute("aria-hidden") === "false") {
      if (event.key === "Escape") {
        event.stopImmediatePropagation();
        closeImageZoom();
        return;
      }
      if (event.key === "ArrowLeft") {
        event.stopImmediatePropagation();
        showZoomPrev();
        return;
      }
      if (event.key === "ArrowRight") {
        event.stopImmediatePropagation();
        showZoomNext();
        return;
      }
    }

    if (!modal.classList.contains("open")) return;

    // Shift + ← / → cambia de PRODUCTO.
    // ← / → solo cambia de IMAGEN.
    if (event.shiftKey && event.key === "ArrowLeft") {
      event.preventDefault();
      switchProduct("prev");
      return;
    }
    if (event.shiftKey && event.key === "ArrowRight") {
      event.preventDefault();
      switchProduct("next");
      return;
    }

    if (event.key === "Escape") closeModal();
    if (event.key === "ArrowLeft") showPreviousImage();
    if (event.key === "ArrowRight") showNextImage();
  });


