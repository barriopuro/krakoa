  <meta property="og:image:url" content={`${base}/og-image.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="KRAKOA | Remeras" />
  <meta
    name="twitter:description"
    content="Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />

  <!-- Schema.org: Organization + todos los productos en un único
       script con @graph. Antes había 117 <script> inline (uno por
       producto) que el navegador tenía que parsear. Ahora es uno
       solo. Google lo acepta igual. -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          name: "KRAKOA",
          url: SITE_ORIGIN + BASE_PATH,
          logo: SITE_ORIGIN + BASE_PATH + "/logos/krakoalogo-horizontal.webp",
          sameAs: ["https://instagram.com/krakoa.sw"],
        },
        ...catalogo.products.map((product) => ({
          "@type": "Product",
          name: product.name,
          image: SITE_ORIGIN + BASE_PATH + product.modelo,
          description: "Remera " + product.name + " de KRAKOA. Categoría: " + product.categoryName + ". Algodón peinado 24/1, estampa DTF premium.",
          sku: product.id,
          brand: { "@type": "Brand", name: "KRAKOA" },
          offers: {
            "@type": "AggregateOffer",
            priceCurrency: "ARS",
            lowPrice: "20000",
            highPrice: "25000",
            offerCount: "3",
            availability: "https://schema.org/InStock",
          },
        })),
      ],
    })}
  ></script>

  <script is:inline>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "yuh7dq7teh");
  </script>

  <!-- Fuente custom (Payback, renombrada a KrakoaFont).
       set:html + template literal permite interpolar ${base} dentro
       del CSS. Necesario porque el sitio corre con base: /krakoa. -->
  <style is:inline set:html={`
    @font-face {
      font-family: "KrakoaFont";
      src: url("${base}/fonts/krakoafont.ttf") format("truetype");
      font-weight: normal;
      font-style: normal;
      font-display: swap;
    }
  `}></style>
    <link rel="preload" as="font" type="font/ttf" href={`${base}/fonts/krakoafont.ttf`} crossorigin />
  
  <!-- Precargamos la primera imagen del hero (que ahora es estática
       en el HTML). El navegador la prioriza desde el HTML y la baja
       antes que las 234 imágenes del catálogo. El LCP debería bajar
       a ~2-3s. -->
  <link rel="preload" as="image" href={`${base}/${catalogo.products[0].modelo}`} fetchpriority="high" />
</head>

  <body>

 <div id="krakoa-loader" class="krakoa-loader" style="position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:#0a0a0a;transition:opacity 0.45s ease;">
  <img src={`${base}/logos/krakoalogo-isotipo.webp`} alt="KRAKOA" style="width:90px;height:auto;opacity:0;transition:opacity 0.6s ease;" />
</div>

<!-- Barra de progreso de scroll: línea fina arriba de todo que
