.category-wrap {
  position: relative;
  z-index: 1;
  display: inline-flex;
  background: var(--category-color, #888);
}

/* Cuando el botón se despega, tiene que quedar por encima de los vecinos. */
.category-wrap:hover {
  z-index: 5;
}

.category-button {
  position: relative;
  padding: 12px 20px;
  border: 3px solid #333;
  border-radius: 0;
  background: #111;
  color: #ccc;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.01em;
  cursor: pointer;
  font-family: inherit;
  overflow: hidden;
  transform: translate(0, 0);
  transition: transform 0.22s ease, color 0.2s ease, border-color 0.2s ease;
  will-change: transform;
}

/* Reserva el ancho del texto original. El ::before es invisible, no
   ocupa altura y no se ve, pero su ancho entra en el cálculo del
   "max-content" del botón. Así, cuando durante el glitch el .cat-text
   pasa a mostrar símbolos más angostos, el botón NO se achica. */
.category-button::before {
  content: attr(data-original-text);
  display: block;
  height: 0;
  overflow: hidden;
  visibility: hidden;
  pointer-events: none;
  font: inherit;
  font-weight: inherit;
  font-size: inherit;
  letter-spacing: inherit;
  white-space: nowrap;
}

/* Hover solo en dispositivos con puntero real (desktop). En mobile
   los navegadores "pegan" el :hover después del tap y el botón se
   queda elevado hasta tocar otro lado. Con esto, en mobile solo
   .active hace el efecto (que es lo correcto: si desactivás el
   filtro, el botón baja al instante). */
@media (hover: hover) and (pointer: fine) {
  .category-wrap:hover .category-button:not(:active) {
    transform: translate(-14px, -14px);
    color: #fff;
  }
}

/* focus-visible (navegación con teclado) sigue funcionando en todos
   los dispositivos. */
.category-button:focus-visible {
  transform: translate(-14px, -14px);
  color: #fff;
}

/* Activo: queda despegado permanentemente, con borde del color. */
.category-button.active {
  transform: translate(-14px, -14px);
  color: #fff;
  border-color: var(--category-color, #888);
}

/* Badge con el conteo de modelos. Aparece al hover del wrap (desktop)
   y se queda mientras el botón está .active (mobile y desktop). Se
   mueve junto al botón cuando éste se eleva, quedando en la esquina
   superior-derecha del botón elevado. */
.category-count {
  position: absolute;
  top: -8px;
  right: -8px;
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 999px;
  background: var(--category-color, #888);
  color: #0a0a0a;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.01em;
  font-variant-numeric: tabular-nums;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
  /* scale(0) = arranca "colapsado" en el centro. Al aparecer, crece
     desde su centro (transform-origin) hasta scale(1). Al desaparecer,
     se encoge de vuelta. */
  transform: translate(0, 0) scale(0);
  transform-origin: center;
  /* Pop out: ease-in rápido, sin delay → se encoge apenas se va el
     hover/active. */
  transition: opacity 0.15s ease-in, transform 0.15s ease-in;
  z-index: 10;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
}

@media (hover: hover) and (pointer: fine) {
  .category-wrap:hover .category-count {
    opacity: 1;
    transform: translate(-14px, -14px) scale(1);
    /* Pop in: delay de 200ms (el badge aparece cuando el botón ya
       terminó de elevarse) + overshoot con cubic-bezier "back" →
       el badge se pasa un toque de tamaño y vuelve, se siente "pop".
       La opacidad no tiene overshoot, solo fade-in limpio. */
    transition: opacity 0.15s ease 0.2s,
                transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s;
  }
}

/* .active funciona en TODOS los dispositivos (mobile incluido). */
:global(.category-button.active ~ .category-count) {
  opacity: 1;
  transform: translate(-14px, -14px) scale(1);
  transition: opacity 0.15s ease 0.2s,
              transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s;
}

/* --------------------------- */
/* GLITCH SUTIL DE CATEGORÍAS  */
/* --------------------------- */

/* Los glitches ahora son spans REALES. .cat-text envuelve el texto
   visible y los spans .cat-glitch-a/b muestran la versión scrambled
   encima, posicionados de forma absoluta. */
.cat-text {
  display:global(.cat-text) {
  display: inline-block;
  position: relative;
}: inline-block;
  position: relative;
}

:global(.cat-glitch-a),
:global(.cat-glitch-b) {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  user-select: none;
  opacity: 0;
  white-space: nowrap;
  z-index: 2;
  font: inherit;
  font-weight: inherit;
  font-size: inherit;
  letter-spacing: inherit;
}

:global(.cat-glitch-a) {
  color: #ff0055;
  text-shadow: 2px 0 rgba(255, 0, 85, 0.95);
}

:global(.cat-glitch-b) {
  color: #00fff0;
  text-shadow: -2px 0 rgba(0, 255, 240, 0.95);
}

:global(.category-button.glitching) :global(.cat-glitch-a) {
  opacity: 1;
  animation: catGlitchA 0.32s steps(5, end) 1,
             catFlickerA 0.32s steps(2, end) 1;
}

:global(.category-button.glitching) :global(.cat-glitch-b) {
  opacity: 1;
  animation: catGlitchB 0.32s steps(5, end) 1,
             catFlickerB 0.32s steps(2, end) 1;
}

@keyframes catGlitchA {
  0%   { clip-path: inset(20% 0 60% 0); transform: translate(-4px, 0); text-shadow: 3px 0 rgba(255, 0, 85, 1); }
  20%  { clip-path: inset(50% 0 20% 0); transform: translate(4px, 0);  text-shadow: -3px 0 rgba(255, 0, 85, 1); }
  40%  { clip-path: inset(0% 0 40% 0);  transform: translate(-5px, 0) scaleY(-1); text-shadow: 4px 0 rgba(255, 0, 85, 1); }
  60%  { clip-path: inset(60% 0 5% 0);  transform: translate(3px, 0);  text-shadow: -3px 0 rgba(255, 0, 85, 1); }
  80%  { clip-path: inset(30% 0 30% 0); transform: translate(-4px, 0); text-shadow: 3px 0 rgba(255, 0, 85, 1); }
  100% { clip-path: inset(20% 0 60% 0); transform: translate(0, 0);    text-shadow: 2px 0 rgba(255, 0, 85, 0.95); }
}

@keyframes catGlitchB {
  0%   { clip-path: inset(55% 0 25% 0); transform: translate(4px, 0);  text-shadow: -3px 0 rgba(0, 255, 240, 1); }
  20%  { clip-path: inset(15% 0 70% 0); transform: translate(-4px, 0); text-shadow: 3px 0 rgba(0, 255, 240, 1); }
  40%  { clip-path: inset(70% 0 10% 0); transform: translate(5px, 0) scaleX(-1); text-shadow: -4px 0 rgba(0, 255, 240, 1); }
  60%  { clip-path: inset(25% 0 55% 0); transform: translate(-3px, 0); text-shadow: 3px 0 rgba(0, 255, 240, 1); }
  80%  { clip-path: inset(40% 0 30% 0); transform: translate(4px, 0);  text-shadow: -3px 0 rgba(0, 255, 240, 1); }
  100% { clip-path: inset(55% 0 25% 0); transform: translate(0, 0);    text-shadow: -2px 0 rgba(0, 255, 240, 0.95); }
}

@keyframes catFlickerA {
  0%   { opacity: 1; }
  25%  { opacity: 0.4; }
  50%  { opacity: 1; }
  75%  { opacity: 0.5; }
  100% { opacity: 1; }
}

@keyframes catFlickerB {
  0%   { opacity: 1; }
  25%  { opacity: 0.5; }
  50%  { opacity: 0.3; }
  75%  { opacity: 1; }
  100% { opacity: 1; }
}

/* Glitch del borde: cambia el border-color con saltos digitales entre
   gris, magenta y cian. El fondo (#111) NO se toca. Se usa
   box-shadow: inset para reforzar el efecto sin que se salga del
   botón (overflow: hidden lo cliparía). */
:global(.category-button.glitching) {
  animation: catBorderGlitch 0.32s steps(5, end) 1;
}

@keyframes catBorderGlitch {
  0%   { border-color: #ff0055; box-shadow: inset 0 0 0 1px rgba(255, 0, 85, 0.2); }
  20%  { border-color: #13524d; box-shadow: inset 0 0 0 1px rgba(0, 255, 240, 0.2); }
  40%  { border-color: #333;    box-shadow: inset 0 0 0 0 transparent; }
  60%  { border-color: #ff0055; box-shadow: inset 0 0 0 1px rgba(255, 0, 85, 0.2); }
  80%  { border-color: #13524d; box-shadow: inset 0 0 0 1px rgba(0, 255, 240, 0.2); }
  100% { border-color: #333;    box-shadow: inset 0 0 0 0 transparent; }
}

  
  .products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;

    /* Truco para salir del `main` (que tiene max-width) y ocupar
