    const remembered = lastColorByProduct.get(productId);
    if (remembered && data[remembered]) return remembered;
    const defaultColor = product.dataset.defaultColor || "";
    if (defaultColor && data[defaultColor]) return defaultColor;
    return Object.keys(data).sort((a, b) => a.localeCompare(b, "es"))[0];
  }

  // Construye el array `currentImages` a partir de los datos de un
