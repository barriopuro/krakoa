// Normaliza un texto para comparar: minúsculas + sin acentos.
// "Música" → "musica", "Dragón" → "dragon".
// NFD separa cada letra de su acento, y el regex elimina los diacríticos
// (el rango U+0300–U+036F son los "combining diacritical marks").
function normalizeText(str) {
  return (str || "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");
}

function filterProducts() {
  const raw = normalizeText(searchInput.value).trim();
  // Partimos la búsqueda por espacios: cada palabra se busca por separado.
  // Así "dragon ball" matchea "dragon ball z" y también el tag "dragon".
  const terms = raw.split(/\s+/).filter(Boolean);

  // ── Paso 1: clasificar cada producto y OCULTAR los que no matchean.
  // Las que se van a mostrar NO se tocan todavía (siguen con .is-hidden
  // si estaban ocultas), así no hay flash mientras se reordena.
  const toShowSet = new Set();

  products.forEach((product) => {
    const name = normalizeText(product.dataset.name);
    const tags = normalizeText(product.dataset.tags);
    const category = product.dataset.category ?? "";

    const matchesSearch =
      terms.length === 0 ||
      terms.every((term) => name.includes(term) || tags.includes(term));

    const matchesCategory =
      activeCategory === null || category === activeCategory;

    const shouldShow = matchesSearch && matchesCategory;

    if (shouldShow) {
      toShowSet.add(product);
    } else {
      // Ocultar inmediatamente (display: none).
      if (product.classList.contains("is-revealing")) {
        product.classList.remove("is-revealing");
      }
      if (!product.classList.contains("is-hidden")) {
        product.classList.add("is-hidden");
      }
    }
  });

  // ── Paso 2: reordenar el DOM (ahora que las ocultas ya no ocupan
  // lugar, el reorder no genera saltos visuales).
  if (typeof window.__krakoaReorderProducts === "function") {
    window.__krakoaReorderProducts(activeCategory === null ? "random" : "alpha");
  }

  // ── Paso 3: revelar TODAS las visibles con stagger calculado
  // según el ORDEN VISUAL ACTUAL del DOM. No solo las que estaban
  // ocultas: si solo animamos las nuevas, quedan "huecos" donde
  // están las que ya estaban visibles, y el ojo percibe que
  // "algunas aparecen antes que otras". Al reanimar todas, el
  // stagger es parejo y sigue la lectura natural de la grilla
  // (arriba-izquierda → arriba-derecha → abajo...).
  // Trade-off: las que ya estaban visibles hacen un fade-in leve
  // (1 → 0 → 1 en 300ms). Es el comportamiento típico de los
  // grids al filtrar.
  const grid = document.querySelector("#products");
  if (!grid) return;
  const allCards = Array.from(grid.querySelectorAll(".product-card"));

  let revealIndex = 0;
  allCards.forEach((product) => {
    // Solo animamos las que DEBEN mostrarse (toShowSet).
    // Las que no, ya quedaron con .is-hidden en el Paso 1 y se
    // saltean acá.
    if (!toShowSet.has(product)) return;

    // Desocultar (por si venía oculta de un filtro anterior) y animar.
    product.classList.remove("is-hidden");
    product.style.setProperty(
      "--card-stagger",
      `${Math.min(revealIndex, 15) * 30}ms`
    );
    // Forzamos reinicio de la animación (por si ya estaba
    // corriendo de un filtrado anterior rápido).
    product.classList.remove("is-revealing");
    void product.offsetWidth;
    product.classList.add("is-revealing");
    revealIndex++;
  });
}

// Listener de animationend: cuando una tarjeta termina de animarse,
// actualizamos su estado definitivo. Se agrega UNA SOLA VEZ al inicio
// (no en cada filtro, para no acumular listeners).
//   - cardHide termina → pasar a is-hidden (display: none).
//   - cardReveal termina → quitar is-revealing (queda en estado base).
// Los checks de clase evitan bugs si el usuario filtró rápido y el
// animationend llega tarde (la clase ya no está, no hacemos nada).
products.forEach((product) => {
  product.addEventListener("animationend", (event) => {
    if (
      event.animationName === "cardReveal" &&
      product.classList.contains("is-revealing")
    ) {
      product.classList.remove("is-revealing");
    }
  });
});

// Aplica un filtro de categoría al catálogo. Puede hacer push al
// history (default, para clicks del usuario) o no (para restauraciones
// desde el botón atrás).
// categoryId: id de la categoría, o null para "todas".
function applyCategoryFilter(categoryId, { push = true, scroll = true } = {}) {
  const previousCategory = activeCategory;
  activeCategory = categoryId;

  // Actualizamos las clases .active de los botones.
  categoryButtons.forEach((btn) => {
    btn.classList.toggle("active", btn.dataset.category === categoryId);
  });

  // Tinte de fondo: on si hay categoría, off si no.
  if (categoryId === null) {
    hideTint();
  } else {
    const btn = Array.from(categoryButtons).find(
      (b) => b.dataset.category === categoryId
    );
    const wrap = btn?.closest(".category-wrap");
    const color =
      wrap?.style.getPropertyValue("--category-color")?.trim() ||
      "#888888";
    showTint(color);
  }

  filterProducts();

  // Scroll al inicio de la grilla. Solo cuando el usuario clickea
  // (no cuando se restaura desde back, para no saltar de lugar).
  // Además, solo scrolleamos si el usuario está MÁS ABAJO que el
  // destino. Si ya está arriba (viendo el header/hero), no movemos
  // la página: cambiar de categoría no debe sacarte de donde estás.
  if (scroll) {
    const productsGrid = document.querySelector("#products");
    if (productsGrid) {
      const top =
        productsGrid.getBoundingClientRect().top + window.scrollY - 110;
      if (window.scrollY > top) {
        window.scrollTo({ top, behavior: "smooth" });
      }
    }
  }

  // Actualizamos el título de la pestaña según el estado (categoría o default).
  updatePageTitle();

  // Actualizamos la URL con la categoría activa (?cat=anime), para
  // poder compartir el filtro. Usamos replaceState para NO agregar
  // una entrada nueva al historial: el "atrás" lo maneja el
  // historyStack con pushHistory, y no queremos pisarlo.
  updateUrlWithCategory(categoryId);

  // Pusheamos al history para que "atrás" pueda restaurar el estado previo.
  if (push) {
    pushHistory("category", { previousCategory });
  }
}

// Actualiza el título de la pestaña según el estado actual:
//   - Modal abierto → "{Producto} | KRAKOA"
//   - Filtro de categoría activo → "{Categoría} | KRAKOA"
//   - Estado por defecto → "KRAKOA | REMERAS"
// Es una función declaration (no arrow), así que se puede llamar desde
// código que aparece antes en el archivo (hoisting).
function updatePageTitle() {
  const DEFAULT_TITLE = "KRAKOA | REMERAS";
  const modalEl = document.querySelector("#product-modal");
  const modalTitleEl = document.querySelector("#modal-title");
  const isModalOpen =
    modalEl && modalEl.getAttribute("aria-hidden") === "false";
  const productName = (modalTitleEl?.textContent ?? "").trim();

  // Prioridad 1: si el modal está abierto, mostramos el producto.
  if (isModalOpen && productName) {
    document.title = `KRAKOA | ${productName}`;
    return;
  }

  // Prioridad 2: si hay filtro de categoría activo, mostramos la categoría.
  if (activeCategory !== null) {
    const btn = Array.from(categoryButtons).find(
      (b) => b.dataset.category === activeCategory
    );
    const catName = (btn?.dataset.originalText ?? "").trim();
    if (catName) {
      document.title = `KRAKOA | ${catName}`;
      return;
    }
  }

  // Default.
  document.title = DEFAULT_TITLE;
}

// Actualiza la query string de la URL con la categoría activa.
//   - Categoría activa: /?cat=anime (mantiene el hash si lo hay)
//   - Sin categoría: borra el ?cat=
// Usa replaceState para no tocar el historial del navegador.
function updateUrlWithCategory(categoryId) {
  try {
    const url = new URL(window.location.href);
    if (categoryId) {
      url.searchParams.set("cat", categoryId);
    } else {
      url.searchParams.delete("cat");
    }
    history.replaceState(history.state, "", url);
  } catch (error) {
    console.warn("[KRAKOA] No se pudo actualizar la URL:", error);
  }
}

// Lee el ?cat= de la URL al cargar la página. Si existe y matchea
// con una categoría válida, aplica el filtro sin push y sin scroll
// (el usuario está empezando a navegar: no queremos sacudirlo).
function applyCategoryFromUrl() {
  try {
    const url = new URL(window.location.href);
    const catId = url.searchParams.get("cat");
    if (!catId) return;

    const exists = Array.from(categoryButtons).some(
      (b) => b.dataset.category === catId
    );
    if (!exists) return;

    applyCategoryFilter(catId, { push: false, scroll: false });
  } catch (error) {
    console.warn("[KRAKOA] No se pudo leer la categoría de la URL:", error);
  }
}

