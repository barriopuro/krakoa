    text += `Subtotal prendas (${total} ${total === 1 ? "unidad" : "unidades"}): *${formatPrice(subtotal)}*\n`;
    text += `Precio por unidad aplicado: *${formatPrice(unitPrice)}*\n`;
    text += `Envío: *A coordinar según zona*\n\n`;
