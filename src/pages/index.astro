    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    max-width: 100vw;

    /* Padding interno para que las tarjetas no toquen los bordes. */
    padding: 0 14px;
  }

  .product-card {
    min-width: 0;
  }

  .product-button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .product-image {
    position: relative;
    aspect-ratio: 1 / 1.18;
    background: #141414;
    overflow: hidden;
    border-radius: 15px;
  }

  .product-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity, transform;
  }

  /* Imagen base: visible por defecto. */
  .product-image-base {
    opacity: 1;
    transform: scale(1);
    z-index: 1;
  }

  /* Imagen hover: oculta por defecto. */
  .product-image-hover {
    opacity: 0;
    transform: scale(1.015);
    z-index: 0;
  }

  /* Hover: la base se va, la hover aparece. */
  .product-button:hover .product-image-base {
    opacity: 0;
    transform: scale(1.015);
  }

  .product-button:hover .product-image-hover {
    opacity: 1;
    transform: scale(1);
  }

  /* Overlay con degradado abajo de la imagen. */
  .product-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 32px 14px 14px;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--category-color, #888) 10%, rgba(0, 0, 0, 0.88)) 0%,
      color-mix(in srgb, var(--category-color, #888) 10%, rgba(0, 0, 0, 0.6)) 45%,
      rgba(0, 0, 0, 0) 100%
    );
    display: flex;
    flex-direction: column;
    gap: 4px;
    pointer-events: none;
    z-index: 2;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (min-width: 901px) {
    :global(.product-button:hover .product-overlay) {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  .product-category {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #d0d0d0;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .product-category .category-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--category-color);
    flex-shrink: 0;
    box-shadow: 0 0 6px var(--category-color);
  }

  .product-title {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: #fff;
    line-height: 1.25;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
    /* Limitar a 2 renglones con ellipsis. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.site-footer) {
    position: relative;
    margin-top: 40px;
    padding: 60px 5vw 30px;
    border-top: 1px solid #242424;
    background: #0a0a0a;
    overflow: hidden;
  }

  .footer-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  :global(.footer-particle) {
    position: absolute;
    bottom: -10px;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    animation: floatUp linear infinite;
    will-change: transform, opacity;
  }

  @keyframes floatUp {
    0% {
      transform: translateY(0) translateX(0);
      opacity: 0;
    }
    10% {
      opacity: 0.22;
    }
    90% {
      opacity: 0.22;
    }
    100% {
      transform: translateY(-420px) translateX(24px);
      opacity: 0;
    }
  }

  :global(.footer-inner) {
    position: relative;
    z-index: 1;
    width: min(1000px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 100px 1fr 180px;
    gap: 40px;
    align-items: start;
  }

:global(.footer-col--brand) {
    display: flex;
    justify-content: center;
  }

:global(.footer-logo) {
    width: 70px;
    height: auto;
    display: block;
    opacity: 0.9;
  }

:global(.footer-col--text p) {
    margin: 0;
    color: #888;
    font-size: 12.5px;
    line-height: 1.75;
    text-align: center;
  }

:global(.footer-col--links) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }

:global(.footer-col-title) {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 4px;
  }

:global(.footer-col--links a) {
    color: #999;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    width: fit-content;
    transition: color 0.2s ease, transform 0.2s ease;
  }

:global(.footer-col--links a:hover) {
    color: #fff;
    transform: translateX(3px);
  }

/* La flecha del link de Instagram: absoluta, así no afecta el centrado
   del texto "Instagram" respecto a los otros links de la columna. */
:global(.footer-col--links a) {
    position: relative;
  }

:global(.footer-external-arrow) {
    position: absolute;
    left: 100%;
    margin-left: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 11px;
    opacity: 0.7;
    pointer-events: none;
  }

:global(.footer-bottom) {
    position: relative;
    z-index: 1;
    width: min(1000px, 100%);
    margin: 40px auto 0;
    padding-top: 22px;
    border-top: 1px solid #1a1a1a;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #555;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

:global(.footer-bottom a) {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

:global(.footer-bottom a:hover) {
    color: #fff;
  }

  @media (max-width: 900px) {
    .products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      padding: 0 12px;
    }

    .product-title {
      font-size: 13px;
    }

    .product-category {
      font-size: 10px;
    }

    .product-overlay {
      padding: 28px 10px 10px;
    }

    /* En mobile no hay hover: la imagen hover nunca se muestra. */
    .product-image-hover {
      display: none;
    }
  }

  /* Barra de categorías sticky: aplica en desktop y mobile. */
  .categories {
    position: sticky;
    top: 0;
    z-index: 100;
    margin-inline: -5vw;
    /* Padding-top 26px para que el badge (22px de alto, elevado)
       entre completo cuando la barra está sticky arriba de todo. */
    padding: 26px 5vw 12px;
    background: rgba(11, 11, 11, 0.72);
    -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
    border-bottom: 1px solid #1f1f1f;
    margin-bottom: 25px;
  }

  /* Tablet: achicamos el buscador y ocultamos el label de Instagram
     para que todo entre sin apretarse. */
  @media (max-width: 1000px) {
    #search {
      width: 150px;
    }

    .instagram-btn {
      padding: 0;
      width: 42px;
      height: 42px;
      justify-content: center;
    }

    .instagram-btn svg {
      width: 18px;
      height: 18px;
    }

    .instagram-label {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      padding: 14px 4vw;
      gap: 10px;
    }

    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .logo-horizontal {
      width: 115px;
    }

    .instagram-btn {
      padding: 0;
      width: 38px;
      height: 38px;
      justify-content: center;
      border-radius: 8px;
      border-color: #242424;
    }

    .instagram-btn svg {
      width: 18px;
      height: 18px;
    }

    .instagram-label {
      display: none;
    }

    .header-actions {
      gap: 6px;
    }

    .cart-button,
    .menu-toggle,
    .search-toggle {
      width: 38px;
      height: 38px;
    }

    /* Buscador en mobile: lupa visible, panel oculto por defecto. */
    .search-toggle {
      display: inline-flex;
    }

    .header-search-panel {
      display: none;
    }

    /* Modo búsqueda: el header se transforma en "input + ×". */
    .site-header.search-open .brand,
    .site-header.search-open .desktop-nav,
    .site-header.search-open .search-toggle,
    .site-header.search-open .instagram-btn,
    .site-header.search-open .cart-button,
    .site-header.search-open .menu-toggle {
      display: none;
    }

    :global(.site-header.search-open) :global(.header-search-panel) {
      display: flex;
      flex: 1;
      gap: 8px;
      animation: searchPanelIn 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .site-header.search-open #search {
      flex: 1;
      width: 100%;
      /* Fijamos la altura al mismo valor que los demás botones del
         header mobile (lupa, carrito, hamburguesa = 38px). Sin esto,
         el input con su padding + font-size medía ~40px y el × medía
         42px, así que el header entero crecía ~4px al abrir el
         buscador y volvía a achicarse al cerrarlo. Mismo tipo de
         fix que la altura fija del h1 del hero. */
      height: 38px;
      font-size: 14px;
      padding: 0 14px;
    }

    .site-header.search-open .search-close {
      display: inline-flex;
      width: 38px;
      height: 38px;
    }

    .hero {
      padding: 40px 0 35px;
    }



    .categories {
      flex-wrap: wrap;
      gap: 4px;
    }

    .category-button {
      padding: 8px 11px;
      font-size: 12px;
      border-radius: 0;
    }
  }
      /* --------------------------- */
  /* MODAL DE PRODUCTO (NUEVO)   */
  /* --------------------------- */

  .modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.42s ease, visibility 0s linear 0.42s;
  }

  .modal.open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.42s ease, visibility 0s linear 0s;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
  }

  .modal-content {
    position: relative;
    width: min(96vw, 1100px);
    max-height: 92dvh;
    background: #111;
    border: 1px solid #242424;
    border-radius: 16px;
    overflow: hidden;
    z-index: 1;
    display: flex;
    flex-direction: column;
    transform: translateY(60px) scale(0.97);
    opacity: 0;
    transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.42s ease;
    will-change: transform, opacity;
  }

  .modal.open .modal-content {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 5;
    width: 36px;
    height: 36px;
    border: 1px solid #2a2a2a;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .modal-close:hover {
    background: #fff;
    color: #111;
    border-color: #fff;
  }

  .modal-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    max-height: 92dvh;
    overflow: hidden;
  }

  /* GALERÍA */

  .modal-gallery {
    background: #0a0a0a;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-right: 1px solid #242424;
    min-width: 0;
  }

  .modal-image-area {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #141414;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .modal-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  :global(.modal-image-el) {
    position: absolute;
    inset: 16px;
    width: calc(100% - 32px);
    height: calc(100% - 32px);
    object-fit: contain;
    display: block;
    opacity: 0;
    transform: translateX(0) scale(1);
    transition: opacity 0.32s ease, transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
    pointer-events: none;
    user-select: none;
  }

  :global(.modal-image-el.active) {
    opacity: 1;
    transform: translateX(0) scale(1);
    pointer-events: auto;
  }

  :global(.modal-image-el.enter-from-right) {
    transform: translateX(30px) scale(0.98);
  }
  :global(.modal-image-el.enter-from-left) {
    transform: translateX(-30px) scale(0.98);
  }
  :global(.modal-image-el.leave-to-left) {
    opacity: 0;
    transform: translateX(-30px) scale(0.98);
  }
  :global(.modal-image-el.leave-to-right) {
    opacity: 0;
    transform: translateX(30px) scale(0.98);
  }

  :global(.modal-image-el.enter-fade) {
    transform: translateX(0) scale(1);
  }
  :global(.modal-image-el.leave-fade) {
    opacity: 0;
    transform: translateX(0) scale(1);
  }

  .modal-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 38px;
    height: 38px;
    border: 1px solid #2a2a2a;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .modal-arrow:hover {
    background: #fff;
    color: #111;
  }

  .modal-prev {
    left: 12px;
  }

  .modal-next {
    right: 12px;
  }

  .modal-image-overlay {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .modal-image-label,
  .modal-image-counter {
    padding: 4px 9px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.75);
    color: #ddd;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .modal-image-counter {
    color: #999;
    font-variant-numeric: tabular-nums;
  }

  .modal-thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(56px, 1fr));
    gap: 8px;
    flex-shrink: 0;
    width: 100%;
    height: 72px;
  }

  :global(.modal-thumb) {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 2px solid #242424;
    border-radius: 8px;
    background: #141414;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  :global(.modal-thumb:hover) {
    opacity: 0.9;
    border-color: var(--category-color, #666);
  }

  :global(.modal-thumb.active) {
    opacity: 1;
    border-color: var(--category-color, #fff);
    box-shadow: 0 0 10px -2px var(--category-color, #fff);
  }

  :global(.modal-thumb img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* INFO */

  .modal-info {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    background: #111;
  }

  .modal-info-header {
    padding: 22px 24px 14px;
    border-bottom: 1px solid #242424;
    flex-shrink: 0;
  }

  .modal-category {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #999;
  }

  .modal-category::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--category-color, #888);
    box-shadow: 0 0 8px var(--category-color, #888);
  }

  .modal-info-header h2 {
    margin: 0;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 900;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    line-height: 1.05;
    padding-right: 30px;
  }

  .modal-info-body {
    flex: 1;
    overflow-y: auto;
    padding: 18px 24px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-height: 0;
  }

  .modal-field {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .modal-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .modal-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ddd;
  }

  .modal-step {
    color: var(--category-color, #fff);
    font-weight: 900;
  }

  :global(.modal-chart-button) {
    align-self: flex-start;
    margin-top: 4px;
    padding: 9px 14px;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    background: #0a0a0a;
    color: #ccc;
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  :global(.modal-chart-button:hover) {
    border-color: var(--category-color, #fff);
    color: var(--category-color, #fff);
    background: #141414;
  }

  :global(.modal-chart-button:active) {
    transform: translateY(1px);
  }

  .modal-size-cm {
    font-size: 11px;
    color: #999;
    font-variant-numeric: tabular-nums;
  }

  /* FITS */

  .modal-fits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  :global(.modal-fit) {
    padding: 12px 14px;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    background: #0a0a0a;
    color: #bbb;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
    font-family: inherit;
    font-size: inherit;
  }

  :global(.modal-fit strong) {
    display: block;
    font-size: 13px;
    color: #fff;
    margin-bottom: 2px;
  }

  :global(.modal-fit span) {
    font-size: 11px;
    color: #888;
    line-height: 1.35;
  }

  :global(.modal-fit:hover) {
    border-color: #444;
    background: #141414;
  }

  :global(.modal-fit.active) {
    border-color: var(--category-color, #fff);
    background: #181818;
  }

  :global(.modal-fit.active strong) {
    color: var(--category-color, #fff);
  }

  /* SIZES */

  .modal-sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  :global(.modal-size) {
    min-width: 48px;
    padding: 9px 12px;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    background: #0a0a0a;
    color: #ccc;
    font-family: monospace;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  :global(.modal-size:hover) {
    border-color: #444;
    background: #141414;
  }

  :global(.modal-size.active) {
    border-color: var(--category-color, #fff);
    background: var(--category-color, #fff);
    color: #0a0a0a;
  }

  /* QUANTITY */

  .modal-quantity-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .modal-quantity {
    display: inline-flex;
    align-items: center;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    overflow: hidden;
    background: #0a0a0a;
  }

  .modal-quantity button {
    width: 34px;
    height: 34px;
    border: 0;
    background: transparent;
    color: #bbb;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .modal-quantity button:hover {
    background: #1f1f1f;
    color: #fff;
  }

  .modal-quantity span {
    min-width: 34px;
    padding: 0 6px;
    text-align: center;
    font-family: monospace;
    font-size: 14px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }


  /* FOOTER */

  .modal-info-footer {
    border-top: 1px solid #242424;
    padding: 16px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
  }

  .modal-add {
    width: 100%;
    padding: 14px 18px;
    border: 0;
    border-radius: 10px;
    background: var(--category-color, #fff);
    color: #0a0a0a;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.15s ease, filter 0.2s ease;
  }

  .modal-add:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }

  .modal-add.is-added {
    background: #25d366 !important;
    color: #fff;
  }

  .modal-actions {
    display: flex;
    gap: 8px;
  }

  .modal-see-cart,
  .modal-share {
    flex: 1;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, border-color 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .modal-see-cart {
    background: var(--category-color, #fff);
    color: #0a0a0a;
    border: 1px solid var(--category-color, #fff);
  }

  .modal-see-cart:hover {
    filter: brightness(1.12);
    border-color: var(--category-color, #fff);
  }

  .modal-share {
    background: transparent;
    color: #ddd;
    border: 1px solid #2a2a2a;
  }

  .modal-share:hover {
    border-color: var(--category-color, #fff);
    color: var(--category-color, #fff);
  }

  :global(body.modal-open) {
    overflow: hidden;
  }

  /* --------------------------- */
  /* FLECHAS DE PRODUCTO         */
  /* --------------------------- */

  /* Desktop: afuera del modal, a los costados de la pantalla. */
  .modal-product-arrow {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1010;
    width: 60px;
    height: 60px;
    border: 1px solid var(--category-color, rgba(255, 255, 255, 0.18));
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
    opacity: 0;
    pointer-events: none;
  }

  :global(.modal.open) .modal-product-arrow {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-product-arrow:hover {
    background: var(--category-color, #fff);
    border-color: var(--category-color, #fff);
    color: #0a0a0a;
  }

  .modal-product-arrow-label {
    font-size: 6px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    opacity: 0.9;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .modal-product-arrow-icon {
    font-size: 22px;
    line-height: 1;
    font-weight: 400;
    transition: color 0.2s ease;
  }

  .modal-product-prev {
    left: 24px;
  }

  .modal-product-next {
    right: 24px;
  }

  /* Mobile: flechas dentro del header del modal. */
  .modal-product-arrow-mobile {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    width: 44px;
    height: 44px;
    border: 1px solid var(--category-color, #2a2a2a);
    border-radius: 8px;
    background: #0a0a0a;
    color: #ccc;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .modal-product-arrow-mobile:hover {
    background: var(--category-color, #444);
    border-color: var(--category-color, #444);
    color: #0a0a0a;
  }

  .modal-product-arrow-mobile .modal-product-arrow-label {
    font-size: 7px;
  }

  .modal-product-arrow-mobile .modal-product-arrow-icon {
    font-size: 20px;
  }

  /* En mobile ocultamos las flechas de afuera y mostramos las del header. */
  @media (max-width: 1280px) {
    .modal-product-arrow {
      display: none;
    }

    .modal-product-arrow-mobile {
      display: flex;
    }

    .modal-info-header {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .modal-info-header-center {
      flex: 1;
      text-align: center;
      min-width: 0;
    }

    .modal-info-header-center h2 {
      padding-right: 0;
    }
  }

  /* Desktop: el header vuelve a su layout normal (sin flechas mobile). */
  @media (min-width: 1281px) {
    .modal-info-header-center {
      display: block;
    }
  }

  /* Animación de cambio de producto. */
  .modal-grid.switching-next {
    animation: switchOutLeft 0.18s ease-in forwards;
  }

  .modal-grid.switching-prev {
    animation: switchOutRight 0.18s ease-in forwards;
  }

  .modal-grid.switching-in-next {
    animation: switchInFromRight 0.22s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .modal-grid.switching-in-prev {
    animation: switchInFromLeft 0.22s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes switchOutLeft {
    from { opacity: 1; transform: translateX(0); }
    to   { opacity: 0; transform: translateX(-30px); }
  }

  @keyframes switchOutRight {
    from { opacity: 1; transform: translateX(0); }
    to   { opacity: 0; transform: translateX(30px); }
  }

  @keyframes switchInFromRight {
    from { opacity: 0; transform: translateX(30px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @keyframes switchInFromLeft {
    from { opacity: 0; transform: translateX(-30px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* MODAL RESPONSIVE */

   @media (max-width: 800px) {
    .modal {
      padding: 0;
      align-items: stretch;
    }

    .modal-content {
      width: 100%;
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
      border: 0;
      overflow: hidden;
      /* En mobile: fade puro, sin transform.
         El slide se veía trabado en muchos celus por el costo del
         re-layout del contenido grande del modal. El fade es lo más
         liviano que existe y no se traba nunca. */
      transform: none;
      transition: opacity 0.3s ease;
      will-change: opacity;
    }

    .modal.open .modal-content {
      opacity: 1;
    }

    /* En mobile el modal-grid pasa a ser el ÚNICO scroller:
       todo el contenido (foto, thumbs, título, selectores, botones)
       se desplaza junto. */
    .modal-grid {
      display: flex;
      flex-direction: column;
      grid-template-columns: none;
      height: 100%;
      max-height: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
      contain: layout;
    }

    .modal-gallery {
      flex-shrink: 0;
      border-right: 0;
      border-bottom: 1px solid #242424;
      padding: 14px;
    }

    .modal-image-area {
      aspect-ratio: 1 / 1;
      flex: none;
      min-height: auto;
    }

    /* La info deja de ser flex/scroll internamente en mobile. */
    .modal-info {
      display: block;
      flex-shrink: 0;
      min-height: auto;
    }

    .modal-info-header {
      padding: 18px 16px 12px;
    }

    .modal-info-body {
      padding: 16px;
      overflow: visible;
      flex: none;
      min-height: auto;
    }

    .modal-info-footer {
      padding: 14px 16px;
      flex-shrink: 0;
    }

    .modal-close {
      top: 10px;
      right: 10px;
    }
  }

    :global(.back-to-top) {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 900;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(40, 40, 40, 0.9);
    color: white;
    font-size: 24px;
