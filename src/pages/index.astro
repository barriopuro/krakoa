  // La usa el popstate (que ya viene del back del navegador).
  function closeTopOverlay() {
    const top = historyStack.pop();
    if (!top) return;

    if (top.kind === "modal") {
      closeModalDirect();
    } else if (top.kind === "cart") {
      closeCartDrawerDirect();
    } else if (top.kind === "image-zoom") {
      closeImageZoomDirect();
    } else if (top.kind === "mobile-menu") {
      closeMobileMenuDirect();
    } else if (top.kind === "promo") {
      if (typeof window.KRAKOA_CLOSE_PROMO === "function") {
        window.KRAKOA_CLOSE_PROMO();
      }
    } else if (top.kind === "category") {
      applyCategoryFilter(top.state?.previousCategory ?? null, {
        push: false,
        scroll: false,
      });
    }
  }

