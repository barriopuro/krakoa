      src: `${BASE_PATH}${extra.src}`,
      label: extra.label,
    }));

    return [
      { src: modelo, thumbSrc: modelo400, label: "Modelo" },
      { src: remera, thumbSrc: remera400, label: "Remera" },
      ...extras,
      { src: `${BASE_PATH}/talles/oversize.webp`, label: "Talles Oversize" },
      { src: `${BASE_PATH}/talles/regular.webp`, label: "Talles Regular" },
