  const handleClick = () => {
    const clickedCategory = button.dataset.category ?? "";
    const isAlreadyActive = button.classList.contains("active");
    // Toggle: si ya estaba activo, vamos a "todas" (null).
    const newCategory = isAlreadyActive ? null : clickedCategory;
    applyCategoryFilter(newCategory);
  };

  // Click en el botón: frena la propagación para no disparar también el del wrap.
  button.addEventListener("click", (event) => {
    event.stopPropagation();
    handleClick();
  });

  // Click en el wrap (la "sombra" de color que queda cuando el botón se despega):
  // dispara el mismo handler.
  wrap?.addEventListener("click", handleClick);
});

  // Botón "volver arriba" + barra de progreso de scroll + anillo del botón.
  const scrollProgress = document.querySelector("#scroll-progress");
  const backToTopRingProgress = document.querySelector(
    "#back-to-top-ring-progress"
  );
  // Circunferencia del anillo (2π × r, con r=19).
  // Tiene que coincidir con el stroke-dasharray del CSS.
  const BACK_TO_TOP_CIRCUMFERENCE = 2 * Math.PI * 19;

  function updateScrollProgress() {
    if (!scrollProgress) return;
    const docHeight =
      document.documentElement.scrollHeight - window.innerHeight;
    // Si la página no scrollea (contenido más corto que la ventana),
    // dejamos la barra en 0.
    const percent = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
    // S31: scaleX en vez de width (compositor-only). 0 → 1.
    scrollProgress.style.transform = `scaleX(${percent / 100})`;

    // Anillo del botón "volver arriba": se llena de 0 a 100.
    // dashoffset va de C (vacío) a 0 (lleno).
    if (backToTopRingProgress) {
      const offset = BACK_TO_TOP_CIRCUMFERENCE * (1 - percent / 100);
      backToTopRingProgress.style.strokeDashoffset = String(offset);
    }
  }

  let scrollTicking = false;

  window.addEventListener("scroll", () => {
    if (!scrollTicking) {
      window.requestAnimationFrame(() => {
        if (window.scrollY > 600) {
          backToTop.classList.add("visible");
        } else {
          backToTop.classList.remove("visible");
        }
        updateScrollProgress();
        scrollTicking = false;
      });
      scrollTicking = true;
    }
  }, { passive: true });

  // Actualizamos al cargar la página (por si el usuario recarga estando
  // a mitad de scroll, o entra con un hash).
  updateScrollProgress();

  backToTop.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

