function filterProducts() {
  const raw = searchInput.value.toLowerCase().trim();
  // Partimos la búsqueda por espacios: cada palabra se busca por separado.
  // Así "dragon ball" matchea "dragon ball z" y también el tag "dragon".
  const terms = raw.split(/\s+/).filter(Boolean);

  products.forEach((product) => {
    const name = product.dataset.name ?? "";
    const tags = (product.dataset.tags ?? "").toLowerCase();
    const category = product.dataset.category ?? "";

    // Cada término debe aparecer en el nombre O en algún tag.
    const matchesSearch =
      terms.length === 0 ||
      terms.every((term) => name.includes(term) || tags.includes(term));

    const matchesCategory =
      activeCategory === null || category === activeCategory;

    product.style.display =
      matchesSearch && matchesCategory ? "" : "none";
  });

  // Reordenamos el DOM según el modo:
  //  - Con categoría activa: alfabético (para que se vea ordenado).
  //  - Sin categoría (home): el orden aleatorio original.
  if (typeof window.__krakoaReorderProducts === "function") {
    window.__krakoaReorderProducts(activeCategory === null ? "random" : "alpha");
  }
}

// Aplica un filtro de categoría al catálogo. Puede hacer push al
// history (default, para clicks del usuario) o no (para restauraciones
// desde el botón atrás).
// categoryId: id de la categoría, o null para "todas".
function applyCategoryFilter(categoryId, { push = true, scroll = true } = {}) {
  const previousCategory = activeCategory;
  activeCategory = categoryId;

  // Actualizamos las clases .active de los botones.
  categoryButtons.forEach((btn) => {
    btn.classList.toggle("active", btn.dataset.category === categoryId);
  });

  // Tinte de fondo: on si hay categoría, off si no.
  if (categoryId === null) {
    hideTint();
  } else {
    const btn = Array.from(categoryButtons).find(
      (b) => b.dataset.category === categoryId
    );
    const wrap = btn?.closest(".category-wrap");
    const color =
      wrap?.style.getPropertyValue("--category-color")?.trim() ||
      "#888888";
    showTint(color);
  }

  filterProducts();

  // Scroll al inicio de la grilla. Solo cuando el usuario clickea
  // (no cuando se restaura desde back, para no saltar de lugar).
  // Además, solo scrolleamos si el usuario está MÁS ABAJO que el
  // destino. Si ya está arriba (viendo el header/hero), no movemos
  // la página: cambiar de categoría no debe sacarte de donde estás.
  if (scroll) {
    const productsGrid = document.querySelector("#products");
    if (productsGrid) {
      const top =
        productsGrid.getBoundingClientRect().top + window.scrollY - 110;
      if (window.scrollY > top) {
        window.scrollTo({ top, behavior: "smooth" });
      }
    }
  }

  // Pusheamos al history para que "atrás" pueda restaurar el estado previo.
  if (push) {
    pushHistory("category", { previousCategory });
  }
}

