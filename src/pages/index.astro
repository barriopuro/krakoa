---
import catalogo from "../data/catalogo.json";

const categories = [
  { id: "todos", name: "Todos" },
  ...catalogo.categories,
];

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>KRAKOA | REMERAS</title>
<link rel="icon" type="image/png" href={`${base}/logos/krakoalogo-isotipo.png`} />
  <meta
    name="description"
    content="KRAKOA — Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />

  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#111111" />

  <meta property="og:title" content="KRAKOA | Remeras" />
  <meta
    property="og:description"
    content="Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KRAKOA" />
  <meta property="og:image" content={`${base}/og-image.jpg`} />
  <meta property="og:image:url" content={`${base}/og-image.jpg`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="KRAKOA | Remeras" />
  <meta
    name="twitter:description"
    content="Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />
</head>

  <body>
<header class="site-header">
  <a href={`${base}/`} class="brand" aria-label="KRAKOA">
    <img
      class="logo-horizontal"
      src={`${base}/logos/krakoalogo-horizontal.png`}
      alt="KRAKOA"
    />

    <img
      class="logo-isotipo"
      src={`${base}/logos/krakoalogo-isotipo.png`}
      alt=""
      aria-hidden="true"
    />
  </a>

  <div class="header-actions">
    <a
      href="https://instagram.com/krakoa.sw"
      target="_blank"
      rel="noopener noreferrer"
      class="instagram"
    >
      Instagram
    </a>

    <button
      id="cart-toggle"
      class="cart-button"
      type="button"
      aria-label="Ver mi pedido"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
        <path d="M3 6h18" />
        <path d="M16 10a4 4 0 0 1-8 0" />
      </svg>
      <span id="cart-count" class="cart-count" hidden>0</span>
    </button>
  </div>
</header>

    <main>
      <section class="hero">
         <h1>CATALOGO.</h1>
      </section>

      <section class="catalog">
        <div class="catalog-header">
        

          <div class="search-wrapper">
            <input
              id="search"
              type="search"
              placeholder="Buscar diseño..."
              autocomplete="off"
            />
          </div>
        </div>

        <nav class="categories" aria-label="Categorías">
          {
            categories.map((category) => (
              <button
  class:list={[
    "category-button",
    { active: category.id === "todos" },
  ]}
  data-category={category.id}
  style={`--category-color: ${category.color ?? "#888888"}`}
>
  <span class="category-dot"></span>
  {category.name}
</button>
            ))
          }
        </nav>

        <div id="products" class="products">
          {
            catalogo.products.map((product) => (
              <article
                class="product-card"
                data-name={product.name.toLowerCase()}
                data-category={product.category}
              >
                <button class="product-button" type="button">
                  <div class="product-image">
                    <img
                      src={`${base}/${product.modelo}`}
                      alt={`Remera ${product.name}`}
                      loading="lazy"
                    />
                  </div>

                  <div class="product-info">
  <h3>{product.name}</h3>

  <span
    class="product-category"
    style={`--category-color: ${
      catalogo.categories.find(
        (category) => category.id === product.category
      )?.color ?? "#888888"
    }`}
  >
    <i class="category-dot"></i>
    {product.categoryName}
  </span>
</div>
                </button>
              </article>
            ))
          }
        </div>
      </section>
<div id="product-modal" class="modal" aria-hidden="true">
  <div class="modal-backdrop"></div>

  <div class="modal-content" role="dialog" aria-modal="true">
    <button
      id="modal-close"
      class="modal-close"
      type="button"
      aria-label="Cerrar"
    >
      ×
    </button>

    <div class="modal-grid">
      <!-- COLUMNA IZQUIERDA: GALERÍA -->
      <div class="modal-gallery">
        <div class="modal-image-area">
          <button
            id="modal-prev"
            class="modal-arrow modal-prev"
            type="button"
            aria-label="Imagen anterior"
          >
            ‹
          </button>

          <div class="modal-image-wrapper">
            <img id="modal-image" src="" alt="" />
          </div>

          <button
            id="modal-next"
            class="modal-arrow modal-next"
            type="button"
            aria-label="Imagen siguiente"
          >
            ›
          </button>

          <div class="modal-image-overlay">
            <span id="modal-image-label" class="modal-image-label">Modelo</span>
            <span id="modal-image-counter" class="modal-image-counter">1 / 4</span>
          </div>
        </div>

        <div id="modal-thumbs" class="modal-thumbs"></div>
      </div>

      <!-- COLUMNA DERECHA: INFO + SELECTORES -->
      <div class="modal-info">
        <div class="modal-info-header">
          <span id="modal-category" class="modal-category"></span>
          <h2 id="modal-title"></h2>
        </div>

        <div class="modal-info-body">
          <!-- CORTE -->
          <div class="modal-field">
            <div class="modal-label-row">
              <label class="modal-label">
                <span class="modal-step">1.</span> Elegí el corte:
              </label>
              <button
                id="modal-see-chart"
                class="modal-link"
                type="button"
              >
                Ver gráfico
              </button>
            </div>
            <div id="modal-fits" class="modal-fits"></div>
          </div>

          <!-- TALLE -->
          <div class="modal-field">
            <div class="modal-label-row">
              <label class="modal-label">
                <span class="modal-step">2.</span> Elegí el talle:
              </label>
              <span id="modal-size-cm" class="modal-size-cm"></span>
            </div>
            <div id="modal-sizes" class="modal-sizes"></div>
          </div>

          <!-- CANTIDAD -->
          <div class="modal-field modal-quantity-row">
            <label class="modal-label">Cantidad:</label>
            <div class="modal-quantity">
              <button
                id="modal-qty-minus"
                type="button"
                aria-label="Restar uno"
              >
                −
              </button>
              <span id="modal-qty-value">1</span>
              <button
                id="modal-qty-plus"
                type="button"
                aria-label="Sumar uno"
              >
                +
              </button>
            </div>
          </div>

          <!-- AVISO TELA -->
          <div class="modal-note">
            <strong>100% Algodón Peinado 24/1 Premium</strong>
            <p>No encoge, cuello con rib reforzado y costuras de alta resistencia.</p>
          </div>
        </div>

        <div class="modal-info-footer">
          <button id="modal-add" class="modal-add" type="button">
            Agregar al Pedido
          </button>

          <div class="modal-actions">
            <button
              id="modal-whatsapp"
              class="modal-whatsapp"
              type="button"
            >
              Consultar por WhatsApp
            </button>

            <button
              id="modal-share"
              class="modal-share"
              type="button"
              aria-label="Compartir"
            >
              Compartir
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

    <div id="cart-drawer" class="cart-drawer" aria-hidden="true">
      <div class="cart-drawer-backdrop"></div>

      <aside
        class="cart-drawer-panel"
        role="dialog"
        aria-modal="true"
        aria-label="Mi pedido"
      >
        <header class="cart-drawer-header">
          <h2>Mi Pedido</h2>
          <span id="cart-drawer-count" class="cart-drawer-count">0</span>
          <button
            id="cart-drawer-close"
            class="cart-drawer-close"
            type="button"
            aria-label="Cerrar"
          >
            ×
          </button>
        </header>

        <div id="cart-drawer-body" class="cart-drawer-body">
          <div class="cart-empty" id="cart-empty">
            <p>Tu lista de pedido está vacía</p>
            <p class="cart-empty-hint">
              Navegá por el catálogo y elegí corte, talle y cantidad.
            </p>
            <button id="cart-empty-cta" type="button" class="cart-empty-cta">
              Explorar catálogo
            </button>
          </div>
        </div>

        <footer
          class="cart-drawer-footer"
          id="cart-drawer-footer"
          hidden
        >
          <div class="cart-drawer-total">
            <span>Total de prendas:</span>
            <strong id="cart-drawer-total">0</strong>
          </div>

          <button
            id="cart-drawer-whatsapp"
            type="button"
            class="cart-drawer-whatsapp"
          >
            Enviar Pedido por WhatsApp
          </button>
        </footer>
      </aside>
    </div>

    </main>

    <footer>
      <span>KRAKOA</span>

      <a
        href="https://instagram.com/krakoa.sw"
        target="_blank"
        rel="noopener noreferrer"
      >
        @krakoa.sw
      </a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #0b0b0b;
    color: #f2f2f2;
    font-family: Arial, Helvetica, sans-serif;
  }

  .site-header {
    width: 100%;
    padding: 22px 5vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #242424;
  }

 .brand {
  display: flex;
  align-items: center;
  text-decoration: none;
}

.logo-horizontal {
  display: block;
  width: 150px;
  height: auto;
}

.logo-isotipo {
  display: none;
  width: 34px;
  height: 34px;
  object-fit: contain;
}

  .instagram {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 16px;
  border-radius: 6px;
  background: linear-gradient(135deg, #833ab4, #c13584, #e1306c, #f77737, #fcaf45);
  color: white;
  text-decoration: none;
  font-size: 13px;
  font-weight: 700;
  transition: transform 0.2s ease, filter 0.2s ease;
}

.instagram:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}

  main {
    width: min(1400px, 90vw);
    margin: 0 auto;
  }

 .hero {
  padding: 55px 0 45px;
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: #888;
  }

  h1 {
    margin: 0;
    font-size: clamp(48px, 9vw, 120px);
    line-height: 0.88;
    letter-spacing: -0.065em;
    font-weight: 900;
  }

  .intro {
    margin: 32px 0 0;
    color: #999;
    font-size: 15px;
  }

  .catalog {
    padding-bottom: 100px;
  }

  .catalog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 25px;
  }

  h2 {
    margin: 0;
    font-size: 24px;
    letter-spacing: -0.03em;
  }

  .search-wrapper input {
    width: 240px;
    padding: 11px 14px;
    border: 1px solid #333;
    border-radius: 0;
    outline: none;
    background: #111;
    color: white;
    font-size: 14px;
  }

  .search-wrapper input:focus {
    border-color: #777;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 35px;
  }

 .category-button {
  border: 1px solid #333;
  background: transparent;
  color: #999;
  padding: 9px 15px;
  cursor: pointer;
  font-size: 13px;
  transition: 0.2s ease;

  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.category-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--category-color);
  flex-shrink: 0;
}

.category-button:hover,
.category-button.active {
  border-color: var(--category-color);
  color: white;
}

.category-button.active .category-dot {
  box-shadow: 0 0 8px var(--category-color);
}

  
 .products {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 28px;
  max-width: 1180px;
  margin: 0 auto;
}

  .product-card {
    min-width: 0;
  }

  .product-button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .product-image {
    aspect-ratio: 1 / 1.18;
    background: #141414;
    overflow: hidden;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.35s ease;
  }

  .product-button:hover .product-image img {
    transform: scale(1.025);
  }

  .product-info {
    padding: 12px 2px 0;
  }

  .product-info h3 {
    margin: 0 0 5px;
    font-size: 15px;
    font-weight: 700;
  }

.product-category {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #777;
  font-size: 12px;
}

.product-category .category-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--category-color);
  flex-shrink: 0;
}

  footer {
    padding: 30px 5vw;
    border-top: 1px solid #242424;
    display: flex;
    justify-content: space-between;
    color: #666;
    font-size: 12px;
  }

  footer a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .site-header {
      padding: 18px 5vw;
    }

    .hero {
      padding: 40px 0 35px;
    }

    .catalog-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

    .search-wrapper,
    .search-wrapper input {
      width: 100%;
    }

    .categories {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 5px;
    }

    .category-button {
      white-space: nowrap;
    }
	.logo-horizontal {
  display: block;
}

.logo-isotipo {
  display: none;
}
  }
      /* --------------------------- */
  /* MODAL DE PRODUCTO (NUEVO)   */
  /* --------------------------- */

  .modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .modal.open {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
  }

  .modal-content {
    position: relative;
    width: min(96vw, 1100px);
    max-height: 92dvh;
    background: #111;
    border: 1px solid #242424;
    border-radius: 16px;
    overflow: hidden;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 5;
    width: 36px;
    height: 36px;
    border: 1px solid #2a2a2a;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .modal-close:hover {
    background: #fff;
    color: #111;
    border-color: #fff;
  }

  .modal-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    max-height: 92dvh;
    overflow: hidden;
  }

  /* GALERÍA */

  .modal-gallery {
    background: #0a0a0a;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-right: 1px solid #242424;
    min-width: 0;
  }

  .modal-image-area {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #141414;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .modal-image-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .modal-image-wrapper img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .modal-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 38px;
    height: 38px;
    border: 1px solid #2a2a2a;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .modal-arrow:hover {
    background: #fff;
    color: #111;
  }

  .modal-prev {
    left: 12px;
  }

  .modal-next {
    right: 12px;
  }

  .modal-image-overlay {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }

  .modal-image-label,
  .modal-image-counter {
    padding: 4px 9px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.75);
    color: #ddd;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .modal-image-counter {
    color: #999;
    font-variant-numeric: tabular-nums;
  }

  .modal-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    flex-shrink: 0;
    width: 100%;
    height: 72px;
  }

  :global(.modal-thumb) {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 2px solid #242424;
    border-radius: 8px;
    background: #141414;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  :global(.modal-thumb:hover) {
    opacity: 0.9;
    border-color: var(--category-color, #666);
  }

  :global(.modal-thumb.active) {
    opacity: 1;
    border-color: var(--category-color, #fff);
    box-shadow: 0 0 10px -2px var(--category-color, #fff);
  }

  :global(.modal-thumb img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* INFO */

  .modal-info {
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    background: #111;
  }

  .modal-info-header {
    padding: 22px 24px 14px;
    border-bottom: 1px solid #242424;
    flex-shrink: 0;
  }

  .modal-category {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #999;
  }

  .modal-category::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--category-color, #888);
    box-shadow: 0 0 8px var(--category-color, #888);
  }

  .modal-info-header h2 {
    margin: 0;
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 900;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    line-height: 1.05;
    padding-right: 30px;
  }

  .modal-info-body {
    flex: 1;
    overflow-y: auto;
    padding: 18px 24px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-height: 0;
  }

  .modal-field {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .modal-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .modal-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ddd;
  }

  .modal-step {
    color: var(--category-color, #fff);
    font-weight: 900;
  }

  .modal-link {
    background: none;
    border: 0;
    padding: 0;
    color: #888;
    font-size: 11px;
    text-decoration: underline;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .modal-link:hover {
    color: var(--category-color, #fff);
  }

  .modal-size-cm {
    font-size: 11px;
    color: #999;
    font-variant-numeric: tabular-nums;
  }

  /* FITS */

  .modal-fits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  :global(.modal-fit) {
    padding: 12px 14px;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    background: #0a0a0a;
    color: #bbb;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
