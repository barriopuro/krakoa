<style>
  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #0b0b0b;
    color: #f2f2f2;
    font-family: Arial, Helvetica, sans-serif;
    overflow-x: clip;
  }

  /* Bounce al click (feedback táctil en cualquier botón).
     Usa la propiedad `scale` (independiente de `transform`) así se combina
     con los hover existentes sin pisarlos. La transición va solo en :active
     → al apretar se achica rápido (80ms), al soltar vuelve instantáneo.
     Excluyo .category-button porque su .active ya tiene un translate de
     elevación y el scale le restaría tamaño durante el efecto. */
  :global(button:not(.category-button):active),
  :global(a.instagram-btn:active),
  :global(a.faq-cta-button:active) {
    scale: 0.95;
    transition: scale 0.08s ease;
  }

  .site-header {
    width: 100%;
    padding: 18px 5vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #242424;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-horizontal {
    display: block;
    width: 175px;
    height: auto;
  }

  .logo-isotipo {
    display: none;
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  /* Navegación desktop */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-left: auto;
    margin-right: 12px;
  }

  .desktop-nav a {
    color: #999;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
    padding: 6px 2px;
  }

  .desktop-nav a:hover {
    color: #fff;
  }

  /* Subrayado animado en los links del header.
     El ::after es un pseudo-elemento dentro de un <header> (fuera de <main>),
     así que va con :global() según las reglas del proyecto.
     Se dibuja de izquierda a derecha (transform-origin: left) al hover,
     y se retrae al revés al sacar el mouse. Curva "out-expo" para un
     cierre suave. */
  :global(.desktop-nav a) {
    position: relative;
  }

  :global(.desktop-nav a::after) {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 2px;
    right: 2px;
    height: 1px;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  :global(.desktop-nav a:hover::after) {
    transform: scaleX(1);
  }

  /* Acciones del header */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .instagram-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid #242424;
    border-radius: 8px;
    background: transparent;
    color: #ddd;
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 600;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }

  .instagram-btn svg {
    width: 15px;
    height: 15px;
    color: #e1306c;
    flex-shrink: 0;
  }

  .instagram-btn:hover {
    border-color: #3a3a3a;
    color: #fff;
    transform: translateY(-1px);
  }

  .cart-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: #fff;
    color: #111;
    border: 0;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .cart-button:hover {
    background: #e5e5e5;
    transform: translateY(-1px);
  }

  .cart-button svg {
    width: 20px;
    height: 20px;
  }

  .cart-count {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    display: none;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
  }

  .cart-count.is-visible {
    display: inline-flex;
  }

  /* Botón hamburguesa (solo mobile) */
  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid #242424;
    border-radius: 8px;
    background: transparent;
    color: #ddd;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .menu-toggle:hover {
    background: #1a1a1a;
    border-color: #3a3a3a;
    color: #fff;
  }

  .menu-toggle svg {
    width: 20px;
    height: 20px;
  }

  /* Menú mobile (drawer) */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1200;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0s linear 0.28s;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.28s ease, visibility 0s linear 0s;
  }

  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
  }

  .mobile-menu-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(320px, 85vw);
    height: 100%;
    background: #111;
    border-left: 1px solid #242424;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s ease;
  }

  .mobile-menu.open .mobile-menu-panel {
    transform: translateX(0);
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 22px;
    border-bottom: 1px solid #242424;
  }

  .mobile-menu-title {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #888;
  }

  .mobile-menu-close {
    width: 34px;
    height: 34px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #999;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .mobile-menu-close:hover {
    background: #242424;
    color: #fff;
  }

  .mobile-menu-nav {
    display: flex;
    flex-direction: column;
    padding: 12px 0;
    flex: 1;
  }

  .mobile-menu-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    color: #ddd;
    text-decoration: none;
    font-size: 15px;
