  /* --------------------------- */
  /* BUSCADOR EN EL HEADER       */
  /* --------------------------- */

  /* Botón lupa: solo visible en mobile. */
  .search-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid #242424;
    border-radius: 8px;
    background: transparent;
    color: #ddd;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .search-toggle:hover {
    background: #1a1a1a;
    border-color: #3a3a3a;
    color: #fff;
  }

  .search-toggle svg {
    width: 18px;
    height: 18px;
  }

  /* Panel que contiene el input + botón ×. */
  .header-search-panel {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Input del buscador en desktop: ancho fijo, mismo look que antes. */
  #search {
    width: 200px;
    padding: 9px 14px;
    border: 1px solid #333;
    border-radius: 8px;
    outline: none;
    background: #111;
    color: #fff;
    font-size: 13px;
    transition: border-color 0.2s ease;
  }

  #search:focus {
    border-color: #777;
  }

  /* Botón × del buscador: solo visible en mobile. */
  .search-close {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid #242424;
    border-radius: 8px;
    background: transparent;
    color: #ddd;
    cursor: pointer;
    font-size: 22px;
    line-height: 1;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .search-close:hover {
    background: #1a1a1a;
    border-color: #3a3a3a;
    color: #fff;
  }

  /* Transición al abrir/cerrar el buscador en mobile.
     El glitch va SOLO en las piezas del buscador (input, placeholder,
     × y lupa), no en el header entero: así no vibran el logo, el
     carrito ni el resto de los botones. */
  @keyframes searchShake {
    0%   { transform: translateX(0); }
    20%  { transform: translateX(-2px); }
    40%  { transform: translateX(2px); }
    60%  { transform: translateX(-1px); }
    80%  { transform: translateX(1px); }
    100% { transform: translateX(0); }
  }

  /* Glitch del buscador: borde + placeholder + íconos (no el fondo).
     Concordancia con el glitch del menú de categorías. */

  /* Input (mobile y desktop): borde + placeholder + shake leve. */
  :global(.header-search-panel.search-switching) :global(#search) {
    animation: searchFieldGlitch 0.4s steps(9, end) 1,
               searchShake 0.4s steps(4, end) 1;
  }

  :global(.header-search-panel.search-switching) :global(#search)::placeholder {
    animation: searchPlaceholderGlitch 0.4s steps(7, end) 1;
  }

  /* Botón X (mobile): borde + el "×" (color + text-shadow) + shake. */
  :global(.header-search-panel.search-switching) :global(#search-close) {
    animation: searchXGlitch 0.4s steps(9, end) 1,
               searchShake 0.4s steps(4, end) 1;
  }

  /* Lupa (mobile al cerrar): borde del botón + ícono SVG + shake.
     El SVG no lleva shake propio: vibra junto al botón padre. */
  :global(.search-toggle.search-switching) {
    animation: searchToggleBorderGlitch 0.4s steps(7, end) 1,
               searchShake 0.4s steps(4, end) 1;
  }

  :global(.search-toggle.search-switching) :global(svg) {
    animation: searchIconGlitch 0.4s steps(9, end) 1;
  }

  /* Borde del input: flash breve de magenta/cian con glow externo,
     y vuelve a gris entre cada uno. Sin bucle "navideño". */
  @keyframes searchFieldGlitch {
    0%   { border-color: #ff0055; box-shadow: inset 0 0 0 2px rgba(255, 0, 85, 0.35), 0 0 10px rgba(255, 0, 85, 0.45); }
    15%  { border-color: #333;    box-shadow: inset 0 0 0 0 transparent, 0 0 0 transparent; }
    30%  { border-color: #00fff0; box-shadow: inset 0 0 0 2px rgba(0, 255, 240, 0.3), 0 0 8px rgba(0, 255, 240, 0.45); }
    50%  { border-color: #333;    box-shadow: inset 0 0 0 0 transparent, 0 0 0 transparent; }
    70%  { border-color: #ff0055; box-shadow: inset 0 0 0 2px rgba(255, 0, 85, 0.35), 0 0 10px rgba(255, 0, 85, 0.45); }
    85%  { border-color: #333;    box-shadow: inset 0 0 0 0 transparent, 0 0 0 transparent; }
    100% { border-color: #333;    box-shadow: none; }
  }

  /* Placeholder: RGB split doble (magenta + cian a la vez, alternando
     de lado). El color base se mantiene gris (#666) la mayoría del
     tiempo, con algún flash puntual a un gris más claro. */
  @keyframes searchPlaceholderGlitch {
    0%   { color: #666; text-shadow: 3px 0 rgba(255, 0, 85, 0.9), -3px 0 rgba(0, 255, 240, 0.9); }
    15%  { color: #999; text-shadow: -3px 0 rgba(255, 0, 85, 0.9), 3px 0 rgba(0, 255, 240, 0.9); }
    30%  { color: #666; text-shadow: 2px 0 rgba(255, 0, 85, 0.7), -2px 0 rgba(0, 255, 240, 0.7); }
    50%  { color: #999; text-shadow: -3px 0 rgba(255, 0, 85, 0.9), 3px 0 rgba(0, 255, 240, 0.9); }
    70%  { color: #666; text-shadow: 3px 0 rgba(255, 0, 85, 0.9), -3px 0 rgba(0, 255, 240, 0.9); }
    85%  { color: #666; text-shadow: none; }
    100% { color: #666; text-shadow: none; }
  }

  /* × y su borde: el texto (×) con RGB split doble, y el borde con
     flash breve (magenta/cian) + glow. Los dos efectos corren
     sincronizados. */
  @keyframes searchXGlitch {
    0%   { color: #ddd; text-shadow: 3px 0 rgba(255, 0, 85, 0.9), -3px 0 rgba(0, 255, 240, 0.9); border-color: #ff0055; box-shadow: 0 0 10px rgba(255, 0, 85, 0.45); }
    15%  { color: #ddd; text-shadow: -3px 0 rgba(255, 0, 85, 0.9), 3px 0 rgba(0, 255, 240, 0.9); border-color: #242424; box-shadow: none; }
    30%  { color: #ddd; text-shadow: 2px 0 rgba(255, 0, 85, 0.7), -2px 0 rgba(0, 255, 240, 0.7); border-color: #00fff0; box-shadow: 0 0 8px rgba(0, 255, 240, 0.45); }
    50%  { color: #ddd; text-shadow: -2px 0 rgba(255, 0, 85, 0.7), 2px 0 rgba(0, 255, 240, 0.7); border-color: #242424; box-shadow: none; }
    70%  { color: #ddd; text-shadow: 3px 0 rgba(255, 0, 85, 0.9), -3px 0 rgba(0, 255, 240, 0.9); border-color: #ff0055; box-shadow: 0 0 10px rgba(255, 0, 85, 0.45); }
    85%  { color: #ddd; text-shadow: none; border-color: #242424; box-shadow: none; }
    100% { color: #ddd; text-shadow: none; border-color: #242424; box-shadow: none; }
  }

  /* Borde de la lupa: igual al borde del input (flash + glow). */
  @keyframes searchToggleBorderGlitch {
    0%   { border-color: #ff0055; box-shadow: 0 0 10px rgba(255, 0, 85, 0.45); }
    15%  { border-color: #242424; box-shadow: none; }
    30%  { border-color: #00fff0; box-shadow: 0 0 8px rgba(0, 255, 240, 0.45); }
    50%  { border-color: #242424; box-shadow: none; }
    70%  { border-color: #ff0055; box-shadow: 0 0 10px rgba(255, 0, 85, 0.45); }
    85%  { border-color: #242424; box-shadow: none; }
    100% { border-color: #242424; box-shadow: none; }
  }

  /* SVG de la lupa: RGB split doble con drop-shadow (el equivalente
     a text-shadow pero para SVG), alternando dirección. El color
     base del ícono se mantiene en #ddd para no parpadear. */
  @keyframes searchIconGlitch {
    0%   { color: #ddd; filter: drop-shadow(3px 0 #ff0055) drop-shadow(-3px 0 #00fff0); }
    15%  { color: #ddd; filter: drop-shadow(-3px 0 #ff0055) drop-shadow(3px 0 #00fff0); }
    30%  { color: #ddd; filter: drop-shadow(2px 0 #ff0055) drop-shadow(-2px 0 #00fff0); }
    50%  { color: #ddd; filter: drop-shadow(-2px 0 #ff0055) drop-shadow(2px 0 #00fff0); }
    70%  { color: #ddd; filter: drop-shadow(3px 0 #ff0055) drop-shadow(-3px 0 #00fff0); }
    85%  { color: #ddd; filter: none; }
    100% { color: #ddd; filter: none; }
  }

  @keyframes searchPanelIn {
    0%   { opacity: 0; transform: scale(0.94); filter: blur(6px); }
    100% { opacity: 1; transform: scale(1);    filter: blur(0); }
  }

