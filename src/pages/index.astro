/* (los @keyframes flashPriceGreen/Red fueron reemplazados por las
   versiones "Soft" que están más abajo. Se eliminaron por limpieza.) */

  /* --------------------------- */
  /* NÚMEROS QUE RUEDAN (odómetro) */
  /* --------------------------- */

  /* El precio se renderiza como una serie de spans, uno por carácter
     (incluyendo el "$", el punto y los dígitos). Cada span tiene
     position: relative y overflow: hidden para que el dígito "que
     sale" y el "que entra" no se salgan del contenedor. Los spans
     que no cambian de valor no se tocan. */
  :global(.price-digit) {
    display: inline-block;
    position: relative;
    overflow: hidden;
    vertical-align: bottom;
    /* Altura fija (1.15em, igual al line-height del padre) para que
       el bloque no cambie de alto durante la animación de los dígitos
       (el "digit-out" está en absolute, y sin altura fija el span
       colapsaría al alto del "digit-in" en cada frame). */
    line-height: 1.15;
    height: 1.15em;
  }

  /* El dígito "viejo" sale hacia arriba y se desvanece. */
  :global(.price-digit .digit-out) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    animation: priceDigitOut 0.32s cubic-bezier(0.4, 0, 0.2, 1) both;
    pointer-events: none;
  }

  /* El dígito "nuevo" entra desde abajo. */
  :global(.price-digit .digit-in) {
    display: inline-block;
    animation: priceDigitIn 0.32s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  @keyframes priceDigitOut {
    from { transform: translateY(0);     opacity: 1; }
    to   { transform: translateY(-100%); opacity: 0; }
  }

  @keyframes priceDigitIn {
    from { transform: translateY(100%);  opacity: 0; }
    to   { transform: translateY(0);     opacity: 1; }
  }

  /* El contenedor del precio (con las animaciones) necesita un
     flash breve de fondo para reforzar el cambio. Es un flash
     MUY sutil (verde o rojo al 15%), mucho más discreto que los
     flashes anteriores. Solo aplica al contenedor padre. */
  :global(.modal-price-unit) {
    /* inline-block en vez de inline-flex: se comporta como un texto
       más dentro del flex del .modal-price-main, sin afectar el
       cálculo de altura del bloque padre. */
    display: inline-block;
    white-space: nowrap;
    padding: 2px 6px;
    margin-left: -6px;
    border-radius: 6px;
    transition: background 0.4s ease;
    /* Altura estable y line-height igual al de los dígitos. */
    line-height: 1.15;
    vertical-align: bottom;
  }

  :global(.modal-price-unit.flash-green) {
    animation: flashPriceGreenSoft 0.6s ease-out;
  }

  :global(.modal-price-unit.flash-red) {
    animation: flashPriceRedSoft 0.6s ease-out;
  }

  @keyframes flashPriceGreenSoft {
    0%   { background: rgba(37, 211, 102, 0.18); }
    100% { background: transparent; }
  }

  @keyframes flashPriceRedSoft {
    0%   { background: rgba(248, 113, 113, 0.18); }
    100% { background: transparent; }
  }

  /* --------------------------- */
  /* BARRA DE PROGRESO DE SCROLL */
  /* --------------------------- */

  /* Línea fina arriba de todo, de izquierda a derecha, que se llena
     con el scroll. Gradiente con los colores del glitch para
     mantener la identidad KRAKOA. */
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, #ff0055 0%, #00fff0 100%);
    z-index: 9500;
    pointer-events: none;
    /* Sin transition: el ancho lo actualiza el JS en cada frame de
       scroll. Una transition acá produciría lag (la barra iría
       "persiguiendo" al scroll). */
    will-change: width;
  }

  /* --------------------------- */
  /* TEXTURA DE GRANO (NOISE)    */
  /* --------------------------- */

  /* Grano sutil sobre todo el sitio, generado con feTurbulence de SVG.
     Es un pseudo-elemento del body con position: fixed, así cubre el
     viewport sin scrollear. Queda por ENCIMA del contenido estático y
     del hero, pero por DEBAJO de la barra sticky de categorías (100),
     back-to-top (900) y los overlays (1000+). Así los modales, el
     carrito y el zoom se ven nítidos, sin grano encima.

     La opacidad es MUY baja (0.045). Si te parece mucho o poco, se
     ajusta ese único valor.

     El SVG es un data URI con feTurbulence (fractalNoise) de 200x200
     que se tilea con background-repeat. El "%23" es el "#" codificado
     para no romper el data URI.

     Ojo con performance: feTurbulence puede ser costoso en mobile de
     gama muy baja. En la auditoría de performance que tenemos
     pendiente, si vemos lag, lo cambiamos por un PNG estático o lo
     reducimos. */
    :global(body)::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0.045;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='200' height='200' filter='url(%23n)'/></svg>");
    background-repeat: repeat;
  }

  /* --------------------------- */
  /* GLITCH OCASIONAL DEL LOGO   */
  /* --------------------------- */

  /* Cada 30-60s, el logo horizontal del header hace un glitch breve
     (220ms) de tipo "color shift + shake": se desplaza horizontal,
     cambia el tono con hue-rotate, y vuelve. Es MUCHO menos
     frecuente que el glitch del hero (que cada 5-9s), así que no
     compite con él y se siente como "un detalle ocasional".

     Todo con :global() porque el logo vive en el <header> (fuera de
     <main>) y la clase .glitching la maneja el JS. */
  :global(.logo-horizontal.glitching) {
    animation: logoGlitch 0.42s steps(9, end) 1;
    will-change: transform, filter, clip-path;
  }

  /* Glitch unificado con la técnica del hero: clip-path con tiras y
     bloques (inset de 4 lados), flips (scaleX/scaleY), RGB split
     dinámico (drop-shadow magenta/cian, que es el equivalente a
     text-shadow pero funciona en imágenes y bordes), y steps() para
     los saltos digitales.
     Misma duración (420ms) y misma cantidad de pasos (9) que el hero,
     para que se sienta como la misma familia visual. */
  @keyframes logoGlitch {
    0%   { clip-path: inset(10% 0 80% 0);     transform: translate(-2px, 0);           filter: drop-shadow(4px 0 #ff0055) drop-shadow(-4px 0 #00fff0) drop-shadow(0 0 8px #ff0055); }
    11%  { clip-path: inset(60% 0 10% 0);     transform: translate(3px, 0);            filter: drop-shadow(-5px 0 #ff0055) drop-shadow(5px 0 #00fff0) drop-shadow(0 0 8px #00fff0); }
    22%  { clip-path: inset(30% 55% 55% 10%); transform: translate(-2px, 0) scaleY(-1); filter: drop-shadow(4px 0 #ff0055) drop-shadow(-4px 0 #00fff0) drop-shadow(0 0 10px #ff0055); }
    33%  { clip-path: inset(80% 0 5% 0);      transform: translate(4px, 0);            filter: drop-shadow(-6px 0 #ff0055) drop-shadow(6px 0 #00fff0) drop-shadow(0 0 10px #00fff0); }
    44%  { clip-path: inset(20% 30% 60% 25%); transform: translate(-3px, 0) scaleX(-1); filter: drop-shadow(5px 0 #ff0055) drop-shadow(-5px 0 #00fff0) drop-shadow(0 0 12px #ff0055); }
    55%  { clip-path: inset(45% 0 40% 0);     transform: translate(2px, 0);            filter: drop-shadow(-4px 0 #ff0055) drop-shadow(4px 0 #00fff0) drop-shadow(0 0 8px #00fff0); }
    66%  { clip-path: inset(70% 45% 15% 0);   transform: translate(-3px, 0);           filter: drop-shadow(5px 0 #ff0055) drop-shadow(-5px 0 #00fff0) drop-shadow(0 0 10px #ff0055); }
    77%  { clip-path: inset(5% 0 85% 0);      transform: translate(1px, 0) scaleX(-1); filter: drop-shadow(-4px 0 #ff0055) drop-shadow(4px 0 #00fff0) drop-shadow(0 0 8px #00fff0); }
    88%  { clip-path: inset(40% 20% 35% 30%); transform: translate(-3px, 0);           filter: drop-shadow(3px 0 #ff0055) drop-shadow(-3px 0 #00fff0) drop-shadow(0 0 6px #ff0055); }
    100% { clip-path: inset(10% 0 80% 0);     transform: translate(0, 0);              filter: none; }
  }

  /* --------------------------- */
  /* MARQUESINA: HOVER PAUSE + AMARILLO KRA */
  /* --------------------------- */

  /* Al pasar el mouse por un ítem de la marquesina:
     1) La cinta entera se PAUSA (animation-play-state: paused).
     2) El texto del ítem sobre el que está el mouse se pone en
        amarillo KRA (#ffd655), destacándolo como "lectura activa".
     Solo en desktop (pointer: fine) para no dejar el hover pegado
     en mobile. */
  @media (hover: hover) and (pointer: fine) {
    :global(.marquee:hover) .marquee-track {
      animation-play-state: paused;
    }

    :global(.marquee-item:hover) {
      color: #ffd655;
      transition: color 0.2s ease;
    }
  }

  /* --------------------------- */
  /* REVEAL POR LETRA DEL HERO   */
  /* --------------------------- */

  /* Al cargar la página (después del loader), las letras de "CATALOGO"
     aparecen una por una con fade + slide up. El JS arma los spans
     con un `animation-delay` escalonado (45ms por letra).
     Al terminar, restaura el HTML normal, y el typewriter y el glitch
     siguen funcionando como siempre. */
  :global(.hero-reveal-letter) {
    display: inline-block;
    opacity: 0;
    transform: translateY(20px) scale(0.85);
    animation: heroRevealLetter 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    will-change: opacity, transform;
  }

  @keyframes heroRevealLetter {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* --------------------------- */
  /* GLITCH DEL LOADER INICIAL   */
  /* --------------------------- */

  /* El isotipo del loader hace un glitch breve (420ms) después de
     aparecer con fade. Reusa el keyframe `logoGlitch` que ya está
     declarado globalmente. Le da un "arranque" narrativo al sitio:
     primero aparece el logo, después parpadea, después se revela
     el hero con las letras apareciendo. */
  :global(#krakoa-loader img.glitching) {
    animation: logoGlitch 0.42s steps(9, end) 1;
    will-change: transform, filter, clip-path;
  }

</style>

<button
  id="back-to-top"
  class="back-to-top"
  type="button"
  aria-label="Volver arriba"
>
  <svg class="back-to-top-ring" viewBox="0 0 44 44" aria-hidden="true">
    <circle class="back-to-top-ring-track" cx="22" cy="22" r="19" />
    <circle id="back-to-top-ring-progress" class="back-to-top-ring-progress" cx="22" cy="22" r="19" />
  </svg>
  <span class="back-to-top-icon" aria-hidden="true">↑</span>
</button>

<script define:vars={{ base, PROMO_DATA: promo }}>

  // Loader de carga inicial
  (() => {
    const loader = document.querySelector("#krakoa-loader");
    if (!loader) return;
    const img = loader.querySelector("img");
    // Bajamos el MIN_TIME de 1000 a 300. Con 300ms el glitch
    // del isotipo alcanza a verse un instante, pero el usuario
    // pasa al hero mucho más rápido.
    const MIN_TIME = 300;
    const startTime = Date.now();
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    // Intervalo del glitch periódico. Se guarda para poder limpiarlo
    // cuando el loader se va (si no, sigue corriendo sobre un elemento
    // que ya fue removido del DOM).
    let loaderGlitchInterval = null;

    function triggerLoaderGlitch() {
      if (img.classList.contains("glitching")) return;
      img.classList.add("glitching");
      setTimeout(() => img.classList.remove("glitching"), 420);
    }

    // Esperamos 2 frames para que el navegador pinte, y mostramos el logo
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        img.style.opacity = "1";

        if (prefersReducedMotion) return;

        // Primer glitch a los 600ms (después del fade in).
        setTimeout(triggerLoaderGlitch, 600);

        // Glitch periódico cada 2.5s, mientras el loader esté visible.
        // Así, si la carga tarda 8 segundos, el usuario ve ~3 glitches
        // en vez de uno solo.
        loaderGlitchInterval = setInterval(triggerLoaderGlitch, 2500);
      });
    });

    const hide = () => {
      const elapsed = Date.now() - startTime;
      const wait = Math.max(0, MIN_TIME - elapsed);
      setTimeout(() => {
        // Frenamos el glitch periódico antes de sacar el loader.
        if (loaderGlitchInterval) {
          clearInterval(loaderGlitchInterval);
          loaderGlitchInterval = null;
        }

        loader.style.opacity = "0";
        loader.style.pointerEvents = "none";

        // Avisamos que el loader se está yendo, para que otros efectos
        // (como el reveal por letra del hero) puedan arrancar.
        document.dispatchEvent(new CustomEvent("krakoa:loaded"));

        setTimeout(() => loader.remove(), 500);
      }, wait);
    };

    // Estrategia nueva: esperar DOMContentLoaded (HTML+CSS listos)
    // y NO window.load (que espera a todas las imágenes, incluyendo
    // las lazy del catálogo, y al script de Clarity).
    //
    // Además, un "race" con un timeout de 1500ms: si por alguna razón
    // DOMContentLoaded tarda (por un script externo lento), ocultamos
    // el loader igual. Así el usuario NUNCA queda mirando una pantalla
    // negra por más de 1.5s.
    //
    // El MIN_TIME de 1000ms se sigue respetando: así el glitch del
    // isotipo se ve completo antes de que el loader se vaya.
    let hideScheduled = false;

    function scheduleHide() {
      if (hideScheduled) return;
      hideScheduled = true;
      hide();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", scheduleHide, { once: true });
    } else {
      scheduleHide();
    }

    // Red de seguridad: a los 1.5s, ocultar sí o sí.
    setTimeout(scheduleHide, 1500);
  })();

  // -------------------------
  // PROMO POPUP
  // -------------------------
  // La config viene del JSON generado por el script (src/data/promo.json).
  // Necesitamos pasarla al cliente porque el script de Astro corre
  // después del render. Usamos un objeto global.
  window.KRAKOA_PROMO = PROMO_DATA;

  // Exponemos closePromoModalDirect para que closeTopOverlay() la use.
  window.KRAKOA_CLOSE_PROMO = null;

  (() => {
    const promoModal = document.querySelector("#promo-modal");
    if (!promoModal) return; // no hay promo configurada

    const promoData = window.KRAKOA_PROMO;
    if (!promoData || !promoData.activa) return;
    if (!promoData.imagenes || promoData.imagenes.length === 0) return;

    const promoImages = promoModal.querySelectorAll(".promo-image-el");
    const promoThumbs = promoModal.querySelectorAll(".promo-thumb");
    const promoPrev = promoModal.querySelector("#promo-prev");
    const promoNext = promoModal.querySelector("#promo-next");
    const promoClose = promoModal.querySelector("#promo-close");
    const promoDontShow = promoModal.querySelector("#promo-dont-show");
    const promoBackdrop = promoModal.querySelector(".promo-backdrop");

    const STORAGE_KEY_DONT_SHOW = "krakoa_promo_dont_show";
    const STORAGE_KEY_SESSION = "krakoa_promo_session_closed";

    let promoIndex = 0;
    let autoRotateTimer = null;
    let autoRotateActive = true;

    // ¿Debemos mostrar la promo?
    function shouldShowPromo() {
      // 1) Si el usuario la cerró en ESTA sesión (con la ×), no mostrar.
      if (sessionStorage.getItem(STORAGE_KEY_SESSION) === "1") {
        return false;
      }

      // 2) Si el usuario tocó "No mostrar de nuevo", chequeamos:
      //    - Si el hash de la promo cambió → mostrar (es una promo nueva).
      //    - Si pasaron más de X horas → mostrar.
      try {
        const raw = localStorage.getItem(STORAGE_KEY_DONT_SHOW);
        if (!raw) return true;

        const saved = JSON.parse(raw);
        const currentHash = promoData.hash;

        if (saved.hash && saved.hash !== currentHash) {
          // La promo cambió → mostrar.
          return true;
        }

        const hoursPassed = (Date.now() - saved.timestamp) / (1000 * 60 * 60);
        const limit = promoData.config.noMostrarDuracionHoras || 24;

        return hoursPassed >= limit;
      } catch (error) {
        return true;
      }
    }

    function renderPromoImage(index) {
      promoIndex = index;
      promoImages.forEach((img, i) => {
        img.classList.toggle("active", i === index);
      });
      promoThumbs.forEach((thumb, i) => {
        thumb.classList.toggle("active", i === index);
      });
    }

    function stopAutoRotate() {
      if (autoRotateTimer) {
        clearInterval(autoRotateTimer);
        autoRotateTimer = null;
      }
      autoRotateActive = false;
    }

    function startAutoRotate() {
      // Solo si hay más de 1 imagen y no fue detenido por el usuario.
      if (promoImages.length < 2) return;
      if (!autoRotateActive) return;
      if (autoRotateTimer) return;

      const seconds = promoData.config.autoRotateSegundos || 5;
      autoRotateTimer = setInterval(() => {
        const nextIndex = (promoIndex + 1) % promoImages.length;
        renderPromoImage(nextIndex);
      }, seconds * 1000);
    }

    let promoCloseTimer = null;

    function openPromoModal() {
      if (promoModal.classList.contains("open")) return;
      if (promoModal.getAttribute("aria-hidden") === "false") return;

      // Si había un cierre en curso (CRT close), lo cancelamos.
      if (promoCloseTimer) {
        clearTimeout(promoCloseTimer);
        promoCloseTimer = null;
      }
      promoModal.classList.remove("is-closing");

      promoModal.setAttribute("aria-hidden", "false");

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          promoModal.classList.add("open");
        });
      });

      pushHistory("promo");
      startAutoRotate();
    }

    function closePromoModal() {
      if (isTopOfHistory("promo")) {
        popHistory();
        return;
      }
      closePromoModalDirect();
    }

    function closePromoModalDirect() {
      if (promoModal.getAttribute("aria-hidden") === "true") return;
      if (promoCloseTimer) {
        clearTimeout(promoCloseTimer);
        promoCloseTimer = null;
      }

      // Disparamos el CRT close.
      promoModal.classList.remove("open");
      promoModal.classList.add("is-closing");
      promoModal.setAttribute("aria-hidden", "true");
      stopAutoRotate();

      // Limpiamos .is-closing después de la animación (380ms) para
      // que el contenedor vuelva a quedar oculto del todo.
      promoCloseTimer = setTimeout(() => {
        promoModal.classList.remove("is-closing");
        promoCloseTimer = null;
      }, 380);
    }

    // Exponemos la función para que closeTopOverlay() la use cuando
    // el usuario toca el botón "atrás" del celular.
    window.KRAKOA_CLOSE_PROMO = closePromoModalDirect;

    // Marcamos la sesión como "ya cerrada" (solo si no fue "no mostrar").
    function markSessionClosed() {
      try {
        sessionStorage.setItem(STORAGE_KEY_SESSION, "1");
      } catch (error) {}
    }

    // Guardamos el "no mostrar de nuevo".
    function markDontShow() {
      try {
        localStorage.setItem(
          STORAGE_KEY_DONT_SHOW,
          JSON.stringify({
            hash: promoData.hash,
            timestamp: Date.now(),
          })
        );
      } catch (error) {}
    }

    // Listeners
    promoClose?.addEventListener("click", () => {
      markSessionClosed();
      closePromoModal();
    });

    promoBackdrop?.addEventListener("click", () => {
      markSessionClosed();
      closePromoModal();
    });

    promoDontShow?.addEventListener("click", () => {
      markDontShow();
      markSessionClosed();
      closePromoModal();
    });

    promoPrev?.addEventListener("click", () => {
      stopAutoRotate();
      const prev =
        (promoIndex - 1 + promoImages.length) % promoImages.length;
      renderPromoImage(prev);
    });

    promoNext?.addEventListener("click", () => {
      stopAutoRotate();
      const next = (promoIndex + 1) % promoImages.length;
      renderPromoImage(next);
    });

    promoThumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        stopAutoRotate();
        const index = parseInt(thumb.getAttribute("data-index") || "0", 10);
        renderPromoImage(index);
      });
    });

    // Escape cierra la promo.
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (promoModal.getAttribute("aria-hidden") === "false") {
        event.stopImmediatePropagation();
        markSessionClosed();
        closePromoModal();
      }
    });

    // Swipe en mobile sobre la imagen.
    let promoTouchStartX = 0;
    promoModal.addEventListener(
      "touchstart",
      (event) => {
        promoTouchStartX = event.changedTouches[0].screenX;
      },
      { passive: true }
    );
    promoModal.addEventListener(
      "touchend",
      (event) => {
        const dx = event.changedTouches[0].screenX - promoTouchStartX;
        if (Math.abs(dx) < 50) return;
        stopAutoRotate();
        if (dx < 0) {
          renderPromoImage((promoIndex + 1) % promoImages.length);
        } else {
          renderPromoImage(
            (promoIndex - 1 + promoImages.length) % promoImages.length
          );
        }
      },
      { passive: true }
    );

    // Abrimos la promo a los 2 segundos, solo si corresponde.
    if (shouldShowPromo()) {
      setTimeout(() => {
        try {
          openPromoModal();
        } catch (error) {
          console.error("[KRAKOA] Error abriendo promo:", error);
        }
      }, 2000);
    }
  })();

  const searchInput = document.querySelector("#search");

  // -------------------------
  // BUSCADOR EN EL HEADER
  // -------------------------
  // En mobile, el header se transforma en "input + ×" al tocar la lupa.
  // En desktop no hay transformación: el input está siempre visible.
  const siteHeader = document.querySelector(".site-header");
  const searchToggle = document.querySelector("#search-toggle");
  const searchClose = document.querySelector("#search-close");

  function triggerSearchGlitch() {
    if (!siteHeader) return;
    const panel = document.querySelector("#header-search-panel");
    searchToggle?.classList.add("search-switching");
    panel?.classList.add("search-switching");
    // 420ms = 400ms de la nueva animación + 20ms de margen (antes
    // era 340ms, cuando la animación duraba 320ms).
    setTimeout(() => {
      searchToggle?.classList.remove("search-switching");
      panel?.classList.remove("search-switching");
    }, 420);
  }

  function openSearch() {
    triggerSearchGlitch();
    siteHeader?.classList.add("search-open");
    // Foco después de que el navegador pinte el input (para que se abra
    // el teclado en mobile).
    requestAnimationFrame(() => {
      searchInput?.focus();
    });
  }

  function closeSearch() {
    triggerSearchGlitch();
    siteHeader?.classList.remove("search-open");
    searchInput?.blur();
    // Al cerrar en mobile, limpiamos la búsqueda y restauramos el catálogo.
    // Si no, el usuario quedaría con un filtro invisible aplicado.
    if (searchInput && searchInput.value !== "") {
      searchInput.value = "";
      filterProducts();
    }
  }

  searchToggle?.addEventListener("click", openSearch);
  searchClose?.addEventListener("click", closeSearch);

  // En desktop, al hacer focus en el input (click para escribir),
  // disparamos el mismo glitch del header. En mobile NO, porque
  // openSearch ya lo dispara y el focus automático duplicaría el efecto.
  searchInput?.addEventListener("focus", () => {
    if (window.matchMedia("(min-width: 701px)").matches) {
      triggerSearchGlitch();
    }
  });

  // -------------------------
  // ALEATORIZAR EL CATÁLOGO
  // -------------------------
  // Mezcla round-robin aleatoria: mantiene variedad de categorías
  // (no todos los de anime juntos) pero cambia el orden en cada visita.
  // Se hace ANTES de que el hero lea las imágenes, así el hero también
  // agarra un set distinto cada vez.
  (() => {
    const productsGrid = document.querySelector("#products");
    if (!productsGrid) return;

    const cards = Array.from(productsGrid.querySelectorAll(".product-card"));
    if (cards.length < 2) return;

    // Agrupamos por categoría.
    const byCategory = new Map();
    cards.forEach((card) => {
      const cat = card.dataset.category || "otros";
      if (!byCategory.has(cat)) byCategory.set(cat, []);
      byCategory.get(cat).push(card);
    });

    // Fisher-Yates shuffle para mezclar un array in-place.
    function shuffle(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    // Mezclamos cada categoría internamente.
    const groups = Array.from(byCategory.values());
    groups.forEach((group) => shuffle(group));

    // También mezclamos el orden de las categorías, para que no arranque
    // siempre con la misma.
    shuffle(groups);

    // Armamos el orden final con round-robin: uno de cada categoría,
    // rotando, hasta agotar todas.
    const ordered = [];
    let maxLen = Math.max(...groups.map((g) => g.length));
    for (let i = 0; i < maxLen; i++) {
      groups.forEach((group) => {
        if (group[i]) ordered.push(group[i]);
      });
    }

    // Reinsertamos en el DOM en el orden nuevo. DocumentFragment evita
    // reflows intermedios (mucho más rápido con 99 productos).
    const fragment = document.createDocumentFragment();
    ordered.forEach((card) => fragment.appendChild(card));
    productsGrid.appendChild(fragment);

    // Guardamos el orden aleatorio para poder restaurarlo cuando el
    // usuario saque el filtro de categoría.
    window.__krakoaRandomOrder = ordered.slice();

    // Exponemos una función para reordenar el DOM según un criterio.
    // La usa filterProducts cuando hay categoría activa (orden alfabético).
    window.__krakoaReorderProducts = (mode) => {
      const grid = document.querySelector("#products");
      if (!grid) return;

      let newOrder;
      if (mode === "alpha") {
        // Orden alfabético por data-name (que ya está en minúsculas).
        newOrder = Array.from(grid.querySelectorAll(".product-card")).sort(
          (a, b) =>
            (a.dataset.name || "").localeCompare(b.dataset.name || "", "es")
        );
      } else {
        // Restaurar el orden aleatorio original.
        newOrder = window.__krakoaRandomOrder || [];
        if (newOrder.length === 0) return;
      }

          const frag = document.createDocumentFragment();
    newOrder.forEach((card) => frag.appendChild(card));
    grid.appendChild(frag);
    };
  })();

  // -------------------------
  // SKELETON LOADER DEL CATÁLOGO
  // -------------------------
  // Mientras cada imagen base (.product-image-base) se está cargando,
  // el contenedor .product-image no tiene .loaded y el CSS muestra
  // el shimmer. Cuando la imagen termina de cargar, agregamos .loaded
  // y el shimmer se desvanece.
  // Hay que manejar dos casos:
  //   1) La imagen ya cargó antes de correr este código (cache, o ya
  //      estaba en viewport al recargar). Se detecta con img.complete.
  //   2) La imagen todavía está cargando (loading=lazy). Se detecta
  //      con el evento 'load'.
  (() => {
    const cards = document.querySelectorAll(".product-image");
    cards.forEach((container) => {
      const img = container.querySelector(".product-image-base");
      if (!img) {
        // Sin imagen base no tiene sentido el skeleton.
        container.classList.add("loaded");
        return;
      }

      // Caso 1: ya cargó (o está en cache).
      if (img.complete && img.naturalWidth > 0) {
        container.classList.add("loaded");
        return;
      }

      // Caso 2: todavía cargando. Escuchamos el load.
      img.addEventListener(
        "load",
        () => container.classList.add("loaded"),
        { once: true }
      );

      // Si por algún motivo la imagen falla, sacamos el skeleton igual
      // para no dejar un shimmer eterno.
      img.addEventListener(
        "error",
        () => container.classList.add("loaded"),
        { once: true }
      );
    });
  })();

  const tintLayers = [
