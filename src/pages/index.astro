  // -------------------------
  // HISTORY STACK (botón atrás)
  // -------------------------

  // Pila de "acciones" que el usuario hizo y que pueden deshacerse con
  // el botón atrás del navegador. Cada entry tiene:
  //   - kind: el tipo ("modal", "cart", "image-zoom", "mobile-menu",
  //     "promo", "category").
  //   - state: datos extra para poder deshacer (ej: para "category",
  //     el previousCategory).
  // El último es el que está arriba de todo. Cuando el usuario toca
  // "atrás", sacamos el último y deshacemos esa acción.
  let historyStack = [];

  // ¿La acción "kind" es la que está arriba de todo?
  function isTopOfHistory(kind) {
    return (
      historyStack.length > 0 &&
      historyStack[historyStack.length - 1].kind === kind
    );
  }

  // Empuja una acción a la pila y al historial del navegador.
  // state es opcional: guarda datos para poder restaurar después.
  function pushHistory(kind, state = {}) {
    history.pushState({ krakoaOverlay: kind, ...state }, "");
    historyStack.push({ kind, state });
  }

