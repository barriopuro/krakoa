 .hero {
  position: relative;
  padding: 80px 0 60px;
  overflow: hidden;
  background: #141414;
  left: 50%;
  width: 100vw;
  transform: translateX(-50%);
}

.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

  :global(.hero-bg img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.4s ease, transform 9s ease-out;
    transform: scale(1.02) translateX(-1.5%);
  }

      :global(.hero-bg img.active) {
    opacity: 0.32;
    transform: scale(1.1) translateX(1.5%);
     will-change: opacity, transform;

  }

  :global(.hero-bg img:nth-child(even)) {
    transform: scale(1.02) translateX(1.5%);
  }

  :global(.hero-bg img:nth-child(even).active) {
    opacity: 0.32;
    transform: scale(1.1) translateX(-1.5%);
  }

  :global(.hero-bg img:nth-child(even).active) {
    animation: heroZoomRight 9s ease-out forwards;
  }

 

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(11, 11, 11, 0.15) 0%,
    rgba(11, 11, 11, 0.6) 100%
  );
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 2;
  width: min(1400px, 90vw);
  margin: 0 auto;
}

.marquee {
  margin: 0px 0 0px;
  padding: 16px 0;
  overflow: hidden;
  background: #0d0d0d;
  border-radius: 12px;
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
          mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
}

.marquee-track {
  display: flex;
  align-items: center;
  width: max-content;
  animation: marqueeScroll 45s linear infinite;
}

.marquee-item {
  display: inline-flex;
  align-items: center;
  gap: 24px;
  padding-right: 24px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #888;
  white-space: nowrap;
}

.marquee-sep {
  font-style: normal;
  color: #444;
}

@keyframes marqueeScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

  .eyebrow {
    margin: 0 0 18px;
    font-size: 12px;
    letter-spacing: 0.18em;
    color: #888;
  }

  h1 {
    margin: 0;
    font-size: clamp(48px, 9vw, 120px);
    line-height: 0.88;
    letter-spacing: -0.065em;
    font-weight: 900;
    /* Fijamos la altura para que el h1 mida lo mismo con Arial o con
       KrakoaFont (que tiene métricas distintas y expande el line-box
       cuando el typewriter switchea). overflow: visible (default) deja
       que los text-shadow y glitch se vean aunque se salgan del box. */
    height: calc(clamp(48px, 9vw, 120px) * 0.88);
  }

   /* --------------------------- */
  /* GLITCH DEL TÍTULO DEL HERO  */
  /* --------------------------- */

  h1 {
    position: relative;
  }

  /* Los glitches ahora son spans REALES (no pseudo-elementos). El JS les
     setea textContent directo, sin attr() en content. */
  :global(.hero-glitch-a),
  :global(.hero-glitch-b) {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
    opacity: 0;
    white-space: nowrap;
    z-index: 2;
  }

  :global(.hero-glitch-a) {
    color: #ff0055;
    text-shadow: 1px 0 rgba(255, 0, 85, 0.7);
  }

  /* Las primeras 3 letras de KRAKOA van en amarillo mientras el
     typewriter está mostrando ese estado. Lo crea el JS → :global(). */
  :global(.hero-kra) {
    color: #ffd655;
  }

  /* Cuando el typewriter muestra KRAKOA (o un prefijo de KRAKOA),
     el h1 recibe la clase .is-krakoa y con ella la fuente custom. */
    :global(h1.is-krakoa) {
    font-family: "KrakoaFont", Arial, Helvetica, sans-serif;
    /* Payback solo existe en un peso (400). Forzamos font-weight
       normal para que el browser NO sintetice bold artificial (faux
       bold), que la engrosaba de más. */
    font-weight: normal;
    /* Payback no necesita el tracking negativo que sí pide Arial.
       Lo subimos a 0.02em para que respire sin desarmar el ritmo. */
    letter-spacing: 0.00em;
  }

  /* "KRAKOA" en el título de "Cómo Comprar". Misma fuente que el hero,
     sin amarillo, para reforzar marca sin robarle protagonismo. */
  :global(.brand-inline) {
    font-family: "KrakoaFont", Arial, Helvetica, sans-serif;
    font-weight: normal;
    letter-spacing: 0.00em;
  }

  :global(.hero-glitch-b) {
    color: #00fff0;
    text-shadow: -1px 0 rgba(0, 255, 240, 0.7);
  }

  :global(h1.glitching) :global(.hero-glitch-a) {
  opacity: 1;
  animation: glitchSlicesA 0.42s steps(9, end) 1,
             glitchFlickerA 0.42s steps(5, end) 1;
}

:global(h1.glitching) :global(.hero-glitch-b) {
  opacity: 1;
  animation: glitchSlicesB 0.42s steps(9, end) 1,
             glitchFlickerB 0.42s steps(5, end) 1;
}

  /* Glitch mejorado: 10 fotogramas con mezcla de tiras horizontales
     (inset top/bottom) y bloques recortados (inset top/right/bottom/left)
     para simular datamoshing. El text-shadow también se anima →
     RGB split dinámico. steps(9) hace los saltos digitales. */
  @keyframes glitchSlicesA {
    0%   { clip-path: inset(10% 0 80% 0);     transform: translate(-8px, 0);  text-shadow: 4px 0 rgba(255, 0, 85, 1); }
    11%  { clip-path: inset(60% 0 10% 0);     transform: translate(10px, 0);  text-shadow: -6px 0 rgba(255, 0, 85, 1); }
    22%  { clip-path: inset(30% 55% 55% 10%); transform: translate(-6px, 0);  text-shadow: 4px 0 rgba(255, 0, 85, 1); }
    33%  { clip-path: inset(80% 0 5% 0);      transform: translate(12px, 0);  text-shadow: -8px 0 rgba(255, 0, 85, 1); }
    44%  { clip-path: inset(20% 30% 60% 25%); transform: translate(-10px, 0) scaleY(-1); text-shadow: 6px 0 rgba(255, 0, 85, 1); }
    55%  { clip-path: inset(45% 0 40% 0);     transform: translate(6px, 0);   text-shadow: -4px 0 rgba(255, 0, 85, 1); }
    66%  { clip-path: inset(70% 45% 15% 0);   transform: translate(-8px, 0);  text-shadow: 8px 0 rgba(255, 0, 85, 1); }
    77%  { clip-path: inset(5% 0 85% 0);      transform: translate(4px, 0) scaleX(-1); text-shadow: -6px 0 rgba(255, 0, 85, 1); }
    88%  { clip-path: inset(40% 20% 35% 30%); transform: translate(-10px, 0); text-shadow: 5px 0 rgba(255, 0, 85, 1); }
    100% { clip-path: inset(10% 0 80% 0);     transform: translate(0, 0);     text-shadow: 3px 0 rgba(255, 0, 85, 0.9); }
  }

  @keyframes glitchSlicesB {
    0%   { clip-path: inset(55% 0 25% 0);     transform: translate(8px, 0);   text-shadow: -4px 0 rgba(0, 255, 240, 1); }
    11%  { clip-path: inset(15% 0 65% 0);     transform: translate(-10px, 0); text-shadow: 6px 0 rgba(0, 255, 240, 1); }
    22%  { clip-path: inset(75% 30% 10% 0);   transform: translate(6px, 0);   text-shadow: -4px 0 rgba(0, 255, 240, 1); }
    33%  { clip-path: inset(25% 0 60% 0);     transform: translate(-12px, 0) scaleX(-1); text-shadow: 8px 0 rgba(0, 255, 240, 1); }
    44%  { clip-path: inset(40% 15% 50% 35%); transform: translate(10px, 0);  text-shadow: -6px 0 rgba(0, 255, 240, 1); }
    55%  { clip-path: inset(85% 0 5% 0);      transform: translate(-6px, 0);  text-shadow: 4px 0 rgba(0, 255, 240, 1); }
    66%  { clip-path: inset(35% 0 45% 0);     transform: translate(8px, 0) scaleY(-1); text-shadow: -8px 0 rgba(0, 255, 240, 1); }
    77%  { clip-path: inset(50% 40% 40% 0);   transform: translate(-4px, 0);  text-shadow: 6px 0 rgba(0, 255, 240, 1); }
    88%  { clip-path: inset(20% 25% 55% 20%); transform: translate(10px, 0);  text-shadow: -5px 0 rgba(0, 255, 240, 1); }
    100% { clip-path: inset(55% 0 25% 0);     transform: translate(0, 0);     text-shadow: -3px 0 rgba(0, 255, 240, 0.9); }
  }

  @keyframes glitchFlickerA {
    0%   { opacity: 1; }
    20%  { opacity: 0.35; }
    40%  { opacity: 1; }
    60%  { opacity: 0.45; }
    80%  { opacity: 1; }
    100% { opacity: 1; }
  }

  @keyframes glitchFlickerB {
    0%   { opacity: 1; }
    20%  { opacity: 0.55; }
    40%  { opacity: 0.3; }
    60%  { opacity: 1; }
    80%  { opacity: 1; }
    100% { opacity: 1; }
  }

  @keyframes glitchBaseShift {
    0%   { transform: translate(0, 0); }
    25%  { transform: translate(-2px, 0); }
    50%  { transform: translate(2px, 1px); }
    75%  { transform: translate(-1px, -1px); }
    100% { transform: translate(0, 0); }
  }

  /* Cursor tipo terminal: el punto final del título titila.
     Forzamos Arial para que el "_" no herede KrakoaFont (que puede
     no tener ese glifo, o tenerlo con un ancho raro). */
  :global(.hero-cursor) {
    display: inline;
    animation: cursorBlink 1s step-end infinite;
    font-family: Arial, Helvetica, sans-serif;
  }

  @keyframes cursorBlink {
    0%   { opacity: 1; }
    50%  { opacity: 0; }
    100% { opacity: 1; }
  }

