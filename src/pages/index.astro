    :global(.back-to-top) {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 900;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(40, 40, 40, 0.9);
    color: white;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  :global(.back-to-top.visible) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

    :global(.back-to-top:hover) {
    background: #555;
  }

  /* Anillo de progreso alrededor del botón "volver arriba".
     El SVG gira -90° para que el trazo arranque desde las 12 en punto
     (por defecto arranca a las 3). El track es la pista gris, el
     progress es el trazo cian que se llena con el scroll. */
  :global(.back-to-top-ring) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    pointer-events: none;
    overflow: visible;
  }

  :global(.back-to-top-ring-track) {
    fill: none;
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 2;
  }

  :global(.back-to-top-ring-progress) {
    fill: none;
    stroke: #00fff0;
    stroke-width: 2;
    stroke-linecap: round;
    /* 2π × r (r=19) = 119.38. Se setea acá el valor inicial (vacío)
       y el JS lo va actualizando según el scroll. */
    stroke-dasharray: 119.38;
    stroke-dashoffset: 119.38;
  }

  :global(.back-to-top-icon) {
    position: relative;
    z-index: 1;
    line-height: 1;
  }


