  /* Barra de categorías sticky: aplica en desktop y mobile. */
  .categories {
    position: sticky;
    top: 0;
    z-index: 100;
    margin-inline: -5vw;
    /* Padding-top 26px para que el badge (22px de alto, elevado)
       entre completo cuando la barra está sticky arriba de todo. */
    padding: 26px 5vw 12px;
    background: rgba(11, 11, 11, 0.82);
    /* blur(6px) en vez de blur(10px): imperceptible al ojo, pero
       reduce bastante el costo de recalcular el blur en cada frame
       de scroll (especialmente en mobile). Subimos la opacidad del
       fondo (0.72 → 0.82) para compensar el menor blur. */
    -webkit-backdrop-filter: blur(6px);
            backdrop-filter: blur(6px);
    border-bottom: 1px solid #1f1f1f;
    margin-bottom: 25px;
