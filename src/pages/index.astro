<button
  id="back-to-top"
  class="back-to-top"
  type="button"
  aria-label="Volver arriba"
>
  ↑
</button>

<script define:vars={{ base }}>
  const searchInput = document.querySelector("#search");
    const backToTop = document.querySelector("#back-to-top");
  const categoryButtons = document.querySelectorAll(".category-button");
  const products = document.querySelectorAll(".product-card");

  let activeCategory = "todos";

  function filterProducts() {
    const search = searchInput.value.toLowerCase().trim();

    products.forEach((product) => {
      const name = product.dataset.name ?? "";
      const category = product.dataset.category ?? "";

      const matchesSearch = name.includes(search);
      const matchesCategory =
        activeCategory === "todos" || category === activeCategory;

      product.style.display =
        matchesSearch && matchesCategory ? "" : "none";
    });
  }

  categoryButtons.forEach((button) => {
    button.addEventListener("click", () => {
      categoryButtons.forEach((item) => item.classList.remove("active"));
      button.classList.add("active");

      activeCategory = button.dataset.category ?? "todos";

      filterProducts();
    });
  });

  searchInput.addEventListener("input", filterProducts);


   // -------------------------
  // MODAL DE PRODUCTO
  // -------------------------

  // Tabla de talles (alto x ancho en cm)
  const SIZE_CHART = {
    Oversize: [
      { size: "S",   alto: 72, ancho: 55 },
      { size: "M",   alto: 74, ancho: 57 },
      { size: "L",   alto: 76, ancho: 59 },
      { size: "XL",  alto: 78, ancho: 61 },
      { size: "2XL", alto: 80, ancho: 63 },
    ],
    Regular: [
      { size: "S",   alto: 65, ancho: 45 },
      { size: "M",   alto: 67, ancho: 49 },
      { size: "L",   alto: 69, ancho: 53 },
      { size: "XL",  alto: 71, ancho: 56 },
      { size: "2XL", alto: 74, ancho: 58 },
      { size: "3XL", alto: 76, ancho: 58 },
      { size: "4XL", alto: 78, ancho: 60 },
      { size: "5XL", alto: 81, ancho: 62 },
    ],
  };

  const modal = document.querySelector("#product-modal");
  const modalImage = document.querySelector("#modal-image");
  const modalImageLabel = document.querySelector("#modal-image-label");
  const modalImageCounter = document.querySelector("#modal-image-counter");
  const modalTitle = document.querySelector("#modal-title");
  const modalCategory = document.querySelector("#modal-category");
  const modalThumbs = document.querySelector("#modal-thumbs");
  const modalFits = document.querySelector("#modal-fits");
  const modalSizes = document.querySelector("#modal-sizes");
  const modalSizeCm = document.querySelector("#modal-size-cm");
  const modalQtyValue = document.querySelector("#modal-qty-value");
  const modalQtyMinus = document.querySelector("#modal-qty-minus");
  const modalQtyPlus = document.querySelector("#modal-qty-plus");
  const modalAdd = document.querySelector("#modal-add");
  const modalWhatsapp = document.querySelector("#modal-whatsapp");
  const modalShare = document.querySelector("#modal-share");
  const modalClose = document.querySelector("#modal-close");
  const modalPrev = document.querySelector("#modal-prev");
  const modalNext = document.querySelector("#modal-next");
  const modalBackdrop = document.querySelector(".modal-backdrop");
  const modalSeeChart = document.querySelector("#modal-see-chart");

  let currentImages = [];
  let currentImageIndex = 0;
  let selectedFit = "Oversize";
  let selectedSize = "L";
  let currentQuantity = 1;
  let currentProductName = "";
  let touchStartX = 0;
  let touchEndX = 0;


  function getSizesForFit(fit) {
    return SIZE_CHART[fit] || [];
  }

  function getMeasure(fit, size) {
    return getSizesForFit(fit).find((item) => item.size === size) || null;
  }


  function renderThumbs() {
    modalThumbs.innerHTML = "";

    currentImages.forEach((image, index) => {
      const thumb = document.createElement("button");
      thumb.type = "button";
      thumb.className = "modal-thumb";
      if (index === currentImageIndex) thumb.classList.add("active");
      thumb.setAttribute("aria-label", `Ver ${image.label}`);

      const img = document.createElement("img");
      img.src = image.src;
      img.alt = image.label;
      img.loading = "lazy";

      thumb.appendChild(img);

      thumb.addEventListener("click", () => {
        currentImageIndex = index;
        renderModalImage();
      });

      modalThumbs.appendChild(thumb);
    });
  }


  function renderModalImage() {
    const current = currentImages[currentImageIndex];
    if (!current) return;

    modalImage.src = current.src;
    modalImage.alt = `${currentProductName} — ${current.label}`;
    modalImageLabel.textContent = current.label;
    modalImageCounter.textContent = `${currentImageIndex + 1} / ${currentImages.length}`;

    // Refrescar el estado activo de las miniaturas sin redibujarlas todas.
    const thumbs = modalThumbs.querySelectorAll(".modal-thumb");
    thumbs.forEach((thumb, index) => {
      thumb.classList.toggle("active", index === currentImageIndex);
    });
  }


  function renderFits() {
    modalFits.innerHTML = "";

    ["Oversize", "Regular"].forEach((fit) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "modal-fit";
      if (fit === selectedFit) btn.classList.add("active");

      btn.innerHTML = fit === "Oversize"
        ? `<strong>Oversize</strong><span>Hombros caídos, corte amplio</span>`
        : `<strong>Regular Fit</strong><span>Corte tradicional al cuerpo</span>`;

      btn.addEventListener("click", () => {
        if (selectedFit === fit) return;
        selectedFit = fit;

        // Si el talle actual no existe en el nuevo corte, bajamos al más alto disponible.
        const sizes = getSizesForFit(selectedFit);
        const exists = sizes.some((item) => item.size === selectedSize);
        if (!exists) {
          selectedSize = sizes[sizes.length - 1].size;
        }

        renderFits();
        renderSizes();
        updateSizeCm();
      });

      modalFits.appendChild(btn);
    });
  }


  function renderSizes() {
    modalSizes.innerHTML = "";

    const sizes = getSizesForFit(selectedFit);

    sizes.forEach(({ size }) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "modal-size";
      btn.textContent = size;
      if (size === selectedSize) btn.classList.add("active");

      btn.addEventListener("click", () => {
        selectedSize = size;
        renderSizes();
        updateSizeCm();
      });

      modalSizes.appendChild(btn);
    });
  }


  function updateSizeCm() {
    const measure = getMeasure(selectedFit, selectedSize);
    if (!measure) {
      modalSizeCm.textContent = "";
      return;
    }
    modalSizeCm.textContent = `${measure.alto} cm alto × ${measure.ancho} cm ancho`;
  }


  function renderQuantity() {
    modalQtyValue.textContent = currentQuantity;
  }


  function openModal(product) {
    const name = product.querySelector("h3")?.textContent ?? "";
    const category = product.querySelector(".product-category");
    const categoryColor =
      category?.style.getPropertyValue("--category-color") ?? "#ffffff";
    const categoryName =
      category?.textContent?.trim() ?? "";

    modal.style.setProperty("--category-color", categoryColor);

    const image = product.querySelector("img");
    if (!image) return;

    const modelo = image.getAttribute("src");
    const remera = modelo.replace("/modelo.", "/remera.");

    currentImages = [
      { src: modelo, label: "Modelo" },
      { src: remera, label: "Remera" },
      { src: `${base}/talles/oversize.webp`, label: "Talles Oversize" },
      { src: `${base}/talles/regular.webp`, label: "Talles Regular" },
    ];

    currentImageIndex = 0;
    currentProductName = name;
    currentQuantity = 1;
    selectedFit = "Oversize";
    selectedSize = "L";

    modalTitle.textContent = name;
    modalCategory.textContent = categoryName;

    renderThumbs();
    renderModalImage();
    renderFits();
    renderSizes();
    updateSizeCm();
    renderQuantity();

    modalAdd.classList.remove("is-added");
    modalAdd.textContent = "Agregar al Pedido";

    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    document.body.classList.add("modal-open");
  }


  function closeModal() {
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("modal-open");
  }


  function showPreviousImage() {
    currentImageIndex =
      (currentImageIndex - 1 + currentImages.length) % currentImages.length;
    renderModalImage();
  }


  function showNextImage() {
    currentImageIndex = (currentImageIndex + 1) % currentImages.length;
    renderModalImage();
  }


  products.forEach((product) => {
    const button = product.querySelector(".product-button");
    button?.addEventListener("click", () => {
      openModal(product);
    });
  });


  modalClose.addEventListener("click", closeModal);
  modalBackdrop.addEventListener("click", closeModal);
  modalPrev.addEventListener("click", showPreviousImage);
  modalNext.addEventListener("click", showNextImage);

  // Atajo: al tocar "Ver gráfico", salta a la miniatura del talle del corte actual.
  modalSeeChart.addEventListener("click", () => {
    currentImageIndex = selectedFit === "Oversize" ? 2 : 3;
    renderModalImage();
  });


  modalQtyMinus.addEventListener("click", () => {
    if (currentQuantity > 1) {
      currentQuantity -= 1;
      renderQuantity();
    }
  });

  modalQtyPlus.addEventListener("click", () => {
    if (currentQuantity < 20) {
      currentQuantity += 1;
      renderQuantity();
    }
  });


  // En A3 este botón va a agregar al carrito de verdad.
  // Por ahora solo da feedback visual.
  modalAdd.addEventListener("click", () => {
    modalAdd.classList.add("is-added");
    modalAdd.textContent = "¡Agregado!";
    setTimeout(() => {
      modalAdd.classList.remove("is-added");
      modalAdd.textContent = "Agregar al Pedido";
    }, 1600);
  });


  modalWhatsapp.addEventListener("click", () => {
    const message = `¡Hola KRAKOA! Quería consultar por la remera de *${currentProductName}* en corte *${selectedFit}*, talle *${selectedSize}*. ¿Tienen stock disponible?`;
    const url = `https://wa.me/5491132372306?text=${encodeURIComponent(message)}`;
    window.open(url, "_blank", "noopener,noreferrer");
  });


  modalShare.addEventListener("click", async () => {
    const url = window.location.href;
    const title = currentProductName;

    if (navigator.share) {
      try {
        await navigator.share({
          title: `KRAKOA | ${title}`,
          text: `Mirá esta remera de KRAKOA: ${title}`,
          url,
        });
      } catch (error) {
        // cancelado
      }
    } else {
      try {
        await navigator.clipboard.writeText(url);
        modalShare.textContent = "¡Enlace copiado!";
        setTimeout(() => {
          modalShare.textContent = "Compartir";
        }, 2000);
      } catch (error) {
        alert("No se pudo copiar el enlace.");
      }
    }
  });


  modalImage.addEventListener("touchstart", (event) => {
    touchStartX = event.changedTouches[0].screenX;
  });

  modalImage.addEventListener("touchend", (event) => {
    touchEndX = event.changedTouches[0].screenX;
    const difference = touchStartX - touchEndX;
    if (Math.abs(difference) < 50) return;
    if (difference > 0) {
      showNextImage();
    } else {
      showPreviousImage();
    }
  });


  document.addEventListener("keydown", (event) => {
    if (!modal.classList.contains("open")) return;
    if (event.key === "Escape") closeModal();
    if (event.key === "ArrowLeft") showPreviousImage();
    if (event.key === "ArrowRight") showNextImage();
  });


  // -------------------------
  // CARRITO DE PEDIDO
  // -------------------------

  const CART_KEY = "krakoa_cart";
  const WHATSAPP_NUMBER = "5491132372306";

  const cartToggle = document.querySelector("#cart-toggle");
  const cartCount = document.querySelector("#cart-count");
  const cartDrawer = document.querySelector("#cart-drawer");
  const cartDrawerClose = document.querySelector("#cart-drawer-close");
  const cartDrawerBackdrop = document.querySelector(".cart-drawer-backdrop");
  const cartDrawerCount = document.querySelector("#cart-drawer-count");
  const cartDrawerTotal = document.querySelector("#cart-drawer-total");
  const cartDrawerFooter = document.querySelector("#cart-drawer-footer");
  const cartDrawerWhatsapp = document.querySelector("#cart-drawer-whatsapp");
  const cartDrawerBody = document.querySelector("#cart-drawer-body");

  let cartItems = [];
  try {
    const saved = localStorage.getItem(CART_KEY);
    cartItems = saved ? JSON.parse(saved) : [];
  } catch (error) {
    cartItems = [];
  }


  function saveCart() {
    try {
      localStorage.setItem(CART_KEY, JSON.stringify(cartItems));
    } catch (error) {
      // Si localStorage está bloqueado, no hacemos nada.
    }
  }


  function getTotalCount() {
    return cartItems.reduce((acc, item) => acc + item.quantity, 0);
  }


  function updateCartBadge() {
    const total = getTotalCount();

    if (total > 0) {
      cartCount.textContent = total;
      cartCount.classList.add("is-visible");
    } else {
      cartCount.classList.remove("is-visible");
    }
  }


  function addToCart(product) {
    const { name, image, fit, size, quantity, color } = product;
    const key = `${name}__${fit}__${size}`;

    const existing = cartItems.find((item) => item.key === key);

    if (existing) {
      existing.quantity += quantity;
    } else {
      cartItems.push({ key, name, image, fit, size, quantity, color });
    }

    saveCart();
    updateCartBadge();
    renderCartDrawer();
  }


  function removeFromCart(key) {
    cartItems = cartItems.filter((item) => item.key !== key);
    saveCart();
    updateCartBadge();
    renderCartDrawer();
  }


  function changeQuantity(key, delta) {
    const item = cartItems.find((i) => i.key === key);
    if (!item) return;

    item.quantity += delta;

    if (item.quantity <= 0) {
      removeFromCart(key);
      return;
    }

    saveCart();
    updateCartBadge();
    renderCartDrawer();
  }


  function clearCart() {
    cartItems = [];
    saveCart();
    updateCartBadge();
    renderCartDrawer();
  }


  function renderCartDrawer() {
    const total = getTotalCount();

    cartDrawerCount.textContent = total;
    cartDrawerTotal.textContent = total;
    cartDrawerFooter.hidden = total === 0;

    if (cartItems.length === 0) {
      cartDrawerBody.innerHTML = `
        <div class="cart-empty">
          <p>Tu lista de pedido está vacía</p>
          <p class="cart-empty-hint">
            Navegá por el catálogo y elegí corte, talle y cantidad.
          </p>
          <button id="cart-empty-cta" type="button" class="cart-empty-cta">
            Explorar catálogo
          </button>
        </div>
      `;
      return;
    }

    const itemsHtml = cartItems
      .map(
        (item) => `
        <div class="cart-item">
          <img
            class="cart-item-img"
            src="${item.image}"
            alt="${item.name}"
            loading="lazy"
          />
          <div class="cart-item-info">
            <div class="cart-item-top">
              <h4>${item.name}</h4>
              <button
                type="button"
                class="cart-item-remove"
                data-action="remove"
                data-key="${item.key}"
                aria-label="Eliminar ${item.name}"
              >
                ×
              </button>
            </div>
            <div class="cart-item-meta">
              <span>${item.fit}</span>
              <span>·</span>
              <span>Talle <strong>${item.size}</strong></span>
            </div>
            <div class="cart-item-qty">
              <button
                type="button"
                data-action="dec"
                data-key="${item.key}"
                aria-label="Restar uno"
              >
                −
              </button>
              <span>${item.quantity}</span>
              <button
                type="button"
                data-action="inc"
                data-key="${item.key}"
                aria-label="Sumar uno"
              >
                +
              </button>
            </div>
          </div>
        </div>
      `
      )
      .join("");

    cartDrawerBody.innerHTML = `
      <div class="cart-items-header">
        <span>${cartItems.length} ${
      cartItems.length === 1 ? "modelo" : "modelos"
    }</span>
        <button type="button" class="cart-clear" data-action="clear">
          Vaciar lista
        </button>
      </div>
      <div class="cart-items">
        ${itemsHtml}
      </div>
    `;
  }


  function buildWhatsAppOrderMessage() {
    const total = getTotalCount();

    let text = `¡Hola KRAKOA! Quería encargar las siguientes remeras:\n\n`;

    cartItems.forEach((item, index) => {
      text += `${index + 1}. *Remera ${item.name}*\n`;
      text += `   - Corte: *${item.fit}*\n`;
      text += `   - Talle: *${item.size}*\n`;
      text += `   - Cantidad: *${item.quantity}*\n\n`;
    });

    text += `Total de prendas: *${total}*\n\n`;
    text += `¿Tienen disponibilidad y cómo coordinamos pago y envío? ¡Gracias!`;

    return text;
  }


  function openCartDrawer() {
    cartDrawer.classList.add("open");
    cartDrawer.setAttribute("aria-hidden", "false");
    document.body.classList.add("cart-open");
  }


  function closeCartDrawer() {
    cartDrawer.classList.remove("open");
    cartDrawer.setAttribute("aria-hidden", "true");
    document.body.classList.remove("cart-open");
  }


  cartToggle?.addEventListener("click", openCartDrawer);
  cartDrawerClose?.addEventListener("click", closeCartDrawer);
  cartDrawerBackdrop?.addEventListener("click", closeCartDrawer);

  cartDrawerWhatsapp?.addEventListener("click", () => {
    if (cartItems.length === 0) return;
    const message = buildWhatsAppOrderMessage();
    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
      message
    )}`;
    window.open(url, "_blank", "noopener,noreferrer");
  });

  // Delegación de eventos dentro del carrito.
  cartDrawerBody.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    const actionEl = target.closest("[data-action]");

    if (actionEl) {
      const action = actionEl.getAttribute("data-action");
      const key = actionEl.getAttribute("data-key");

      if (action === "remove" && key) {
        removeFromCart(key);
        return;
      }
      if (action === "dec" && key) {
        changeQuantity(key, -1);
        return;
      }
      if (action === "inc" && key) {
        changeQuantity(key, +1);
        return;
      }
      if (action === "clear") {
        clearCart();
        return;
      }
    }

    if (target.id === "cart-empty-cta") {
      closeCartDrawer();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && cartDrawer.classList.contains("open")) {
      closeCartDrawer();
    }
  });

  updateCartBadge();
  renderCartDrawer();


  // -------------------------
  // Conectar modal → carrito
  // -------------------------

  // Reemplazamos el listener anterior (que solo daba feedback visual)
  // por uno que agrega de verdad al carrito.
  const modalAddOld = modalAdd;
  const modalAddClone = modalAddOld.cloneNode(true);
  modalAddOld.parentNode.replaceChild(modalAddClone, modalAddOld);

  modalAddClone.addEventListener("click", () => {
    const imageSrc = currentImages[0]?.src || "";
    const color = modal.style.getPropertyValue("--category-color") || "#ffffff";

    addToCart({
      name: currentProductName,
      image: imageSrc,
      fit: selectedFit,
      size: selectedSize,
      quantity: currentQuantity,
      color,
    });

    modalAddClone.classList.add("is-added");
    modalAddClone.textContent = "¡Agregado!";

    setTimeout(() => {
      modalAddClone.classList.remove("is-added");
      modalAddClone.textContent = "Agregar al Pedido";
    }, 1600);
  });
</script>