    /* Buscador en mobile: lupa visible, panel oculto por defecto. */
    .search-toggle {
      display: inline-flex;
    }

    .header-search-panel {
      display: none;
    }

    /* Modo búsqueda: el header se transforma en "input + ×". */
    .site-header.search-open .brand,
    .site-header.search-open .desktop-nav,
    .site-header.search-open .search-toggle,
    .site-header.search-open .instagram-btn,
    .site-header.search-open .cart-button,
    .site-header.search-open .menu-toggle {
