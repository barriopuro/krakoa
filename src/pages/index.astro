    // Flash + banner si el unitario cambió respecto del render anterior
    if (animate && lastCartUnitPrice !== null && unitPrice !== lastCartUnitPrice) {
      const isCheaper = unitPrice < lastCartUnitPrice;
      flashCartUnitLine(isCheaper);
      showCartTierBanner(total, unitPrice, isCheaper);
