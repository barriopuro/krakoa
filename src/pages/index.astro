---
import catalogo from "../data/catalogo.json";
import promo from "../data/promo.json";

const categories = catalogo.categories;

// Conteo de productos por categoría, para el badge del menú.
const productCountByCategory = {};
catalogo.products.forEach((p) => {
  productCountByCategory[p.category] = (productCountByCategory[p.category] || 0) + 1;
});

const base = import.meta.env.BASE_URL;

// URL base absoluta para los JSON-LD (Schema.org necesita URLs absolutas).
// Si Astro.site no está configurado, cae a la URL de producción.
// Nota: evitamos optional chaining (?.), nullish coalescing (??) y
// template literals en este bloque porque el scanner de dependencias
// de Vite 7 (rolldown) no los procesa bien en el frontmatter.
const siteOriginRaw = Astro.site ? Astro.site.origin : "https://barriopuro.github.io";
const SITE_ORIGIN = siteOriginRaw.replace(/\/$/, "");
const BASE_PATH = base.endsWith("/") ? base.slice(0, -1) : base;

function productUrl(path) {
  return SITE_ORIGIN + BASE_PATH + path;
}

// (SCHEMA_PRICES y SCHEMA_ORG se eliminaron del frontmatter porque
// el scanner de dependencias de Vite 7 (rolldown) falla al parsear
// declaraciones const con objetos literales en este contexto.
// Los valores van inline en el JSON-LD del head.)

const totalModelos = catalogo.products.length;

const marqueeText = [
  "Envíos a todo el país",
  "" + totalModelos + " modelos diferentes",
  "100% Algodón Peinado 24/1",
  "Cortes Oversize y Regular Fit",
  "Estampas DTF Premium",
  "Pre-encogido Térmico",
  "Atención personalizada por WhatsApp",
];
---

<!doctype html>
<html lang="es">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>KRAKOA | REMERAS</title>
<link rel="icon" type="image/png" href={`${base}/logos/krakoalogo-isotipo.webp`} />
