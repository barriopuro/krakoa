        <div class="modal-image-area">
          <button
            id="modal-prev"
            class="modal-arrow modal-prev"
            type="button"
            aria-label="Imagen anterior"
          >
            ‹
          </button>

          <div class="modal-image-wrapper">
  <img
    id="modal-image-a"
    class="modal-image-el active"
    src=""
    alt=""
    decoding="async"
  />
  <img
    id="modal-image-b"
    class="modal-image-el"
    src=""
    alt=""
    decoding="async"
  />
</div>

          <button
