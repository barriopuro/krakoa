  // -------------------------
  // PRECIOS
  // -------------------------
  // Los tiers se aplican al TOTAL de prendas del pedido, no por ítem.
  // Si el pedido tiene 3 remeras (aunque sean modelos distintos), todas
  // salen a $23.000 c/u. Si tiene 5 o más, todas a $20.000 c/u.
  //
  // Para agregar un tier nuevo o cambiar precios, se edita solo este array.
  const PRICE_TIERS = [
    { min: 1, max: 1,        price: 25000, label: "1 remera" },
    { min: 2, max: 4,        price: 23000, label: "2 a 4 remeras" },
    { min: 5, max: Infinity, price: 20000, label: "5 o más" },
  ];

  // Formatea un número como precio en pesos: 25000 → "$25.000".
  function formatPrice(value) {
    return "$" + value.toLocaleString("es-AR");
  }

  // Devuelve el precio unitario que corresponde a una cantidad total.
  // Si la cantidad es 0 (carrito vacío), devuelve el precio del primer tier.
  function getUnitPrice(totalQuantity) {
    if (totalQuantity <= 0) return PRICE_TIERS[0].price;
    const tier = PRICE_TIERS.find(
      (t) => totalQuantity >= t.min && totalQuantity <= t.max
    );
    return tier ? tier.price : PRICE_TIERS[PRICE_TIERS.length - 1].price;
  }

  // Devuelve el próximo tier y cuántas unidades faltan para llegar.
  // Devuelve null si ya está en el tier máximo.
  // Ejemplo: si totalQuantity = 3, devuelve { price: 20000, label: "5 o más", unitsNeeded: 2 }.
  function getNextTier(totalQuantity) {
    const currentIndex = PRICE_TIERS.findIndex(
      (t) => totalQuantity >= t.min && totalQuantity <= t.max
    );
    if (currentIndex === -1) return null;
    if (currentIndex >= PRICE_TIERS.length - 1) return null;
    const next = PRICE_TIERS[currentIndex + 1];
    return { ...next, unitsNeeded: next.min - totalQuantity };
  }


