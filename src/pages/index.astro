      /* --------------------------- */
  /* MODAL DE PRODUCTO (NUEVO)   */
  /* --------------------------- */

  .modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    visibility: hidden;
    pointer-events: none;
  }

  .modal.open,
  .modal.is-closing {
    visibility: visible;
    pointer-events: auto;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .modal.open .modal-backdrop {
    opacity: 1;
  }

  .modal.is-closing .modal-backdrop {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .modal-content {
    position: relative;
    width: min(96vw, 1100px);
    max-height: 92dvh;
    background: #111;
    border: 1px solid #242424;
    border-radius: 16px;
    overflow: hidden;
    z-index: 1;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform-origin: center center;
  }

  .modal.open .modal-content {
    animation: crtOpen 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    opacity: 1;
  }

  .modal.is-closing .modal-content {
    animation: crtClose 0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  /* Scanlines durante la apertura del modal. Se apagan solas en 0.6s. */
  .modal-content::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 2px,
      rgba(0, 255, 240, 0.20) 3px,
      rgba(0, 255, 240, 0.20) 4px
    );
    opacity: 0;
  }

  .modal.open .modal-content::after {
    animation: scanlinesShow 0.6s ease;
  }

  @keyframes crtOpen {
    0%   { opacity: 0; transform: scaleY(0.005) scaleX(0.5); filter: brightness(5); }
    25%  { opacity: 1; transform: scaleY(0.02) scaleX(1);    filter: brightness(3); }
    55%  { opacity: 1; transform: scaleY(1.03) scaleX(1);    filter: brightness(1.4); }
    80%  { opacity: 1; transform: scaleY(0.99) scaleX(1);    filter: brightness(1.1); }
    100% { opacity: 1; transform: scaleY(1) scaleX(1);       filter: brightness(1); }
  }

  @keyframes crtClose {
    0%   { opacity: 1; transform: scaleY(1) scaleX(1);      filter: brightness(1); }
    35%  { opacity: 1; transform: scaleY(0.06) scaleX(1);   filter: brightness(2.5); }
    70%  { opacity: 1; transform: scaleY(0.01) scaleX(0.8); filter: brightness(4); }
    100% { opacity: 0; transform: scaleY(0.005) scaleX(0.3); filter: brightness(6); }
  }

  @keyframes scanlinesShow {
    0%   { opacity: 0; }
    25%  { opacity: 1; }
    70%  { opacity: 1; }
    100% { opacity: 0; }
  }

  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 5;
    width: 36px;
    height: 36px;
    border: 1px solid #2a2a2a;
