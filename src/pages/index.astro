 /* --------------------------- */
/* ZOOM DE IMAGEN              */
/* --------------------------- */

:global(.image-zoom) {
  position: fixed;
  inset: 0;
  z-index: 1300;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(0, 0, 0, 0.93);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s ease, visibility 0s linear 0.22s;
  cursor: zoom-out;
  overflow: hidden;
}

/* Cursores del zoom: grab cuando está ampliada, grabbing mientras
   se arrastra. En 1x, el cursor base (zoom-out) se mantiene. */
:global(.image-zoom-img.is-zoomed) {
  cursor: grab;
}

:global(.image-zoom-img.is-grabbing) {
  cursor: grabbing;
}

:global(.image-zoom.open) {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.22s ease, visibility 0s linear 0s;
}



/* El overlay del zoom centra el stage. */
:global(.image-zoom) {
  position: fixed;
  inset: 0;
  z-index: 1300;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(0, 0, 0, 0.93);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s ease, visibility 0s linear 0.22s;
  cursor: zoom-out;
}

/* El stage se achica al contenido: imagen + flechas pegadas a sus lados.
   position: relative para que las flechas se posicionen respecto a ÉL
   y no respecto a la pantalla. */
:global(.image-zoom-stage) {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  max-height: 100%;
}

:global(.image-zoom-img) {
  max-width: 78vw;
  max-height: 92vh;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
  border-radius: 6px;
  touch-action: pinch-zoom;
  cursor: zoom-out;
  user-select: none;
  transition: none;
  will-change: transform;
}

:global(.image-zoom-arrow) {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  z-index: 3;
  width: 48px;
  height: 48px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 30px;
  line-height: 1;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  user-select: none;
}

:global(.image-zoom-prev) {
  left: 24px;
}

:global(.image-zoom-next) {
  right: 24px;
}

:global(.image-zoom-arrow:hover) {
  background: #fff;
  color: #111;
  border-color: #fff;
}

:global(.image-zoom-close) {
  position: absolute;
  top: 18px;
  right: 18px;
  z-index: 3;
  width: 40px;
  height: 40px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 24px;
  line-height: 1;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, border-color 0.2s ease;
}

:global(.image-zoom-close:hover) {
  background: #fff;
  color: #111;
  border-color: #fff;
}

@media (max-width: 700px) {
  :global(.image-zoom) {
    padding: 12px;
  }

  :global(.image-zoom-stage) {
    gap: 8px;
  }

  :global(.image-zoom-arrow) {
    width: 38px;
    height: 38px;
    font-size: 22px;
  }

  :global(.image-zoom-prev) {
    left: 12px;
  }

  :global(.image-zoom-next) {
    right: 12px;
  }

  :global(.image-zoom-img) {
    max-width: 74vw;
  }
}

/* Cursor zoom-in sobre la imagen del carrusel del modal.
   Solo aplica cuando el slide activo es zoomeable (lo maneja el JS
   con la clase .is-zoomable en el wrapper). */
:global(.modal-image-wrapper.is-zoomable) {
  cursor: zoom-in;
}

/* Ícono de lupa en mobile, en la esquina inferior derecha de la imagen.
   Solo se muestra si el wrapper es zoomeable. */
:global(.modal-image-wrapper.is-zoomable)::after {
  content: "";
  position: absolute;
  right: 22px;
  bottom: 22px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.6);
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='7'/><line x1='21' y1='21' x2='16.65' y2='16.65'/><line x1='11' y1='8' x2='11' y2='14'/><line x1='8' y1='11' x2='14' y2='11'/></svg>");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 18px 18px;
  pointer-events: none;
  opacity: 0.85;
  transition: opacity 0.2s ease;
}

/* En desktop no hace falta el ícono (ya está el cursor zoom-in). */
@media (min-width: 801px) {
  :global(.modal-image-wrapper.is-zoomable)::after {
    display: none;
  }
}

/* --------------------------- */
/* PROMO POPUP                 */
/* --------------------------- */

:global(.promo-modal) {
  position: fixed;
  inset: 0;
  z-index: 1250;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.32s ease, visibility 0s linear 0.32s;
}

:global(.promo-modal.open),
:global(.promo-modal.is-closing) {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.32s ease, visibility 0s linear 0s;
}

:global(.promo-backdrop) {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.88);
  backdrop-filter: blur(8px);
}

:global(.promo-content) {
  position: relative;
  z-index: 1;
  width: min(92vw, 500px);
  max-height: 92dvh;
  background: #111;
  border: 1px solid #242424;
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transform-origin: center center;
  opacity: 0;
}

:global(.promo-modal.open .promo-content) {
  animation: crtOpen 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  opacity: 1;
}

:global(.promo-modal.is-closing .promo-content) {
  animation: crtClose 0.35s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

:global(.promo-content::after) {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 20;
  pointer-events: none;
  background: repeating-linear-gradient(
    0deg,
    transparent 0px,
    transparent 2px,
    rgba(0, 255, 240, 0.20) 3px,
    rgba(0, 255, 240, 0.20) 4px
  );
  opacity: 0;
}

:global(.promo-modal.open .promo-content::after) {
  animation: scanlinesShow 0.6s ease;
}

:global(.promo-close) {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 5;
  width: 36px;
  height: 36px;
  border: 1px solid #2a2a2a;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

:global(.promo-close:hover) {
  background: #fff;
  color: #111;
  border-color: #fff;
}

:global(.promo-stage) {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  background: #0a0a0a;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

:global(.promo-image-wrapper) {
  position: relative;
  width: 100%;
  height: 100%;
}

:global(.promo-image-el) {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  opacity: 0;
  transition: opacity 0.4s ease;
  pointer-events: none;
  user-select: none;
  z-index: 2;
}

/* 1. Flicker de encendido + 3. Pulso de brillo (Neon Glow) */
:global(.promo-image-el.active) {
  opacity: 1;
  pointer-events: auto;
  /* El flicker dura 0.8s. Después arranca el pulso de neón en bucle. */
  animation: promoFlickerOn 0.8s ease-out forwards, 
             promoNeonPulse 2.5s infinite alternate 0.8s;
}

/* 2. Capa de Scanlines animadas (Rayas de TV) */
:global(.promo-image-wrapper::after) {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 4;
  pointer-events: none;
  /* Subimos la opacidad a 0.15 (15%) para que se note */
  background: linear-gradient(
    to bottom,
    transparent 50%,
    rgba(0, 255, 240, 0.15) 50%
  );
  background-size: 100% 4px; /* Rayas horizontales de 2px */
  animation: promoScanlines 6s linear infinite;
}

@keyframes promoFlickerOn {
  0%   { opacity: 0; filter: brightness(3); }
  10%  { opacity: 1; filter: brightness(1); }
  20%  { opacity: 0.2; filter: brightness(2); }
  30%  { opacity: 1; filter: brightness(1); }
  45%  { opacity: 0.5; filter: brightness(1.5); }
  60%  { opacity: 1; filter: brightness(1); }
  100% { opacity: 1; filter: brightness(1); }
}

@keyframes promoNeonPulse {
  0%   { box-shadow: 0 0 5px rgba(0, 255, 240, 0.2); }
  100% { box-shadow: 0 0 25px rgba(0, 255, 240, 0.7); }
}

@keyframes promoScanlines {
  0%   { background-position: 0 0; }
  100% { background-position: 0 100vh; }
}

