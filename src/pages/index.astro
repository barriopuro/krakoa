  </svg>
  <span class="back-to-top-icon" aria-hidden="true">↑</span>
</button>

<script define:vars={{ base, PROMO_DATA: promo }}>

  // S32: constantes del sitio para armar URLs absolutas.
  // - SITE_ORIGIN: origen real desde donde corre la página
  //   (https://barriopuro.github.io en prod, http://localhost:4321
  //   en dev). Lo usa el botón "Compartir" para armar la URL de la
  //   página puente /producto/slug/.
  // - BASE_PATH: `base` sin el trailing slash (/krakoa/ → /krakoa).
  //   Mismo cálculo que hace el frontmatter.
  const SITE_ORIGIN = window.location.origin;
  const BASE_PATH = base.endsWith("/") ? base.slice(0, -1) : base;

  // Loader de carga inicial
  (() => {
    const loader = document.querySelector("#krakoa-loader");
    if (!loader) return;
    const img = loader.querySelector("img");
    // Bajamos el MIN_TIME de 1000 a 300. Con 300ms el glitch
    // del isotipo alcanza a verse un instante, pero el usuario
    // pasa al hero mucho más rápido.
    const MIN_TIME = 300;
    const startTime = Date.now();
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    // Intervalo del glitch periódico. Se guarda para poder limpiarlo
    // cuando el loader se va (si no, sigue corriendo sobre un elemento
    // que ya fue removido del DOM).
    let loaderGlitchInterval = null;

    function triggerLoaderGlitch() {
      if (img.classList.contains("glitching")) return;
      img.classList.add("glitching");
      setTimeout(() => img.classList.remove("glitching"), 420);
    }

    // Esperamos 2 frames para que el navegador pinte, y mostramos el logo
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        img.style.opacity = "1";

        if (prefersReducedMotion) return;

        // Primer glitch a los 600ms (después del fade in).
        setTimeout(triggerLoaderGlitch, 600);

        // Glitch periódico cada 2.5s, mientras el loader esté visible.
        // Así, si la carga tarda 8 segundos, el usuario ve ~3 glitches
        // en vez de uno solo.
        loaderGlitchInterval = setInterval(triggerLoaderGlitch, 2500);
      });
    });

    const hide = () => {
      const elapsed = Date.now() - startTime;
      const wait = Math.max(0, MIN_TIME - elapsed);
      setTimeout(() => {
        // Frenamos el glitch periódico antes de sacar el loader.
        if (loaderGlitchInterval) {
          clearInterval(loaderGlitchInterval);
          loaderGlitchInterval = null;
        }

        loader.style.opacity = "0";
        loader.style.pointerEvents = "none";

        // Avisamos que el loader se está yendo, para que otros efectos
        // (como el reveal por letra del hero) puedan arrancar.
        document.dispatchEvent(new CustomEvent("krakoa:loaded"));

        setTimeout(() => loader.remove(), 500);
      }, wait);
    };

    // Estrategia nueva: esperar DOMContentLoaded (HTML+CSS listos)
    // y NO window.load (que espera a todas las imágenes, incluyendo
    // las lazy del catálogo, y al script de Clarity).
    //
    // Además, un "race" con un timeout de 1500ms: si por alguna razón
    // DOMContentLoaded tarda (por un script externo lento), ocultamos
    // el loader igual. Así el usuario NUNCA queda mirando una pantalla
    // negra por más de 1.5s.
    //
    // El MIN_TIME de 1000ms se sigue respetando: así el glitch del
    // isotipo se ve completo antes de que el loader se vaya.
    let hideScheduled = false;

    function scheduleHide() {
      if (hideScheduled) return;
      hideScheduled = true;
      hide();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", scheduleHide, { once: true });
    } else {
      scheduleHide();
    }

    // Red de seguridad: a los 1.5s, ocultar sí o sí.
    setTimeout(scheduleHide, 1500);
  })();

  // -------------------------
  // PROMO POPUP
  // -------------------------
  // La config viene del JSON generado por el script (src/data/promo.json).
  // Necesitamos pasarla al cliente porque el script de Astro corre
  // después del render. Usamos un objeto global.
  window.KRAKOA_PROMO = PROMO_DATA;

  // Exponemos closePromoModalDirect para que closeTopOverlay() la use.
  window.KRAKOA_CLOSE_PROMO = null;

  (() => {
    const promoModal = document.querySelector("#promo-modal");
    if (!promoModal) return; // no hay promo configurada

    const promoData = window.KRAKOA_PROMO;
    if (!promoData || !promoData.activa) return;
    if (!promoData.imagenes || promoData.imagenes.length === 0) return;

    const promoImages = promoModal.querySelectorAll(".promo-image-el");
    const promoThumbs = promoModal.querySelectorAll(".promo-thumb");
    const promoPrev = promoModal.querySelector("#promo-prev");
    const promoNext = promoModal.querySelector("#promo-next");
    const promoClose = promoModal.querySelector("#promo-close");
    const promoDontShow = promoModal.querySelector("#promo-dont-show");
    const promoBackdrop = promoModal.querySelector(".promo-backdrop");

    const STORAGE_KEY_DONT_SHOW = "krakoa_promo_dont_show";
    const STORAGE_KEY_SESSION = "krakoa_promo_session_closed";

    let promoIndex = 0;
    let autoRotateTimer = null;
    let autoRotateActive = true;

    // ¿Debemos mostrar la promo?
    function shouldShowPromo() {
      // 1) Si el usuario la cerró en ESTA sesión (con la ×), no mostrar.
      if (sessionStorage.getItem(STORAGE_KEY_SESSION) === "1") {
        return false;
      }

      // 2) Si el usuario tocó "No mostrar de nuevo", chequeamos:
      //    - Si el hash de la promo cambió → mostrar (es una promo nueva).
      //    - Si pasaron más de X horas → mostrar.
      try {
        const raw = localStorage.getItem(STORAGE_KEY_DONT_SHOW);
        if (!raw) return true;

        const saved = JSON.parse(raw);
        const currentHash = promoData.hash;

        if (saved.hash && saved.hash !== currentHash) {
          // La promo cambió → mostrar.
          return true;
        }

        const hoursPassed = (Date.now() - saved.timestamp) / (1000 * 60 * 60);
        const limit = promoData.config.noMostrarDuracionHoras || 24;

        return hoursPassed >= limit;
      } catch (error) {
        return true;
      }
    }

    function renderPromoImage(index) {
      promoIndex = index;
      promoImages.forEach((img, i) => {
        img.classList.toggle("active", i === index);
      });
      promoThumbs.forEach((thumb, i) => {
        thumb.classList.toggle("active", i === index);
      });
    }

    function stopAutoRotate() {
      if (autoRotateTimer) {
        clearInterval(autoRotateTimer);
        autoRotateTimer = null;
      }
      autoRotateActive = false;
    }

    function startAutoRotate() {
      // Solo si hay más de 1 imagen y no fue detenido por el usuario.
      if (promoImages.length < 2) return;
      if (!autoRotateActive) return;
      if (autoRotateTimer) return;

      const seconds = promoData.config.autoRotateSegundos || 5;
      autoRotateTimer = setInterval(() => {
        const nextIndex = (promoIndex + 1) % promoImages.length;
        renderPromoImage(nextIndex);
      }, seconds * 1000);
    }

    let promoCloseTimer = null;

    function openPromoModal() {
      if (promoModal.classList.contains("open")) return;
      if (promoModal.getAttribute("aria-hidden") === "false") return;

      // Si había un cierre en curso (CRT close), lo cancelamos.
      if (promoCloseTimer) {
        clearTimeout(promoCloseTimer);
        promoCloseTimer = null;
      }
      promoModal.classList.remove("is-closing");

      promoModal.setAttribute("aria-hidden", "false");
      document.body.classList.add("promo-open");

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          promoModal.classList.add("open");
        });
      });

      pushHistory("promo");
      startAutoRotate();
    }

    function closePromoModal() {
      if (isTopOfHistory("promo")) {
        popHistory();
        return;
      }
      closePromoModalDirect();
    }

    function closePromoModalDirect() {
      if (promoModal.getAttribute("aria-hidden") === "true") return;
      if (promoCloseTimer) {
        clearTimeout(promoCloseTimer);
        promoCloseTimer = null;
      }

      // Disparamos el CRT close.
      promoModal.classList.remove("open");
      promoModal.classList.add("is-closing");
      promoModal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("promo-open");
      stopAutoRotate();

      // Limpiamos .is-closing después de la animación (380ms) para
      // que el contenedor vuelva a quedar oculto del todo.
      promoCloseTimer = setTimeout(() => {
        promoModal.classList.remove("is-closing");
        promoCloseTimer = null;
      }, 380);
    }

    // Exponemos la función para que closeTopOverlay() la use cuando
    // el usuario toca el botón "atrás" del celular.
    window.KRAKOA_CLOSE_PROMO = closePromoModalDirect;

    // Marcamos la sesión como "ya cerrada" (solo si no fue "no mostrar").
    function markSessionClosed() {
      try {
        sessionStorage.setItem(STORAGE_KEY_SESSION, "1");
      } catch (error) {}
    }

    // Guardamos el "no mostrar de nuevo".
    function markDontShow() {
      try {
        localStorage.setItem(
          STORAGE_KEY_DONT_SHOW,
          JSON.stringify({
            hash: promoData.hash,
            timestamp: Date.now(),
          })
        );
      } catch (error) {}
    }

    // Listeners
    promoClose?.addEventListener("click", () => {
      markSessionClosed();
      closePromoModal();
    });

    promoBackdrop?.addEventListener("click", () => {
      markSessionClosed();
      closePromoModal();
    });

    promoDontShow?.addEventListener("click", () => {
      markDontShow();
      markSessionClosed();
      closePromoModal();
    });

    promoPrev?.addEventListener("click", () => {
      stopAutoRotate();
      const prev =
        (promoIndex - 1 + promoImages.length) % promoImages.length;
      renderPromoImage(prev);
    });

    promoNext?.addEventListener("click", () => {
      stopAutoRotate();
      const next = (promoIndex + 1) % promoImages.length;
      renderPromoImage(next);
    });

    promoThumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        stopAutoRotate();
        const index = parseInt(thumb.getAttribute("data-index") || "0", 10);
        renderPromoImage(index);
      });
    });

    // Escape cierra la promo.
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (promoModal.getAttribute("aria-hidden") === "false") {
        event.stopImmediatePropagation();
        markSessionClosed();
        closePromoModal();
      }
    });

    // Swipe en mobile sobre la imagen.
    let promoTouchStartX = 0;
    promoModal.addEventListener(
      "touchstart",
      (event) => {
        promoTouchStartX = event.changedTouches[0].screenX;
      },
      { passive: true }
    );
    promoModal.addEventListener(
      "touchend",
      (event) => {
        const dx = event.changedTouches[0].screenX - promoTouchStartX;
        if (Math.abs(dx) < 50) return;
        stopAutoRotate();
        if (dx < 0) {
          renderPromoImage((promoIndex + 1) % promoImages.length);
        } else {
          renderPromoImage(
            (promoIndex - 1 + promoImages.length) % promoImages.length
          );
        }
      },
      { passive: true }
    );

    // Abrimos la promo a los 2 segundos, solo si corresponde.
    if (shouldShowPromo()) {
      setTimeout(() => {
        try {
          openPromoModal();
        } catch (error) {
          console.error("[KRAKOA] Error abriendo promo:", error);
        }
      }, 2000);
    }
  })();

  const searchInput = document.querySelector("#search");

  // S29: seteamos --sbw en el html con el ancho actual de la scrollbar.
  // Los bloques con width: 100vw (hero, products, no-results, tint)
  // la restan con calc(100vw - var(--sbw, 0px)) para no moverse al
  // abrir overlays (que hacen desaparecer la scrollbar). Se recalcula
  // al cargar y al resize. NO se recalcula al abrir overlays (queremos
  // que el valor sea el "con scrollbar", que es el estado por defecto).
  function updateScrollbarVariable() {
    const sbw = window.innerWidth - document.documentElement.clientWidth;
    document.documentElement.style.setProperty("--sbw", sbw + "px");
  }
  updateScrollbarVariable();
  window.addEventListener("resize", updateScrollbarVariable);

  // S31: helper global de "¿hay algún overlay abierto?". Lo usan
  // los schedulers de efectos (glitch, typewriter, rotación, etc.)
  // para pausarse cuando hay algo encima. Incluye los estados
  // "is-closing" para que los efectos sigan pausados durante el
  // cierre animado (CRT close, 380ms).
  function isAnyOverlayOpen() {
    return !!(
      document.querySelector(".modal.open") ||
      document.querySelector(".modal.is-closing") ||
      document.querySelector(".cart-drawer.open") ||
      document.querySelector(".mobile-menu.open") ||
      document.querySelector(".image-zoom.open") ||
      document.querySelector(".promo-modal.open") ||
      document.querySelector(".promo-modal.is-closing")
    );
  }

  // -------------------------
  // BUSCADOR EN EL HEADER
  // -------------------------
  // En mobile, el header se transforma en "input + ×" al tocar la lupa.
  // En desktop no hay transformación: el input está siempre visible.
  const siteHeader = document.querySelector(".site-header");
  const searchToggle = document.querySelector("#search-toggle");
  const searchClose = document.querySelector("#search-close");

  function triggerSearchGlitch() {
    if (!siteHeader) return;
    const panel = document.querySelector("#header-search-panel");
    searchToggle?.classList.add("search-switching");
    panel?.classList.add("search-switching");
    // 420ms = 400ms de la nueva animación + 20ms de margen (antes
    // era 340ms, cuando la animación duraba 320ms).
    setTimeout(() => {
      searchToggle?.classList.remove("search-switching");
      panel?.classList.remove("search-switching");
    }, 420);
  }

  function openSearch() {
    triggerSearchGlitch();
    siteHeader?.classList.add("search-open");
    // Foco después de que el navegador pinte el input (para que se abra
    // el teclado en mobile).
    requestAnimationFrame(() => {
      searchInput?.focus();
    });
  }

  function closeSearch() {
    triggerSearchGlitch();
    siteHeader?.classList.remove("search-open");
    searchInput?.blur();
    // Al cerrar en mobile, limpiamos la búsqueda y restauramos el catálogo.
    // Si no, el usuario quedaría con un filtro invisible aplicado.
    if (searchInput && searchInput.value !== "") {
      searchInput.value = "";
      filterProducts();
    }
  }

  searchToggle?.addEventListener("click", openSearch);
  searchClose?.addEventListener("click", closeSearch);

  // -------------------------
  // BUSCADOR COMPACTO (dentro de la barra de categorías)
  // -------------------------
  // La lupa compacta reemplaza las categorías por un input en el
  // centro de la barra. El × cierra y limpia.
  const categoriesCompactSearchToggle = document.querySelector(
    ".categories-compact-search-toggle"
  );
  const searchCompact = document.querySelector("#search-compact");
  const searchCompactClose = document.querySelector("#search-compact-close");

  function openCompactSearch() {
    if (!categoriesBar) return;
    // Copiamos el valor actual del input del header.
    if (searchInput && searchCompact) {
      searchCompact.value = searchInput.value;
    }
    categoriesBar.classList.add("search-open");
    categoriesCompactSearchToggle?.setAttribute("aria-label", "Cerrar búsqueda");
    requestAnimationFrame(() => {
      searchCompact?.focus();
    });
  }

  function closeCompactSearch() {
    if (!categoriesBar) return;
    categoriesBar.classList.remove("search-open");
    // Sincronizamos el valor al input del header (por si el usuario
    // dejó una búsqueda activa: así al volver al header la ve).
    if (searchInput && searchCompact) {
      searchInput.value = searchCompact.value;
    }
    searchCompact?.blur();
    categoriesCompactSearchToggle?.setAttribute("aria-label", "Buscar");
  }

  // Cierra el panel Y limpia el input / restaura el catálogo.
  // Se usa desde: × del panel (desktop), toggle-X (mobile),
  // y Escape.
  function handleCloseCompactSearch() {
    const hadValue =
      (searchCompact && searchCompact.value !== "") ||
      (searchInput && searchInput.value !== "");
    if (searchCompact) searchCompact.value = "";
    if (searchInput) searchInput.value = "";
    if (hadValue) {
      // Sin animación: las tarjetas vuelven a aparecer de golpe.
      filterProducts({ animate: false });
    }
    closeCompactSearch();
  }

  categoriesCompactSearchToggle?.addEventListener("click", () => {
    // S28: en mobile el mismo toggle abre y cierra (cambia a X).
    // En desktop el toggle se oculta cuando search-open, así que
    // este branch solo se ejecuta en mobile.
    if (categoriesBar && categoriesBar.classList.contains("search-open")) {
      handleCloseCompactSearch();
      return;
    }
    openCompactSearch();
  });

  searchCompactClose?.addEventListener("click", handleCloseCompactSearch);

  // Botón "Ver todo el catálogo" del bloque "sin resultados".
  // Limpia búsqueda + categoría, cierra el buscador compacto si
  // estaba abierto, y sube al inicio de la grilla.
  const noResultsReset = document.querySelector("#no-results-reset");
  noResultsReset?.addEventListener("click", () => {
    if (searchInput) searchInput.value = "";
    if (searchCompact) searchCompact.value = "";
    if (categoriesBar) categoriesBar.classList.remove("search-open");
    // Sin push al history: es un reset, no una navegación. Sin scroll:
    // manejamos el scroll abajo, con "smooth" para que se sienta como
    // una transición y no como un salto.
    applyCategoryFilter(null, { push: false, scroll: false });

    const productsGrid = document.querySelector("#products");
    if (productsGrid) {
      const top =
        productsGrid.getBoundingClientRect().top + window.scrollY - 110;
      window.scrollTo({ top, behavior: "smooth" });
    }
  });

  searchCompact?.addEventListener(
    "input",
    debounce(() => {
      // Sincronizamos el valor al input del header para que al
      // volver al header el campo esté actualizado.
      if (searchInput) searchInput.value = searchCompact.value;
      filterProducts();

      // Al buscar desde la barra compacta (que solo aparece cuando
      // el usuario ya scrolleó), subimos al inicio de la grilla para
      // que vea los resultados en primer plano. Sin esto, el
      // scroll-anchoring del navegador nos deja pegados a la última
      // sección (Preguntas Frecuentes).
      // Usamos "auto" (no "smooth") porque el buscador se dispara con
      // debounce 150ms: mientras el usuario sigue escribiendo, el
      // scroll ya está en el destino y no se reinicia la animación.
      const productsGrid = document.querySelector("#products");
      if (productsGrid) {
        const top =
          productsGrid.getBoundingClientRect().top + window.scrollY - 110;
        if (window.scrollY > top) {
          window.scrollTo({ top, behavior: "auto" });
        }
      }
    }, 150)
  );

  // En desktop, al hacer focus en el input (click para escribir),
  // disparamos el mismo glitch del header. En mobile NO, porque
  // openSearch ya lo dispara y el focus automático duplicaría el efecto.
  searchInput?.addEventListener("focus", () => {
    if (window.matchMedia("(min-width: 701px)").matches) {
      triggerSearchGlitch();
    }
  });

  // -------------------------
  // ALEATORIZAR EL CATÁLOGO
  // -------------------------
  // Mezcla round-robin aleatoria: mantiene variedad de categorías
  // (no todos los de anime juntos) pero cambia el orden en cada visita.
  // Se hace ANTES de que el hero lea las imágenes, así el hero también
  // agarra un set distinto cada vez.
  (() => {
    const productsGrid = document.querySelector("#products");
    if (!productsGrid) return;

    const cards = Array.from(productsGrid.querySelectorAll(".product-card"));
    if (cards.length < 2) return;

    // Agrupamos por categoría.
    const byCategory = new Map();
    cards.forEach((card) => {
      const cat = card.dataset.category || "otros";
      if (!byCategory.has(cat)) byCategory.set(cat, []);
      byCategory.get(cat).push(card);
    });

    // Fisher-Yates shuffle para mezclar un array in-place.
    function shuffle(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    // Mezclamos cada categoría internamente.
    const groups = Array.from(byCategory.values());
    groups.forEach((group) => shuffle(group));

    // También mezclamos el orden de las categorías, para que no arranque
    // siempre con la misma.
    shuffle(groups);

    // Armamos el orden final con round-robin: uno de cada categoría,
    // rotando, hasta agotar todas.
    const ordered = [];
    let maxLen = Math.max(...groups.map((g) => g.length));
    for (let i = 0; i < maxLen; i++) {
      groups.forEach((group) => {
        if (group[i]) ordered.push(group[i]);
      });
    }

    // Reinsertamos en el DOM en el orden nuevo. DocumentFragment evita
    // reflows intermedios (mucho más rápido con 99 productos).
    const fragment = document.createDocumentFragment();
    ordered.forEach((card) => fragment.appendChild(card));
    productsGrid.appendChild(fragment);

    // Guardamos el orden aleatorio para poder restaurarlo cuando el
    // usuario saque el filtro de categoría.
    window.__krakoaRandomOrder = ordered.slice();

    // Exponemos una función para reordenar el DOM según un criterio.
    // La usa filterProducts cuando hay categoría activa (orden alfabético).
    window.__krakoaReorderProducts = (mode) => {
      const grid = document.querySelector("#products");
      if (!grid) return;

      let newOrder;
      if (mode === "alpha") {
        // Orden alfabético por data-name (que ya está en minúsculas).
        newOrder = Array.from(grid.querySelectorAll(".product-card")).sort(
          (a, b) =>
            (a.dataset.name || "").localeCompare(b.dataset.name || "", "es")
        );
      } else {
        // Restaurar el orden aleatorio original.
        newOrder = window.__krakoaRandomOrder || [];
        if (newOrder.length === 0) return;
      }

          const frag = document.createDocumentFragment();
    newOrder.forEach((card) => frag.appendChild(card));
    grid.appendChild(frag);
    };
  })();

  // -------------------------
  // SKELETON LOADER DEL CATÁLOGO
  // -------------------------
  // Mientras cada imagen base (.product-image-base) se está cargando,
  // el contenedor .product-image no tiene .loaded y el CSS muestra
  // el shimmer. Cuando la imagen termina de cargar, agregamos .loaded
  // y el shimmer se desvanece.
  // Hay que manejar dos casos:
  //   1) La imagen ya cargó antes de correr este código (cache, o ya
  //      estaba en viewport al recargar). Se detecta con img.complete.
  //   2) La imagen todavía está cargando (loading=lazy). Se detecta
  //      con el evento 'load'.
  (() => {
    const cards = document.querySelectorAll(".product-image");
    cards.forEach((container) => {
      const img = container.querySelector(".product-image-base");
      if (!img) {
        // Sin imagen base no tiene sentido el skeleton.
        container.classList.add("loaded");
        return;
      }

      // Caso 1: ya cargó (o está en cache).
      if (img.complete && img.naturalWidth > 0) {
        container.classList.add("loaded");
        return;
      }

      // Caso 2: todavía cargando. Escuchamos el load.
      img.addEventListener(
        "load",
        () => container.classList.add("loaded"),
        { once: true }
      );

      // Si por algún motivo la imagen falla, sacamos el skeleton igual
      // para no dejar un shimmer eterno.
      img.addEventListener(
        "error",
        () => container.classList.add("loaded"),
        { once: true }
      );
    });
  })();

  // -------------------------
  // AUTO-SLIDE + HOVER (modelo ↔ remera)
  // -------------------------
  // Una única animación para auto-slide y hover: la remera entra
  // desde la derecha, se sostiene, y sale hacia la derecha. Modelo
  // es el estado base (siempre al final del ciclo).
  //
  // El auto-slide es global: cada 2-10s elige 1-2 tarjetas al azar
  // de las visibles (threshold 0.75, no contiguas en la grilla), las
  // anima con un hold de 3-5s, y aplica un cooldown de 6 turnos para
  // que una tarjeta no repita antes de que otras hayan tenido turno.
  //
  // Precarga condicional: en mobile la remera se descarga al rotar.
  // En desktop se descarga al 10% visible (equivale a lazy).
  //
  // Pausas: document.hidden, hover (desktop), filtro en curso,
  // overlays abiertos (modal, carrito, menú, zoom, promo).
  (() => {
    const cards = Array.from(document.querySelectorAll(".product-card"));
    if (cards.length === 0) return;

    const isDesktop = window.matchMedia("(min-width: 901px)").matches;
    const visibleCards = new Set();
    const SLIDE_DURATION = 320; // 0.32s
    const COOLDOWN_TURNS = 6;
    let turnCounter = 0;

    // Estado por tarjeta: phase = "idle" | "in" | "holding" | "out"
    cards.forEach((card) => {
      card._state = {
        phase: "idle",
        transitionTimer: null,
        holdTimer: null,
        lastTurn: -Infinity,
      };
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const card = entry.target;
          if (entry.intersectionRatio >= 0.75) {
            visibleCards.add(card);
          } else {
            visibleCards.delete(card);
          }
          if (isDesktop && entry.intersectionRatio >= 0.1) {
            const hover = card.querySelector(".product-image-hover");
            if (hover && !hover.src && hover.dataset.src) {
              hover.src = hover.dataset.src;
            }
          }
        });
      },
      { threshold: [0.1, 0.75] }
    );

    cards.forEach((card) => observer.observe(card));

    function getHover(card) {
      return card.querySelector(".product-image-hover");
    }

    function isHovered(card) {
      return card.matches(":hover");
    }

    function loadImage(src) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve();
        img.onerror = () => reject(new Error("No se pudo cargar: " + src));
        img.src = src;
      });
    }

    // S31: elige la variante correcta de la imagen hover según el
    // tamaño de la tarjeta y el DPR del device. En desktop, 1000w
    // (tarjeta de 300-400px CSS × DPR 2 = 600-800px reales).
    // En mobile, 400w con DPR 2 (tarjeta ~180px × 2 = 360px) o
    // 600w con DPR 3 (~540px). Ahorra ~550KB por sesión mobile.
    function pickHoverSrc(hover) {
      if (isDesktop) return hover.dataset.src;
      const dpr = window.devicePixelRatio || 1;
      if (dpr >= 3) return hover.dataset.src600 || hover.dataset.src;
      return hover.dataset.src400 || hover.dataset.src;
    }

    // Cuenta cuántas tarjetas están animándose AHORA (en entrada o
    // en hold). Lo usa scheduleNextSlide para decidir si tiene que
    // disparar rápido (no hay ninguna activa) o esperar normal (ya
    // hay alguna animándose, dejamos que se superpongan).
    function countActiveSlides() {
      let count = 0;
      visibleCards.forEach((card) => {
        const phase = card._state.phase;
        if (phase === "in" || phase === "holding") count++;
      });
      return count;
    }

    // x: 0 = visible en su lugar, 100 = oculta a la derecha.
    function applyHoverPosition(hover, x, opacity) {
      hover.style.transition =
        `transform ${SLIDE_DURATION}ms ease, opacity ${SLIDE_DURATION}ms ease`;
      hover.style.transform = `translateX(${x}%)`;
      hover.style.opacity = String(opacity);
      hover.style.zIndex = "2";
    }

    function slideIn(card) {
      const state = card._state;
      if (state.phase === "in" || state.phase === "holding") return;
      if (state.transitionTimer) {
        clearTimeout(state.transitionTimer);
        state.transitionTimer = null;
      }
      const hover = getHover(card);
      if (!hover) return;

      // Desde idle: setear posición inicial sin transición y forzar
      // reflow para que la animación arranque desde el borde derecho.
      if (state.phase === "idle") {
        hover.style.transition = "none";
        hover.style.zIndex = "2";
        hover.style.transform = "translateX(100%)";
        hover.style.opacity = "0";
        hover.getBoundingClientRect();
      }

      state.phase = "in";
      applyHoverPosition(hover, 0, 1);

      state.transitionTimer = setTimeout(() => {
        state.transitionTimer = null;
        if (state.phase === "in") state.phase = "holding";
      }, SLIDE_DURATION);
    }

    function slideOut(card) {
      const state = card._state;
      if (state.phase === "idle" || state.phase === "out") return;
      if (state.holdTimer) {
        clearTimeout(state.holdTimer);
        state.holdTimer = null;
      }
      if (state.transitionTimer) {
        clearTimeout(state.transitionTimer);
        state.transitionTimer = null;
      }
      const hover = getHover(card);
      if (!hover) return;

      state.phase = "out";
      applyHoverPosition(hover, 100, 0);

      state.transitionTimer = setTimeout(() => {
        state.transitionTimer = null;
        if (state.phase === "out") {
          state.phase = "idle";
          hover.style.transition = "";
          hover.style.zIndex = "";
          hover.style.transform = "";
          hover.style.opacity = "";
        }
      }, SLIDE_DURATION);
    }

    // ¿Dos tarjetas son adyacentes en la grilla?
    // - Misma fila + distancia horizontal ≈ ancho + gap.
    // - Misma columna + distancia vertical ≈ alto + gap.
    function areAdjacent(card1, card2) {
      if (card1 === card2) return false;
      const r1 = card1.getBoundingClientRect();
      const r2 = card2.getBoundingClientRect();
      const TOL = 20;

      const sameRow =
        Math.abs(r1.top - r2.top) < TOL &&
        Math.abs(r1.bottom - r2.bottom) < TOL;
      const sameCol =
        Math.abs(r1.left - r2.left) < TOL &&
        Math.abs(r1.right - r2.right) < TOL;

      if (sameRow) {
        const gap = 14;
        const expectedGap = r1.width + gap;
        if (Math.abs(r1.left - r2.left) <= expectedGap * 1.15) return true;
      }
      if (sameCol) {
        const gap = 14;
        const expectedGap = r1.height + gap;
        if (Math.abs(r1.top - r2.top) <= expectedGap * 1.15) return true;
      }
      return false;
    }

    function shuffle(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    async function triggerSlide(card) {
      const state = card._state;
      if (state.phase !== "idle") return;

      const hover = getHover(card);
      if (!hover) return;

      // Precarga condicional (mobile).
      if (!hover.src && hover.dataset.src) {
        try {
          const src = pickHoverSrc(hover);
          await loadImage(src);
          hover.src = src;
        } catch (error) {
          return;
        }
      }

      // Re-chequear después del await (puede haber cambiado todo).
      if (!visibleCards.has(card)) return;
      if (state.phase !== "idle") return;
      if (isDesktop && isHovered(card)) return;

      card._state.lastTurn = turnCounter;
      slideIn(card);

      const holdTime = 3000 + Math.random() * 2000; // 3-5s
      state.holdTimer = setTimeout(() => {
        state.holdTimer = null;
        if (!isHovered(card)) slideOut(card);
      }, holdTime);
    }

    function triggerRandomSlides() {
      turnCounter++;

      // Cooldown dinámico: si hay pocas tarjetas visibles, esperar 6
      // turnos para que vuelva a rotar la misma es demasiado (con 1
      // sola visible, son ~18s entre rotaciones). Lo ajustamos según
      // cuántas hay, con un mínimo de 2 y un máximo de COOLDOWN_TURNS.
      const effectiveCooldown = Math.min(
        COOLDOWN_TURNS,
        Math.max(2, visibleCards.size * 2)
      );

      const candidates = Array.from(visibleCards).filter((card) => {
        if (card._state.phase !== "idle") return false;
        if (isDesktop && isHovered(card)) return false;
        return (turnCounter - card._state.lastTurn) >= effectiveCooldown;
      });

      // Si no hay suficientes por cooldown, resetear los de las
      // visibles para que vuelvan a ser candidatas.
      if (candidates.length === 0) {
        visibleCards.forEach((card) => {
          card._state.lastTurn = -Infinity;
        });
        return;
      }

      const wantTwo = candidates.length >= 2 && Math.random() < 0.5;
      shuffle(candidates);

      const chosen = [candidates[0]];
      if (wantTwo) {
        for (let i = 1; i < candidates.length; i++) {
          if (!chosen.some((c) => areAdjacent(c, candidates[i]))) {
            chosen.push(candidates[i]);
            break;
          }
        }
      }

      chosen.forEach((card) => triggerSlide(card));
    }

    let slideTimer = null;

    function scheduleNextSlide() {
      if (slideTimer) clearTimeout(slideTimer);

      // Delay adaptativo: si no hay ninguna tarjeta animándose ahora,
      // disparamos rápido (300-800ms) para que nunca se sienta "muerto".
      // Si ya hay alguna activa, esperamos normal (1.5-5s) para que las
      // animaciones se superpongan sin amontonarse.
      const hasActive = countActiveSlides() > 0;
      const delay = hasActive
        ? 1500 + Math.random() * 3500   // 1.5-5s
        : 300 + Math.random() * 500;    // 0.3-0.8s

      slideTimer = setTimeout(() => {
        if (!document.hidden && visibleCards.size > 0) {
          const isRevealing = document.querySelector(
            ".product-card.is-revealing"
          );
          const hasOverlay = document.querySelector(
            ".modal.open, .cart-drawer.open, .mobile-menu.open, .image-zoom.open, .promo-modal.open"
          );
          if (!isRevealing && !hasOverlay) {
            triggerRandomSlides();
          }
        }
        scheduleNextSlide();
      }, delay);
    }

    // Listeners de hover (solo desktop).
    if (isDesktop) {
      cards.forEach((card) => {
        card.addEventListener("mouseenter", () => {
          const state = card._state;

          // Cancelar el holdTimer del auto-slide si lo había: el
          // mouse toma el control hasta que salga.
          if (state.holdTimer) {
            clearTimeout(state.holdTimer);
            state.holdTimer = null;
          }

          if (state.phase === "idle") {
            // Entrada por hover normal.
            slideIn(card);
          } else if (state.phase === "out") {
            // Rebote: la remera estaba saliendo, vuelve a entrar.
            if (state.transitionTimer) {
              clearTimeout(state.transitionTimer);
              state.transitionTimer = null;
            }
            state.phase = "in";
            applyHoverPosition(getHover(card), 0, 1);
            state.transitionTimer = setTimeout(() => {
              state.transitionTimer = null;
              if (state.phase === "in") state.phase = "holding";
            }, SLIDE_DURATION);
          }
          // Si phase === "in" o "holding": ya está visible, no
          // hace falta hacer nada. Solo se cancela el holdTimer
          // (ya hecho arriba).
        });

        card.addEventListener("mouseleave", () => {
          const state = card._state;
          if (state.phase === "in" || state.phase === "holding") {
            slideOut(card);
          }
        });
      });
    }

    // S35: dot click handler. Cambia el color de la tarjeta sin abrir
    // el modal. Actualiza las dos imágenes (base + hover), marca el
    // dot activo, resetea el hover si estaba visible, y recuerda el
    // color para cuando se abra el modal.
    cards.forEach((card) => {
      const badge = card.querySelector(".product-colors-badge");
      if (!badge) return;
      const dots = badge.querySelectorAll(".product-color-dot");
      if (dots.length === 0) return;

      // S36: el badge está FUERA del <button>, así que el :active
      // del botón no se activa al tocarlo (no es descendiente). Ya
      // no hace falta mousedown/touchstart handlers.
      //
      // El click handler procesa el color solo si el target es un
      // dot. Si fue en el fondo del badge, no hace nada (pero
      // cortamos la propagación por las dudas).
      badge.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();

        const dot = event.target.closest(".product-color-dot");
        if (!dot) return;

        const colorSlug = dot.dataset.color;
        if (!colorSlug) return;

        const colorsRaw = card.dataset.colors || "";
        if (!colorsRaw) return;

        let colorsData;
        try {
          colorsData = JSON.parse(colorsRaw);
        } catch (error) {
          return;
        }

        const colorData = colorsData[colorSlug];
        if (!colorData) return;

        // Actualizar imágenes + dot activo.
        if (typeof window.__krakoaUpdateCardColor === "function") {
          window.__krakoaUpdateCardColor(
            card.dataset.id,
            colorSlug,
            colorData
          );
        }

        // Si el hover (remera) está visible, resetearlo para que
        // no quede el color viejo hasta el próximo ciclo.
        const state = card._state;
        if (state && (state.phase === "in" || state.phase === "holding")) {
          slideOut(card);
        }

        // Recordar el color para el modal.
        if (typeof window.__krakoaSetCardColor === "function") {
          window.__krakoaSetCardColor(card.dataset.id, colorSlug);
        }
      });
    });

    scheduleNextSlide();
  })();

  const tintLayers = [
  document.querySelector("#catalogTintA"),
  document.querySelector("#catalogTintB"),
];
let tintIndex = 0;
let tintTimer = null;

function commitTintSwap() {
  if (!tintTimer) return;
  clearTimeout(tintTimer);
  tintTimer = null;
  const old = tintLayers[tintIndex];
  tintIndex = 1 - tintIndex;
  old.classList.remove("visible", "leaving");
}

// S31: altura máxima vista del catálogo. La usa renderTintMarquee para
// calcular cuántos renglones generar. Solo crece (Math.max), así si el
// usuario filtra a una categoría con menos productos, los renglones
// siguen cubriendo la altura máxima anterior (evita "huecos" al volver
// a una categoría con más productos).
let maxCatalogHeight = 0;

// S31: genera el contenido del marquee decorativo dentro de una capa
// de tinte. Crea N renglones con el nombre de la categoría repetido,
// tamaños alternados, direcciones alternadas y delay aleatorio por
// renglón para que no se muevan todos sincronizados.
function renderTintMarquee(layer, categoryName) {
  if (!layer) return;

  const name = (categoryName || "KRAKOA").toUpperCase();
  // 20 repeticiones del nombre + espacio. Cada span mide ~4000px,
  // suficiente para cubrir el viewport en desktop y mobile.
  const text = (name + " ").repeat(20);

  // Medimos la altura actual del catálogo y la acumulamos con la mayor
  // vista hasta ahora. Esto se hace ANTES de aplicar el filtro de
  // categoría (showTint se llama antes de filterProducts), así que la
  // medición corresponde al catálogo completo.
  const catalog = document.querySelector(".catalog");
  if (catalog) {
    maxCatalogHeight = Math.max(maxCatalogHeight, catalog.offsetHeight);
  }
  const height = maxCatalogHeight || window.innerHeight * 2;

  // Cantidad de renglones: la diagonal del catálogo dividida por un
  // promedio de 70px por renglón. El +10 es margen. El Math.max(30, ...)
  // asegura un mínimo para catálogos chicos.
  //
  // S31: sin cap. Volvimos al cálculo original porque el cap de 90
  // dejaba hueco al fondo de la sección. La performance se maneja
  // pausando las animaciones cuando el usuario scrollea y cuando el
  // catálogo no está en viewport (ver más abajo).
  const diagonal = Math.sqrt(
    height * height + window.innerWidth * window.innerWidth
  );
  const rowCount = Math.max(30, Math.ceil(diagonal / 70) + 10);

  // Tamaños que se alternan (todos entre 60px y 110px).
  const sizes = [95, 75, 110, 60, 85, 105, 70, 90];

  let html = '<div class="tint-marquee">';
  for (let i = 0; i < rowCount; i++) {
    const size = sizes[i % sizes.length];
    // Delay aleatorio negativo: cada renglón empieza en un punto
    // distinto del ciclo de 80s, así no van todos sincronizados.
    const delay = (Math.random() * 80).toFixed(2);
    html += `<div class="tint-marquee-row" style="font-size:${size}px">`;
    html += `<span style="animation-delay:-${delay}s">${text}</span>`;
    html += `<span aria-hidden="true" style="animation-delay:-${delay}s">${text}</span>`;
    html += `</div>`;
  }
  html += '</div>';

  layer.innerHTML = html;
}

// S31: pausa de la marquesina. El navegador no está obligado a
// detener las animaciones cuando el usuario scrollea, y en mobile
// de gama media eso causaba jank (muchas capas GPU activas
// compitiendo con el scroll). Pausamos con una clase en <body>
// que solo afecta a los spans del marquee (regla CSS scopeada).
//
// - Durante scroll: pausa. Se reanuda 150ms después de que el
//   usuario deja de scrollear (debounce).
// - Off-viewport: pausa cuando el catálogo no está en pantalla
//   (IntersectionObserver). Ahorra batería cuando el usuario
//   está en el hero, el footer o leyendo Cómo Comprar.
const tintMarqueePause = (() => {
  let scrollTimer = null;
  let catalogInView = true;

  function setPaused(paused) {
    document.body.classList.toggle("tint-paused", paused);
  }

  window.addEventListener("scroll", () => {
    setPaused(true);
    if (scrollTimer) clearTimeout(scrollTimer);
    scrollTimer = setTimeout(() => {
      scrollTimer = null;
      setPaused(!catalogInView);
    }, 150);
  }, { passive: true });

  const catalog = document.querySelector("#catalogo");
  if (catalog && "IntersectionObserver" in window) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        catalogInView = entry.isIntersecting;
        if (!scrollTimer) setPaused(!catalogInView);
      });
    }, { threshold: 0 });
    obs.observe(catalog);
  }

  return { setPaused };
})();

// showTint ahora recibe también el NOMBRE de la categoría para pintar
// la marquesina con el texto correcto. Si name no viene, usa "KRAKOA"
// como fallback.
function showTint(color, name) {
  // Si había un swap en curso, lo cerramos ya.
  if (tintTimer) commitTintSwap();

  const active = tintLayers[tintIndex];
  const next = tintLayers[1 - tintIndex];

  // Primer tinte: no había nada visible, solo entra la capa activa.
  if (!active.classList.contains("visible")) {
    active.style.setProperty("--tint-color", color);
    renderTintMarquee(active, name);
    active.classList.add("visible");
    return;
  }

  // Cambio de categoría: capa nueva entra desde la derecha,
  // capa vieja sale hacia la izquierda.
  next.style.setProperty("--tint-color", color);
  renderTintMarquee(next, name);
  next.classList.remove("visible", "leaving");
  void next.offsetWidth; // forzar reflow
  next.classList.add("visible");
  active.classList.add("leaving");

  tintTimer = setTimeout(() => {
    tintTimer = null;
    tintIndex = 1 - tintIndex;
    active.classList.remove("visible", "leaving");
  }, 600);
}

function hideTint() {
  if (tintTimer) commitTintSwap();
  tintLayers[tintIndex].classList.remove("visible");
}
  const backToTop = document.querySelector("#back-to-top");
  const categoryButtons = document.querySelectorAll(".category-button");
  const products = document.querySelectorAll(".product-card");

  let activeCategory = null;

// Normaliza un texto para comparar: minúsculas + sin acentos.
// "Música" → "musica", "Dragón" → "dragon".
// NFD separa cada letra de su acento, y el regex elimina los diacríticos
// (el rango U+0300–U+036F son los "combining diacritical marks").
function normalizeText(str) {
  return (str || "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");
}

function filterProducts({ animate = true } = {}) {
  const raw = normalizeText(searchInput.value).trim();
  // Partimos la búsqueda por espacios: cada palabra se busca por separado.
  // Así "dragon ball" matchea "dragon ball z" y también el tag "dragon".
  const terms = raw.split(/\s+/).filter(Boolean);

  // ── Paso 1: clasificar cada producto y OCULTAR los que no matchean.
  // Las que se van a mostrar NO se tocan todavía (siguen con .is-hidden
  // si estaban ocultas), así no hay flash mientras se reordena.
  const toShowSet = new Set();

  products.forEach((product) => {
    const name = normalizeText(product.dataset.name);
    const tags = normalizeText(product.dataset.tags);
    const category = product.dataset.category ?? "";

    const matchesSearch =
      terms.length === 0 ||
      terms.every((term) => name.includes(term) || tags.includes(term));

    const matchesCategory =
      activeCategory === null || category === activeCategory;

    const shouldShow = matchesSearch && matchesCategory;

    if (shouldShow) {
      toShowSet.add(product);
    } else {
      // Ocultar inmediatamente (display: none).
      if (product.classList.contains("is-revealing")) {
        product.classList.remove("is-revealing");
      }
      if (!product.classList.contains("is-hidden")) {
        product.classList.add("is-hidden");
      }
    }
  });

  // ── Paso 1.5: mostrar u ocultar el bloque "sin resultados" según
  // si quedó alguna tarjeta visible. Se hace acá (antes de tocar el
  // DOM de las tarjetas) para que el mensaje aparezca en el mismo
  // frame en que se oculta la última tarjeta.
  const noResults = document.querySelector("#no-results");
  if (noResults) {
    noResults.hidden = toShowSet.size > 0;
  }

  // ── Paso 2: reordenar el DOM (ahora que las ocultas ya no ocupan
  // lugar, el reorder no genera saltos visuales).
  if (typeof window.__krakoaReorderProducts === "function") {
    window.__krakoaReorderProducts(activeCategory === null ? "random" : "alpha");
  }

  // ── Paso 3: revelar TODAS las visibles con stagger calculado
  // según el ORDEN VISUAL ACTUAL del DOM. No solo las que estaban
  // ocultas: si solo animamos las nuevas, quedan "huecos" donde
  // están las que ya estaban visibles, y el ojo percibe que
  // "algunas aparecen antes que otras". Al reanimar todas, el
  // stagger es parejo y sigue la lectura natural de la grilla
  // (arriba-izquierda → arriba-derecha → abajo...).
  // Trade-off: las que ya estaban visibles hacen un fade-in leve
  // (1 → 0 → 1 en 300ms). Es el comportamiento típico de los
  // grids al filtrar.
  const grid = document.querySelector("#products");
  if (!grid) return;
  const allCards = Array.from(grid.querySelectorAll(".product-card"));

  // Modo sin animación: desocultar las tarjetas de golpe, sin
  // reveal animado. Se usa al limpiar el buscador desde la X, donde
  // reanimar toda la grilla se ve como una "recarga".
  if (!animate) {
    allCards.forEach((product) => {
      if (!toShowSet.has(product)) return;
      product.classList.remove("is-hidden");
      product.classList.remove("is-revealing");
      product.style.removeProperty("--card-stagger");
    });
    return;
  }

  let revealIndex = 0;
  allCards.forEach((product) => {
    // Solo animamos las que DEBEN mostrarse (toShowSet).
    // Las que no, ya quedaron con .is-hidden en el Paso 1 y se
    // saltean acá.
    if (!toShowSet.has(product)) return;

    // Desocultar (por si venía oculta de un filtro anterior) y animar.
    product.classList.remove("is-hidden");
    product.style.setProperty(
      "--card-stagger",
      `${Math.min(revealIndex, 15) * 30}ms`
    );
    // Forzamos reinicio de la animación (por si ya estaba
    // corriendo de un filtrado anterior rápido).
    product.classList.remove("is-revealing");
    void product.offsetWidth;
    product.classList.add("is-revealing");
    revealIndex++;
  });
}

  // -------------------------
  // BARRA DE CATEGORÍAS COMPACTA
  // -------------------------
  // Cuando el header sale de vista (por arriba), la barra de
  // categorías se pone en modo compacto: agrega el logo a la
  // izquierda, el carrito a la derecha, y (en desktop) la lupa.
  // Al volver el header, la barra vuelve a su estado normal.
  const categoriesBar = document.querySelector(".categories");

  if (siteHeader && categoriesBar && "IntersectionObserver" in window) {
    let compactExitTimer = null;
    const icons = categoriesBar.querySelectorAll('.categories-compact-brand, .categories-compact-cart, .categories-compact-search-toggle');

    function triggerIconGlitch() {
      icons.forEach(icon => {
        icon.classList.remove('glitching');
        void icon.offsetWidth;
        icon.classList.add('glitching');
        setTimeout(() => icon.classList.remove('glitching'), 420);
      });
    }

    const headerObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const isOut = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          
          if (isOut) {
            if (compactExitTimer) {
              clearTimeout(compactExitTimer);
              compactExitTimer = null;
            }
            categoriesBar.classList.remove("compact-leaving");
            categoriesBar.classList.add("compact");
            
            // Glitch al entrar
            triggerIconGlitch();
          } else {
            // Si el buscador compacto estaba abierto, lo cerramos
            if (categoriesBar.classList.contains("search-open")) {
              closeCompactSearch();
            }
            
            // Si la barra estaba compacta, disparamos la salida
            if (categoriesBar.classList.contains("compact")) {
              categoriesBar.classList.add("compact-leaving");
              
              // Glitch al salir (el menú se oculta a los 420ms, cuando termina el glitch)
              triggerIconGlitch();

              // Glitch en los iconos del header
              siteHeader.classList.add("header-animating");
              setTimeout(() => {
                siteHeader.classList.remove("header-animating");
              }, 420);
              
              compactExitTimer = setTimeout(() => {
                categoriesBar.classList.remove("compact", "compact-leaving");
                compactExitTimer = null;
              }, 420); 
            }
          }
        });
      },
      { threshold: 0 }
    );
    headerObserver.observe(siteHeader);
  }

  // Listener de animationend: cuando una tarjeta termina de animarse,
// actualizamos su estado definitivo. Se agrega UNA SOLA VEZ al inicio
// (no en cada filtro, para no acumular listeners).
//   - cardHide termina → pasar a is-hidden (display: none).
//   - cardReveal termina → quitar is-revealing (queda en estado base).
// Los checks de clase evitan bugs si el usuario filtró rápido y el
// animationend llega tarde (la clase ya no está, no hacemos nada).
products.forEach((product) => {
  product.addEventListener("animationend", (event) => {
    if (
      event.animationName === "cardReveal" &&
      product.classList.contains("is-revealing")
    ) {
      product.classList.remove("is-revealing");
    }
  });
});

// Aplica un filtro de categoría al catálogo. Puede hacer push al
// history (default, para clicks del usuario) o no (para restauraciones
// desde el botón atrás).
// categoryId: id de la categoría, o null para "todas".
function applyCategoryFilter(categoryId, { push = true, scroll = true } = {}) {
  const previousCategory = activeCategory;
  activeCategory = categoryId;

  // Actualizamos las clases .active de los botones.
  categoryButtons.forEach((btn) => {
    btn.classList.toggle("active", btn.dataset.category === categoryId);
  });

  // Tinte de fondo: on si hay categoría, off si no.
  if (categoryId === null) {
    hideTint();
  } else {
    const btn = Array.from(categoryButtons).find(
      (b) => b.dataset.category === categoryId
    );
    const wrap = btn?.closest(".category-wrap");
    const color =
      wrap?.style.getPropertyValue("--category-color")?.trim() ||
      "#888888";
    // S31: pasamos también el nombre visible de la categoría para
    // que la marquesina decorativa muestre "ANIME", "CINE Y TV", etc.
    const name = btn?.dataset.originalText || "KRAKOA";
    showTint(color, name);
  }

  filterProducts();

  // Scroll al inicio de la grilla. Solo cuando el usuario clickea
  // (no cuando se restaura desde back, para no saltar de lugar).
  // Además, solo scrolleamos si el usuario está MÁS ABAJO que el
  // destino. Si ya está arriba (viendo el header/hero), no movemos
  // la página: cambiar de categoría no debe sacarte de donde estás.
  if (scroll) {
    const productsGrid = document.querySelector("#products");
    if (productsGrid) {
      const top =
        productsGrid.getBoundingClientRect().top + window.scrollY - 110;
      if (window.scrollY > top) {
        window.scrollTo({ top, behavior: "smooth" });
      }
    }
  }

  // Actualizamos el título de la pestaña según el estado (categoría o default).
  updatePageTitle();

  // Actualizamos la URL con la categoría activa (?cat=anime), para
  // poder compartir el filtro. Usamos replaceState para NO agregar
  // una entrada nueva al historial: el "atrás" lo maneja el
  // historyStack con pushHistory, y no queremos pisarlo.
  updateUrlWithCategory(categoryId);

  // Pusheamos al history para que "atrás" pueda restaurar el estado previo.
  if (push) {
    pushHistory("category", { previousCategory });
  }
}

// Actualiza el título de la pestaña según el estado actual:
//   - Modal abierto → "{Producto} | KRAKOA"
//   - Filtro de categoría activo → "{Categoría} | KRAKOA"
//   - Estado por defecto → "KRAKOA | REMERAS"
// Es una función declaration (no arrow), así que se puede llamar desde
// código que aparece antes en el archivo (hoisting).
function updatePageTitle() {
  const DEFAULT_TITLE = "KRAKOA | REMERAS";
  const modalEl = document.querySelector("#product-modal");
  const modalTitleEl = document.querySelector("#modal-title");
  const isModalOpen =
    modalEl && modalEl.getAttribute("aria-hidden") === "false";
  const productName = (modalTitleEl?.textContent ?? "").trim();

  // Prioridad 1: si el modal está abierto, mostramos el producto.
  if (isModalOpen && productName) {
    document.title = `KRAKOA | ${productName}`;
    return;
  }

  // Prioridad 2: si hay filtro de categoría activo, mostramos la categoría.
  if (activeCategory !== null) {
    const btn = Array.from(categoryButtons).find(
      (b) => b.dataset.category === activeCategory
    );
    const catName = (btn?.dataset.originalText ?? "").trim();
    if (catName) {
      document.title = `KRAKOA | ${catName}`;
      return;
    }
  }

  // Default.
  document.title = DEFAULT_TITLE;
}

// Actualiza la query string de la URL con la categoría activa.
//   - Categoría activa: /?cat=anime (mantiene el hash si lo hay)
//   - Sin categoría: borra el ?cat=
// Usa replaceState para no tocar el historial del navegador.
function updateUrlWithCategory(categoryId) {
  try {
    const url = new URL(window.location.href);
    if (categoryId) {
      url.searchParams.set("cat", categoryId);
    } else {
      url.searchParams.delete("cat");
    }
    history.replaceState(history.state, "", url);
  } catch (error) {
    console.warn("[KRAKOA] No se pudo actualizar la URL:", error);
  }
}

// Lee el ?cat= de la URL al cargar la página. Si existe y matchea
// con una categoría válida, aplica el filtro sin push y sin scroll
// (el usuario está empezando a navegar: no queremos sacudirlo).
function applyCategoryFromUrl() {
  try {
    const url = new URL(window.location.href);
    const catId = url.searchParams.get("cat");
    if (!catId) return;

    const exists = Array.from(categoryButtons).some(
      (b) => b.dataset.category === catId
    );
    if (!exists) return;

    applyCategoryFilter(catId, { push: false, scroll: false });
  } catch (error) {
    console.warn("[KRAKOA] No se pudo leer la categoría de la URL:", error);
  }
}

categoryButtons.forEach((button) => {
