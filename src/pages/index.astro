 .hero {
  position: relative;
  padding: 80px 0 60px;
  overflow: hidden;
  background: #141414;
  left: 50%;
  width: 100vw;
  transform: translateX(-50%);
}

.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

  :global(.hero-bg img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.4s ease, transform 9s ease-out;
    transform: scale(1.02) translateX(-1.5%);
  }

      :global(.hero-bg img.active) {
    opacity: 0.32;
    transform: scale(1.1) translateX(1.5%);
     will-change: opacity, transform;

  }

  :global(.hero-bg img:nth-child(even)) {
    transform: scale(1.02) translateX(1.5%);
  }

  :global(.hero-bg img:nth-child(even).active) {
    opacity: 0.32;
    transform: scale(1.1) translateX(-1.5%);
  }

  /* (la referencia a heroZoomRight se eliminó: ese keyframe nunca
     existió, así que la regla era un no-op silencioso.) */

 

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  /* Tres capas apiladas (la primera queda visualmente "arriba"):
     1) Scanlines horizontales finas (estilo CRT), 1px de blanco
        translúcido cada 3px. Muy sutiles: no distraen, pero le dan
        una textura de "pantalla vieja" al hero.
     2) Vignette radial: oscurece los bordes y deja el centro
        limpio, dirigiendo la mirada al título.
     3) Degradado vertical que ya existía (mantiene el contraste
        del texto contra el fondo de imágenes). */
  background-image:
    repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.00) 0px,
      rgba(255, 255, 255, 0.02) 3px,
      transparent 1px,
      transparent 3px
    ),
    radial-gradient(
      ellipse at center,
      transparent 0%,
      transparent 45%,
      rgba(0, 0, 0, 0.9) 100%
    ),
    linear-gradient(
      180deg,
      rgba(11, 11, 11, 0.15) 0%,
      rgba(11, 11, 11, 0.6) 100%
    );
}

.hero-content {
  position: relative;
  z-index: 2;
  width: min(1400px, 90vw);
  margin: 0 auto;
}

.marquee {
  margin: 0px 0 0px;
  padding: 16px 0;
  overflow: hidden;
  background: #0d0d0d;
  border-radius: 12px;
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
          mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
}

.marquee-track {
  display: flex;
  align-items: center;
  width: max-content;
  animation: marqueeScroll 45s linear infinite;
}

.marquee-item {
  display: inline-flex;
  align-items: center;
  gap: 24px;
  padding-right: 24px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #888;
  white-space: nowrap;
}

.marquee-sep {
  font-style: normal;
  color: #444;
}

@keyframes marqueeScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

