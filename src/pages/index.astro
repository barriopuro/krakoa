}

.category-button {
  position: relative;
  padding: 12px 20px;
  border: 3px solid #333;
  border-radius: 0;
  background: #111;
  color: #ccc;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.01em;
  cursor: pointer;
  font-family: inherit;
  overflow: hidden;
  transform: translate(0, 0);
  transition: transform 0.22s ease, color 0.2s ease, border-color 0.2s ease;
  will-change: transform;
}

/* Reserva el ancho del texto original. El ::before es invisible, no
   ocupa altura y no se ve, pero su ancho entra en el cálculo del
   "max-content" del botón. Así, cuando durante el glitch el .cat-text
   pasa a mostrar símbolos más angostos, el botón NO se achica. */
.category-button::before {
  content: attr(data-original-text);
  display: block;
  height: 0;
  overflow: hidden;
  visibility: hidden;
  pointer-events: none;
  font: inherit;
  font-weight: inherit;
  font-size: inherit;
  letter-spacing: inherit;
  white-space: nowrap;
}

/* Hover solo en dispositivos con puntero real (desktop). En mobile
   los navegadores "pegan" el :hover después del tap y el botón se
   queda elevado hasta tocar otro lado. Con esto, en mobile solo
   .active hace el efecto (que es lo correcto: si desactivás el
   filtro, el botón baja al instante). */
@media (hover: hover) and (pointer: fine) {
  .category-wrap:hover .category-button:not(:active) {
    transform: translate(-14px, -14px);
    color: #fff;
  }
}

/* focus-visible (navegación con teclado) sigue funcionando en todos
   los dispositivos. */
.category-button:focus-visible {
  transform: translate(-14px, -14px);
  color: #fff;
}

/* Activo: queda despegado permanentemente, con borde del color. */
.category-button.active {
  transform: translate(-14px, -14px);
  color: #fff;
  border-color: var(--category-color, #888);
}

/* Badge con el conteo de modelos. Aparece al hover del wrap (desktop)
   y se queda mientras el botón está .active (mobile y desktop). Se
   mueve junto al botón cuando éste se eleva, quedando en la esquina
   superior-derecha del botón elevado. */
.category-count {
  position: absolute;
  top: -8px;
  right: -8px;
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 999px;
  background: var(--category-color, #888);
  color: #0a0a0a;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.01em;
  font-variant-numeric: tabular-nums;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
  /* scale(0) = arranca "colapsado" en el centro. Al aparecer, crece
     desde su centro (transform-origin) hasta scale(1). Al desaparecer,
     se encoge de vuelta. */
  transform: translate(0, 0) scale(0);
  transform-origin: center;
  /* Pop out: ease-in rápido, sin delay → se encoge apenas se va el
     hover/active. */
  transition: opacity 0.15s ease-in, transform 0.15s ease-in;
  z-index: 10;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
}

@media (hover: hover) and (pointer: fine) {
  .category-wrap:hover .category-count {
    opacity: 1;
    transform: translate(-14px, -14px) scale(1);
    /* Pop in: delay de 200ms (el badge aparece cuando el botón ya
       terminó de elevarse) + overshoot con cubic-bezier "back" →
       el badge se pasa un toque de tamaño y vuelve, se siente "pop".
       La opacidad no tiene overshoot, solo fade-in limpio. */
    transition: opacity 0.15s ease 0.2s,
                transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s;
  }
}

/* .active funciona en TODOS los dispositivos (mobile incluido). */
:global(.category-button.active ~ .category-count) {
  opacity: 1;
  transform: translate(-14px, -14px) scale(1);
  transition: opacity 0.15s ease 0.2s,
              transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s;
}

/* --------------------------- */
/* GLITCH SUTIL DE CATEGORÍAS  */
/* --------------------------- */

/* Los glitches ahora son spans REALES. .cat-text envuelve el texto
   visible y los spans .cat-glitch-a/b muestran la versión scrambled
   encima, posicionados de forma absoluta. */
  .cat-text {
    display: inline-block;
    position: relative;
  }

:global(.cat-glitch-a),
:global(.cat-glitch-b) {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  user-select: none;
  opacity: 0;
  white-space: nowrap;
  z-index: 2;
  font: inherit;
  font-weight: inherit;
  font-size: inherit;
  letter-spacing: inherit;
}

:global(.cat-glitch-a) {
  color: #ff0055;
  text-shadow: 2px 0 rgba(255, 0, 85, 0.95);
}

:global(.cat-glitch-b) {
  color: #00fff0;
  text-shadow: -2px 0 rgba(0, 255, 240, 0.95);
}

:global(.category-button.glitching) :global(.cat-glitch-a) {
  opacity: 1;
  animation: catGlitchA 0.4s steps(9, end) 1,
             catFlickerA 0.4s steps(5, end) 1;
}

:global(.category-button.glitching) :global(.cat-glitch-b) {
  opacity: 1;
  animation: catGlitchB 0.4s steps(9, end) 1,
             catFlickerB 0.4s steps(5, end) 1;
}

/* Glitch de texto unificado con la técnica del hero: 10 keyframes
   con bloques y tiras horizontales variados (inset de 4 lados),
   flips (scaleX/scaleY) en frames clave, y RGB split DOBLE: el
   text-shadow ahora tiene un offset magenta y uno cian al mismo
   tiempo, y la dirección alterna en cada frame. Eso es lo que da
   la sensación "cyberpunk" (los dos colores separados del texto). */
@keyframes catGlitchA {
  0%   { clip-path: inset(10% 0 80% 0);     transform: translate(-4px, 0);           text-shadow: 4px 0 rgba(255, 0, 85, 1), -4px 0 rgba(0, 255, 240, 1); }
  11%  { clip-path: inset(60% 0 10% 0);     transform: translate(5px, 0);            text-shadow: -5px 0 rgba(255, 0, 85, 1), 5px 0 rgba(0, 255, 240, 1); }
  22%  { clip-path: inset(30% 55% 55% 10%); transform: translate(-3px, 0) scaleY(-1); text-shadow: 3px 0 rgba(255, 0, 85, 1), -3px 0 rgba(0, 255, 240, 1); }
  33%  { clip-path: inset(80% 0 5% 0);      transform: translate(6px, 0);            text-shadow: -6px 0 rgba(255, 0, 85, 1), 6px 0 rgba(0, 255, 240, 1); }
  44%  { clip-path: inset(20% 30% 60% 25%); transform: translate(-5px, 0) scaleX(-1); text-shadow: 5px 0 rgba(255, 0, 85, 1), -5px 0 rgba(0, 255, 240, 1); }
  55%  { clip-path: inset(45% 0 40% 0);     transform: translate(3px, 0);            text-shadow: -3px 0 rgba(255, 0, 85, 1), 3px 0 rgba(0, 255, 240, 1); }
  66%  { clip-path: inset(70% 45% 15% 0);   transform: translate(-4px, 0);           text-shadow: 4px 0 rgba(255, 0, 85, 1), -4px 0 rgba(0, 255, 240, 1); }
  77%  { clip-path: inset(5% 0 85% 0);      transform: translate(2px, 0) scaleX(-1); text-shadow: -2px 0 rgba(255, 0, 85, 1), 2px 0 rgba(0, 255, 240, 1); }
  88%  { clip-path: inset(40% 20% 35% 30%); transform: translate(-5px, 0);           text-shadow: 5px 0 rgba(255, 0, 85, 1), -5px 0 rgba(0, 255, 240, 1); }
  100% { clip-path: inset(10% 0 80% 0);     transform: translate(0, 0);              text-shadow: 2px 0 rgba(255, 0, 85, 0.9), -2px 0 rgba(0, 255, 240, 0.9); }
}

@keyframes catGlitchB {
  0%   { clip-path: inset(55% 0 25% 0);     transform: translate(4px, 0);            text-shadow: -4px 0 rgba(0, 255, 240, 1), 4px 0 rgba(255, 0, 85, 1); }
  11%  { clip-path: inset(15% 0 70% 0);     transform: translate(-5px, 0);           text-shadow: 5px 0 rgba(0, 255, 240, 1), -5px 0 rgba(255, 0, 85, 1); }
  22%  { clip-path: inset(75% 30% 10% 0);   transform: translate(3px, 0) scaleX(-1); text-shadow: -3px 0 rgba(0, 255, 240, 1), 3px 0 rgba(255, 0, 85, 1); }
  33%  { clip-path: inset(25% 0 60% 0);     transform: translate(-6px, 0);           text-shadow: 6px 0 rgba(0, 255, 240, 1), -6px 0 rgba(255, 0, 85, 1); }
  44%  { clip-path: inset(40% 15% 50% 35%); transform: translate(5px, 0) scaleY(-1);  text-shadow: -5px 0 rgba(0, 255, 240, 1), 5px 0 rgba(255, 0, 85, 1); }
  55%  { clip-path: inset(85% 0 5% 0);      transform: translate(-3px, 0);           text-shadow: 3px 0 rgba(0, 255, 240, 1), -3px 0 rgba(255, 0, 85, 1); }
  66%  { clip-path: inset(35% 0 45% 0);     transform: translate(4px, 0);            text-shadow: -4px 0 rgba(0, 255, 240, 1), 4px 0 rgba(255, 0, 85, 1); }
  77%  { clip-path: inset(50% 40% 40% 0);   transform: translate(-2px, 0) scaleX(-1); text-shadow: 2px 0 rgba(0, 255, 240, 1), -2px 0 rgba(255, 0, 85, 1); }
  88%  { clip-path: inset(20% 25% 55% 20%); transform: translate(5px, 0);            text-shadow: -5px 0 rgba(0, 255, 240, 1), 5px 0 rgba(255, 0, 85, 1); }
  100% { clip-path: inset(55% 0 25% 0);     transform: translate(0, 0);              text-shadow: -2px 0 rgba(0, 255, 240, 0.9), 2px 0 rgba(255, 0, 85, 0.9); }
}

/* Flicker más "señal que se corta" que "estrella que titila".
   Saltos más discretos, sin llegar a 0. */
@keyframes catFlickerA {
  0%   { opacity: 1; }
  15%  { opacity: 0.65; }
  30%  { opacity: 1; }
  50%  { opacity: 0.75; }
  70%  { opacity: 1; }
  85%  { opacity: 0.6; }
  100% { opacity: 1; }
}

@keyframes catFlickerB {
  0%   { opacity: 1; }
  15%  { opacity: 0.7; }
  30%  { opacity: 0.55; }
  50%  { opacity: 1; }
  70%  { opacity: 0.65; }
  85%  { opacity: 1; }
  100% { opacity: 1; }
}

/* Glitch del borde: cambia el border-color con saltos digitales entre
   gris, magenta y cian. El fondo (#111) NO se toca. Se usa
   box-shadow: inset para reforzar el efecto sin que se salga del
   botón (overflow: hidden lo cliparía). */
:global(.category-button.glitching) {
  animation: catBorderGlitch 0.4s steps(5, end) 1;
}

/* Borde: en vez de saltar entre gris/magenta/cian en bucle (que daba
   el look "guirnalda"), ahora hace un flash breve de un solo color
   (magenta) con un inset box-shadow que lo refuerza, y vuelve a gris
   enseguida. La mayor parte del tiempo el borde está en su color
   base (#333), así no compite con el texto del glitch. La idea es
   "interferencia" (un pulso eléctrico), no "luces de fiesta". */
@keyframes catBorderGlitch {
  0%   { border-color: #ff0055; box-shadow: inset 0 0 0 2px rgba(255, 0, 85, 0.35), 0 0 12px rgba(255, 0, 85, 0.5); }
  15%  { border-color: #333;    box-shadow: inset 0 0 0 0 transparent, 0 0 0 transparent; }
  30%  { border-color: #00fff0; box-shadow: inset 0 0 0 2px rgba(0, 255, 240, 0.3), 0 0 10px rgba(0, 255, 240, 0.45); }
  50%  { border-color: #333;    box-shadow: inset 0 0 0 0 transparent, 0 0 0 transparent; }
  70%  { border-color: #ff0055; box-shadow: inset 0 0 0 2px rgba(255, 0, 85, 0.35), 0 0 12px rgba(255, 0, 85, 0.5); }
  85%  { border-color: #333;    box-shadow: inset 0 0 0 0 transparent, 0 0 0 transparent; }
  100% { border-color: #333;    box-shadow: inset 0 0 0 0 transparent, 0 0 0 transparent; }
}

  
  .products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;

    /* Truco para salir del `main` (que tiene max-width) y ocupar
       todo el ancho de la ventana. Mismo truco que el hero. */
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    max-width: 100vw;

    /* Padding interno para que las tarjetas no toquen los bordes. */
    padding: 0 14px;
  }

  .product-card {
    min-width: 0;
  }

  /* Animación de revelado al filtrar (cambio de categoría o búsqueda).
     Las tres clases las maneja el JS, así que van con :global().

     - .is-hidden: display: none. La tarjeta no ocupa lugar en la grilla.
       Es el estado "definitivo" de una tarjeta filtrada.
     - .is-hiding: la tarjeta está en transición hacia .is-hidden.
       Sigue ocupando lugar pero con opacity 0 + scale chico.
     - .is-revealing: la tarjeta está en transición de aparición.
       Arranca con opacity 0 + scale chico y SIN transition (para
       que el punto de partida sea instantáneo). Después el JS
       le quita esta clase y el CSS base la anima a su estado normal.

     La transition del estado base aplica tanto para ocultar como
     para mostrar. La duración (350ms) es la misma para ambos casos,
     así se siente simétrico. */
  :global(.product-card.is-hidden) {
    display: none !important;
  }

     :global(.product-card.is-hidden) {
    display: none !important;
  }

  :global(.product-card.is-revealing) {
    animation: cardReveal 0.3s ease-out both;
    animation-delay: var(--card-stagger, 0ms);
  }

@keyframes cardReveal {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* --------------------------- */
  /* FADE-IN AL SCROLLEAR        */
  /* --------------------------- */

  /* Las secciones arrancan con esta clase (la agrega el JS al cargar),
     y el IntersectionObserver les agrega .is-visible cuando entran al
     viewport. La transición las lleva de opacity 0 + translateY(30px)
     a opacity 1 + translateY(0) en 0.7s. Después de animarse una vez,
     se quedan visibles para siempre (el observer deja de vigilarlas). */
  :global(.section-observe) {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

   :global(.section-observe.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  /* --------------------------- */
  /* GLITCH DEL TÍTULO DEL MODAL */
  /* --------------------------- */

  /* Misma técnica que el hero: clip-path con tiras y bloques, flips,
     RGB split doble en el text-shadow (magenta + cian a la vez),
     steps() para los saltos digitales.
     Se usa en dos momentos:
       1) Al abrir un producto (E19): glitch breve de 400ms.
       2) Cada 15-20s mientras el modal está abierto (E20): glitch
          breve de 300ms.
     La clase que activa esto es .glitching, la misma del hero, pero
     el selector es específico del modal para no interferir con el
     h1 del hero. */
  :global(.modal-info-header h2.glitching) {
    animation: modalTitleGlitch 0.4s steps(9, end) 1;
    will-change: transform, filter, clip-path;
  }

  @keyframes modalTitleGlitch {
    0%   { clip-path: inset(10% 0 80% 0);     transform: translate(-4px, 0);           text-shadow: 4px 0 rgba(255, 0, 85, 1), -4px 0 rgba(0, 255, 240, 1); }
    11%  { clip-path: inset(60% 0 10% 0);     transform: translate(5px, 0);            text-shadow: -5px 0 rgba(255, 0, 85, 1), 5px 0 rgba(0, 255, 240, 1); }
    22%  { clip-path: inset(30% 55% 55% 10%); transform: translate(-3px, 0) scaleY(-1); text-shadow: 3px 0 rgba(255, 0, 85, 1), -3px 0 rgba(0, 255, 240, 1); }
    33%  { clip-path: inset(80% 0 5% 0);      transform: translate(6px, 0);            text-shadow: -6px 0 rgba(255, 0, 85, 1), 6px 0 rgba(0, 255, 240, 1); }
    44%  { clip-path: inset(20% 30% 60% 25%); transform: translate(-5px, 0) scaleX(-1); text-shadow: 5px 0 rgba(255, 0, 85, 1), -5px 0 rgba(0, 255, 240, 1); }
    55%  { clip-path: inset(45% 0 40% 0);     transform: translate(3px, 0);            text-shadow: -3px 0 rgba(255, 0, 85, 1), 3px 0 rgba(0, 255, 240, 1); }
    66%  { clip-path: inset(70% 45% 15% 0);   transform: translate(-4px, 0);           text-shadow: 4px 0 rgba(255, 0, 85, 1), -4px 0 rgba(0, 255, 240, 1); }
    77%  { clip-path: inset(5% 0 85% 0);      transform: translate(2px, 0) scaleX(-1); text-shadow: -2px 0 rgba(255, 0, 85, 1), 2px 0 rgba(0, 255, 240, 1); }
    88%  { clip-path: inset(40% 20% 35% 30%); transform: translate(-5px, 0);           text-shadow: 5px 0 rgba(255, 0, 85, 1), -5px 0 rgba(0, 255, 240, 1); }
    100% { clip-path: inset(10% 0 80% 0);     transform: translate(0, 0);              text-shadow: 2px 0 rgba(255, 0, 85, 0.9), -2px 0 rgba(0, 255, 240, 0.9); }
  }
  
    .product-button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  :global(.product-image) {
    position: relative;
    aspect-ratio: 1 / 1.18;
    background: #141414;
    overflow: hidden;
    border-radius: 15px;
  }

  /* Skeleton loader: el ::before existe SIEMPRE (contenido vacío,
     opacidad 0). Cuando el contenedor NO tiene .loaded, se pone
     opaco y anima el shimmer. Cuando el JS agrega .loaded, vuelve
     a opacidad 0 con fade (por el transition del bloque base).
     Todo con :global() porque .loaded lo maneja el JS. */
  :global(.product-image)::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(
      90deg,
      #161616 0%,
      #2a2a2a 50%,
      #161616 100%
    );
    background-size: 200% 100%;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  :global(.product-image:not(.loaded))::before {
    opacity: 1;
    animation: skeletonShimmer 1.4s ease-in-out infinite;
  }

  @keyframes skeletonShimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .product-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Solo animamos opacity. Se quitó la transición de transform
       porque el scale(1.015) del hover causaba un shift sutil de
       1-2px al cambiar entre las dos imágenes (el navegador
       redondeaba la escala a píxeles distintos y "reasentaba" el
       contenido). Con crossfade puro de opacity el cambio se
       siente igual de fluido y no se mueve nada. */
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* (se eliminó el will-change en hover: promocionar la imagen a una
     capa GPU durante la transición causaba un shift sutil de 1-2px,
     porque la capa se rasterizaba en una posición de subpíxel
     ligeramente distinta a la original. El navegador ya promociona
     solo durante las transiciones de opacity, así que no perdemos
     performance.) */

  /* Imagen base: visible por defecto. Sin transform (se quitó el
     scale del hover para eliminar el shift de 1-2px). */
  .product-image-base {
    opacity: 1;
    z-index: 1;
  }

  /* Imagen hover: oculta por defecto. */
  .product-image-hover {
    opacity: 0;
    z-index: 0;
  }

  /* Hover: la base se va, la hover aparece. Crossfade puro. */
  .product-button:hover .product-image-base {
    opacity: 0;
  }

  .product-button:hover .product-image-hover {
    opacity: 1;
  }

  /* Overlay con degradado abajo de la imagen. */
  .product-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 32px 14px 14px;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--category-color, #888) 10%, rgba(0, 0, 0, 0.88)) 0%,
      color-mix(in srgb, var(--category-color, #888) 10%, rgba(0, 0, 0, 0.6)) 45%,
      rgba(0, 0, 0, 0) 100%
    );
    display: flex;
    flex-direction: column;
    gap: 4px;
    pointer-events: none;
    z-index: 2;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (min-width: 901px) {
    :global(.product-button:hover .product-overlay) {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  .product-category {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #d0d0d0;
    font-size: 11px;
    font-weight: 600;
