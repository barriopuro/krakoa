      : `Por llevar ${total} ${word}, cada una sale ${formatPrice(unitPrice)}`;

    cartTierBanner.hidden = false;
    cartTierBanner.classList.remove("banner-green", "banner-red");
    cartTierBanner.classList.add(isCheaper ? "banner-green" : "banner-red");

    cartTierBannerTimer = setTimeout(() => {
