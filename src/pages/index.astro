      aria-label="Instagram de KRAKOA"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
      </svg>
      <span class="instagram-label">@krakoa.sw</span>
    </a>

    <button
      id="menu-toggle"
      class="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <button
      id="cart-toggle"
      class="cart-button"
      type="button"
      aria-label="Ver mi pedido"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
        <path d="M3 6h18" />
        <path d="M16 10a4 4 0 0 1-8 0" />
      </svg>
      <span id="cart-count" class="cart-count" hidden>0</span>
    </button>
  </div>
</header>

  <!-- MENÚ MOBILE -->
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <div class="mobile-menu-backdrop"></div>

    <aside
      class="mobile-menu-panel"
      role="dialog"
      aria-modal="true"
      aria-label="Menú de navegación"
    >
      <header class="mobile-menu-header">
        <span class="mobile-menu-title">Menú</span>
        <button
          id="mobile-menu-close"
          class="mobile-menu-close"
          type="button"
          aria-label="Cerrar menú"
        >
          ×
        </button>
      </header>

      <nav class="mobile-menu-nav" aria-label="Secciones">
        <a href="#catalogo" data-menu-link>Catálogo</a>
        <a href="#como-comprar" data-menu-link>Cómo Comprar</a>
        <a href="#calidad" data-menu-link>Materiales</a>
        <a
          href="https://instagram.com/krakoa.sw"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </nav>
    </aside>
  </div>

    <main>
      <section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <!-- Primera imagen del hero: estática, con fetchpriority="high",
         para que el navegador la priorice como LCP y la baje antes
         que las imágenes del catálogo. El JS la usa como base y
         solo agrega las 5 rotativas. -->
    <img
      class="hero-bg-img active"
      src={`${base}/${catalogo.products[0].modelo}`}
      alt=""
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </div>
  <div class="hero-content">
    <h1 data-text="CATALOGO_"><span id="hero-text">CATALOGO</span><span id="hero-cursor" class="hero-cursor">_</span></h1>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {[1, 2].map(() =>
      marqueeText.map((item) => (
        <span class="marquee-item">
          {item}
          <i class="marquee-sep">·</i>
        </span>
      ))
    )}
  </div>
</div>

      <section id="catalogo" class="catalog">
        <div class="catalog-tint" id="catalogTintA" aria-hidden="true"></div>
        <div class="catalog-tint" id="catalogTintB" aria-hidden="true"></div>

        <nav class="categories" aria-label="Categorías">
          <!-- Logo compacto: aparece cuando el header sale de vista.
               En desktop se ve el horizontal, en mobile el isotipo.
               S28: es un <button> clickeable que scrollea al tope
               (mismo comportamiento que el botón "volver arriba").
               Los <img> van con alt="" porque el nombre accesible
               lo aporta el aria-label del botón. -->
          <button
            class="categories-compact-brand"
            type="button"
            aria-label="Volver arriba"
          >
            <img class="categories-compact-logo-horizontal" src={`${base}/logos/krakoalogo-horizontal.webp`} alt="" />
            <img class="categories-compact-logo-isotipo" src={`${base}/logos/krakoalogo-isotipo.webp`} alt="" />
          </button>

          <!-- Lupa compacta: solo visible en desktop cuando la barra
               está en modo compacto. Al clickear reemplaza las
               categorías por el input. -->
          <button class="categories-compact-search-toggle" type="button" aria-label="Buscar">
            <svg class="icon-search" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <!-- Wrapper de los botones de categoría. -->
          <div class="categories-buttons">
            {
  categories.map((category, index) => (
    <>
      <span
        class="category-wrap"
        style={`--category-color: ${category.color ?? "#888888"}`}
      >
        <button
          class="category-button"
          data-category={category.id}
          data-original-text={category.name}
        >
          {category.name}
        </button>
        <span class="category-count" aria-hidden="true">
          {productCountByCategory[category.id] ?? 0}
        </span>
      </span>
      {index === 3 && <span class="category-break" aria-hidden="true"></span>}
    </>
  ))
}
          </div>

          <!-- Panel del buscador compacto: aparece cuando el usuario
               clickea la lupa (solo desktop). Reemplaza a las
               categorías en el centro. -->
          <div class="categories-compact-search-panel" id="categories-search-panel">
            <input id="search-compact" type="search" placeholder="Buscar diseño..." autocomplete="off" aria-label="Buscar diseño" />
            <button id="search-compact-close" class="categories-compact-search-close" type="button" aria-label="Cerrar búsqueda">×</button>
          </div>

          <!-- Carrito compacto. -->
          <button class="categories-compact-cart cart-button" type="button" aria-label="Ver mi pedido">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
              <path d="M3 6h18" />
              <path d="M16 10a4 4 0 0 1-8 0" />
            </svg>
            <span id="cart-count-compact" class="cart-count" hidden>0</span>
          </button>
        </nav>

        <div id="products" class="products">
          {
            catalogo.products.map((product, index) => {
              return (
                <article
                  class="product-card"
                  data-name={product.name.toLowerCase()}
                  data-tags={(product.tags || []).join(" ")}
                  data-category={product.category}
                  data-id={product.id}
                  data-extras={JSON.stringify(product.extras || [])}
                  data-modelo-400={`${base}/${product.modelo400}`}
                  data-remera-400={`${base}/${product.remera400}`}
                  data-colors={product.colors ? JSON.stringify(product.colors) : ""}
                  data-default-color={product.defaultColor || ""}
                >
                  <button class="product-button" type="button">
                  <div class="product-image">
                    <img
                      class="product-image-base"
                      src={`${base}/${product.modelo}`}
                      srcset={`${base}/${product.modelo400} 400w, ${base}/${product.modelo600} 600w, ${base}/${product.modelo} 1000w`}
                      sizes="(max-width: 900px) 50vw, (max-width: 1400px) 33vw, 25vw"
                      alt={`Remera ${product.name}`}
                      loading="lazy"
                      decoding="async"
                      fetchpriority={index >= 6 ? "low" : "auto"}
                    />

                    <img
                      class="product-image-hover"
                      data-src={`${base}/${product.remera}`}
                      data-src-400={`${base}/${product.remera400}`}
                      data-src-600={`${base}/${product.remera600}`}
                      alt=""
                      loading="lazy"
                      aria-hidden="true"
                    />

                    <div
                      class="product-overlay"
                      style={`--category-color: ${
                        catalogo.categories.find(
                          (category) => category.id === product.category
                        )?.color ?? "#888888"
                      }`}
                    >
                      <span class="product-category">
                        <i class="category-dot"></i>
                        {product.categoryName}
                      </span>

                      <h3 class="product-title">{product.name}</h3>
                    </div>
                  </div>
                </button>
                {product.colors && Object.keys(product.colors).length > 1 && (
                  <span
                    class="product-colors-badge"
                    style={`--category-color: ${
                      catalogo.categories.find(
                        (category) => category.id === product.category
                      )?.color ?? "#888888"
                    };`}
                  >
                    {Object.entries(product.colors)
                      .slice(0, 4)
                      .map(([slug, color]) => (
                        <span
                          class={`product-color-dot${slug === product.defaultColor ? " active" : ""}`}
                          data-color={slug}
                          style={`--dot-color: ${color.hex};`}
                          title={color.name}
                          aria-label={color.name}
                        ></span>
                      ))}
                    {Object.keys(product.colors).length > 4 && (
                      <span class="product-colors-more">
                        +{Object.keys(product.colors).length - 4}
                      </span>
                    )}
                  </span>
                )}
              </article>
              );
            })
          }
        </div>

        <div id="no-results" class="no-results" hidden>
          <h3 class="no-results-title">No encontramos diseños con esa búsqueda</h3>
          <p class="no-results-sub">Revisá la ortografía o navegá por nuestro catálogo.</p>
          <button id="no-results-reset" type="button" class="no-results-button">
            Ver todo el catálogo
          </button>
        </div>
           </section>

      <!-- CÓMO COMPRAR -->
      <section id="como-comprar" class="faq-section">
        <div class="faq-inner">
          <div class="faq-head">
            <span class="section-kicker">Preguntas Frecuentes</span>
            <h2>Cómo Comprar en <span class="brand-inline"><span class="hero-kra">KRA</span>KOA</span></h2>
            <p class="faq-sub">
              Todo lo que necesitás saber sobre pedidos, pagos, talles y envíos.
            </p>
          </div>

          <div class="faq-list">
            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Cómo realizo mi pedido desde la web?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
