  // -------------------------
  // HISTORY STACK (botón atrás)
  // -------------------------

  // Pila de "acciones" que el usuario hizo y que pueden deshacerse con
  // el botón atrás del navegador. Cada entry tiene:
  //   - kind: el tipo ("modal", "cart", "image-zoom", "mobile-menu",
  //     "promo", "category").
  //   - state: datos extra para poder deshacer (ej: para "category",
  //     el previousCategory).
  // El último es el que está arriba de todo. Cuando el usuario toca
  // "atrás", sacamos el último y deshacemos esa acción.
  let historyStack = [];

  // ¿La acción "kind" es la que está arriba de todo?
  function isTopOfHistory(kind) {
    return (
      historyStack.length > 0 &&
      historyStack[historyStack.length - 1].kind === kind
    );
  }

  // Empuja una acción a la pila y al historial del navegador.
  // state es opcional: guarda datos para poder restaurar después.
  function pushHistory(kind, state = {}) {
    history.pushState({ krakoaOverlay: kind, ...state }, "");
    historyStack.push({ kind, state });
  }

  // Saca la acción de arriba. Dispara history.back(), que a su vez
  // dispara el popstate, que hace la restauración real.
  function popHistory() {
    if (historyStack.length === 0) return;
    history.back();
  }

  // Deshace la acción que está en el tope de la pila.
  // La usa el popstate (que ya viene del back del navegador).
  function closeTopOverlay() {
    const top = historyStack.pop();
    if (!top) return;

    if (top.kind === "modal") {
      closeModalDirect();
    } else if (top.kind === "cart") {
      closeCartDrawerDirect();
    } else if (top.kind === "image-zoom") {
      closeImageZoomDirect();
    } else if (top.kind === "mobile-menu") {
      closeMobileMenuDirect();
    } else if (top.kind === "promo") {
      if (typeof window.KRAKOA_CLOSE_PROMO === "function") {
        window.KRAKOA_CLOSE_PROMO();
      }
    } else if (top.kind === "category") {
      applyCategoryFilter(top.state?.previousCategory ?? null, {
        push: false,
        scroll: false,
      });
    }
  }

  window.addEventListener("popstate", () => {
    closeTopOverlay();
  });


  function saveCart() {
