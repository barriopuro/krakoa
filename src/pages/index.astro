      baseImg.src = `${BASE_PATH}${colorData.modelo}`;
      baseImg.srcset = `${BASE_PATH}${colorData.modelo400} 400w, ${BASE_PATH}${colorData.modelo600} 600w, ${BASE_PATH}${colorData.modelo} 1000w`;
    }

    // Imagen hover (remera). Si ya está cargada, la actualizamos
    // también (para que el auto-slide no muestre el color viejo).
    const hoverImg = card.querySelector(".product-image-hover");
    if (hoverImg) {
      hoverImg.dataset.src = `${BASE_PATH}${colorData.remera}`;
      hoverImg.dataset.src400 = `${BASE_PATH}${colorData.remera400}`;
      hoverImg.dataset.src600 = `${BASE_PATH}${colorData.remera600}`;
      if (hoverImg.src) {
        const isDesktopNow = window.matchMedia(
          "(min-width: 901px)"
        ).matches;
        const dpr = window.devicePixelRatio || 1;
        let newSrc;
        if (isDesktopNow) {
          newSrc = hoverImg.dataset.src;
        } else if (dpr >= 3) {
          newSrc = hoverImg.dataset.src600 || hoverImg.dataset.src;
        } else {
          newSrc = hoverImg.dataset.src400 || hoverImg.dataset.src;
        }
        hoverImg.src = newSrc;
