      visible.classList.add(leaveClass);

      // Cuando termina la transición, limpiamos y swapeamos el rol.
      const cleanup = () => {
        visible.classList.remove(leaveClass);
        visible.classList.remove("active");
        // La que era "visible" pasa a ser la oculta (se queda con el src viejo
        // hasta el próximo render).
        modalImageActive = hidden;
      };
      setTimeout(cleanup, 340); // 320ms de transición + 20ms de margen
    });
  }


  function renderFits() {
    modalFits.innerHTML = "";

    ["Oversize", "Regular"].forEach((fit) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "modal-fit";
      if (fit === selectedFit) btn.classList.add("active");

      btn.innerHTML = fit === "Oversize"
        ? `<strong>Oversize</strong><span>Hombros caídos, corte amplio</span>`
        : `<strong>Regular Fit</strong><span>Corte tradicional al cuerpo</span>`;

      btn.addEventListener("click", () => {
        if (selectedFit === fit) return;
        selectedFit = fit;

        // Si el talle actual no existe en el nuevo corte, bajamos al más alto disponible.
        const sizes = getSizesForFit(selectedFit);
        const exists = sizes.some((item) => item.size === selectedSize);
        if (!exists) {
          selectedSize = sizes[sizes.length - 1].size;
        }

        renderFits();
        renderSizes();
        updateSizeCm();
      });

      modalFits.appendChild(btn);
    });
  }


  function renderSizes() {
    modalSizes.innerHTML = "";

    const sizes = getSizesForFit(selectedFit);

    sizes.forEach(({ size }) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "modal-size";
      btn.textContent = size;
      if (size === selectedSize) btn.classList.add("active");

      btn.addEventListener("click", () => {
        selectedSize = size;
        renderSizes();
        updateSizeCm();
      });

      modalSizes.appendChild(btn);
    });
  }


  function updateSizeCm() {
    const measure = getMeasure(selectedFit, selectedSize);
    if (!measure) {
      modalSizeCm.textContent = "";
      return;
    }
    modalSizeCm.textContent = `${measure.alto} cm alto × ${measure.ancho} cm ancho`;
  }


  function renderQuantity(animate = false) {
    modalQtyValue.textContent = currentQuantity;
    updatePriceBlock(animate);
  }


  // -------------------------
  // BLOQUE DE PRECIO DEL MODAL
  // -------------------------

  // Guardamos el último precio unitario renderizado para detectar
  // cuándo cambia de tier y disparar el flash verde/rojo.
  // Se resetea al abrir el modal (sin flash al abrir).
  let lastUnitPrice = null;

  // Dibuja la tablita de tiers. Marca con .active la fila que corresponde
  // al total proyectado actual.
  function renderPriceTiers(activeTierIndex) {
    modalPriceTiers.innerHTML = "";

    PRICE_TIERS.forEach((tier, index) => {
      const row = document.createElement("div");
      row.className = "modal-price-tier";
      if (index === activeTierIndex) row.classList.add("active");

      const labelEl = document.createElement("span");
      labelEl.className = "modal-price-tier-label";
      labelEl.textContent = tier.label;

      const valueEl = document.createElement("span");
      valueEl.className = "modal-price-tier-value";
      valueEl.textContent = `${formatPrice(tier.price)} c/u`;

      row.appendChild(labelEl);
      row.appendChild(valueEl);
      modalPriceTiers.appendChild(row);
    });
  }

  // Dispara el flash verde o rojo sobre el precio grande.
  function flashPriceElement(el, isCheaper) {
    el.classList.remove("flash-green", "flash-red");
    // Forzamos reflow para que la animación se reinicie aunque ya
    // tenga una clase aplicada de un flash anterior.
    void el.offsetWidth;
    el.classList.add(isCheaper ? "flash-green" : "flash-red");
    setTimeout(() => {
      el.classList.remove("flash-green", "flash-red");
    }, 620);
  }

  // Recalcula y pinta todo el bloque de precio.
  // animate: si es true, dispara el flash cuando cambia el unitario.
  function updatePriceBlock(animate = false) {
    const cartTotal = getTotalCount();
    const projectedTotal = cartTotal + currentQuantity;
    const unitPrice = getUnitPrice(projectedTotal);
    const totalWithProduct = projectedTotal * unitPrice;

    // Precio grande
    modalPriceUnit.textContent = `${formatPrice(unitPrice)} c/u`;

    // Texto chico de contexto
    if (cartTotal === 0) {
      modalPriceSub.textContent =
        currentQuantity === 1
          ? "Llevás 1 remera"
          : `Llevás ${currentQuantity} remeras`;
    } else {
      const word = projectedTotal === 1 ? "remera" : "remeras";
      modalPriceSub.textContent = `Tu pedido queda en ${projectedTotal} ${word}`;
    }

    // Tabla de tiers
    const activeTierIndex = PRICE_TIERS.findIndex(
      (t) => projectedTotal >= t.min && projectedTotal <= t.max
    );
    renderPriceTiers(activeTierIndex);

    // Badge "agregá X más"
    const next = getNextTier(projectedTotal);
    if (next && next.unitsNeeded > 0 && next.unitsNeeded <= 3) {
      const word = next.unitsNeeded === 1 ? "remera" : "remeras";
      modalPriceBadge.textContent = `Agregá ${next.unitsNeeded} ${word} más y todas salen a ${formatPrice(next.price)} c/u`;
      modalPriceBadge.hidden = false;
    } else {
      modalPriceBadge.hidden = true;
    }

    // Total
    modalPriceTotal.textContent = formatPrice(totalWithProduct);

    // Flash (solo si el unitario cambió)
    if (animate && lastUnitPrice !== null && unitPrice !== lastUnitPrice) {
      flashPriceElement(modalPriceUnit, unitPrice < lastUnitPrice);
    }
    lastUnitPrice = unitPrice;
  }

  // Calcula el ancho de la barra de scroll y lo guarda en una variable CSS.
  // Sirve para compensar el "salto" que hace el layout cuando se oculta la barra.
  function getScrollbarWidth() {
    return window.innerWidth - document.documentElement.clientWidth;
  }

  function lockScroll() {
    const scrollbarWidth = getScrollbarWidth();
    if (scrollbarWidth > 0) {
      document.body.style.paddingRight = `${scrollbarWidth}px`;
    }
    document.body.classList.add("modal-open");
  }

  function unlockScroll() {
    document.body.style.paddingRight = "";
    document.body.classList.remove("modal-open");
  }


  function openModal(product) {
    const name = product.querySelector("h3")?.textContent ?? "";
    const category = product.querySelector(".product-category");
    const overlay = product.querySelector(".product-overlay");
    const categoryColor =
      overlay?.style.getPropertyValue("--category-color") ?? "#ffffff";
    const categoryName =
      category?.textContent?.trim() ?? "";

    // Enviamos evento a Clarity: qué producto se vio.
    // Usamos el data-id (slug del producto) como identificador.
    const productIdForClarity = product.dataset.id || "";
    if (window.clarity && productIdForClarity) {
      window.clarity("event", "view_" + productIdForClarity);
    }


    const image = product.querySelector(".product-image-base");
    if (!image) return;

    const modelo = image.getAttribute("src");
    const remera = modelo.replace("/modelo.", "/remera.");

    // Fotos extra: vienen del JSON generado por el script.
    // Cada extra tiene { src, label }. Si no hay, el array queda vacío.
    const extras = product.dataset.extras
      ? JSON.parse(product.dataset.extras)
      : [];

    currentImages = [
      { src: modelo, label: "Modelo" },
      { src: remera, label: "Remera" },
      ...extras.map((extra) => ({
        src: `${base}${extra.src}`,
        label: extra.label,
      })),
      { src: `${base}/talles/oversize.webp`, label: "Talles Oversize" },
      { src: `${base}/talles/regular.webp`, label: "Talles Regular" },
    ];

    currentImageIndex = 0;
    currentProductName = name;
    currentProductId = product.dataset.id || "";
    currentQuantity = 1;
    lastUnitPrice = null;

    // Recalculamos los índices zoomeables para este producto
    // (depende de cuántos slides tenga: 4 sin extras, 5 con 1 extra, etc.)
    zoomableIndices = currentImages
      .map((_, index) => (isZoomableSlide(index, currentImages.length) ? index : -1))
      .filter((index) => index !== -1);

    // Reseteamos las dos capas de imagen para que el próximo modal
    // arranque limpio (sin restos del producto anterior).
    modalImageActive = modalImageA;
    modalImageA.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade", "leave-to-left", "leave-to-right", "leave-fade");
    modalImageB.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade", "leave-to-left", "leave-to-right", "leave-fade");
    modalImageA.src = "";
    modalImageB.src = "";
    selectedFit = "Oversize";
    selectedSize = "L";

    modalTitle.textContent = name;
    modalCategory.textContent = categoryName;

    renderThumbs();
    renderModalImage();
    renderFits();
    renderSizes();
    updateSizeCm();
    renderQuantity();

    modalAdd.classList.remove("is-added");
    modalAdd.textContent = "Agregar al Pedido";

    modal.style.setProperty("--category-color", categoryColor);

    modal.setAttribute("aria-hidden", "false");
    lockScroll();

    // Empujamos el modal a la pila del historial para que el botón "atrás"
    // del celular lo cierre en vez de salir de la página. Si el modal se
    // abrió porque la URL traía un hash (link compartido), NO lo hacemos:
    // el usuario entró directo, no navegó desde la página.
    if (!openingFromHash) {
      pushHistory("modal");
    }

    // Separamos el "pintar el modal" (que existe, pero invisible) del
    // "animar el modal" (agregar .open). Así el navegador tiene un frame
    // completo para calcular layout antes de arrancar la animación.
    // Esto reduce mucho el "tirón" en mobile, especialmente la primera vez.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        modal.classList.add("open");
      });
    });
  }
  


  function closeModal() {
    // Si el modal está en la pila, lo sacamos por ahí: history.back()
    // dispara el popstate, que hace el cierre real. Así el "atrás" del
    // celular y el click en la X quedan perfectamente sincronizados.
    if (isTopOfHistory("modal")) {
      popHistory();
      return;
    }
    closeModalDirect();
  }

  function closeModalDirect() {
    // Si ya está cerrado (aria-hidden="true"), no hacemos nada.
    // Usamos aria-hidden en vez de la clase .open porque .open se agrega
    // dentro de un requestAnimationFrame, y el popstate puede llegar antes.
    if (modal.getAttribute("aria-hidden") === "true") return;

    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    unlockScroll();
  }

  // -------------------------
  // ZOOM DE IMAGEN
  // -------------------------

  // Renderiza la imagen del zoom según zoomImageIndex.
  // Se usa tanto al abrir como al navegar entre fotos zoomeables.
  function renderImageZoom() {
    const current = currentImages[zoomImageIndex];
    if (!current) return;
    imageZoomImg.src = current.src;
    imageZoomImg.alt = `${currentProductName} — ${current.label}`;
  }

  // Abre el zoom apuntando al slide "startIndex".
  function openImageZoom(startIndex) {
    zoomImageIndex = startIndex;
    renderImageZoom();
    imageZoom.setAttribute("aria-hidden", "false");
    imageZoom.classList.add("open");
    pushHistory("image-zoom");
  }

  // Salta a la foto zoomeable anterior / siguiente (con wrap).
  function showZoomPrev() {
    const pos = zoomableIndices.indexOf(zoomImageIndex);
    if (pos === -1) return;
    const prevPos = (pos - 1 + zoomableIndices.length) % zoomableIndices.length;
    zoomImageIndex = zoomableIndices[prevPos];
    renderImageZoom();
  }

  function showZoomNext() {
    const pos = zoomableIndices.indexOf(zoomImageIndex);
    if (pos === -1) return;
    const nextPos = (pos + 1) % zoomableIndices.length;
    zoomImageIndex = zoomableIndices[nextPos];
    renderImageZoom();
  }

  function closeImageZoom() {
    if (isTopOfHistory("image-zoom")) {
      popHistory();
      return;
    }
    closeImageZoomDirect();
  }

  function closeImageZoomDirect() {
    if (imageZoom.getAttribute("aria-hidden") === "true") return;
    imageZoom.classList.remove("open");
    imageZoom.setAttribute("aria-hidden", "true");

    // Limpiamos la src para que no quede la imagen colgada en memoria.
    // La hacemos después de la transición.
    setTimeout(() => {
      if (!imageZoom.classList.contains("open")) {
        imageZoomImg.src = "";
      }
    }, 260);
  }


  function showPreviousImage() {
    currentImageIndex =
      (currentImageIndex - 1 + currentImages.length) % currentImages.length;
    renderModalImage("prev");
  }


  function showNextImage() {
    currentImageIndex = (currentImageIndex + 1) % currentImages.length;
    renderModalImage("next");
  }


  // -------------------------
  // NAVEGACIÓN ENTRE PRODUCTOS
  // -------------------------

  // Devuelve la lista de productos VISIBLES en el ORDEN ACTUAL del DOM
  // (respetando filtros de categoría, búsqueda y reordenamiento).
  //
  // OJO: no usamos el NodeList `products` (que se creó al inicio del
  // script y no se actualiza cuando reordenamos el DOM con appendChild).
  // Consultamos el DOM en vivo para obtener el orden real.
  function getVisibleProducts() {
    return Array.from(
      document.querySelectorAll("#products .product-card")
    ).filter((product) => {
      return product.style.display !== "none";
    });
  }

  // Encuentra el producto actual en el DOM (para saber dónde estamos parados).
  function findCurrentProductIndex(visibleList) {
    return visibleList.findIndex(
      (product) => product.dataset.id === currentProductId
    );
  }

  // Cambia al producto anterior o siguiente con animación.
  // direction: "next" | "prev"
  function switchProduct(direction) {
    if (isSwitchingProduct) return;
    if (!modal.classList.contains("open")) return;

    const visibleList = getVisibleProducts();
    if (visibleList.length === 0) return;

    const currentIndex = findCurrentProductIndex(visibleList);
    if (currentIndex === -1) return;

    let targetIndex;
    if (direction === "next") {
      targetIndex = (currentIndex + 1) % visibleList.length;
    } else {
      targetIndex = (currentIndex - 1 + visibleList.length) % visibleList.length;
    }

    const targetProduct = visibleList[targetIndex];
    if (!targetProduct) return;

    // Si el zoom estaba abierto, lo cerramos antes de cambiar.
    if (imageZoom.getAttribute("aria-hidden") === "false") {
      closeImageZoomDirect();
    }

    isSwitchingProduct = true;

    const modalGrid = modal.querySelector(".modal-grid");
    if (!modalGrid) {
      isSwitchingProduct = false;
      return;
    }

    const outClass = direction === "next" ? "switching-next" : "switching-prev";
    const inClass = direction === "next" ? "switching-in-next" : "switching-in-prev";

    // 1) Animación de salida.
    modalGrid.classList.add(outClass);

    setTimeout(() => {
      modalGrid.classList.remove(outClass);

      // 2) Cargamos el producto nuevo (sin abrir de nuevo el modal).
      loadProductIntoModal(targetProduct);

      // 3) Animación de entrada.
      modalGrid.classList.add(inClass);

      setTimeout(() => {
        modalGrid.classList.remove(inClass);
        isSwitchingProduct = false;
      }, 240);
    }, 190);
  }

  // Carga el contenido de un producto en el modal ya abierto.
  // Es como openModal pero SIN tocar el estado de apertura del modal,
  // el historyStack ni el scroll.
  function loadProductIntoModal(product) {
    const name = product.querySelector("h3")?.textContent ?? "";
    const category = product.querySelector(".product-category");
    const overlay = product.querySelector(".product-overlay");
    const categoryColor =
      overlay?.style.getPropertyValue("--category-color") ?? "#ffffff";
    const categoryName =
      category?.textContent?.trim() ?? "";

    const image = product.querySelector(".product-image-base");
    if (!image) return;

    const modelo = image.getAttribute("src");
    const remera = modelo.replace("/modelo.", "/remera.");

    const extras = product.dataset.extras
      ? JSON.parse(product.dataset.extras)
      : [];

    currentImages = [
      { src: modelo, label: "Modelo" },
      { src: remera, label: "Remera" },
      ...extras.map((extra) => ({
        src: `${base}${extra.src}`,
        label: extra.label,
      })),
      { src: `${base}/talles/oversize.webp`, label: "Talles Oversize" },
      { src: `${base}/talles/regular.webp`, label: "Talles Regular" },
    ];

    currentImageIndex = 0;
    currentProductName = name;
    currentProductId = product.dataset.id || "";
    currentQuantity = 1;
    lastUnitPrice = null;

    zoomableIndices = currentImages
      .map((_, index) => (isZoomableSlide(index, currentImages.length) ? index : -1))
      .filter((index) => index !== -1);

    // Reset de capas del carrusel.
    modalImageActive = modalImageA;
    modalImageA.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade", "leave-to-left", "leave-to-right", "leave-fade");
    modalImageB.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade", "leave-to-left", "leave-to-right", "leave-fade");
    modalImageA.src = "";
    modalImageB.src = "";
    selectedFit = "Oversize";
    selectedSize = "L";

    modalTitle.textContent = name;
    modalCategory.textContent = categoryName;

    renderThumbs();
    renderModalImage();
    renderFits();
    renderSizes();
    updateSizeCm();
    renderQuantity();

    modalAdd.classList.remove("is-added");
    modalAdd.textContent = "Agregar al Pedido";

    modal.style.setProperty("--category-color", categoryColor);

    // Enviamos evento a Clarity: qué producto se vio.
    const productIdForClarity = product.dataset.id || "";
    if (window.clarity && productIdForClarity) {
      window.clarity("event", "view_" + productIdForClarity);
    }

    // Scroll interno del modal: volver arriba (mobile).
    const modalGrid = modal.querySelector(".modal-grid");
    if (modalGrid) {
      modalGrid.scrollTop = 0;
    }
  }

  // Listeners de las flechas de producto.
  modalProductPrev?.addEventListener("click", () => switchProduct("prev"));
  modalProductNext?.addEventListener("click", () => switchProduct("next"));
  modalProductPrevMobile?.addEventListener("click", () => switchProduct("prev"));
  modalProductNextMobile?.addEventListener("click", () => switchProduct("next"));


  products.forEach((product) => {
    const button = product.querySelector(".product-button");
    button?.addEventListener("click", () => {
      openModal(product);
    });
  });

  // Si la URL trae un hash tipo #remera-naruto, abrimos ese producto solo.
  let hashHandled = false;

  function openProductFromHash() {
    if (hashHandled) return;

    const hash = window.location.hash.replace(/^#/, "");
    if (!hash) return;

    const target = Array.from(products).find(
      (product) => product.dataset.id === hash
    );

    if (target) {
      hashHandled = true;

      // OJO: abrimos el modal PRIMERO, y después tocamos el historial.
      // Así, si el pushState falla por algún motivo, el modal ya está abierto
      // y todos los botones siguen funcionando.
      openingFromHash = true;
      openModal(target);
      openingFromHash = false;

      // Ahora hacemos el truco del historial. Si algo falla acá,
      // el modal ya está abierto y no se rompe nada más.
      try {
        const baseUrl = window.location.pathname;
        history.replaceState(null, "", baseUrl);
        history.pushState({ krakoaOverlay: "modal" }, "", `#${hash}`);
        historyStack.push({ kind: "modal", state: {} });
      } catch (error) {
        console.error("[KRAKOA] Error manipulando el historial:", error);
      }
    }
  }

  // Al cargar la página. Lo diferimos con setTimeout para asegurarnos de que
  // TODO el resto del script ya se registró (por si openProductFromHash
  // tira algún error que antes rompía la ejecución del script entero).
  setTimeout(() => {
    try {
      openProductFromHash();
    } catch (error) {
      console.error("[KRAKOA] Error abriendo producto desde el hash:", error);
    }
  }, 0);

  // Nota: no escuchamos "hashchange". Antes lo hacíamos, pero generaba
  // bucles raros cuando el propio openProductFromHash hacía pushState.
  // Si el usuario cambia el hash a mano, recarga y listo.


  modalClose.addEventListener("click", closeModal);
  modalBackdrop.addEventListener("click", closeModal);
  modalPrev.addEventListener("click", showPreviousImage);
  modalNext.addEventListener("click", showNextImage);

  // Atajo: al tocar "Ver tabla de talles", salta a la tabla del corte actual.
  // Las tablas SIEMPRE son los últimos 2 slides:
  //   - Oversize: length - 2
  //   - Regular:  length - 1
  modalSeeChart.addEventListener("click", () => {
    const total = currentImages.length;
    currentImageIndex = selectedFit === "Oversize" ? total - 2 : total - 1;
    renderModalImage("fade");
  });


  modalQtyMinus.addEventListener("click", () => {
    if (currentQuantity > 1) {
      currentQuantity -= 1;
      renderQuantity(true);
    }
  });

  modalQtyPlus.addEventListener("click", () => {
    if (currentQuantity < 20) {
      currentQuantity += 1;
      renderQuantity(true);
    }
  });





  modalSeeCart.addEventListener("click", () => {
    openCartDrawer();
  });


  modalShare.addEventListener("click", async () => {
    // Armamos la URL con el hash del producto (ej: .../#remera-naruto).
    const baseUrl = window.location.origin + window.location.pathname;
    const url = currentProductId ? `${baseUrl}#${currentProductId}` : baseUrl;
    const title = currentProductName;

    if (navigator.share) {
      try {
        await navigator.share({
          title: `KRAKOA | ${title}`,
          text: `Mirá esta remera de KRAKOA: ${title}`,
          url,
        });
      } catch (error) {
        // cancelado
      }
    } else {
      try {
        await navigator.clipboard.writeText(url);
        modalShare.textContent = "¡Enlace copiado!";
        setTimeout(() => {
          modalShare.textContent = "Compartir";
        }, 2000);
      } catch (error) {
        alert("No se pudo copiar el enlace.");
      }
    }
  });


  // El swipe ahora va sobre el contenedor de las dos imágenes, porque la imagen
  // "activa" va cambiando entre la capa A y la B. Escuchar en el wrapper evita
  // tener que reconectar el listener cada vez.

  modalImageWrapper.addEventListener("touchstart", (event) => {
    touchStartX = event.changedTouches[0].screenX;
  });

  modalImageWrapper.addEventListener("touchend", (event) => {
    touchEndX = event.changedTouches[0].screenX;
    const difference = touchStartX - touchEndX;
    if (Math.abs(difference) < 50) return;
    if (difference > 0) {
      showNextImage();
    } else {
      showPreviousImage();
    }
  });

  // -------------------------
  // ZOOM DE IMAGEN — listeners
  // -------------------------

  // Abrir el zoom al hacer click/tap sobre la imagen del carrusel,
  // solo si el slide activo es una foto (no tabla de talles).
  let zoomTouchStartX = 0;
  let zoomTouchStartY = 0;
  let zoomMoved = false;

  modalImageWrapper.addEventListener("touchstart", (event) => {
    zoomTouchStartX = event.changedTouches[0].screenX;
    zoomTouchStartY = event.changedTouches[0].screenY;
    zoomMoved = false;
  });

  modalImageWrapper.addEventListener("touchmove", (event) => {
    const dx = Math.abs(event.changedTouches[0].screenX - zoomTouchStartX);
    const dy = Math.abs(event.changedTouches[0].screenY - zoomTouchStartY);
    if (dx > 8 || dy > 8) zoomMoved = true;
  });

  modalImageWrapper.addEventListener("click", (event) => {
    // Si en mobile el usuario hizo swipe, no disparamos el zoom.
    if (zoomMoved) {
      zoomMoved = false;
      return;
    }
    if (!isZoomableSlide(currentImageIndex, currentImages.length)) return;
    openImageZoom(currentImageIndex);
  });

  // Cerrar el zoom: click en cualquier parte del overlay (incluye la ×).
  // Usamos pointerdown + pointerup para evitar cierres accidentales
  // cuando el toque empieza sobre la imagen y termina afuera (o al revés).
  // La × se maneja aparte (ver más abajo) y NO debe gatillar este handler.
  let zoomPointerDownOnImage = false;

  imageZoom.addEventListener("pointerdown", (event) => {
    // Ignoramos si el pointerdown fue sobre la × o sobre las flechas.
    if (imageZoomClose.contains(event.target)) return;
    if (imageZoomPrev.contains(event.target)) return;
    if (imageZoomNext.contains(event.target)) return;
    zoomPointerDownOnImage = event.target === imageZoomImg;
  });

  imageZoom.addEventListener("pointerup", (event) => {
    // Ignoramos si el pointerup fue sobre la × o sobre las flechas.
    if (imageZoomClose.contains(event.target)) return;
    if (imageZoomPrev.contains(event.target)) return;
    if (imageZoomNext.contains(event.target)) return;

    const upOnImage = event.target === imageZoomImg;
    // Si empezó y terminó sobre la imagen, NO cerramos
    // (es un tap sobre la foto, probablemente queriendo hacer pinch-zoom).
    if (zoomPointerDownOnImage && upOnImage) {
      zoomPointerDownOnImage = false;

      // En DESKTOP, el click sobre la imagen cierra el zoom.
      // El cursor ya muestra lupa con "-", así que el click debe cumplir.
      // En MOBILE no cerramos, porque el usuario podría estar haciendo
      // pinch-to-zoom nativo sobre la foto.
      if (event.pointerType === "mouse") {
        closeImageZoom();
      }
      return;
    }
    zoomPointerDownOnImage = false;
    closeImageZoom();
  });

  // La × cierra sola, sin que el overlay se entere.
  imageZoomClose.addEventListener("click", (event) => {
    event.stopPropagation();
    event.preventDefault();
    closeImageZoom();
  });

  // Flechas del zoom. Usamos pointerdown con stopPropagation porque el
  // overlay tiene su propio listener de pointerdown/pointerup para cerrar.
  // Sin esto, el pointerup del overlay agarraba el click en la flecha y
  // cerraba el zoom.
  imageZoomPrev.addEventListener("pointerdown", (event) => {
    event.stopPropagation();
    event.preventDefault();
    showZoomPrev();
  });

  imageZoomNext.addEventListener("pointerdown", (event) => {
    event.stopPropagation();
    event.preventDefault();
    showZoomNext();
  });

  // Swipe en mobile sobre el overlay del zoom.
  let zoomSwipeStartX = 0;
  let zoomSwipeStartY = 0;

  imageZoom.addEventListener("touchstart", (event) => {
    zoomSwipeStartX = event.changedTouches[0].screenX;
    zoomSwipeStartY = event.changedTouches[0].screenY;
  }, { passive: true });

  imageZoom.addEventListener("touchend", (event) => {
    const dx = event.changedTouches[0].screenX - zoomSwipeStartX;
    const dy = event.changedTouches[0].screenY - zoomSwipeStartY;
    // Si el movimiento fue más vertical que horizontal, no es swipe.
    if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy)) return;
    if (dx < 0) {
      showZoomNext();
    } else {
      showZoomPrev();
    }
  }, { passive: true });


  document.addEventListener("keydown", (event) => {
    // Si el buscador está abierto en mobile y tocan Escape, lo cerramos.
    if (
      event.key === "Escape" &&
      siteHeader?.classList.contains("search-open")
    ) {
      closeSearch();
      return;
    }

    // Primero, si el zoom está abierto, Escape lo cierra solo a él.
    if (imageZoom.getAttribute("aria-hidden") === "false") {
      if (event.key === "Escape") {
        event.stopImmediatePropagation();
        closeImageZoom();
        return;
      }
      if (event.key === "ArrowLeft") {
        event.stopImmediatePropagation();
        showZoomPrev();
        return;
      }
      if (event.key === "ArrowRight") {
        event.stopImmediatePropagation();
        showZoomNext();
        return;
      }
    }

    if (!modal.classList.contains("open")) return;

    // Shift + ← / → cambia de PRODUCTO.
    // ← / → solo cambia de IMAGEN.
    if (event.shiftKey && event.key === "ArrowLeft") {
      event.preventDefault();
      switchProduct("prev");
      return;
    }
    if (event.shiftKey && event.key === "ArrowRight") {
      event.preventDefault();
      switchProduct("next");
      return;
    }

    if (event.key === "Escape") closeModal();
    if (event.key === "ArrowLeft") showPreviousImage();
    if (event.key === "ArrowRight") showNextImage();
  });


