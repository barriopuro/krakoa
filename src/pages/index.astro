  // Al tocar un link interno del menú (#seccion), interceptamos:
  //  - reemplazamos la entrada del menú por la del hash (no se agrega una nueva),
  //  - liberamos el lock sin history.back(),
  //  - cerramos el menú,
  //  - hacemos scroll suave nosotros.
  // Así el "atrás" del celular vuelve a la posición anterior real.
  mobileMenuLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      const href = link.getAttribute("href") || "";

      // Link interno (#algo): interceptamos.
      if (href.startsWith("#")) {
        event.preventDefault();

        // Reemplazamos la entrada del menú (pushState) por la del hash.
        history.replaceState(null, "", href);

        // Sacamos el menú de la pila sin hacer back (ya lo reemplazamos).
        const idx = historyStack
          .map((entry) => entry.kind)
          .lastIndexOf("mobile-menu");
        if (idx !== -1) historyStack.splice(idx, 1);

        // Cerramos el menú sin disparar popHistory.
        closeMobileMenuDirect();

        // Scroll suave a la sección (con un pequeño margen superior).
        const target = document.querySelector(href);
        if (target) {
          const top =
            target.getBoundingClientRect().top +
            window.scrollY -
            20;
          window.scrollTo({ top, behavior: "smooth" });
        }
        return;
      }

      // Link externo (Instagram): solo cerramos el menú normalmente.
      closeMobileMenu();
    });
  });

// -------------------------
// HERO — imágenes rotando
// -------------------------

const heroBg = document.querySelector(".hero-bg");

if (heroBg) {
  // La primera imagen del hero YA está en el HTML con fetchpriority="high".
  // El JS no la crea: la usa como base y agrega las 5 rotativas
  // (aleatorias, distintas a la primera) para la rotación.
  const baseImg = heroBg.querySelector(".hero-bg-img");

  if (baseImg) {
    const baseSrc = baseImg.getAttribute("src");

    const allSrcs = Array.from(
      document.querySelectorAll(".product-card .product-image-base")
    )
      .map((img) => img.getAttribute("src"))
      .filter((src) => src && src !== baseSrc);

    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    // Agregamos 5 imágenes rotativas (la primera ya está estática).
    const picked = shuffleArray(allSrcs).slice(0, 5);

    picked.forEach((src) => {
      const img = document.createElement("img");
      img.src = src;
      img.alt = "";
      img.setAttribute("aria-hidden", "true");
      img.decoding = "async";
      img.fetchPriority = "low";
      img.loading = "lazy";
      heroBg.appendChild(img);
    });

    const heroImgs = heroBg.querySelectorAll("img");

    if (heroImgs.length > 1) {
      let heroIndex = 0;
      let heroRotationInterval = null;

      function startHeroRotation() {
        if (heroRotationInterval) return;
        heroRotationInterval = setInterval(() => {
          heroImgs[heroIndex].classList.remove("active");
          heroIndex = (heroIndex + 1) % heroImgs.length;
          heroImgs[heroIndex].classList.add("active");
        }, 5500);
      }

      function stopHeroRotation() {
        if (heroRotationInterval) {
          clearInterval(heroRotationInterval);
          heroRotationInterval = null;
        }
      }

      // Pausar/reanudar la rotación cuando el hero entra o sale
      // del viewport. Ahorra CPU cuando el usuario está scrolleando
      // el catálogo o leyendo el footer.
      const heroSection = document.querySelector(".hero");
      if (heroSection && "IntersectionObserver" in window) {
        const heroObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              startHeroRotation();
            } else {
              stopHeroRotation();
            }
          });
        }, { threshold: 0.1 });
        heroObserver.observe(heroSection);
      } else {
        startHeroRotation();
      }
    }
  } // cierra el if (baseImg)
}

// -------------------------
// HERO — helpers de texto
// -------------------------

// Devuelve el HTML del texto del hero. Si el texto es parte de
// "KRAKOA" (prefijo), las primeras 3 letras van en amarillo.
function formatHeroText(text) {
  if (!text) return "";
  const WORD = "KRAKOA";
  const isKra = text.length > 0 && WORD.startsWith(text);
  if (!isKra) return text;
  const yellowPart = text.slice(0, 3);
  const whitePart = text.slice(3);
  return `<span class="hero-kra">${yellowPart}</span>${whitePart}`;
}

// -------------------------
// HERO — glitch del título
// -------------------------

// Cada 5-9 segundos, el h1 hace un glitch de 280ms (chromatic aberration
// + slices). Los intervalos son aleatorios para que no se sienta mecánico.
// Respeta prefers-reduced-motion: si el usuario pidió menos movimiento
// en su sistema operativo, no hace nada.
(() => {
  const glitchEl = document.querySelector(".hero-content h1");
  if (!glitchEl) return;

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  const GLITCH_DURATION = 420;  // ms que dura el glitch visible (matchea la animación CSS)
  const MIN_DELAY = 5000;       // 5s mínimo entre glitches
  const MAX_DELAY = 9000;       // 9s máximo entre glitches

  // Símbolos "digitales" para el scrambling de caracteres.
  const SCRAMBLE_CHARS = "@#$%&!?*+=/\\|<>[]{}~^";

  function scrambleText(text, ratio = 0.35) {
    return text
      .split("")
      .map((ch) => {
        if (ch === " " || ch === ".") return ch;
        return Math.random() < ratio
          ? SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)]
          : ch;
      })
      .join("");
  }

  // Creamos los dos spans de glitch una sola vez.
  (() => {
    if (glitchEl.querySelector(".hero-glitch-a")) return;
    const ga = document.createElement("span");
    ga.className = "hero-glitch-a";
    ga.setAttribute("aria-hidden", "true");
    glitchEl.appendChild(ga);
    const gb = document.createElement("span");
    gb.className = "hero-glitch-b";
    gb.setAttribute("aria-hidden", "true");
    glitchEl.appendChild(gb);
  })();

  let heroInView = true;
  const heroSectionForGlitch = document.querySelector(".hero");
  if (heroSectionForGlitch && "IntersectionObserver" in window) {
    const glitchVisibilityObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        heroInView = entry.isIntersecting;
      });
    }, { threshold: 0.1 });
    glitchVisibilityObserver.observe(heroSectionForGlitch);
  }

  function scheduleNextGlitch() {
    const delay = MIN_DELAY + Math.random() * (MAX_DELAY - MIN_DELAY);
    setTimeout(() => {
      // Si el hero no está a la vista, saltamos este ciclo para
      // no gastar CPU. Reagendamos directamente.
      if (!heroInView) {
        scheduleNextGlitch();
        return;
      }
      // Tomamos el texto actual (dataset.text lo mantiene sincronizado
      // el typewriter). El "." final va aparte en #hero-cursor, así
      // que lo sacamos para hacer el scrambling.
      const original = glitchEl.dataset.text || "CATALOGO_";
      const originalVisible = original.replace(/[._]$/, "");
      const scrambled = scrambleText(originalVisible, 0.4);
      const textEl = glitchEl.querySelector("#hero-text");
      const ga = glitchEl.querySelector(".hero-glitch-a");
      const gb = glitchEl.querySelector(".hero-glitch-b");
      // Cambiamos el texto VISIBLE (el principal) durante el glitch.
      if (textEl) textEl.textContent = scrambled;
      // Y los spans de color llevan el mismo texto scrambled.
      if (ga) ga.textContent = scrambled;
      if (gb) gb.textContent = scrambled;
      glitchEl.classList.add("glitching");
      setTimeout(() => {
        glitchEl.classList.remove("glitching");
        // Restauramos el texto visible SOLO si el typewriter no lo pisó
        // (si estaba escribiendo, deja que maneje él y no rompemos nada).
        if (textEl && textEl.textContent === scrambled) {
          textEl.innerHTML = formatHeroText(originalVisible);
        }
        if (ga) ga.textContent = "";
        if (gb) gb.textContent = "";
        scheduleNextGlitch();
      }, GLITCH_DURATION);
    }, delay);
  }

  scheduleNextGlitch();
})();

// -------------------------
// HERO — typewriter CATALOGO ↔ KRAKOA
// -------------------------

// Cada 8-14 segundos (aleatorio), el título se "borra" letra por letra,
// se escribe "KRAKOA", se mantiene un instante, se borra, y se vuelve
// a escribir "CATALOGO". El punto final siempre queda como cursor.
// El glitch sigue corriendo en paralelo y pinta lo que esté visible.
(() => {
  const h1 = document.querySelector(".hero-content h1");
  const textEl = document.querySelector("#hero-text");
  if (!h1 || !textEl) return;

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  const WORD_MAIN = "CATALOGO";
  const WORD_ALT = "KRAKOA";

  const TYPE_DELAY = 80;    // ms por letra al escribir
  const ERASE_DELAY = 45;   // ms por letra al borrar (más rápido)
  const HOLD_ALT = 700;     // ms que KRAKOA se queda visible
  const MIN_CYCLE = 8000;   // 8s mínimo entre ciclos completos
  const MAX_CYCLE = 14000;  // 14s máximo

  let isAnimating = false;

  // Actualiza el texto visible y el data-text (para el glitch).
  // Si el glitch está activo, forzamos reflow para que attr() en los
  // pseudo-elementos se re-evalúe con el nuevo valor.
  function setText(content) {
    textEl.innerHTML = formatHeroText(content);
    h1.dataset.text = content + "_";
    // Si el texto actual es KRAKOA (o un prefijo de KRAKOA), el h1
    // recibe la clase .is-krakoa para usar la fuente custom.
    const isKrakoa = content.length > 0 && "KRAKOA".startsWith(content);
    h1.classList.toggle("is-krakoa", isKrakoa);
    if (h1.classList.contains("glitching")) {
      void h1.offsetWidth;
    }
  }

  function sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  async function typeWord(word) {
    for (let i = 1; i <= word.length; i++) {
      setText(word.slice(0, i));
      await sleep(TYPE_DELAY);
    }
  }

  async function eraseText() {
    const current = textEl.textContent;
    for (let i = current.length - 1; i >= 0; i--) {
      setText(current.slice(0, i));
      await sleep(ERASE_DELAY);
    }
  }

  async function cycle() {
    if (isAnimating) return;
    isAnimating = true;

    await eraseText();          // borrar CATALOGO
    await typeWord(WORD_ALT);   // escribir KRAKOA
    await sleep(HOLD_ALT);      // hold corto
    await eraseText();          // borrar KRAKOA
    await typeWord(WORD_MAIN);  // escribir CATALOGO

    isAnimating = false;
  }

  let typewriterInView = true;
  const heroSectionForTypewriter = document.querySelector(".hero");
  if (heroSectionForTypewriter && "IntersectionObserver" in window) {
    const typewriterVisibilityObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        typewriterInView = entry.isIntersecting;
      });
    }, { threshold: 0.1 });
    typewriterVisibilityObserver.observe(heroSectionForTypewriter);
  }

  function scheduleNext() {
    const delay = MIN_CYCLE + Math.random() * (MAX_CYCLE - MIN_CYCLE);
    setTimeout(async () => {
      // Si el hero no está a la vista, saltamos el ciclo completo.
      if (!typewriterInView) {
        scheduleNext();
        return;
      }
      try {
        await cycle();
      } catch (error) {
        console.error("[KRAKOA] Error en typewriter:", error);
        isAnimating = false;
      }
      scheduleNext();
    }, delay);
  }

  scheduleNext();
})();

// -------------------------
// HERO — reveal por letra (solo en la carga inicial)
// -------------------------

// Cuando el loader se va, el hero revela "CATALOGO" letra por letra
// con un stagger corto. Al terminar, restauramos el HTML normal para
// que el typewriter y el glitch sigan funcionando igual que siempre.
// El reveal se dispara con el evento "krakoa:loaded" que emite el
// loader al empezar a desvanecerse.
(() => {
  const textEl = document.querySelector("#hero-text");
  if (!textEl) return;
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  let played = false;

  function playReveal() {
    if (played) return;
    played = true;

    const originalHTML = textEl.innerHTML;
    const word = "CATALOGO";

    // ── Paso 1: medir la posición exacta de CADA letra en el texto
    // original (como un solo nodo, con kerning correcto).
    // Usamos Range para obtener la caja de cada carácter.
    textEl.textContent = word;
    void textEl.offsetWidth;

    const textRect = textEl.getBoundingClientRect();
    const range = document.createRange();
    const textNode = textEl.firstChild;
    const charLefts = [];
    for (let i = 0; i < word.length; i++) {
      range.setStart(textNode, i);
      range.setEnd(textNode, i + 1);
      charLefts.push(range.getBoundingClientRect().left - textRect.left);
    }

    // ── Paso 2: crear los spans (sin animación, sin transform) para
    // poder medir y reposicionar cada letra con precisión.
    textEl.innerHTML = word
      .split("")
      .map(
        (ch) =>
          `<span class="hero-reveal-letter" style="animation: none; opacity: 0; transform: none">${ch}</span>`
      )
      .join("");
    void textEl.offsetWidth;

    const spans = textEl.querySelectorAll(".hero-reveal-letter");

    // ── Paso 3: alinear cada span con la posición de su letra en el
    // texto original usando margin-left. Se hace en orden y se
    // recalcula después de cada ajuste (getBoundingClientRect fuerza
    // reflow), así cada span arranca desde la posición ya ajustada
    // del anterior. Resultado: cada letra queda EXACTAMENTE en el
    // mismo píxel que en el texto original (con kerning real).
    spans.forEach((span, i) => {
      if (i === 0) return; // el primero ya está en su lugar
      const spanRect = span.getBoundingClientRect();
      const textRectNow = textEl.getBoundingClientRect();
      const currentLeft = spanRect.left - textRectNow.left;
      const targetLeft = charLefts[i];
      const delta = targetLeft - currentLeft;
      if (Math.abs(delta) > 0.1) {
        span.style.marginLeft = `${delta}px`;
        void span.offsetWidth; // reflow para el próximo
      }
    });

    // ── Paso 4: arrancar la animación (quitar overrides inline para
    // que el CSS y el keyframe tomen el control).
    spans.forEach((el, i) => {
      el.style.animation = "";
      el.style.opacity = "";
      el.style.transform = "";
      el.style.animationDelay = `${i * 60}ms`;
    });

    // ── Paso 5: restaurar el HTML original cuando termina el reveal.
    const totalTime = 450 + (word.length - 1) * 60 + 100;
    setTimeout(() => {
      textEl.innerHTML = originalHTML;
    }, totalTime);
  }

  // Esperamos 150ms después del evento para que el fade del loader
  // ya esté en curso (0.45s de duración) y el hero se vea detrás.
  // Sin este delay, las primeras letras aparecen debajo del loader
  // todavía opaco.
  document.addEventListener(
    "krakoa:loaded",
    () => setTimeout(playReveal, 150),
    { once: true }
  );

  // Fallback de red de seguridad: solo si el evento NUNCA llega
  // (por un bug en el loader). A los 15s, se ejecuta igual. Esto
  // no debería pasar nunca en condiciones normales.
  setTimeout(playReveal, 15000);
})();

// -------------------------
// GLITCH OCASIONAL DEL LOGO DEL HEADER
// -------------------------

// Cada 30-60s (aleatorio), el logo horizontal hace un glitch breve.
// Respeta prefers-reduced-motion.
(() => {
  const logo = document.querySelector(".logo-horizontal");
  if (!logo) return;
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  // Bajamos la frecuencia (antes era 30-60s). Ahora el glitch del
  // logo del header aparece cada 15-30s: suficiente para sentirse
  // "vivo" sin ser molesto ni competir con el glitch del hero.
  const MIN_DELAY = 15000;
  const MAX_DELAY = 30000;
  // Antes era 220ms. Lo subimos a 420ms para que coincida con la
  // nueva animación CSS (que ahora tiene la misma duración que el
  // glitch del hero). Si no, la clase se quitaba antes de que
  // terminara la animación.
  const GLITCH_DURATION = 420;

  function triggerLogoGlitch() {
    if (logo.classList.contains("glitching")) return;
    logo.classList.add("glitching");
    setTimeout(() => logo.classList.remove("glitching"), GLITCH_DURATION);
  }

  function scheduleNext() {
    const delay = MIN_DELAY + Math.random() * (MAX_DELAY - MIN_DELAY);
    setTimeout(() => {
      triggerLogoGlitch();
      scheduleNext();
    }, delay);
  }

  // Arranca con un pequeño delay inicial (5s) para que no se
  // superponga con la carga inicial de la página.
  setTimeout(scheduleNext, 5000);
})();

// -------------------------
// FOOTER — partículas
// -------------------------

const footerParticles = document.querySelector(".footer-particles");

if (footerParticles) {
  const PARTICLE_COUNT = 22;

  for (let i = 0; i < PARTICLE_COUNT; i++) {
    const p = document.createElement("span");
    p.className = "footer-particle";

    p.style.left = Math.random() * 100 + "%";
    p.style.animationDelay = Math.random() * 14 + "s";
    p.style.animationDuration = 10 + Math.random() * 10 + "s";

    const size = 1.5 + Math.random() * 2.5;
    p.style.width = size + "px";
    p.style.height = size + "px";

    footerParticles.appendChild(p);
  }

  // Pausamos las animaciones de las partículas cuando el footer
  // no está en viewport. Ahorra GPU y CPU cuando el usuario está
  // en el catálogo o en el hero.
  if ("IntersectionObserver" in window) {
    const footerEl = document.querySelector(".site-footer");
    if (footerEl) {
      const particleObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const particles = footerParticles.querySelectorAll(".footer-particle");
          particles.forEach((p) => {
            p.style.animationPlayState = entry.isIntersecting ? "running" : "paused";
          });
        });
      });
      particleObserver.observe(footerEl);
    }
  }
}

// -------------------------
// GLITCH SUTIL DE CATEGORÍAS
// -------------------------

// Dos "cadenas" independientes de timers desfasadas. Cada cadena elige
// un botón al azar (NO activo) y le aplica .glitching por 320ms. Con
// dos cadenas, los glitches pueden superponerse naturalmente sin
// compartir el momento de inicio.
(() => {
  const buttons = Array.from(document.querySelectorAll(".category-button"));
  if (buttons.length === 0) return;
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  const MIN_DELAY = 3000;
  const MAX_DELAY = 7000;
  // Antes era 320ms. Lo subimos a 400ms para que coincida con la
  // nueva duración CSS (10 keyframes + steps(9) tardan más en
  // "leerse"). Si no, la clase se quitaba antes de que terminara.
  const GLITCH_DURATION = 400;

  // Símbolos "digitales" ANGOSTOS. El objetivo es que el texto scrambled
  // tenga un ancho parecido al original, así el botón no cambia de tamaño
  // ni el menú se reacomoda. Nada de @, #, %, & que son muy anchos.
  const SCRAMBLE_CHARS = "!|/\\+~^_-=";

  function scrambleText(text, ratio = 0.25) {
    return text
      .split("")
      .map((ch) => {
        // Respetamos espacios (separan palabras) y puntos.
        if (ch === " " || ch === ".") return ch;
        return Math.random() < ratio
          ? SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)]
          : ch;
      })
      .join("");
  }

  // Envolvemos el texto de cada botón en .cat-text y agregamos los
  // dos spans de glitch. Se hace una sola vez al cargar.
  buttons.forEach((btn) => {
    if (btn.querySelector(".cat-glitch-a")) return;

    const text = btn.textContent.trim();
    btn.innerHTML = "";

    const textSpan = document.createElement("span");
    textSpan.className = "cat-text";
    textSpan.textContent = text;
    btn.appendChild(textSpan);

    const ga = document.createElement("span");
    ga.className = "cat-glitch-a";
    ga.setAttribute("aria-hidden", "true");
    btn.appendChild(ga);

    const gb = document.createElement("span");
    gb.className = "cat-glitch-b";
    gb.setAttribute("aria-hidden", "true");
    btn.appendChild(gb);

    btn.dataset.originalText = text;
  });

  function triggerGlitch() {
    const candidates = buttons.filter(
      (btn) => !btn.classList.contains("active")
    );

    if (candidates.length > 0) {
      const btn = candidates[Math.floor(Math.random() * candidates.length)];
      if (!btn.classList.contains("glitching")) {
        const original = btn.dataset.originalText || "";
        const scrambled = scrambleText(original, 0.5);
        const textSpan = btn.querySelector(".cat-text");
        const ga = btn.querySelector(".cat-glitch-a");
        const gb = btn.querySelector(".cat-glitch-b");
        // Cambiamos el texto PRINCIPAL (el que siempre se ve) durante el glitch.
        if (textSpan) textSpan.textContent = scrambled;
        // Los spans de color llevan el mismo texto scrambled (para los slices).
        if (ga) ga.textContent = scrambled;
        if (gb) gb.textContent = scrambled;
        btn.classList.add("glitching");
        setTimeout(() => {
          btn.classList.remove("glitching");
          if (textSpan) textSpan.textContent = original;
          if (ga) ga.textContent = "";
          if (gb) gb.textContent = "";
        }, GLITCH_DURATION);
      }
    }
  }

  function startChain() {
    function scheduleNext() {
      const delay = MIN_DELAY + Math.random() * (MAX_DELAY - MIN_DELAY);
      setTimeout(() => {
        triggerGlitch();
        scheduleNext();
      }, delay);
    }
    scheduleNext();
  }

  // Dos cadenas arrancan desfasadas. Los glitches pueden pisarse.
  setTimeout(startChain, 800);
  setTimeout(startChain, 2600);
})();

// -------------------------
// FADE-IN AL SCROLLEAR (secciones)
// -------------------------

// Las secciones "Cómo Comprar", "Calidad" y el footer aparecen
// suavemente cuando entran al viewport por primera vez.
// Usa IntersectionObserver (nativo del navegador): el browser
// detecta cuándo un elemento entra/sale del viewport y dispara un
// callback. Es muchísimo más eficiente que escuchar "scroll" y
// medir posiciones a mano.
//
// La clase .section-observe se agrega DESDE JS (no está en el HTML),
// así si JS falla por algún motivo, las secciones se ven normales
// (progressive enhancement). Si el usuario tiene reduce-motion
// activado, ni siquiera agregamos la clase: todo visible de entrada.
(() => {
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  if (!("IntersectionObserver" in window)) return;

  const sections = document.querySelectorAll(
    "#como-comprar, #calidad, .site-footer"
  );
  if (sections.length === 0) return;

  // Marcamos las secciones como "pendientes de animar" (opacity 0).
  sections.forEach((section) => section.classList.add("section-observe"));

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          // Dejamos de vigilar esta sección: ya se animó, no queremos
          // que se re-anime cada vez que el usuario sube y baja.
          observer.unobserve(entry.target);
        }
      });
    },
    {
      // threshold 0.1: la sección se anima cuando al menos 10% de
      // su altura ya es visible en el viewport.
      // rootMargin -80px: adelanta la animación 80px antes de que
      // la sección "toque" el borde inferior del viewport. Así,
      // cuando el usuario llega por un anchor (#como-comprar), la
      // sección ya está visible y no hay salto.
      threshold: 0.3,
      rootMargin: "0px 0px -80px 0px",
    }
  );

  sections.forEach((section) => observer.observe(section));
})();

// -------------------------
// GLITCH OCASIONAL DEL TÍTULO DEL MODAL (E20)
// -------------------------

// Mientras el modal está abierto, cada 15-20s el título hace un
// glitch breve (300ms). Si el modal está cerrado, no hace nada.
// Respeta prefers-reduced-motion.
(() => {
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  const MIN_DELAY = 15000;
  const MAX_DELAY = 20000;
  const GLITCH_DURATION = 300;

  function scheduleNext() {
    const delay = MIN_DELAY + Math.random() * (MAX_DELAY - MIN_DELAY);
    setTimeout(() => {
      // Solo si el modal está abierto (aria-hidden === "false").
      // Si está cerrado, no hacemos nada y reagendamos.
      if (
        modal &&
        modal.getAttribute("aria-hidden") === "false" &&
        typeof triggerModalTitleGlitch === "function"
      ) {
        triggerModalTitleGlitch(GLITCH_DURATION);
      }
      scheduleNext();
    }, delay);
  }

  scheduleNext();
})();

</script>