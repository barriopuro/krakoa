    const W = rect.width / zoomScale;
    const H = rect.height / zoomScale;
    const container = imageZoom.getBoundingClientRect();

    const maxPanX = Math.max(0, (W * zoomScale - container.width) / 2);
    const maxPanY = Math.max(0, (H * zoomScale - container.height) / 2);

    zoomPanX = Math.max(-maxPanX, Math.min(maxPanX, zoomPanX));
    zoomPanY = Math.max(-maxPanY, Math.min(maxPanY, zoomPanY));
  }

