   /* Animación de cambio de producto: RGB split suave + ruido teal + viñeta. */
  .modal-grid.switching-next,
  .modal-grid.switching-prev {
    animation: rgbSplitSwitch 0.24s steps(7, end);
  }

  @keyframes rgbSplitSwitch {
    0%   { transform: translate(0);         filter: none; }
    25%  { transform: translate(-3px, 1px); filter: drop-shadow(3px 0 rgba(255,0,85,0.4)) drop-shadow(-3px 0 rgba(0,255,240,0.4)); }
    50%  { transform: translate(2px, -1px); filter: drop-shadow(-3px 0 rgba(255,0,85,0.4)) drop-shadow(3px 0 rgba(0,255,240,0.4)); }
    75%  { transform: translate(-1px, 0);   filter: drop-shadow(2px 0 rgba(255,0,85,0.3)) drop-shadow(-2px 0 rgba(0,255,240,0.3)); }
    100% { transform: translate(0);         filter: none; }
  }

  /* Ruido teal (::before) + viñeta (::after) sobre el área de la imagen,
     solo durante el switch. El ruido va abajo (z-index 1), la viñeta arriba
     (z-index 2). Las flechas (z-index 3) y el overlay (z-index 4) quedan
     por encima, así no se tapan. */
  .modal-grid.switching-next .modal-image-area::before,
  .modal-grid.switching-prev .modal-image-area::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='500' height='500'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.25' numOctaves='1' stitchTiles='stitch'/><feColorMatrix type='matrix' values='0.03 0 0 0 0  0 0.12 0 0 0  0 0 0.10 0 0  0 0 0 1 0'/></filter><rect width='500' height='500' filter='url(%23n)'/></svg>");
    background-repeat: repeat;
    opacity: 0;
    animation: switchNoise 0.3s ease;
  }

  .modal-grid.switching-next .modal-image-area::after,
  .modal-grid.switching-prev .modal-image-area::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.5) 25%,
      rgba(0, 0, 0, 0.97) 100%
    );
    opacity: 0;
    animation: switchVignette 0.3s ease;
  }

  @keyframes switchNoise {
    0%   { opacity: 0;    background-position: 0 0; }
    30%  { opacity: 0.85; }
    60%  { opacity: 0.75; background-position: 80px -40px; }
    100% { opacity: 0;    background-position: 0 0; }
  }

  @keyframes switchVignette {
    0%   { opacity: 0; }
    30%  { opacity: 1; }
    70%  { opacity: 1; }
    100% { opacity: 0; }
  }

  /* (el ruido de la galería era un remanente del demo anterior. Ahora
     el único ruido es el teal dentro del .modal-image-area, y la
     viñeta W2A va por encima.) */

