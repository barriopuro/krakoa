      if (cartUnitLineText) cartUnitLineText.textContent = "";
      if (cartDrawerSubtotal) cartDrawerSubtotal.textContent = formatPrice(0);
      if (cartTierBanner) cartTierBanner.hidden = true;
      lastCartUnitPrice = null;
      return;
    }

    const unitPrice = getUnitPrice(total);
    const subtotal = total * unitPrice;

    const itemsHtml = cartItems
      .map((item) => {
        const lineTotal = item.quantity * unitPrice;
        const colorLabel =
          item.color && item.color !== "unico" && item.colorName
            ? `<span>${item.colorName}</span><span>·</span>`
            : "";
        return `
        <div class="cart-item">
          <img
            class="cart-item-img"
            src="${item.image}"
            alt="${item.name}"
            loading="lazy"
          />
          <div class="cart-item-info">
            <div class="cart-item-top">
              <h4>${item.name}</h4>
              <button
                type="button"
                class="cart-item-remove"
                data-action="remove"
                data-key="${item.key}"
                aria-label="Eliminar ${item.name}"
              >
                ×
              </button>
            </div>
            <div class="cart-item-meta">
              ${colorLabel}
              <span>${item.fit}</span>
              <span>·</span>
              <span>Talle <strong>${item.size}</strong></span>
            </div>
            <div class="cart-item-bottom">
              <div class="cart-item-qty">
                <button
                  type="button"
                  data-action="dec"
                  data-key="${item.key}"
                  aria-label="Restar uno"
                >
                  −
                </button>
                <span>${item.quantity}</span>
                <button
                  type="button"
                  data-action="inc"
                  data-key="${item.key}"
                  aria-label="Sumar uno"
                >
                  +
                </button>
              </div>
              <span class="cart-item-line-total">${formatPrice(lineTotal)}</span>
            </div>
          </div>
        </div>
      `;
      })
      .join("");

    cartDrawerBody.innerHTML = `
      <div class="cart-items-header">
        <span>${cartItems.length} ${
      cartItems.length === 1 ? "modelo" : "modelos"
    }</span>
        <button type="button" class="cart-clear" data-action="clear">
          Vaciar lista
        </button>
      </div>
      <div class="cart-items">
        ${itemsHtml}
      </div>
    `;

    // Resumen de precios en el footer
    if (cartUnitLineText) {
      const word = total === 1 ? "prenda" : "prendas";
      cartUnitLineText.textContent = `${total} ${word} × ${formatPrice(unitPrice)} c/u`;
    }
    if (cartDrawerSubtotal) {
      cartDrawerSubtotal.textContent = formatPrice(subtotal);
    }

    // Flash + banner si el unitario cambió respecto del render anterior
    if (animate && lastCartUnitPrice !== null && unitPrice !== lastCartUnitPrice) {
      const isCheaper = unitPrice < lastCartUnitPrice;
      flashCartUnitLine(isCheaper);
      showCartTierBanner(total, unitPrice, isCheaper);
    }
    lastCartUnitPrice = unitPrice;

    // Sugerencia persistente del próximo tier. Si hay un banner
    // temporal en curso (se acaba de cambiar de tier), esta llamada
    // no hace nada y el banner sigue visible hasta los 4s.
    updateCartTierBanner();
  }


  function buildWhatsAppOrderMessage() {
    const total = getTotalCount();
    const unitPrice = getUnitPrice(total);
    const subtotal = total * unitPrice;

    let text = `¡Hola KRAKOA! Quería encargar las siguientes remeras:\n\n`;

    cartItems.forEach((item, index) => {
      const lineTotal = item.quantity * unitPrice;
      text += `${index + 1}. *Remera ${item.name}*\n`;
      if (item.color && item.color !== "unico" && item.colorName) {
        text += `   - Color: *${item.colorName}*\n`;
      }
      text += `   - Corte: *${item.fit}*\n`;
      text += `   - Talle: *${item.size}*\n`;
      text += `   - Cantidad: *${item.quantity}*\n`;
      text += `   - Precio unitario: *${formatPrice(unitPrice)}*\n`;
      text += `   - Subtotal: *${formatPrice(lineTotal)}*\n\n`;
    });

    text += `Subtotal prendas (${total} ${total === 1 ? "unidad" : "unidades"}): *${formatPrice(subtotal)}*\n`;
    text += `Precio por unidad aplicado: *${formatPrice(unitPrice)}*\n`;
    text += `Envío: *A coordinar según zona*\n\n`;
    text += `¿Tienen disponibilidad y cómo coordinamos pago y envío? ¡Gracias!`;

    return text;
  }


  function openCartDrawer() {
    // Si el carrito ya está abierto, no hacemos nada.
    if (cartDrawer.classList.contains("open")) return;

    cartDrawer.classList.add("open");
    cartDrawer.setAttribute("aria-hidden", "false");

    // S29: lockBodyScroll ANTES de cart-open. cart-open dispara
    // `overflow: hidden`, que hace desaparecer la scrollbar. Si
    // lockBodyScroll corriera después, getScrollbarWidth() devolvería
    // 0 y el padding-right no se aplicaría → shift horizontal.
    lockBodyScroll();
    document.body.classList.add("cart-open");

    // Lo empujamos a la pila. Si había un modal debajo, la pila queda
    // ["modal", "cart"], y el primer "atrás" cierra el carrito.
    pushHistory("cart");
  }


  function closeCartDrawer() {
    if (isTopOfHistory("cart")) {
      popHistory();
      return;
    }
    closeCartDrawerDirect();
  }

  function closeCartDrawerDirect() {
    cartDrawer.classList.remove("open");
    cartDrawer.setAttribute("aria-hidden", "true");
    document.body.classList.remove("cart-open");
    // S29: liberamos el lock (con contador, por si el modal sigue abierto).
    unlockBodyScroll();
  }


