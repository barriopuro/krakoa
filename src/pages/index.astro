  // Cambia el color seleccionado: reconstruye las imágenes, resetea
  // el slide a la primera foto, y cierra el zoom si estaba abierto.
  // NO resetea corte/talle/cantidad (no dependen del color).
  function selectColor(slug) {
    if (slug === currentColor) return;
    if (!colorsData || !colorsData[slug]) return;

    // S35: guardamos la etiqueta del slide actual para intentar
    // mantenernos en la misma foto después del cambio de color.
