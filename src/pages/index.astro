  /* El "relleno" verde del botón. Arranca como un rectángulo de ancho
     cero (scaleX(0)) alineado a la izquierda. Cuando el botón recibe
     .is-added, el scaleX va a 1 y el verde se expande de izquierda a
     derecha en 0.4s. Al quitarse la clase, se retrae a la izquierda
     (mismo transform-origin), como una cortina que se cierra. */
  :global(.modal-add)::before {
    content: "";
    position: absolute;
    inset: 0;
    background: #25d366;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  :global(.modal-add.is-added)::before {
    transform: scaleX(1);
  }

  /* El texto del botón va por encima del ::before.
     Necesitamos envolver el texto en un span para poder darle
     position: relative + z-index sin afectar el layout del botón. */
  :global(.modal-add > span) {
    position: relative;
    z-index: 1;
    display: inline-block;
  }

  /* Cuando está en estado "agregado", el texto pasa a blanco para
     contrastar con el verde. La transición de color está declarada
     en el .modal-add base (color 0.25s ease). */
  :global(.modal-add.is-added) {
    color: #fff;
  }

