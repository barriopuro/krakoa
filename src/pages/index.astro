          aria-label="Cerrar menú"
        >
          ×
        </button>
      </header>

      <nav class="mobile-menu-nav" aria-label="Secciones">
        <a href="#catalogo" data-menu-link>Catálogo</a>
        <a href="#como-comprar" data-menu-link>Cómo Comprar</a>
        <a href="#calidad" data-menu-link>Materiales</a>
        <a
          href="https://instagram.com/krakoa.sw"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </nav>
    </aside>
  </div>

    <main>
      <section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <!-- Primera imagen del hero: estática, con fetchpriority="high",
         para que el navegador la priorice como LCP y la baje antes
         que las imágenes del catálogo. El JS la usa como base y
         solo agrega las 5 rotativas. -->
    <img
      class="hero-bg-img active"
      src={`${base}/${catalogo.products[0].modelo}`}
      alt=""
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </div>
  <div class="hero-content">
    <h1 data-text="CATALOGO_"><span id="hero-text">CATALOGO</span><span id="hero-cursor" class="hero-cursor">_</span></h1>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    {[1, 2].map(() =>
      marqueeText.map((item) => (
        <span class="marquee-item">
          {item}
          <i class="marquee-sep">·</i>
        </span>
      ))
    )}
  </div>
</div>

      <section id="catalogo" class="catalog">
        <div class="catalog-tint" id="catalogTintA" aria-hidden="true"></div>
        <div class="catalog-tint" id="catalogTintB" aria-hidden="true"></div>

        <nav class="categories" aria-label="Categorías">
          {
  categories.map((category) => (
    <span
      class="category-wrap"
      style={`--category-color: ${category.color ?? "#888888"}`}
    >
      <button
        class="category-button"
        data-category={category.id}
        data-original-text={category.name}
      >
        {category.name}
      </button>
      <span class="category-count" aria-hidden="true">
        {productCountByCategory[category.id] ?? 0}
      </span>
    </span>
  ))
}
        </nav>

        <div id="products" class="products">
          {
            catalogo.products.map((product) => {
              return (
                <article
                  class="product-card"
                  data-name={product.name.toLowerCase()}
                  data-tags={(product.tags || []).join(" ")}
                  data-category={product.category}
                  data-id={product.id}
                  data-extras={JSON.stringify(product.extras || [])}
                >
                  <button class="product-button" type="button">
                  <div class="product-image">
                    <img
                      class="product-image-base"
                      src={`${base}/${product.modelo}`}
                      alt={`Remera ${product.name}`}
                      loading="lazy"
                      fetchpriority="low"
                    />

                    <img
                      class="product-image-hover"
                      src={`${base}/${product.remera}`}
                      alt=""
                      loading="lazy"
                      aria-hidden="true"
                    />

                    <div
                      class="product-overlay"
                      style={`--category-color: ${
                        catalogo.categories.find(
                          (category) => category.id === product.category
                        )?.color ?? "#888888"
                      }`}
                    >
                      <span class="product-category">
                        <i class="category-dot"></i>
                        {product.categoryName}
                      </span>

                      <h3 class="product-title">{product.name}</h3>
                    </div>
                  </div>
                </button>
              </article>
              );
            })
          }
        </div>
           </section>

      <!-- CÓMO COMPRAR -->
      <section id="como-comprar" class="faq-section">
        <div class="faq-inner">
          <div class="faq-head">
            <span class="section-kicker">Preguntas Frecuentes</span>
            <h2>Cómo Comprar en <span class="brand-inline"><span class="hero-kra">KRA</span>KOA</span></h2>
            <p class="faq-sub">
              Todo lo que necesitás saber sobre pedidos, pagos, talles y envíos.
            </p>
          </div>

          <div class="faq-list">
            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Cómo realizo mi pedido desde la web?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
                  Navegá por el catálogo, elegí tus diseños favoritos, seleccioná el corte
                  (Oversize o Regular Fit), talle y cantidad, y sumalos a <strong>Mi Pedido </strong>
                   con el botón "Agregar al Pedido". Cuando termines, tocá el ícono del carrito
                  (arriba a la derecha) y hacé click en <strong>"Enviar Pedido por WhatsApp"</strong>.
                  Se genera automáticamente tu lista completa para coordinar pago y entrega.
                </p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Qué medios de pago aceptan?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
                  Aceptamos <strong>transferencias bancarias</strong> directas,
                  <strong> Mercado Pago</strong> (dinero en cuenta, tarjetas de débito y crédito), y
                  <strong> efectivo</strong> para entregas previamente coordinadas.
                </p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Hacen envíos a toda la Argentina?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
                  Sí, realizamos envíos a todo el país mediante <strong>Correo Argentino</strong> y
                  <strong> Andreani</strong> (a sucursal o directo a domicilio). También contamos con
                  servicio de mensajería para CABA y zonas de Gran Buenos Aires.
                </p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Cómo sé qué talle elegir?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
                  En cada remera, dentro del modal de detalle, tenés la opción
                  <strong> "Ver gráfico"</strong> que te muestra la tabla de medidas exactas en
                  centímetros (alto × ancho). Te recomendamos medir una remera tuya estirada
                  sobre una mesa plana para comparar. Si te queda la duda, escribinos por
                  WhatsApp y te asesoramos.
                </p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button" aria-expanded="false">
                <span>¿Qué diferencia hay entre corte Oversize y Regular Fit?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="faq-answer">
                <p>
                  El corte <strong>Oversize</strong> tiene una moldería amplia, con hombros caídos
                  y mayor amplitud en el torso para una estética streetwear holgada. El corte
                  <strong> Regular Fit</strong> es el estándar tradicional, más al cuerpo.
                </p>
              </div>
            </div>

            
          </div>

          <div class="faq-cta">
            <div class="faq-cta-text">
              <h3>¿Tenés una consulta especial?</h3>
              <p>
                Atención personalizada vía WhatsApp para dudas sobre talles, stock o pedidos por mayor.
              </p>
            </div>
            <a
              href="https://wa.me/5491132372306?text=Hola%20KRAKOA!%20Tengo%20una%20consulta%20sobre%20el%20cat%C3%A1logo."
              target="_blank"
              rel="noopener noreferrer"
              class="faq-cta-button"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              Hablar por WhatsApp
            </a>
          </div>
        </div>
      </section>

      <!-- CALIDAD Y MATERIALES -->
      <section id="calidad" class="quality-section">
        <div class="quality-inner">
          <div class="quality-head">
            <span class="section-kicker">Materia Prima & Confección</span>
            <h2>Algodón Pesado & Estampas Inalterables</h2>
            <p class="quality-sub">
              Cada prenda de <span class="hero-kra">KRA</span>KOA está pensada bajo estándares de alta calidad.
              No usamos telas livianas ni estampas que se cuartean tras el primer lavado.
            </p>
          </div>

          <div class="quality-pillars">
            <div class="quality-pillar">
              <div class="quality-pillar-head">
              <div class="quality-icon quality-icon--green">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              </div>
              <h3>100% Algodón Peinado 24/1</h3>
              </div>
              <p>
                Hilado premium de fibra larga, de tacto suave pero con gramaje pesado
                (220-240 g) para lograr una caída con cuerpo sin traslucir.
              </p>
            </div>

            <div class="quality-pillar">
              <div class="quality-pillar-head">
              <div class="quality-icon quality-icon--amber">
