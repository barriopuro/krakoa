  // -------------------------
  // HISTORY STACK (botón atrás)
  // -------------------------

  // Pila de "acciones" que el usuario hizo y que pueden deshacerse con
  // el botón atrás del navegador. Cada entry tiene:
  //   - kind: el tipo ("modal", "cart", "image-zoom", "mobile-menu",
  //     "promo", "category").
  //   - state: datos extra para poder deshacer (ej: para "category",
  //     el previousCategory).
  // El último es el que está arriba de todo. Cuando el usuario toca
  // "atrás", sacamos el último y deshacemos esa acción.
  let historyStack = [];

  // ¿La acción "kind" es la que está arriba de todo?
  function isTopOfHistory(kind) {
    return (
      historyStack.length > 0 &&
      historyStack[historyStack.length - 1].kind === kind
    );
  }

  // Empuja una acción a la pila y al historial del navegador.
  // state es opcional: guarda datos para poder restaurar después.
  function pushHistory(kind, state = {}) {
    history.pushState({ krakoaOverlay: kind, ...state }, "");
    historyStack.push({ kind, state });
  }

  // Saca la acción de arriba. Dispara history.back(), que a su vez
  // dispara el popstate, que hace la restauración real.
  function popHistory() {
    if (historyStack.length === 0) return;
    history.back();
  }

  // Deshace la acción que está en el tope de la pila.
  // La usa el popstate (que ya viene del back del navegador).
  function closeTopOverlay() {
    const top = historyStack.pop();
    if (!top) return;

    if (top.kind === "modal") {
      closeModalDirect();
    } else if (top.kind === "cart") {
      closeCartDrawerDirect();
    } else if (top.kind === "image-zoom") {
      closeImageZoomDirect();
    } else if (top.kind === "mobile-menu") {
      closeMobileMenuDirect();
    } else if (top.kind === "promo") {
      if (typeof window.KRAKOA_CLOSE_PROMO === "function") {
        window.KRAKOA_CLOSE_PROMO();
      }
    } else if (top.kind === "category") {
      applyCategoryFilter(top.state?.previousCategory ?? null, {
        push: false,
        scroll: false,
      });
    }
  }

  window.addEventListener("popstate", () => {
    closeTopOverlay();
  });


  function saveCart() {
    try {
      localStorage.setItem(CART_KEY, JSON.stringify(cartItems));
    } catch (error) {
      // Si localStorage está bloqueado, no hacemos nada.
    }
  }


  function getTotalCount() {
    return cartItems.reduce((acc, item) => acc + item.quantity, 0);
  }


  function updateCartBadge() {
    const total = getTotalCount();
    // Ahora hay dos badges: el del header y el de la barra compacta.
    const cartCountCompact = document.querySelector("#cart-count-compact");

    [cartCount, cartCountCompact].forEach((el) => {
      if (!el) return;
      if (total > 0) {
        el.textContent = total;
        el.classList.add("is-visible");
      } else {
        el.classList.remove("is-visible");
      }
    });

    // Actualizamos también el botón "Ver carrito" del modal.
    // Si hay 0 prendas, mostramos "Ver carrito" pelado; si hay, "Ver carrito (N)".
    if (modalSeeCart) {
      modalSeeCart.textContent =
        total > 0 ? `Ver carrito (${total})` : "Ver carrito";
    }
  }


  function addToCart(product) {
    const { name, image, fit, size, quantity, color, colorName } = product;
    // S34: el color entra en la key. Productos sin colores usan
    // "unico" para mantener compatibilidad con ítems viejos del
    // localStorage (que no tenían color y se comportaban como únicos).
    const colorKey = color || "unico";
    const key = `${name}__${fit}__${size}__${colorKey}`;

    const existing = cartItems.find((item) => item.key === key);

    if (existing) {
      existing.quantity += quantity;
    } else {
      cartItems.push({
        key,
        name,
        image,
        fit,
        size,
        quantity,
        color: colorKey,
        colorName: colorName || "",
      });
    }

    saveCart();
    updateCartBadge();
    renderCartDrawer();
  }


  function removeFromCart(key) {
    cartItems = cartItems.filter((item) => item.key !== key);
    saveCart();
    updateCartBadge();
    renderCartDrawer(true);
  }


  function changeQuantity(key, delta) {
    const item = cartItems.find((i) => i.key === key);
    if (!item) return;

    item.quantity += delta;

    if (item.quantity <= 0) {
      removeFromCart(key);
      return;
    }

    saveCart();
    updateCartBadge();
    renderCartDrawer(true);
  }


  function clearCart() {
    cartItems = [];
    saveCart();
    updateCartBadge();
    renderCartDrawer();
  }


  // Estado para detectar cambios de tier y disparar el flash/banner.
  let lastCartUnitPrice = null;
  let cartTierBannerTimer = null;

  function flashCartUnitLine(isCheaper) {
    if (!cartUnitLine) return;
    cartUnitLine.classList.remove("flash-green", "flash-red");
    void cartUnitLine.offsetWidth;
    cartUnitLine.classList.add(isCheaper ? "flash-green" : "flash-red");
    setTimeout(() => {
      cartUnitLine.classList.remove("flash-green", "flash-red");
    }, 620);
  }

  function showCartTierBanner(total, unitPrice, isCheaper) {
    if (!cartTierBanner) return;
    if (cartTierBannerTimer) clearTimeout(cartTierBannerTimer);

    const word = total === 1 ? "remera" : "remeras";
    cartTierBanner.textContent = isCheaper
      ? `✓ Ahora por llevar ${total} ${word}, cada una sale ${formatPrice(unitPrice)}`
      : `Por llevar ${total} ${word}, cada una sale ${formatPrice(unitPrice)}`;

    cartTierBanner.hidden = false;
    cartTierBanner.classList.remove("banner-green", "banner-red");
    cartTierBanner.classList.add(isCheaper ? "banner-green" : "banner-red");

    cartTierBannerTimer = setTimeout(() => {
      cartTierBannerTimer = null;
      // Al vencer el banner temporal, devolvemos el turno a la
      // sugerencia persistente (si aplica).
      updateCartTierBanner();
    }, 4000);
  }

  // Sugerencia persistente en el footer del carrito: cuando el pedido
  // está cerca del próximo tier, mostramos "Agregá N más y todas salen
  // a $X c/u". Reusa getNextTier() y el mismo banner que el feedback
  // de cambio de tier, pero con estilo amarillo (banner-hint) para
  // diferenciarse del verde/rojo temporal.
  //
  // Regla de turnos: si hay un banner temporal en curso (timer activo),
  // esta función NO hace nada. Eso evita pisar el feedback de cambio
  // de tier.
  function updateCartTierBanner() {
    if (!cartTierBanner) return;
    if (cartTierBannerTimer) return;

    const total = getTotalCount();
    if (total === 0) {
      cartTierBanner.hidden = true;
      return;
    }

    const next = getNextTier(total);
    // Sin próximo tier (ya está en el máximo) o falta demasiado para
    // el siguiente: no mostramos nada.
    if (!next || next.unitsNeeded > 3) {
      cartTierBanner.hidden = true;
      return;
    }

    const word = next.unitsNeeded === 1 ? "remera" : "remeras";
    cartTierBanner.textContent = `Agregá ${next.unitsNeeded} ${word} más y todas salen a ${formatPrice(next.price)} c/u`;
    cartTierBanner.hidden = false;
    cartTierBanner.classList.remove("banner-green", "banner-red");
    cartTierBanner.classList.add("banner-hint");
  }

  function renderCartDrawer(animate = false) {
    const total = getTotalCount();

    cartDrawerCount.textContent = total;
    cartDrawerFooter.hidden = total === 0;

    if (cartItems.length === 0) {
