  const faqItems = document.querySelectorAll(".faq-item");

  faqItems.forEach((item) => {
    const question = item.querySelector(".faq-question");
    const answer = item.querySelector(".faq-answer");

    if (!question || !answer) return;

    question.addEventListener("click", () => {
      // S30: glitch breve del texto de la pregunta. Aplica la clase
      // al <button>, pero el CSS solo anima el <span> interno, así
      // el chevron SVG queda quieto.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        if (!question.classList.contains("glitching")) {
          question.classList.add("glitching");
          setTimeout(() => question.classList.remove("glitching"), 340);
        }
      }

      const isOpen = item.classList.contains("open");

      // Cerrar todos los demás (solo uno abierto a la vez).
      faqItems.forEach((other) => {
        if (other === item) return;
        other.classList.remove("open");
        const otherAnswer = other.querySelector(".faq-answer");
        const otherQuestion = other.querySelector(".faq-question");
        if (otherAnswer) otherAnswer.style.maxHeight = "0";
        if (otherQuestion) otherQuestion.setAttribute("aria-expanded", "false");
      });

      // Toggle del actual.
      if (isOpen) {
        item.classList.remove("open");
        answer.style.maxHeight = "0";
        question.setAttribute("aria-expanded", "false");
      } else {
        item.classList.add("open");
        answer.style.maxHeight = answer.scrollHeight + "px";
        question.setAttribute("aria-expanded", "true");
      }
    });
  });

