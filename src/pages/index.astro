  // Aplica el transform actual (translate + scale) y actualiza el cursor.
  function applyImageZoomTransform() {
    if (!imageZoomImg) return;
    imageZoomImg.style.transform =
      `translate(${zoomPanX}px, ${zoomPanY}px) scale(${zoomScale})`;
    imageZoomImg.classList.toggle("is-zoomed", zoomScale > 1);
