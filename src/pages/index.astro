  function resetImageZoomScale() {
    zoomScale = 1;
    zoomPanX = 0;
    zoomPanY = 0;
    zoomIsDragging = false;
    zoomDidDrag = false;
    if (imageZoomImg) {
      imageZoomImg.style.transform = "";
      imageZoomImg.style.transformOrigin = "";
      imageZoomImg.classList.remove("is-zoomed", "is-grabbing");
    }
  }

  // Lista de índices zoomeables del producto actual. Se recalcula
  // cada vez que se abre un modal (porque currentImages cambia).
  let zoomableIndices = [];

  function getSizesForFit(fit) {
    return SIZE_CHART[fit] || [];
  }

  function getMeasure(fit, size) {
    return getSizesForFit(fit).find((item) => item.size === size) || null;
  }


  function renderThumbs() {
    modalThumbs.innerHTML = "";

    currentImages.forEach((image, index) => {
      const thumb = document.createElement("button");
      thumb.type = "button";
      thumb.className = "modal-thumb";
      if (index === currentImageIndex) thumb.classList.add("active");
      thumb.setAttribute("aria-label", `Ver ${image.label}`);

      const img = document.createElement("img");
      img.src = image.src;
      img.alt = image.label;
      img.loading = "lazy";

      thumb.appendChild(img);

      thumb.addEventListener("click", () => {
        const direction = index > currentImageIndex ? "next" : "prev";
        currentImageIndex = index;
        renderModalImage(direction);
      });

      modalThumbs.appendChild(thumb);
    });
  }


  // Renderiza la imagen del modal con una transición direccional.
  // direction: "next" (entra desde la derecha), "prev" (entra desde la izquierda),
  // "fade" (sin desplazamiento, para saltos como "Ver gráfico").
  function renderModalImage(direction = "next") {
    const current = currentImages[currentImageIndex];
    if (!current) return;

    // Marcamos el wrapper como zoomeable solo si el slide actual es una foto.
    modalImageWrapper.classList.toggle(
      "is-zoomable",
      isZoomableSlide(currentImageIndex, currentImages.length)
    );


    const thumbs = modalThumbs.querySelectorAll(".modal-thumb");
    thumbs.forEach((thumb, index) => {
      thumb.classList.toggle("active", index === currentImageIndex);
    });

    // La capa visible y la capa oculta.
    const visible = modalImageActive;
    const hidden = visible === modalImageA ? modalImageB : modalImageA;

    // ¿Es el primer render (no hay nada visible todavía)?
    const isFirstRender = !visible.src;

    if (isFirstRender) {
     visible.src = current.src;
visible.alt = `${currentProductName} — ${current.label}`;
visible.decoding = "async";
visible.classList.add("active");
return;
    }

    // Las clases de animación según la dirección.
    let enterClass, leaveClass;
    if (direction === "next") {
      enterClass = "enter-from-right";
      leaveClass = "leave-to-left";
    } else if (direction === "prev") {
      enterClass = "enter-from-left";
      leaveClass = "leave-to-right";
    } else {
      // "fade"
      enterClass = "enter-fade";
      leaveClass = "leave-fade";
    }

    // 1) Preparamos la capa oculta: src nuevo, posición inicial, sin transición.
    hidden.src = current.src;
hidden.alt = `${currentProductName} — ${current.label}`;
hidden.decoding = "async";
    hidden.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade");
    hidden.classList.add(enterClass);
    // Forzamos reflow para que el navegador registre la posición inicial
    // antes de animar hacia la posición final. Sin esto, a veces el navegador
    // agrupa los cambios de clase y saltea la animación.
    hidden.getBoundingClientRect();

    // 2) Disparamos la animación.
    requestAnimationFrame(() => {
      hidden.classList.remove(enterClass);
      hidden.classList.add("active");

      visible.classList.remove("active");
      visible.classList.add(leaveClass);

      // Cuando termina la transición, limpiamos y swapeamos el rol.
      const cleanup = () => {
        visible.classList.remove(leaveClass);
        visible.classList.remove("active");
        // La que era "visible" pasa a ser la oculta (se queda con el src viejo
        // hasta el próximo render).
        modalImageActive = hidden;
      };
      setTimeout(cleanup, 340); // 320ms de transición + 20ms de margen
    });
  }


  function renderFits() {
    modalFits.innerHTML = "";

    ["Oversize", "Regular"].forEach((fit) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "modal-fit";
      if (fit === selectedFit) btn.classList.add("active");

      btn.innerHTML = fit === "Oversize"
        ? `<strong>Oversize</strong><span>Hombros caídos, corte amplio</span>`
        : `<strong>Regular Fit</strong><span>Corte tradicional al cuerpo</span>`;

      btn.addEventListener("click", () => {
        if (selectedFit === fit) return;
        selectedFit = fit;

        // Si el talle actual no existe en el nuevo corte, bajamos al más alto disponible.
        const sizes = getSizesForFit(selectedFit);
        const exists = sizes.some((item) => item.size === selectedSize);
        if (!exists) {
          selectedSize = sizes[sizes.length - 1].size;
        }

        renderFits();
        renderSizes();
        updateSizeCm();
      });

      modalFits.appendChild(btn);
    });
  }


  function renderSizes() {
    modalSizes.innerHTML = "";

    const sizes = getSizesForFit(selectedFit);

    sizes.forEach(({ size }) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "modal-size";
      btn.textContent = size;
      if (size === selectedSize) btn.classList.add("active");

      btn.addEventListener("click", () => {
        selectedSize = size;
        renderSizes();
        updateSizeCm();
      });

      modalSizes.appendChild(btn);
    });
  }


  function updateSizeCm() {
    const measure = getMeasure(selectedFit, selectedSize);
    if (!measure) {
      modalSizeCm.textContent = "";
      return;
    }
    modalSizeCm.textContent = `${measure.alto} cm alto × ${measure.ancho} cm ancho`;
  }


  function renderQuantity(animate = false) {
    modalQtyValue.textContent = currentQuantity;
    updatePriceBlock(animate);
  }


  // -------------------------
  // BLOQUE DE PRECIO DEL MODAL
  // -------------------------

  // Guardamos el último precio unitario renderizado para detectar
  // cuándo cambia de tier y disparar el flash verde/rojo.
  // Se resetea al abrir el modal (sin flash al abrir).
  let lastUnitPrice = null;

  // Dibuja la tablita de tiers. Marca con .active la fila que corresponde
  // al total proyectado actual.
  function renderPriceTiers(activeTierIndex) {
    modalPriceTiers.innerHTML = "";

    PRICE_TIERS.forEach((tier, index) => {
      const row = document.createElement("div");
      row.className = "modal-price-tier";
      if (index === activeTierIndex) row.classList.add("active");

      const labelEl = document.createElement("span");
      labelEl.className = "modal-price-tier-label";
      labelEl.textContent = tier.label;

      const valueEl = document.createElement("span");
      valueEl.className = "modal-price-tier-value";
      valueEl.textContent = `${formatPrice(tier.price)} c/u`;

      row.appendChild(labelEl);
      row.appendChild(valueEl);
      modalPriceTiers.appendChild(row);
    });
  }

  // Dispara el flash verde o rojo sobre el precio grande.
  function flashPriceElement(el, isCheaper) {
    el.classList.remove("flash-green", "flash-red");
    // Forzamos reflow para que la animación se reinicie aunque ya
    // tenga una clase aplicada de un flash anterior.
    void el.offsetWidth;
    el.classList.add(isCheaper ? "flash-green" : "flash-red");
    setTimeout(() => {
      el.classList.remove("flash-green", "flash-red");
    }, 620);
  }

  // Guarda el último precio renderizado para comparar dígito a dígito.
  // Se resetea a null cuando se abre el modal (sin animación al abrir).
  let lastRenderedPrice = null;

  // Renderiza el precio en #modal-price-unit como una serie de spans
  // (uno por carácter). Si hay un precio anterior y los caracteres en
  // la misma posición son distintos, esos dígitos "ruedan" (sale el
  // viejo, entra el nuevo). Los que no cambian se quedan quietos.
  //
  // Ejemplo: "$25.000" → "$23.000"
  //   Los caracteres cambian en la posición del 5→3 (el 2, 5, ".", 0, 0, 0).
  //   Solo el "5" y el "3" son distintos en esa posición. Los demás
  //   (2, ".", 0, 0, 0) se mantienen. Se anima solo el que cambió.
  function renderPriceDigits(newText, animate = true) {
    if (!modalPriceUnit) return;

    // Si NO hay que animar (primera vez, o se resetea al abrir el modal),
    // reemplazamos el contenido directamente sin spans de animación.
    if (!animate || lastRenderedPrice === null || lastRenderedPrice === newText) {
      modalPriceUnit.textContent = newText;
      lastRenderedPrice = newText;
      return;
    }

    const oldText = lastRenderedPrice;
    // Recorremos carácter por carácter. Manejamos el caso en que las
    // longitudes sean distintas (ej: "$9.000" → "$10.000", que pasa
    // de 6 a 7 caracteres). En ese caso, todos los caracteres a
    // partir de la primera diferencia se animan (no solo uno).
    const maxLen = Math.max(oldText.length, newText.length);
    const fragments = [];

    for (let i = 0; i < maxLen; i++) {
      const oldCh = oldText[i] ?? "";
      const newCh = newText[i] ?? "";

      if (oldCh === newCh) {
        // Carácter sin cambios: se renderiza estático.
        const span = document.createElement("span");
        span.className = "price-digit";
        span.textContent = newCh;
        fragments.push(span);
      } else {
        // Carácter que cambia: se anima con el "out" y el "in".
        const wrapper = document.createElement("span");
        wrapper.className = "price-digit";
        // Clonamos los caracteres a partir del índice i para que
        // todos los que cambian se animen juntos (si las longitudes
        // difieren, es la única forma de que se vea coherente).
        if (oldCh) {
          const out = document.createElement("span");
          out.className = "digit-out";
          out.textContent = oldText.slice(i);
          wrapper.appendChild(out);
        }
        const inEl = document.createElement("span");
        inEl.className = "digit-in";
        inEl.textContent = newText.slice(i);
        wrapper.appendChild(inEl);
        fragments.push(wrapper);
        // Cortamos: el "out" y el "in" ya tienen el resto del texto.
        break;
      }
    }

    // Construimos los fragmentos en un DocumentFragment y los
    // reemplazamos de una sola vez con replaceChildren. Así el
    // contenedor NUNCA queda vacío (que causaba un salto de layout
    // porque el padre colapsaba a 0px por un frame).
    const fragment = document.createDocumentFragment();
    fragments.forEach((frag) => fragment.appendChild(frag));
    modalPriceUnit.replaceChildren(fragment);

    lastRenderedPrice = newText;
  }

  // Recalcula y pinta todo el bloque de precio.
  // animate: si es true, dispara el flash cuando cambia el unitario.
  function updatePriceBlock(animate = false) {
    const cartTotal = getTotalCount();
    const projectedTotal = cartTotal + currentQuantity;
    const unitPrice = getUnitPrice(projectedTotal);
    const totalWithProduct = projectedTotal * unitPrice;

    // Precio grande (con animación de dígitos que ruedan al cambiar).
    // Solo animamos si animate = true (no en la apertura del modal
    // ni cuando se resetea el estado).
    renderPriceDigits(`${formatPrice(unitPrice)} c/u`, animate);

    // Texto chico de contexto
    if (cartTotal === 0) {
      modalPriceSub.textContent =
        currentQuantity === 1
          ? "Llevás 1 remera"
          : `Llevás ${currentQuantity} remeras`;
    } else {
      const word = projectedTotal === 1 ? "remera" : "remeras";
      modalPriceSub.textContent = `Tu pedido queda en ${projectedTotal} ${word}`;
    }

    // Tabla de tiers
    const activeTierIndex = PRICE_TIERS.findIndex(
      (t) => projectedTotal >= t.min && projectedTotal <= t.max
    );
    renderPriceTiers(activeTierIndex);

    // Badge de contexto. NO se oculta nunca (así el bloque de precio
    // mantiene la misma altura en todos los tiers y no salta cuando
    // se cruza al máximo). Tres estados posibles:
    //   - Tier máximo (next === null): mensaje positivo "Ya tenés
    //     el mejor precio".
    //   - Faltan ≤3 unidades para el próximo tier: "Agregá X más".
    //   - Faltan >3 unidades (no debería pasar con los tiers
    //     actuales, pero por las dudas): frase de contexto.
    const next = getNextTier(projectedTotal);
    if (!next) {
      modalPriceBadge.textContent = "✓ Ya tenés el mejor precio por unidad";
    } else if (next.unitsNeeded <= 3) {
      const word = next.unitsNeeded === 1 ? "remera" : "remeras";
      modalPriceBadge.textContent = `Agregá ${next.unitsNeeded} ${word} más y todas salen a ${formatPrice(next.price)} c/u`;
    } else {
      modalPriceBadge.textContent = `Sumá ${next.unitsNeeded} remeras más para llegar a ${formatPrice(next.price)} c/u`;
    }
    modalPriceBadge.hidden = false;

    // Total
    modalPriceTotal.textContent = formatPrice(totalWithProduct);

    // Flash (solo si el unitario cambió)
    if (animate && lastUnitPrice !== null && unitPrice !== lastUnitPrice) {
      flashPriceElement(modalPriceUnit, unitPrice < lastUnitPrice);
    }
    lastUnitPrice = unitPrice;
  }

  // Calcula el ancho de la barra de scroll y lo guarda en una variable CSS.
  // Sirve para compensar el "salto" que hace el layout cuando se oculta la barra.
  function getScrollbarWidth() {
    return window.innerWidth - document.documentElement.clientWidth;
  }

  function lockScroll() {
    const scrollbarWidth = getScrollbarWidth();
    if (scrollbarWidth > 0) {
      document.body.style.paddingRight = `${scrollbarWidth}px`;
    }
    document.body.classList.add("modal-open");
  }

  function unlockScroll() {
    document.body.style.paddingRight = "";
    document.body.classList.remove("modal-open");
  }

  // Dispara el glitch del título del modal (E19 y E20 comparten esta
  // función). Recibe la duración en ms. Cancela cualquier timer
  // anterior para que dos glitches seguidos no se pisen.
  let modalTitleGlitchTimer = null;
  function triggerModalTitleGlitch(duration = 400) {
    if (!modalTitle) return;
    if (modalTitleGlitchTimer) clearTimeout(modalTitleGlitchTimer);
    // Forzamos reinicio de la animación aunque ya estuviera activa.
    modalTitle.classList.remove("glitching");
    void modalTitle.offsetWidth;
    modalTitle.classList.add("glitching");
    modalTitleGlitchTimer = setTimeout(() => {
      modalTitle.classList.remove("glitching");
      modalTitleGlitchTimer = null;
    }, duration);
  }


  function openModal(product) {
    // Si había un cierre en curso (CRT close), lo cancelamos.
    if (modalCloseTimer) {
      clearTimeout(modalCloseTimer);
      modalCloseTimer = null;
    }
    modal.classList.remove("is-closing");

    const name = product.querySelector("h3")?.textContent ?? "";
    const category = product.querySelector(".product-category");
    const overlay = product.querySelector(".product-overlay");
    const categoryColor =
      overlay?.style.getPropertyValue("--category-color") ?? "#ffffff";
    const categoryName =
      category?.textContent?.trim() ?? "";

    // Enviamos evento a Clarity: qué producto se vio.
    // Usamos el data-id (slug del producto) como identificador.
    const productIdForClarity = product.dataset.id || "";
    if (window.clarity && productIdForClarity) {
      window.clarity("event", "view_" + productIdForClarity);
    }


    const image = product.querySelector(".product-image-base");
    if (!image) return;

    const modelo = image.getAttribute("src");
    const remera = modelo.replace("/modelo.", "/remera.");

    // Fotos extra: vienen del JSON generado por el script.
    // Cada extra tiene { src, label }. Si no hay, el array queda vacío.
    const extras = product.dataset.extras
      ? JSON.parse(product.dataset.extras)
      : [];

    currentImages = [
      { src: modelo, label: "Modelo" },
      { src: remera, label: "Remera" },
      ...extras.map((extra) => ({
        src: `${base}${extra.src}`,
        label: extra.label,
      })),
      { src: `${base}/talles/oversize.webp`, label: "Talles Oversize" },
      { src: `${base}/talles/regular.webp`, label: "Talles Regular" },
    ];

    currentImageIndex = 0;
    currentProductName = name;
    currentProductId = product.dataset.id || "";
    currentQuantity = 1;
    lastUnitPrice = null;
    lastRenderedPrice = null;

    // Recalculamos los índices zoomeables para este producto
    // (depende de cuántos slides tenga: 4 sin extras, 5 con 1 extra, etc.)
    zoomableIndices = currentImages
      .map((_, index) => (isZoomableSlide(index, currentImages.length) ? index : -1))
      .filter((index) => index !== -1);

    // Reseteamos las dos capas de imagen para que el próximo modal
    // arranque limpio (sin restos del producto anterior).
    modalImageActive = modalImageA;
    modalImageA.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade", "leave-to-left", "leave-to-right", "leave-fade");
    modalImageB.classList.remove("active", "enter-from-right", "enter-from-left", "enter-fade", "leave-to-left", "leave-to-right", "leave-fade");
    modalImageA.src = "";
    modalImageB.src = "";
    selectedFit = "Oversize";
    selectedSize = "L";

    modalTitle.textContent = name;
    modalCategory.textContent = categoryName;

    renderThumbs();
    renderModalImage();
    renderFits();
    renderSizes();
    updateSizeCm();
    renderQuantity();

    modalAdd.classList.remove("is-added");
    if (modalAddText) modalAddText.textContent = "Agregar al Pedido";

    modal.style.setProperty("--category-color", categoryColor);

    modal.setAttribute("aria-hidden", "false");
    lockScroll();

    // Empujamos el modal a la pila del historial para que el botón "atrás"
    // del celular lo cierre en vez de salir de la página. Si el modal se
    // abrió porque la URL traía un hash (link compartido), NO lo hacemos:
    // el usuario entró directo, no navegó desde la página.
    if (!openingFromHash) {
      pushHistory("modal");
      // Actualizamos la URL con el hash del producto, sin agregar
      // otra entrada al historial (pushHistory ya lo hizo).
      // Así, si el usuario copia la URL del navegador, lleva directo
      // al producto.
      try {
        const urlObj = new URL(window.location.href);
        urlObj.hash = currentProductId ? `#${currentProductId}` : "";
        history.replaceState(history.state, "", urlObj);
      } catch (error) {
        console.warn("[KRAKOA] No se pudo actualizar la URL:", error);
      }
    }

    // Actualizamos el título de la pestaña con el nombre del producto.
    updatePageTitle();

    // Separamos el "pintar el modal" (que existe, pero invisible) del
    // "animar el modal" (agregar .open). Así el navegador tiene un frame
    // completo para calcular layout antes de arrancar la animación.
    // Esto reduce mucho el "tirón" en mobile, especialmente la primera vez.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        modal.classList.add("open");
      });
    });

    // Glitch breve del título después de que el modal ya está
    // entrando (200ms de delay para que no compita con la
    // animación de apertura del modal).
    setTimeout(() => triggerModalTitleGlitch(400), 200);
  }
  


  function closeModal() {
    // Si el modal está en la pila, lo sacamos por ahí: history.back()
    // dispara el popstate, que hace el cierre real. Así el "atrás" del
    // celular y el click en la X quedan perfectamente sincronizados.
    if (isTopOfHistory("modal")) {
      popHistory();
      return;
    }
    closeModalDirect();
  }

  function closeModalDirect() {
    // Si ya está cerrado (aria-hidden="true"), no hacemos nada.
    if (modal.getAttribute("aria-hidden") === "true") return;

    // Disparamos el CRT close.
    modal.classList.remove("open");
    modal.classList.add("is-closing");
    unlockScroll();

    // Quitamos el hash del producto de la URL (sin agregar entrada nueva).
    // Cuando el cierre viene desde popstate (botón atrás), la URL ya
    // cambió a la base: este replaceState queda como no-op.
    try {
      const urlObj = new URL(window.location.href);
      urlObj.hash = "";
      history.replaceState(history.state, "", urlObj);
    } catch (error) {
      console.warn("[KRAKOA] No se pudo limpiar el hash de la URL:", error);
    }

    // Al cerrar el modal, el título vuelve al de la categoría activa
    // (o al default si no hay filtro).
    updatePageTitle();

    // Esperamos a que termine la animación CRT close para limpiar
    // el estado (aria-hidden, is-closing).
    if (modalCloseTimer) clearTimeout(modalCloseTimer);
    modalCloseTimer = setTimeout(() => {
      modal.classList.remove("is-closing");
      modal.setAttribute("aria-hidden", "true");
      modalCloseTimer = null;
    }, 380);
  }

  // -------------------------
  // ZOOM DE IMAGEN
  // -------------------------

  // Renderiza la imagen del zoom según zoomImageIndex.
  // Se usa tanto al abrir como al navegar entre fotos zoomeables.
  function renderImageZoom() {
    const current = currentImages[zoomImageIndex];
    if (!current) return;
    imageZoomImg.src = current.src;
    imageZoomImg.alt = `${currentProductName} — ${current.label}`;
  }

  // Abre el zoom apuntando al slide "startIndex".
  function openImageZoom(startIndex) {
    zoomImageIndex = startIndex;
    resetImageZoomScale();
    renderImageZoom();
    imageZoom.setAttribute("aria-hidden", "false");
    imageZoom.classList.add("open");
    pushHistory("image-zoom");
  }

  // Salta a la foto zoomeable anterior / siguiente (con wrap).
  function showZoomPrev() {
    const pos = zoomableIndices.indexOf(zoomImageIndex);
    if (pos === -1) return;
    const prevPos = (pos - 1 + zoomableIndices.length) % zoomableIndices.length;
    zoomImageIndex = zoomableIndices[prevPos];
    resetImageZoomScale();
    renderImageZoom();
  }

  function showZoomNext() {
    const pos = zoomableIndices.indexOf(zoomImageIndex);
    if (pos === -1) return;
    const nextPos = (pos + 1) % zoomableIndices.length;
    zoomImageIndex = zoomableIndices[nextPos];
    resetImageZoomScale();
    renderImageZoom();
  }

  function closeImageZoom() {
    if (isTopOfHistory("image-zoom")) {
      popHistory();
      return;
    }
    closeImageZoomDirect();
  }

  function closeImageZoomDirect() {
    if (imageZoom.getAttribute("aria-hidden") === "true") return;
    imageZoom.classList.remove("open");
    imageZoom.setAttribute("aria-hidden", "true");
    resetImageZoomScale();

    // Limpiamos la src para que no quede la imagen colgada en memoria.
    // La hacemos después de la transición.
    setTimeout(() => {
      if (!imageZoom.classList.contains("open")) {
        imageZoomImg.src = "";
      }
    }, 260);
  }


  function showPreviousImage() {
    currentImageIndex =
      (currentImageIndex - 1 + currentImages.length) % currentImages.length;
    renderModalImage("prev");
  }


  function showNextImage() {
    currentImageIndex = (currentImageIndex + 1) % currentImages.length;
    renderModalImage("next");
  }


  // -------------------------
  // NAVEGACIÓN ENTRE PRODUCTOS
  // -------------------------

  // Devuelve la lista de productos VISIBLES en el ORDEN ACTUAL del DOM
  // (respetando filtros de categoría, búsqueda y reordenamiento).
  //
  // OJO: no usamos el NodeList `products` (que se creó al inicio del
  // script y no se actualiza cuando reordenamos el DOM con appendChild).
  // Consultamos el DOM en vivo para obtener el orden real.
  function getVisibleProducts() {
    return Array.from(
      document.querySelectorAll("#products .product-card")
    ).filter((product) => {
      // Una tarjeta cuenta como "visible" si no está oculta
      // (.is-hidden). Como ahora el hide es instantáneo (display:
      // none), no hace falta chequear estados intermedios.
      return !product.classList.contains("is-hidden");
    });
  }

  // Encuentra el producto actual en el DOM (para saber dónde estamos parados).
  function findCurrentProductIndex(visibleList) {
    return visibleList.findIndex(
      (product) => product.dataset.id === currentProductId
    );
  }

  // Cambia al producto anterior o siguiente con animación.
  // direction: "next" | "prev"
  function switchProduct(direction) {
    if (isSwitchingProduct) return;
    if (!modal.classList.contains("open")) return;

    const visibleList = getVisibleProducts();
    if (visibleList.length === 0) return;

    const currentIndex = findCurrentProductIndex(visibleList);
    if (currentIndex === -1) return;

    let targetIndex;
    if (direction === "next") {
      targetIndex = (currentIndex + 1) % visibleList.length;
    } else {
