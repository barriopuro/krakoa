];
let tintIndex = 0;
let tintTimer = null;

function commitTintSwap() {
  if (!tintTimer) return;
  clearTimeout(tintTimer);
  tintTimer = null;
  const old = tintLayers[tintIndex];
  tintIndex = 1 - tintIndex;
  old.classList.remove("visible", "leaving");
}

function showTint(color) {
  // Si había un swap en curso, lo cerramos ya.
  if (tintTimer) commitTintSwap();

  const active = tintLayers[tintIndex];
  const next = tintLayers[1 - tintIndex];

  // Primer tinte: no había nada visible, solo entra la capa activa.
  if (!active.classList.contains("visible")) {
    active.style.setProperty("--tint-color", color);
    active.classList.add("visible");
    return;
  }

  // Cambio de categoría: capa nueva entra desde la derecha,
  // capa vieja sale hacia la izquierda.
  next.style.setProperty("--tint-color", color);
  next.classList.remove("visible", "leaving");
  void next.offsetWidth; // forzar reflow
  next.classList.add("visible");
  active.classList.add("leaving");

  tintTimer = setTimeout(() => {
    tintTimer = null;
    tintIndex = 1 - tintIndex;
    active.classList.remove("visible", "leaving");
  }, 600);
}

function hideTint() {
  if (tintTimer) commitTintSwap();
  tintLayers[tintIndex].classList.remove("visible");
}
  const backToTop = document.querySelector("#back-to-top");
