<script define:vars={{ base, PROMO_DATA: promo }}>

  // Loader de carga inicial
  (() => {
    const loader = document.querySelector("#krakoa-loader");
    if (!loader) return;
    const img = loader.querySelector("img");
    const MIN_TIME = 700;
    const startTime = Date.now();

    // Esperamos 2 frames para que el navegador pinte, y mostramos el logo
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        img.style.opacity = "1";
      });
    });

    const hide = () => {
      const elapsed = Date.now() - startTime;
      const wait = Math.max(0, MIN_TIME - elapsed);
      setTimeout(() => {
        loader.style.opacity = "0";
        loader.style.pointerEvents = "none";
        setTimeout(() => loader.remove(), 500);
      }, wait);
    };

    if (document.readyState === "complete") {
      hide();
    } else {
      window.addEventListener("load", hide, { once: true });
    }
  })();

  // -------------------------
  // PROMO POPUP
  // -------------------------
  // La config viene del JSON generado por el script (src/data/promo.json).
  // Necesitamos pasarla al cliente porque el script de Astro corre
  // después del render. Usamos un objeto global.
  window.KRAKOA_PROMO = PROMO_DATA;

  // Exponemos closePromoModalDirect para que closeTopOverlay() la use.
  window.KRAKOA_CLOSE_PROMO = null;

  (() => {
    const promoModal = document.querySelector("#promo-modal");
    if (!promoModal) return; // no hay promo configurada

    const promoData = window.KRAKOA_PROMO;
    if (!promoData || !promoData.activa) return;
    if (!promoData.imagenes || promoData.imagenes.length === 0) return;

    const promoImages = promoModal.querySelectorAll(".promo-image-el");
    const promoThumbs = promoModal.querySelectorAll(".promo-thumb");
    const promoPrev = promoModal.querySelector("#promo-prev");
    const promoNext = promoModal.querySelector("#promo-next");
    const promoClose = promoModal.querySelector("#promo-close");
    const promoDontShow = promoModal.querySelector("#promo-dont-show");
    const promoBackdrop = promoModal.querySelector(".promo-backdrop");

    const STORAGE_KEY_DONT_SHOW = "krakoa_promo_dont_show";
    const STORAGE_KEY_SESSION = "krakoa_promo_session_closed";

    let promoIndex = 0;
    let autoRotateTimer = null;
    let autoRotateActive = true;

    // ¿Debemos mostrar la promo?
    function shouldShowPromo() {
      // 1) Si el usuario la cerró en ESTA sesión (con la ×), no mostrar.
      if (sessionStorage.getItem(STORAGE_KEY_SESSION) === "1") {
        return false;
      }

      // 2) Si el usuario tocó "No mostrar de nuevo", chequeamos:
      //    - Si el hash de la promo cambió → mostrar (es una promo nueva).
      //    - Si pasaron más de X horas → mostrar.
      try {
        const raw = localStorage.getItem(STORAGE_KEY_DONT_SHOW);
        if (!raw) return true;

        const saved = JSON.parse(raw);
        const currentHash = promoData.hash;

        if (saved.hash && saved.hash !== currentHash) {
          // La promo cambió → mostrar.
          return true;
        }

        const hoursPassed = (Date.now() - saved.timestamp) / (1000 * 60 * 60);
        const limit = promoData.config.noMostrarDuracionHoras || 24;

        return hoursPassed >= limit;
      } catch (error) {
        return true;
      }
    }

    function renderPromoImage(index) {
      promoIndex = index;
      promoImages.forEach((img, i) => {
        img.classList.toggle("active", i === index);
      });
      promoThumbs.forEach((thumb, i) => {
        thumb.classList.toggle("active", i === index);
      });
    }

    function stopAutoRotate() {
      if (autoRotateTimer) {
        clearInterval(autoRotateTimer);
        autoRotateTimer = null;
      }
      autoRotateActive = false;
    }

    function startAutoRotate() {
      // Solo si hay más de 1 imagen y no fue detenido por el usuario.
      if (promoImages.length < 2) return;
      if (!autoRotateActive) return;
      if (autoRotateTimer) return;

      const seconds = promoData.config.autoRotateSegundos || 5;
      autoRotateTimer = setInterval(() => {
        const nextIndex = (promoIndex + 1) % promoImages.length;
