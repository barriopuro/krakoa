  // Circunferencia del anillo (2π × r, con r=19).
  // Tiene que coincidir con el stroke-dasharray del CSS.
  const BACK_TO_TOP_CIRCUMFERENCE = 2 * Math.PI * 19;

  function updateScrollProgress() {
    if (!scrollProgress) return;
    const docHeight =
      document.documentElement.scrollHeight - window.innerHeight;
    // Si la página no scrollea (contenido más corto que la ventana),
    // dejamos la barra en 0.
    const percent = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
    scrollProgress.style.width = `${percent}%`;

    // Anillo del botón "volver arriba": se llena de 0 a 100.
    // dashoffset va de C (vacío) a 0 (lleno).
    if (backToTopRingProgress) {
      const offset = BACK_TO_TOP_CIRCUMFERENCE * (1 - percent / 100);
      backToTopRingProgress.style.strokeDashoffset = String(offset);
