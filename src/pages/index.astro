  />

  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#111111" />

  <meta property="og:title" content="KRAKOA | Remeras" />
  <meta
    property="og:description"
    content="Catálogo de remeras inspiradas en anime, música, cine, series, deportes, videojuegos y cultura pop."
  />
